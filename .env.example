# One2All Paddle 配置文件
# 复制此文件为 .env 并修改配置

# 模型输出目录（默认：项目根目录/output）
# 支持绝对路径或相对路径
OUTPUT_DIR=output

# 产品数据目录（默认：项目根目录/product）
# 支持绝对路径或相对路径
PRODUCT_DIR=product

# 预训练模型目录（默认：项目根目录/models/pretrained）
MODELS_DIR=models/pretrained

# 推理服务脚本目录（默认：项目根目录/inference_services）
INFERENCE_SCRIPTS_DIR=inference_services

# 示例：使用绝对路径
# OUTPUT_DIR=D:/One2All/data/output
# PRODUCT_DIR=D:/One2All/data/product
# MODELS_DIR=D:/One2All/models
# INFERENCE_SCRIPTS_DIR=D:/One2All/inference_services
