@app.post("/predict", response_model=PredictMultipleWorkpiecesResponse)
async def predict_multiple(
    file:       UploadFile = File(None),
    image:      str        = Form(None),
    return_viz: bool       = Form(False),
):
    """
    多工件检测接口 - 检测图像中的多个工件，对每个工件分别进行异常检测
    
    Args:
        file: 上传的图像文件
        image: Base64编码的图像
        return_viz: 是否返回可视化结果
        
    Returns:
        包含所有工件检测结果的字典
    """
    start_time = time.time()
    request_id = f"{int(start_time * 1000)}"
    monitor    = PerformanceMonitor(request_id)

    logger.info(f"[{request_id}] ========== MULTI-WORKPIECE PREDICTION REQUEST ==========")

    init_res = monitor.get_full_resource_snapshot()
    logger.info(f"[{request_id}] CPU: {init_res['cpu']['usage_percent']:.1f}%, "
                f"Memory: {init_res['memory']['used_gb']:.2f}GB")
    if 'error' not in init_res['gpu']:
        logger.info(f"[{request_id}] GPU: {init_res['gpu']['allocated_mb']:.1f}MB allocated")

    async with _infer_semaphore:
        try:
            with monitor.step("image_decode"):
                image_data: Optional[np.ndarray] = None
                if file is not None:
                    contents   = await file.read()
                    nparr      = np.frombuffer(contents, np.uint8)
                    image_data = cv2.imdecode(nparr, cv2.IMREAD_COLOR)
                    logger.info(f"[{request_id}] file upload: {file.filename}, {len(contents)} bytes")
                elif image is not None:
                    b64        = image.split(",")[1] if "," in image else image
                    nparr      = np.frombuffer(base64.b64decode(b64), np.uint8)
                    image_data = cv2.imdecode(nparr, cv2.IMREAD_COLOR)
                    logger.info(f"[{request_id}] base64 input")
                else:
                    raise HTTPException(status_code=400, detail="No image provided")

                if image_data is None:
                    raise HTTPException(status_code=400, detail="Invalid image")
                logger.info(f"[{request_id}] decoded image shape={image_data.shape}")

            if PATCHCORE_DETECTOR is None:
                raise HTTPException(status_code=500, detail="Models not loaded")
            if TEMPLATE_IMAGE is None:
                raise HTTPException(status_code=500, detail="Template image not loaded")
            if not TEMPLATE_ANNOTATIONS:
                raise HTTPException(status_code=400, detail="No template annotations available")

            monitor.start_step("total_inference")
            loop = asyncio.get_running_loop()
            try:
                detect_result = await asyncio.wait_for(
                    loop.run_in_executor(
                        _executor_manager.executor,
                        lambda: detect_multiple_workpieces(
                            PATCHCORE_DETECTOR,
                            image_data,
                            TEMPLATE_IMAGE,
                            TEMPLATE_ANNOTATIONS,
                            request_id,
                            monitor,
                            return_visualization=return_viz,
                            reference_workpiece_size=REFERENCE_WORKPIECE_SIZE,
                        )
                    ),
                    timeout=INFERENCE_TIMEOUT_SEC * 3,  # 多工件检测超时时间更长
                )
                monitor.end_step("total_inference")
            except asyncio.TimeoutError:
                monitor.end_step("total_inference")
                logger.error(f"[{request_id}] Multi-workpiece inference timeout after {INFERENCE_TIMEOUT_SEC * 3}s")
                _cleanup(f"[{request_id}] timeout cleanup")
                await _executor_manager.rebuild(reason=f"multi-workpiece timeout [{request_id}]")
                raise HTTPException(status_code=503, detail="Inference timeout, please retry")
            except Exception as exec_err:
                monitor.end_step("total_inference")
                logger.error(f"[{request_id}] Executor error: {exec_err}")
                _cleanup(f"[{request_id}] executor error cleanup")
                await _executor_manager.rebuild(reason=f"executor error [{request_id}]")
                raise

            workpiece_results  = detect_result["workpiece_results"]
            visualization      = detect_result.get("visualization")
            total_workpieces   = detect_result.get("total_workpieces", 0)
            total_anomalies    = detect_result.get("total_anomalies", 0)
            processing_time    = time.time() - start_time

            monitor.log_summary()
            logger.info(
                f"[{request_id}] Workpieces={total_workpieces}, "
                f"total_anomalies={total_anomalies}, "
                f"time={processing_time:.3f}s"
            )
            
            for wp in workpiece_results:
                wp_id = wp.get("workpiece_id", 0)
                wp_anomalies = wp.get("anomaly_count", 0)
                wp_rois = len(wp.get("results", []))
                logger.info(
                    f"[{request_id}] Workpiece {wp_id}: bbox={wp.get('bbox')}, "
                    f"ROIs={wp_rois}, anomalies={wp_anomalies}, strategy={wp.get('strategy')}"
                )
            
            logger.info(f"[{request_id}] ========== MULTI-WORKPIECE REQUEST COMPLETED ==========")
            for handler in logger.handlers:
                handler.flush()

            # 转换结果为Pydantic模型
            wp_results = []
            for wp in workpiece_results:
                wp_results.append(WorkpieceResult(
                    workpiece_id=wp.get("workpiece_id", 0),
                    bbox=list(wp.get("bbox", [0, 0, 0, 0])),
                    results=wp.get("results", []),
                    anomaly_count=wp.get("anomaly_count", 0),
                    strategy=wp.get("strategy", "none"),
                    error=wp.get("error"),
                ))

            return PredictMultipleWorkpiecesResponse(
                workpiece_results=wp_results,
                total_workpieces=total_workpieces,
               total_anomalies=total_anomalies,
                processing_time=processing_time,
                visualization_b64=encode_image_to_base64(visualization) if visualization is not None else None,
            )

        except HTTPException:
            raise
        except Exception as e:
            logger.error(f"[{request_id}] Multi-workpiece prediction error: {e}", exc_info=True)
            raise HTTPException(status_code=500, detail=str(e))


