class MultiScaleFeatureExtractor(torch_nn.Module):
    GRAY_CHANNELS = 4

    UPSAMPLE_TARGETS = {
        "micro": (16, 16),
        "tiny": (16, 16),
        "small": (32, 32),
        "medium": (64, 64),
    }

    SIZE_THRESHOLD_MICRO = 8
    SIZE_THRESHOLD_SMALL = 16
    SIZE_THRESHOLD_MEDIUM = 32

    def __init__(self, backbone_name: str = "resnet18"):
        super().__init__()

        if backbone_name == "resnet50":
            backbone = torchvision_models.resnet50(pretrained=True)
            self.layer1_channels = 256
            self.layer2_channels = 512
        else:
            backbone = torchvision_models.resnet18(pretrained=True)
            self.layer1_channels = 64
            self.layer2_channels = 128

        self.stem = torch_nn.Sequential(
            backbone.conv1,
            backbone.bn1,
            backbone.relu,
            torch_nn.MaxPool2d(kernel_size=3, stride=1, padding=1),
        )

        self.layer1 = backbone.layer1
        self.layer2 = backbone.layer2

        if hasattr(self.layer2[0], 'conv1'):
            if hasattr(self.layer2[0], 'downsample') and self.layer2[0].downsample is not None:
                for module in self.layer2[0].downsample:
                    if isinstance(module, torch_nn.Conv2d):
                        module.stride = (1, 1)
            self.layer2[0].conv1.stride = (1, 1)
        elif hasattr(self.layer2[0], 'conv2'):
            if hasattr(self.layer2[0], 'downsample') and self.layer2[0].downsample is not None:
                for module in self.layer2[0].downsample:
                    if isinstance(module, torch_nn.Conv2d):
                        module.stride = (1, 1)
            self.layer2[0].conv2.stride = (1, 1)

        self.out_channels = self.layer1_channels + self.layer2_channels + self.GRAY_CHANNELS

        for param in self.parameters():
            param.requires_grad = False

    def _get_target_size(self, x: torch.Tensor) -> tuple:
        max_size = max(x.shape[2], x.shape[3])
        if max_size <= self.SIZE_THRESHOLD_MICRO:
            return self.UPSAMPLE_TARGETS["micro"]
        elif max_size <= self.SIZE_THRESHOLD_SMALL:
            return self.UPSAMPLE_TARGETS["tiny"]
        elif max_size <= self.SIZE_THRESHOLD_MEDIUM:
            return self.UPSAMPLE_TARGETS["small"]
        else:
            return self.UPSAMPLE_TARGETS["medium"]

    def _compute_gray_features(self, x: torch.Tensor, target_size: tuple) -> torch.Tensor:
        gray = x.mean(dim=1, keepdim=True)
        gray_feat = F_torch.interpolate(
            gray,
            size=target_size,
            mode="bilinear",
            align_corners=False,
        )
        gray_feat = gray_feat.repeat(1, self.GRAY_CHANNELS, 1, 1)
        return F_torch.normalize(gray_feat, dim=1)

    def forward(self, x: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
        """
        返回 (patches, valid_mask)
        patches:    [B, H*W, C]  已 L2 归一化
        valid_mask: [B, H*W]     True 表示有效区域（非 padding）
        """
        orig_h, orig_w = x.shape[2], x.shape[3]
        target_size = self._get_target_size(x)
        need_upsample = x.shape[2:] != target_size
        if need_upsample:
            x = F_torch.interpolate(
                x,
                size=target_size,
                mode="bilinear",
                align_corners=False
            )

        x_stem = self.stem(x)
        f1 = self.layer1(x_stem)
        f2 = self.layer2(f1)

        f1_norm = F_torch.normalize(f1, dim=1)
        f2_norm = F_torch.normalize(f2, dim=1)

        if x.shape[1] == 3:
            gray_feat = self._compute_gray_features(x, f2.shape[-2:])
            combined = torch.cat([f1_norm, f2_norm, gray_feat], dim=1)
        else:
            combined = torch.cat([f1_norm, f2_norm], dim=1)

        B, C, H, W = combined.shape
        patches = combined.permute(0, 2, 3, 1).reshape(B, H * W, C)
        patches = F_torch.normalize(patches, dim=-1)

        # 计算特征空间中的有效区域 mask（排除 padding 区域）
        if need_upsample:
            up_h, up_w = H, W
            valid_h = min(orig_h, up_h)
            valid_w = min(orig_w, up_w)
            top  = int((up_h - valid_h) // 2)
            left = int((up_w - valid_w) // 2)
            mask = torch.zeros(B, H, W, dtype=torch.bool, device=patches.device)
            mask[:, top:top + valid_h, left:left + valid_w] = True
            valid_mask = mask.reshape(B, H * W)
        else:
            valid_mask = torch.ones(B, H * W, dtype=torch.bool, device=patches.device)

        return patches, valid_mask


