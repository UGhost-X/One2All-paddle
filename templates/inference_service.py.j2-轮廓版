    COLOR_DASH     = (128, 128, 128)

    DISPLAY_SIZE = (400, 400)
    ROI_SIZE     = (150, 150)
    row1_height  = DISPLAY_SIZE[1] + 60

    def _resize(img):
        return cv2.resize(img, DISPLAY_SIZE)

    def draw_dashed_rect(img, pt1, pt2, color, thickness=1, dash_length=10, gap_length=5):
        x1, y1 = pt1; x2, y2 = pt2
        for x in range(x1, x2, dash_length + gap_length):
            end_x = min(x + dash_length, x2)
            cv2.line(img, (x, y1), (end_x, y1), color, thickness)
            cv2.line(img, (x, y2), (end_x, y2), color, thickness)
        for y in range(y1, y2, dash_length + gap_length):
            end_y = min(y + dash_length, y2)
            cv2.line(img, (x1, y), (x1, end_y), color, thickness)
            cv2.line(img, (x2, y), (x2, end_y), color, thickness)

    sx = DISPLAY_SIZE[0] / template_img.shape[1]
    sy = DISPLAY_SIZE[1] / template_img.shape[0]

    tmpl_viz = _resize(template_img).copy()
    if template_workpiece_bbox is not None:
        wx, wy, ww, wh = template_workpiece_bbox
        cv2.rectangle(tmpl_viz, (int(wx*sx), int(wy*sy)), (int((wx+ww)*sx), int((wy+wh)*sy)), COLOR_WORKPIECE, 2)
        tmpl_viz = cv2_put_chinese_text(tmpl_viz, "工件", (int(wx*sx), max(int(wy*sy)-25, 0)), COLOR_WORKPIECE, 16)

    for i, ann in enumerate(annotations):
        segmentation = ann.get("segmentation", [])
        if segmentation:
            for seg in segmentation:
                pts = np.array(seg).reshape(-1, 2).astype(np.float32)
                pts[:, 0] *= sx; pts[:, 1] *= sy
                cv2.polylines(tmpl_viz, [pts.astype(np.int32)], True, COLOR_TEMPLATE, 2)
                tmpl_viz = cv2_put_chinese_text(tmpl_viz, f"{i+1}", (int(pts[0][0]), max(int(pts[0][1])-25, 0)), COLOR_TEMPLATE, 18)
        else:
            x, y, w, h = ann.get("bbox", [0, 0, 0, 0])
            cv2.rectangle(tmpl_viz, (int(x*sx), int(y*sy)), (int((x+w)*sx), int((y+h)*sy)), COLOR_TEMPLATE, 2)
            tmpl_viz = cv2_put_chinese_text(tmpl_viz, f"{i+1}", (int(x*sx), max(int(y*sy)-25, 0)), COLOR_TEMPLATE, 18)

    col1 = np.full((row1_height, DISPLAY_SIZE[0], 3), COLOR_BG, dtype=np.uint8)
    col1[60:] = tmpl_viz
    col1 = cv2_put_chinese_text(col1, "1. 模板图像 + 标注框", (10, 30), COLOR_TEXT, 22)

    alignment_ok = (strategy == "sift" or strategy == "sift_workpiece")

    if alignment_ok:
        ap_viz = _resize(aligned_pred).copy()
        for i, (ann, res) in enumerate(zip(annotations, results)):
            color = COLOR_ANOMALY if res.get("is_anomaly", False) else COLOR_NORMAL
            segmentation = ann.get("segmentation", [])
            if segmentation:
                for seg in segmentation:
                    pts = np.array(seg).reshape(-1, 2).astype(np.float32)
                    pts[:, 0] *= sx; pts[:, 1] *= sy
                    cv2.polylines(ap_viz, [pts.astype(np.int32)], True, color, 2)
                    ap_viz = cv2_put_chinese_text(ap_viz, f"{i+1}", (int(pts[0][0]), max(int(pts[0][1])-25, 0)), color, 16)
            else:
                x, y, w, h = ann.get("bbox", [0, 0, 0, 0])
                cv2.rectangle(ap_viz, (int(x*sx), int(y*sy)), (int((x+w)*sx), int((y+h)*sy)), color, 2)
                ap_viz = cv2_put_chinese_text(ap_viz, f"{i+1}", (int(x*sx), max(int(y*sy)-25, 0)), color, 16)
    else:
        ap_viz = _resize(pred_img).copy()
        sx_p = DISPLAY_SIZE[0] / pred_img.shape[1]
        sy_p = DISPLAY_SIZE[1] / pred_img.shape[0]
        for i, (ann, res) in enumerate(zip(annotations, results)):
            color = COLOR_ANOMALY if res.get("is_anomaly", False) else COLOR_NORMAL
            seg_in_pred = res.get("segmentation_in_pred", [])
            bbox_in_pred = res.get("bbox_in_pred", [0, 0, 0, 0])
            if seg_in_pred and len(seg_in_pred) >= 8:
                pts = np.array([[seg_in_pred[j], seg_in_pred[j+1]]
                               for j in range(0, len(seg_in_pred), 2)],
                              dtype=np.float32)
                pts[:, 0] *= sx_p; pts[:, 1] *= sy_p
                cv2.polylines(ap_viz, [pts.astype(np.int32)], True, color, 2)
                ap_viz = cv2_put_chinese_text(ap_viz, f"{i+1}", (int(pts[0][0]), max(int(pts[0][1])-25, 0)), color, 16)
            elif bbox_in_pred and len(bbox_in_pred) >= 4:
                x, y, w, h = bbox_in_pred
                cv2.rectangle(ap_viz, (int(x*sx_p), int(y*sy_p)), (int((x+w)*sx_p), int((y+h)*sy_p)), color, 2)
                ap_viz = cv2_put_chinese_text(ap_viz, f"{i+1}", (int(x*sx_p), max(int(y*sy_p)-25, 0)), color, 16)

    col2 = np.full((row1_height, DISPLAY_SIZE[0], 3), COLOR_BG, dtype=np.uint8)
    col2[60:] = ap_viz
    col2_title = "2. 对齐后预测图 + 结果" if alignment_ok else "2. 预测图 + 结果(对齐失败)"
    col2 = cv2_put_chinese_text(col2, col2_title, (10, 30), COLOR_TEXT, 22)

    col3_viz = _resize(pred_img).copy()
    sx_p = DISPLAY_SIZE[0] / pred_img.shape[1]
    sy_p = DISPLAY_SIZE[1] / pred_img.shape[0]
    if pred_workpiece_bbox is not None:
        wx, wy, ww, wh = pred_workpiece_bbox
        cv2.rectangle(col3_viz, (int(wx*sx_p), int(wy*sy_p)), (int((wx+ww)*sx_p), int((wy+wh)*sy_p)), COLOR_WORKPIECE, 2)

    col3 = np.full((row1_height, DISPLAY_SIZE[0], 3), COLOR_BG, dtype=np.uint8)
    col3[60:] = col3_viz
    col3 = cv2_put_chinese_text(col3, "3. 原始预测图", (10, 30), COLOR_TEXT, 22)

    row1 = np.hstack([col1, col2, col3])

    rois_per_row   = 3
    n_results      = len(results)
    n_rows         = max(1, (n_results + rois_per_row - 1) // rois_per_row)
    compare_width  = ROI_SIZE[0] * 2 + 20
    roi_row_height = ROI_SIZE[1] + 80
    row2_width     = row1.shape[1]
    row2 = np.full((roi_row_height * n_rows + 60, row2_width, 3), COLOR_BG, dtype=np.uint8)
    row2 = cv2_put_chinese_text(row2, "4. ROI 对比详情 (模板 | 对齐后预测)", (20, 30), COLOR_TEXT, 24)

    def _extract_roi_viz(img, ann):
        segmentation = ann.get('segmentation', [])
        canvas = np.zeros((ROI_SIZE[1], ROI_SIZE[0], 3), dtype=np.uint8)
        if segmentation:
            all_pts = []
            for seg in segmentation:
                pts = np.array(seg).reshape(-1, 2).astype(np.int32)
                all_pts.append(pts)
            if all_pts:
                all_points = np.vstack(all_pts)
                x_min, y_min = np.min(all_points, axis=0)
                x_max, y_max = np.max(all_points, axis=0)
                pad = max(int((x_max - x_min) * 0.1), int((y_max - y_min) * 0.1), 1)
                x_min = max(0, x_min - pad); y_min = max(0, y_min - pad)
                x_max = min(img.shape[1], x_max + pad); y_max = min(img.shape[0], y_max + pad)
                roi = img[y_min:y_max, x_min:x_max].copy()
                if roi.size > 0:
                    mask = np.zeros((y_max - y_min, x_max - x_min), dtype=np.uint8)
                    for pts in all_pts:
                        cv2.fillPoly(mask, [pts - [x_min, y_min]], 255)
                    roi = cv2.bitwise_and(roi, roi, mask=mask)
                    sc = min(ROI_SIZE[0] / roi.shape[1], ROI_SIZE[1] / roi.shape[0])
                    nw, nh = int(roi.shape[1] * sc), int(roi.shape[0] * sc)
                    if nw > 0 and nh > 0:
                        canvas[:nh, :nw] = cv2.resize(roi, (nw, nh))
                return canvas
        rx, ry, rw, rh = [max(0, int(v)) for v in ann.get('bbox', [0,0,0,0])]
        if rw > 0 and rh > 0 and ry+rh <= img.shape[0] and rx+rw <= img.shape[1]:
            roi = img[ry:ry+rh, rx:rx+rw]
            sc  = min(ROI_SIZE[0]/roi.shape[1], ROI_SIZE[1]/roi.shape[0])
            nw, nh = int(roi.shape[1]*sc), int(roi.shape[0]*sc)
            if nw > 0 and nh > 0:
                canvas[:nh, :nw] = cv2.resize(roi, (nw, nh))
        return canvas

    for idx, (ann, res) in enumerate(zip(annotations, results)):
        row_i  = idx // rois_per_row
        col_i  = idx % rois_per_row
        x_off  = 20 + col_i * (compare_width + 40)
        y_off  = 60 + row_i * roi_row_height

        t_roi  = _extract_roi_viz(template_img, ann)
        p_roi  = _extract_roi_viz(aligned_pred, ann)
        max_h  = max(t_roi.shape[0], p_roi.shape[0])
        canvas = np.full((max_h, compare_width, 3), COLOR_BG, dtype=np.uint8)
        canvas[:t_roi.shape[0], :ROI_SIZE[0]] = t_roi
        canvas[:p_roi.shape[0], ROI_SIZE[0]+10:ROI_SIZE[0]+10+p_roi.shape[1]] = p_roi
        cv2.line(canvas, (ROI_SIZE[0]+5, 0), (ROI_SIZE[0]+5, max_h), (128,128,128), 1)

        color    = COLOR_ANOMALY if res.get('is_anomaly', False) else COLOR_NORMAL
        bordered = cv2.copyMakeBorder(canvas, 3, 3, 3, 3, cv2.BORDER_CONSTANT, value=color)
        rh2, rw2 = bordered.shape[:2]
        row2[y_off:y_off+rh2, x_off:x_off+rw2] = bordered

        row2 = cv2_put_chinese_text(row2, "模板",    (x_off+10,             max(y_off-5,0)), (180,180,180), 12)
        row2 = cv2_put_chinese_text(row2, "对齐预测", (x_off+ROI_SIZE[0]+15, max(y_off-5,0)), (180,180,180), 12)
        text_y = y_off + rh2 + 5
        row2 = cv2_put_chinese_text(row2, f"#{idx+1} {res.get('category','?')}", (x_off, text_y), color, 14)
        text_y += 20
        row2 = cv2_put_chinese_text(row2, "异常" if res.get('is_anomaly') else "正常", (x_off, text_y), color, 14)
        text_y += 20
        row2 = cv2_put_chinese_text(row2, f"Score: {res.get('anomaly_score',0):.3f}", (x_off, text_y), (180,180,180), 11)

    anomaly_count = sum(1 for r in results if r.get("is_anomaly", False))
    normal_count  = len(results) - anomaly_count
    header = np.full((50, row2_width, 3), (60, 60, 60), dtype=np.uint8)
    title  = f"检测结果 | 策略:{strategy} | ROI:{len(results)} | 缺陷:{anomaly_count} | 正常:{normal_count}"
    header = cv2_put_chinese_text(header, title, (20, 32), (255,255,255), 20)

    return np.vstack([header, row1, row2])


def transform_bbox_with_H(bbox, H, img_size=None):
    x, y, w, h = bbox
    corners = np.array([[x,y],[x+w,y],[x+w,y+h],[x,y+h]], dtype=np.float32).reshape(-1,1,2)
    t = cv2.perspectiveTransform(corners, H).reshape(-1, 2)
    x0, y0 = np.min(t[:,0]), np.min(t[:,1])
    x1, y1 = np.max(t[:,0]), np.max(t[:,1])
    if img_size:
        iw, ih = img_size
        x0, y0 = max(0, min(x0, iw)), max(0, min(y0, ih))
        x1, y1 = max(0, min(x1, iw)), max(0, min(y1, ih))
    return [float(x0), float(y0), float(x1-x0), float(y1-y0)]


def detect_with_template_coords(
    detector,
    image:           np.ndarray,
    template_image:  np.ndarray,
    annotations:     List[Dict],
    request_id:      str = "",
    monitor:         Optional[PerformanceMonitor] = None,
    return_visualization: bool = False,
) -> Dict[str, Any]:
    if template_image is None or not annotations:
        return {"results": [], "visualization": None, "strategy": "none", "aligned_pred": None}

    local_monitor = monitor if monitor else PerformanceMonitor(request_id or "internal")
    tmpl_h, tmpl_w = template_image.shape[:2]

    local_monitor.start_step("detect_workpiece")
    global CACHED_TEMPLATE_WORKPIECE
    if CACHED_TEMPLATE_WORKPIECE is not None:
        tmpl_workpiece = CACHED_TEMPLATE_WORKPIECE
        logger.debug(f"[{request_id}] Using cached template workpiece bbox")
    else:
        tmpl_workpiece = get_workpiece_bbox_from_annotations(
            annotations, img_size=(tmpl_w, tmpl_h), padding=30
        )
        if tmpl_workpiece is None:
            tmpl_workpiece = detect_workpiece_bbox(template_image, padding=30) or (0, 0, tmpl_w, tmpl_h)
            logger.info(f"[{request_id}] Template workpiece from auto-detection: {tmpl_workpiece}")
        else:
            logger.info(f"[{request_id}] Template workpiece from annotations: {tmpl_workpiece}")
        CACHED_TEMPLATE_WORKPIECE = tmpl_workpiece
    # 根据模板工件比例动态计算面积筛选范围
    min_ratio, max_ratio = get_workpiece_area_ratio_range(image.shape)
    pred_workpiece = detect_workpiece_bbox(
        image, padding=30,
        min_area_ratio=min_ratio,
        max_area_ratio=max_ratio
    ) or (0, 0, image.shape[1], image.shape[0])
    logger.info(f"[{request_id}] Workpiece detection ratio range: [{min_ratio:.2%}, {max_ratio:.2%}], "
                f"detected: {pred_workpiece}")
    local_monitor.end_step("detect_workpiece")

    local_monitor.start_step("sift_alignment")
    tx, ty, tw, th = tmpl_workpiece
    px, py, pw, ph = pred_workpiece
    tmpl_roi = template_image[ty:ty+th, tx:tx+tw]
    pred_roi = image[py:py+ph, px:px+pw]

    sift = cv2.SIFT_create(5000)
    bf   = cv2.BFMatcher(cv2.NORM_L2)
    tmpl_gray = cv2.cvtColor(tmpl_roi, cv2.COLOR_BGR2GRAY) if len(tmpl_roi.shape) == 3 else tmpl_roi
    pred_gray = cv2.cvtColor(pred_roi, cv2.COLOR_BGR2GRAY) if len(pred_roi.shape) == 3 else pred_roi

    clahe = cv2.createCLAHE(clipLimit=3.8, tileGridSize=(1,1))
    tmpl_gray = clahe.apply(tmpl_gray)
    pred_gray = clahe.apply(pred_gray)

    # 保存 CLAHE 处理后的图像用于调试
    debug_dir = Path("debug_clahe")
    debug_dir.mkdir(exist_ok=True)
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    cv2.imwrite(str(debug_dir / f"tmpl_gray.png"), tmpl_gray)
    cv2.imwrite(str(debug_dir / f"pred_gray.png"), pred_gray)
    logger.info(f"[{request_id}] Saved CLAHE debug images to {debug_dir}")

    H = None; strategy = "none"
    if tmpl_gray.size > 0 and pred_gray.size > 0:
        kp_tmpl, des_tmpl = sift.detectAndCompute(tmpl_gray, None)
        kp_pred, des_pred = sift.detectAndCompute(pred_gray, None)

        if des_tmpl is not None and des_pred is not None and len(kp_tmpl) > 10 and len(kp_pred) > 10:
            matches = bf.knnMatch(des_tmpl, des_pred, k=2)
            good    = [m for m_n in matches if len(m_n)==2 for m, n in [m_n] if m.distance < 0.75*n.distance]
            if len(good) > 10:
                src_pts = np.float32([[kp_tmpl[m.queryIdx].pt[0]+tx, kp_tmpl[m.queryIdx].pt[1]+ty] for m in good]).reshape(-1,1,2)
                dst_pts = np.float32([[kp_pred[m.trainIdx].pt[0]+px, kp_pred[m.trainIdx].pt[1]+py] for m in good]).reshape(-1,1,2)

                H_partial, inliers = cv2.estimateAffinePartial2D(
                    dst_pts, src_pts,
                    method=cv2.RANSAC,
                    ransacReprojThreshold=6.0,
                    maxIters=2000
                )

                if H_partial is not None:
                    # 允许小幅度缩放（0.9~1.1）
                    SCALE_MIN, SCALE_MAX = 0.9, 1.1
                    affine_matrix = H_partial[:2, :2]
                    scale_x = np.linalg.norm(affine_matrix[:, 0])
                    scale_y = np.linalg.norm(affine_matrix[:, 1])
                    current_scale = (scale_x + scale_y) / 2.0

                    if current_scale < SCALE_MIN or current_scale > SCALE_MAX:
                        logger.warning(f"[{request_id}] 缩放因子 {current_scale:.3f} 超出范围 [{SCALE_MIN}~{SCALE_MAX}]，进行修正")
                        clamped_scale = max(SCALE_MIN, min(SCALE_MAX, current_scale))
                        affine_matrix = (affine_matrix / current_scale) * clamped_scale
                        current_scale = clamped_scale

                    if current_scale > 1e-6:
                        rotation_matrix = affine_matrix / current_scale
                    else:
                        rotation_matrix = affine_matrix

                    H_partial_scaled = np.array([
                        [rotation_matrix[0, 0], rotation_matrix[0, 1], H_partial[0, 2]],
                        [rotation_matrix[1, 0], rotation_matrix[1, 1], H_partial[1, 2]]
                    ], dtype=np.float64)

                    H = np.vstack([H_partial_scaled, [0, 0, 1]])

                    inlier_ratio = np.sum(inliers) / len(good) if inliers is not None else 0
                    strategy = "sift_workpiece"
                    logger.info(f"[{request_id}] SIFT 工件对齐成功(缩放范围 {SCALE_MIN}~{SCALE_MAX})，匹配点数: {len(good)}, 内点率: {inlier_ratio:.1%}, "
                                f"缩放因子: {current_scale:.3f}, tmpl_roi=({tw}x{th}), pred_roi=({pw}x{ph})")

    rotation_angle = 0.0
    if H is not None:
        affine_matrix = H[:2, :2]
        angle_rad = np.arctan2(affine_matrix[1, 0], affine_matrix[0, 0])
        rotation_angle = float(np.degrees(angle_rad))

    if H is None:
        H = np.eye(3, dtype=np.float64)
    local_monitor.end_step("sift_alignment")

    local_monitor.start_step("warp_image")
    H_2x3 = H[:2, :]  # 从3x3齐次矩阵提取2x3仿射矩阵
    aligned_pred = cv2.warpAffine(
        image, H_2x3, (tmpl_w, tmpl_h),
        flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_CONSTANT, borderValue=(0,0,0)
    )
    local_monitor.end_step("warp_image")

    local_monitor.start_step("roi_inference")
    category_rois:    Dict[str, List[tuple]] = {}
    category_indices: Dict[str, List[int]]   = {}

    for i, ann in enumerate(annotations):
        category = ann.get("category")
        if not category or category not in detector.models:
            continue

        roi = None
        segmentation = ann.get("segmentation", [])
        bbox = ann.get("bbox", [0, 0, 0, 0])

        if segmentation and len(segmentation) > 0:
            roi = _extract_roi_from_segmentation(aligned_pred, segmentation, pad_ratio=0.0)

        if roi is None or roi.size == 0:
            if not bbox or len(bbox) < 4:
                continue
            x, y, w, h = [int(v) for v in bbox]
            x = max(0, min(x, tmpl_w-1)); y = max(0, min(y, tmpl_h-1))
            w = min(w, tmpl_w-x);         h = min(h, tmpl_h-y)
            if w <= 0 or h <= 0:
                continue
            roi = aligned_pred[y:y+h, x:x+w]

        if roi is None or roi.size == 0:
            continue

        category_rois.setdefault(category, []).append(roi)
        category_indices.setdefault(category, []).append((i, ann.get("category_name", category)))

    results_map: Dict[int, Dict] = {}
    for category, rois in category_rois.items():
        indices_info         = category_indices[category]
        category_annotations = [annotations[idx] for idx, _ in indices_info]
        det_results = detector.detect_category(
            rois, category, request_id,
            annotations=category_annotations,
        )
        H_inv = np.linalg.inv(H) if H is not None else np.eye(3, dtype=np.float64)

        for idx, det_result in enumerate(det_results):
            ann_idx, category_name = indices_info[idx]
            ann  = annotations[ann_idx]
            bbox = ann.get("bbox", [0,0,0,0])
            segm = ann.get("segmentation", [])

            x, y, w, h = [float(v) for v in bbox]
            corners = np.array([[x,y],[x+w,y],[x+w,y+h],[x,y+h]], dtype=np.float64).reshape(-1,1,2)
            tc      = cv2.perspectiveTransform(corners, H_inv).reshape(-1,2)
            
            # bbox_in_pred_aligned 是相对于 aligned_pred 的坐标
            bbox_in_pred_aligned = [float(np.min(tc[:,0])), float(np.min(tc[:,1])),
                            float(np.max(tc[:,0])-np.min(tc[:,0])), float(np.max(tc[:,1])-np.min(tc[:,1]))]
            
            # 将坐标从 aligned_pred 转换回原始输入图像坐标
            # H 将原始图像坐标变换到 aligned_pred 坐标，所以 H_inv 将 aligned_pred 坐标变换回原始图像坐标
            # 但这里 bbox_in_pred_aligned 已经是通过 H_inv 计算的了，所以它就是相对于原始图像的坐标
            # 只需要加上 pred_roi 的偏移量 (px, py)
            bx, by, bw, bh = bbox_in_pred_aligned
            bbox_in_pred = [bx, by, bw, bh]

            segm_in_pred = []
            if segm and len(segm) > 0 and len(segm[0]) >= 8:
                pts = np.array([[segm[0][i], segm[0][i+1]] for i in range(0, len(segm[0]), 2)],
                               dtype=np.float64).reshape(-1,1,2)
                tp  = cv2.perspectiveTransform(pts, H_inv).reshape(-1, 2)
                # 加上 pred_roi 的偏移量
                segm_in_pred = [float(v) for v in tp.flatten()]

            results_map[ann_idx] = {
                "category":             category_name,
                "pos_id":               ann.get("pos_id"),
                "bbox":                 bbox,
                "bbox_in_pred":         bbox_in_pred,
                "bbox_clipped":         bbox,
                "segmentation":         segm,
                "segmentation_in_pred": segm_in_pred,
                "is_anomaly":           det_result.get("is_anomaly", False),
                "anomaly_score":        det_result.get("anomaly_score", 0.0),
                "error":                det_result.get("error", 0.0),
                "threshold":            det_result.get("threshold", 0.0),
                "infer_failed":         det_result.get("infer_failed", False),
                "anomaly_type":         "real_defect" if det_result.get("is_anomaly", False) else "normal",
            }

    local_monitor.end_step("roi_inference")

    results = [results_map.get(i, {
        "category":             annotations[i].get("category", "unknown"),
        "pos_id":               annotations[i].get("pos_id"),
        "bbox":                 annotations[i].get("bbox", [0,0,0,0]),
        "bbox_in_pred":         annotations[i].get("bbox", [0,0,0,0]),
        "segmentation":         annotations[i].get("segmentation", []),
        "segmentation_in_pred": [],
        "is_anomaly":           False,
        "anomaly_score":        0.0,
        "error":                0.0,
        "threshold":            0.0,
        "infer_failed":         True,
        "anomaly_type":         "infer_failed",
    }) for i in range(len(annotations))]

    saved_roi_paths = save_roi_screenshots(results, template_image, aligned_pred, annotations, request_id)
    logger.info(f"[{request_id}] ROI截图: OK={len(saved_roi_paths['ok'])}, NG={len(saved_roi_paths['ng'])}")

    visualization = None
    if return_visualization:
        visualization = create_simple_visualization(
            template_image, image, aligned_pred,
            annotations, results, strategy, request_id,
            template_workpiece_bbox=tmpl_workpiece,
            pred_workpiece_bbox=pred_workpiece,
            H=H,
        )

    return {
        "results":            results,
        "visualization":      visualization,
        "strategy":           strategy,
        "aligned_pred":       aligned_pred,
        "H":                  H,
        "template_workpiece": tmpl_workpiece,
        "pred_workpiece":     pred_workpiece,
        "saved_roi_paths":    saved_roi_paths,
    }


def detect_multiple_workpieces(
    detector,
    image: np.ndarray,
    template_image: np.ndarray,
    annotations: List[Dict],
    request_id: str = "",
    monitor: Optional[PerformanceMonitor] = None,
    return_visualization: bool = False,
    reference_workpiece_size: Optional[Tuple[int, int]] = None,
) -> Dict[str, Any]:
    """
    检测图像中的多个工件，对每个工件分别进行对齐和ROI检测
    
    Args:
        detector: 检测器
        image: 预测图像（可能包含多个工件）
        template_image: 模板图像（单个工件）
        annotations: 模板标注信息
        request_id: 请求ID
        monitor: 性能监控器
        return_visualization: 是否返回可视化结果
        reference_workpiece_size: 参考工件尺寸 (width, height)，用于自适应调整检测参数
        
    Returns:
        包含所有工件检测结果的字典
    """
    if template_image is None or not annotations:
        return {
            "workpiece_results": [],
            "visualization": None,
            "total_workpieces": 0,
            "total_anomalies": 0,
        }
    
    local_monitor = monitor if monitor else PerformanceMonitor(request_id or "internal")
    
    # 1. 检测预测图中的所有工件
    local_monitor.start_step("detect_multiple_workpieces")
    workpiece_bboxes = detect_multiple_workpiece_bboxes(
        image, 
        padding=30,
        reference_workpiece_size=reference_workpiece_size
    )
    
    if not workpiece_bboxes:
        logger.warning(f"[{request_id}] 未检测到任何工件，回退到单工件检测")
        single_result = detect_with_template_coords(
            detector, image, template_image, annotations, 
            request_id, monitor, return_visualization
        )
        return {
            "workpiece_results": [{
                "workpiece_id": 0,
                "bbox": single_result.get("pred_workpiece", (0, 0, image.shape[1], image.shape[0])),
                "results": single_result.get("results", []),
                "anomaly_count": sum(1 for r in single_result.get("results", []) if r.get("is_anomaly", False)),
                "strategy": single_result.get("strategy", "none"),
            }],
            "visualization": single_result.get("visualization"),
            "total_workpieces": 1,
            "total_anomalies": single_result.get("anomaly_count", 0),
        }
    
    local_monitor.end_step("detect_multiple_workpieces")
    
    # 2. 对每个工件分别进行检测
    workpiece_results = []
    all_visualizations = []
    total_anomalies = 0
    
    for wp_idx, wp_bbox in enumerate(workpiece_bboxes):
        wp_id = wp_idx + 1
        wx, wy, ww, wh = wp_bbox
        
        logger.info(f"[{request_id}] 处理工件 {wp_id}/{len(workpiece_bboxes)}, bbox={wp_bbox}")
        
        # 提取当前工件区域
        workpiece_image = image[wy:wy+wh, wx:wx+ww]
        if workpiece_image.size == 0:
            logger.warning(f"[{request_id}] 工件 {wp_id} 区域为空，跳过")
            continue
        
        # 对该工件执行单工件检测流程
        try:
            local_monitor.start_step(f"workpiece_{wp_id}_inference")
            
            single_result = detect_with_template_coords(
                detector, 
                workpiece_image,  # 传入裁剪后的工件图像
                template_image, 
                annotations, 
                f"{request_id}_wp{wp_id}", 
                None,  # 使用内部monitor
                return_visualization
            )
            
            local_monitor.end_step(f"workpiece_{wp_id}_inference")
            
            results = single_result.get("results", [])
            
            for r_idx, r in enumerate(results):

                if "bbox_in_pred" in r:
                    bx, by, bw, bh = r["bbox_in_pred"]
                    # 确保坐标是数值类型
                    bx, by, bw, bh = float(bx), float(by), float(bw), float(bh)
                    orig_bbox = [bx, by, bw, bh]
                    r["bbox_in_pred"] = [bx + wx, by + wy, bw, bh]
                
                if "segmentation_in_pred" in r and r["segmentation_in_pred"]:
                    seg = r["segmentation_in_pred"]
                    orig_seg = seg.copy()
                    # 将segmentation坐标（相对于工件图像）转换到全图坐标
                    r["segmentation_in_pred"] = [
                        float(v) + (wx if i % 2 == 0 else wy)
                        for i, v in enumerate(seg)
                    ]
                
                if "bbox_clipped" in r:
                    bc = r["bbox_clipped"]
                    if isinstance(bc, (list, tuple)) and len(bc) >= 4:
                        r["bbox_clipped"] = [float(bc[0]) + wx, float(bc[1]) + wy, float(bc[2]), float(bc[3])]
            
            wp_anomaly_count = sum(1 for r in results if r.get("is_anomaly", False))
            total_anomalies += wp_anomaly_count
            
            workpiece_results.append({
                "workpiece_id": wp_id,
                "bbox": wp_bbox,
                "results": results,
                "anomaly_count": wp_anomaly_count,
                "strategy": single_result.get("strategy", "none"),
                "aligned_pred": single_result.get("aligned_pred"),
            })
            
            if single_result.get("visualization") is not None:
                all_visualizations.append(single_result["visualization"])
                
        except Exception as e:
            logger.error(f"[{request_id}] 工件 {wp_id} 检测失败: {e}")
            workpiece_results.append({
                "workpiece_id": wp_id,
                "bbox": wp_bbox,
                "results": [],
                "anomaly_count": 0,
                "strategy": "failed",
                "error": str(e),
            })
    
    # 3. 合并可视化结果
    visualization = None
    if return_visualization and all_visualizations:
        visualization = create_multi_workpiece_visualization(
            image, workpiece_results, workpiece_bboxes, request_id
        )
    
    return {
        "workpiece_results": workpiece_results,
        "visualization": visualization,
        "total_workpieces": len(workpiece_results),
        "total_anomalies": total_anomalies,
    }


def create_multi_workpiece_visualization(
    original_image: np.ndarray,
    workpiece_results: List[Dict],
    workpiece_bboxes: List[Tuple],
    request_id: str = "",
) -> np.ndarray:
    """
    创建多工件检测结果的可视化图像 - 为每个工件显示详细的对齐过程和ROI对比
    
    Args:
        original_image: 原始预测图像
        workpiece_results: 各工件的检测结果
        workpiece_bboxes: 各工件的bbox
        request_id: 请求ID
        
    Returns:
        可视化图像
    """
    COLOR_NORMAL = (0, 255, 0)      # 绿色 - 正常
    COLOR_ANOMALY = (0, 0, 255)     # 红色 - 异常
    COLOR_WORKPIECE = (255, 128, 0) # 橙色 - 工件框
    COLOR_TEXT = (255, 255, 255)    # 白色 - 文字
    COLOR_NORMAL_ROI = (0, 255, 255)  # 黄色 - 正常ROI
    COLOR_BG = (40, 40, 40)         # 深灰色背景
    COLOR_TEMPLATE = (255, 128, 0)  # 橙色 - 模板标注
    
    # 首先创建全图总览
    viz_overview = original_image.copy()
    
    # 绘制每个工件的检测结果
    for wp_result, wp_bbox in zip(workpiece_results, workpiece_bboxes):
        wx, wy, ww, wh = wp_bbox
        wp_id = wp_result.get("workpiece_id", 0)
        anomaly_count = wp_result.get("anomaly_count", 0)
        
        # 根据是否有异常选择工件框颜色
        wp_color = COLOR_ANOMALY if anomaly_count > 0 else COLOR_NORMAL
        
        # 绘制工件bbox（粗线）
        cv2.rectangle(viz_overview, (wx, wy), (wx + ww, wy + wh), wp_color, 3)
        
        # 添加工件标签
        label = f"WP{wp_id}: {'NG' if anomaly_count > 0 else 'OK'}"
        viz_overview = cv2_put_chinese_text(viz_overview, label, (wx, max(wy - 30, 0)), wp_color, 20)
        
        # 绘制每个ROI的检测结果（包括正常和异常的）
        for idx, roi_result in enumerate(wp_result.get("results", [])):
            is_anomaly = roi_result.get("is_anomaly", False)
            roi_color = COLOR_ANOMALY if is_anomaly else COLOR_NORMAL_ROI
            
            # 优先使用segmentation绘制，否则使用bbox
            segm = roi_result.get("segmentation_in_pred", [])
            bbox = roi_result.get("bbox_in_pred", [0, 0, 0, 0])
            category = roi_result.get("category", f"ROI{idx+1}")
            
            roi_drawn = False
            
            # 尝试使用segmentation绘制
            if segm and len(segm) >= 8:
                try:
                    pts = np.array([[segm[i], segm[i+1]] for i in range(0, len(segm), 2)], 
                                   dtype=np.int32).reshape(-1, 1, 2)
                    cv2.polylines(viz_overview, [pts], True, roi_color, 2)
                    
                    # 在segmentation的第一个点添加标签
                    if len(pts) > 0:
                        label_pos = (int(pts[0][0][0]), max(int(pts[0][0][1]) - 5, 0))
                        viz_overview = cv2_put_chinese_text(viz_overview, category, label_pos, roi_color, 14)
                    roi_drawn = True
                except Exception as e:
                    logger.warning(f"绘制segmentation失败: {e}")
            
            # 如果没有segmentation或绘制失败，使用bbox
            if not roi_drawn and bbox and len(bbox) >= 4:
                try:
                    bx, by, bw, bh = [int(v) for v in bbox]
                    # 确保坐标在图像范围内
                    h, w = viz_overview.shape[:2]
                    bx = max(0, min(bx, w-1))
                    by = max(0, min(by, h-1))
                    bw = min(bw, w-bx)
                    bh = min(bh, h-by)
                    
                    if bw > 0 and bh > 0:
                        cv2.rectangle(viz_overview, (bx, by), (bx + bw, by + bh), roi_color, 2)
                        # 在bbox左上角添加标签
                        viz_overview = cv2_put_chinese_text(viz_overview, category, (bx, max(by - 5, 0)), roi_color, 14)
                        roi_drawn = True
                except Exception as e:
                    logger.warning(f"绘制bbox失败: {e}")
            
            # 添加异常分数标签（仅对异常ROI）
            if is_anomaly and roi_drawn:
                score = roi_result.get("anomaly_score", 0)
                score_text = f"{score:.2f}"
                if bbox and len(bbox) >= 4:
                    bx, by, bw, bh = [int(v) for v in bbox]
                    viz_overview = cv2_put_chinese_text(viz_overview, score_text, (bx, by + bh + 15), COLOR_ANOMALY, 12)
    
    # 添加总览信息
    total_wp = len(workpiece_results)
    total_ng = sum(wp.get("anomaly_count", 0) > 0 for wp in workpiece_results)
    total_rois = sum(len(wp.get("results", [])) for wp in workpiece_results)
    summary = f"工件: {total_wp} (NG:{total_ng} OK:{total_wp-total_ng}) | ROI: {total_rois}"
    viz_overview = cv2_put_chinese_text(viz_overview, summary, (10, 30), COLOR_TEXT, 24)
    
    # 添加图例
    legend_y = 60
    viz_overview = cv2_put_chinese_text(viz_overview, "图例: 正常ROI", (10, legend_y), COLOR_NORMAL_ROI, 16)
    viz_overview = cv2_put_chinese_text(viz_overview, "异常ROI", (150, legend_y), COLOR_ANOMALY, 16)
    viz_overview = cv2_put_chinese_text(viz_overview, "正常工件", (250, legend_y), COLOR_NORMAL, 16)
    viz_overview = cv2_put_chinese_text(viz_overview, "异常工件", (360, legend_y), COLOR_ANOMALY, 16)
    
    # 如果没有工件结果，直接返回总览图
    if not workpiece_results:
        return viz_overview
    
    # 确定统一的宽度（使用工件详情的宽度作为标准，即1050 = 350*3）
    DETAIL_WIDTH = 1050
    
    # 为每个工件创建详细的可视化
    all_sections = []
    
    for wp_idx, (wp_result, wp_bbox) in enumerate(zip(workpiece_results, workpiece_bboxes)):
        wp_id = wp_result.get("workpiece_id", wp_idx + 1)
        wx, wy, ww, wh = wp_bbox
        anomaly_count = wp_result.get("anomaly_count", 0)
        strategy = wp_result.get("strategy", "none")
        results = wp_result.get("results", [])
        aligned_pred = wp_result.get("aligned_pred")
        
        # 提取当前工件区域的原始图像
        workpiece_image = original_image[wy:wy+wh, wx:wx+ww].copy() if wy+wh <= original_image.shape[0] and wx+ww <= original_image.shape[1] else np.zeros((wh, ww, 3), dtype=np.uint8)
        
        # 创建工件标题（使用统一的宽度）
        wp_color = COLOR_ANOMALY if anomaly_count > 0 else COLOR_NORMAL
        wp_header = np.full((50, DETAIL_WIDTH, 3), (60, 60, 60), dtype=np.uint8)
        wp_title = f"工件 {wp_id} | 策略: {strategy} | ROI数: {len(results)} | 异常: {anomaly_count} | 正常: {len(results)-anomaly_count}"
        wp_header = cv2_put_chinese_text(wp_header, wp_title, (20, 32), wp_color, 22)
        
        # 创建三列视图：模板 + 对齐后预测 + 原始工件图
        DISPLAY_SIZE = (350, 350)
        
        def _resize(img, size=DISPLAY_SIZE):
            if img is None or img.size == 0:
                return np.zeros((size[1], size[0], 3), dtype=np.uint8)
            return cv2.resize(img, size)
        
        # 列1: 模板图像（带标注）
        col1 = np.full((DISPLAY_SIZE[1] + 50, DISPLAY_SIZE[0], 3), COLOR_BG, dtype=np.uint8)
        if TEMPLATE_IMAGE is not None:
            tmpl_viz = _resize(TEMPLATE_IMAGE).copy()
            sx = DISPLAY_SIZE[0] / TEMPLATE_IMAGE.shape[1]
            sy = DISPLAY_SIZE[1] / TEMPLATE_IMAGE.shape[0]
            
            # 绘制模板标注
            for i, ann in enumerate(TEMPLATE_ANNOTATIONS):
                segmentation = ann.get("segmentation", [])
                if segmentation:
                    for seg in segmentation:
                        pts = np.array(seg).reshape(-1, 2).astype(np.float32)
                        pts[:, 0] *= sx
                        pts[:, 1] *= sy
                        cv2.polylines(tmpl_viz, [pts.astype(np.int32)], True, COLOR_TEMPLATE, 2)
                else:
                    x, y, w, h = ann.get("bbox", [0, 0, 0, 0])
                    cv2.rectangle(tmpl_viz, (int(x*sx), int(y*sy)), (int((x+w)*sx), int((y+h)*sy)), COLOR_TEMPLATE, 2)
            
            col1[50:] = tmpl_viz
        col1 = cv2_put_chinese_text(col1, "1. 模板图像 + 标注", (10, 30), COLOR_TEXT, 18)
        
        # 列2: 对齐后的预测图
        col2 = np.full((DISPLAY_SIZE[1] + 50, DISPLAY_SIZE[0], 3), COLOR_BG, dtype=np.uint8)
        if aligned_pred is not None and aligned_pred.size > 0:
            aligned_viz = _resize(aligned_pred).copy()
            sx_a = DISPLAY_SIZE[0] / aligned_pred.shape[1]
            sy_a = DISPLAY_SIZE[1] / aligned_pred.shape[0]
            
            # 绘制ROI检测结果
            for idx, res in enumerate(results):
                is_anomaly = res.get("is_anomaly", False)
                color = COLOR_ANOMALY if is_anomaly else COLOR_NORMAL
                
                # 使用模板坐标绘制（因为aligned_pred已经对齐到模板）
                if idx < len(TEMPLATE_ANNOTATIONS):
                    ann = TEMPLATE_ANNOTATIONS[idx]
                    segmentation = ann.get("segmentation", [])
                    if segmentation:
                        for seg in segmentation:
                            pts = np.array(seg).reshape(-1, 2).astype(np.float32)
                            pts[:, 0] *= sx_a
                            pts[:, 1] *= sy_a
                            cv2.polylines(aligned_viz, [pts.astype(np.int32)], True, color, 2)
                    else:
                        x, y, w, h = ann.get("bbox", [0, 0, 0, 0])
                        cv2.rectangle(aligned_viz, (int(x*sx_a), int(y*sy_a)), (int((x+w)*sx_a), int((y+h)*sy_a)), color, 2)
            
            col2[50:] = aligned_viz
        col2 = cv2_put_chinese_text(col2, "2. 对齐后预测图 + 结果", (10, 30), COLOR_TEXT, 18)
        
        # 列3: 原始工件图
        col3 = np.full((DISPLAY_SIZE[1] + 50, DISPLAY_SIZE[0], 3), COLOR_BG, dtype=np.uint8)
        if workpiece_image.size > 0:
            orig_viz = _resize(workpiece_image).copy()
            sx_o = DISPLAY_SIZE[0] / workpiece_image.shape[1]
            sy_o = DISPLAY_SIZE[1] / workpiece_image.shape[0]
            
            # 绘制ROI检测结果（使用全图坐标）
            for idx, res in enumerate(results):
                is_anomaly = res.get("is_anomaly", False)
                color = COLOR_ANOMALY if is_anomaly else COLOR_NORMAL_ROI
                category = res.get("category", f"ROI{idx+1}")
                
                segm = res.get("segmentation_in_pred", [])
                bbox = res.get("bbox_in_pred", [0, 0, 0, 0])
                
                # 转换为相对于工件图像的坐标
                if segm and len(segm) >= 8:
                    try:
                        pts = np.array([[segm[i] - wx, segm[i+1] - wy] for i in range(0, len(segm), 2)], 
                                       dtype=np.float32)
                        pts[:, 0] *= sx_o
                        pts[:, 1] *= sy_o
                        cv2.polylines(orig_viz, [pts.astype(np.int32)], True, color, 2)
                    except Exception:
                        pass
                elif bbox and len(bbox) >= 4:
                    try:
                        bx, by, bw, bh = bbox
                        bx_rel = (bx - wx) * sx_o
                        by_rel = (by - wy) * sy_o
                        bw_rel = bw * sx_o
                        bh_rel = bh * sy_o
                        cv2.rectangle(orig_viz, (int(bx_rel), int(by_rel)), 
                                     (int(bx_rel + bw_rel), int(by_rel + bh_rel)), color, 2)
                    except Exception:
                        pass
            
            col3[50:] = orig_viz
        col3 = cv2_put_chinese_text(col3, "3. 原始工件图", (10, 30), COLOR_TEXT, 18)
        
        # 合并三列
        row1 = np.hstack([col1, col2, col3])
        
        # 创建ROI对比详情
        ROI_SIZE = (140, 140)
        rois_per_row = 4
        n_results = len(results)
        n_rows = max(1, (n_results + rois_per_row - 1) // rois_per_row)
        compare_width = ROI_SIZE[0] * 2 + 20
        roi_row_height = ROI_SIZE[1] + 80
        row2_width = row1.shape[1]
        row2 = np.full((roi_row_height * n_rows + 60, row2_width, 3), COLOR_BG, dtype=np.uint8)
        row2 = cv2_put_chinese_text(row2, "4. ROI 对比详情 (模板 | 对齐后预测)", (20, 30), COLOR_TEXT, 20)
        
        def _extract_roi_viz(img, ann, offset_x=0, offset_y=0):
            """提取ROI可视化，支持偏移量（用于从全图坐标转换为局部坐标）"""
            if img is None or img.size == 0:
                return np.zeros((ROI_SIZE[1], ROI_SIZE[0], 3), dtype=np.uint8)
            
            canvas = np.zeros((ROI_SIZE[1], ROI_SIZE[0], 3), dtype=np.uint8)
            segmentation = ann.get('segmentation', [])
            
            if segmentation and len(segmentation) > 0:
                all_pts = []
                for seg in segmentation:
                    pts = np.array(seg).reshape(-1, 2).astype(np.int32)
                    # 应用偏移量
                    pts[:, 0] -= offset_x
                    pts[:, 1] -= offset_y
                    all_pts.append(pts)
                
                if all_pts:
                    all_points = np.vstack(all_pts)
                    x_min, y_min = np.min(all_points, axis=0)
                    x_max, y_max = np.max(all_points, axis=0)
                    pad = max(int((x_max - x_min) * 0.1), int((y_max - y_min) * 0.1), 1)
                    x_min = max(0, x_min - pad)
                    y_min = max(0, y_min - pad)
                    x_max = min(img.shape[1], x_max + pad)
                    y_max = min(img.shape[0], y_max + pad)
                    
                    if x_max > x_min and y_max > y_min:
                        roi = img[y_min:y_max, x_min:x_max].copy()
                        if roi.size > 0:
                            mask = np.zeros((y_max - y_min, x_max - x_min), dtype=np.uint8)
                            for pts in all_pts:
                                cv2.fillPoly(mask, [pts - [x_min, y_min]], 255)
                            roi = cv2.bitwise_and(roi, roi, mask=mask)
                            sc = min(ROI_SIZE[0] / roi.shape[1], ROI_SIZE[1] / roi.shape[0])
                            nw, nh = int(roi.shape[1] * sc), int(roi.shape[0] * sc)
                            if nw > 0 and nh > 0:
                                canvas[:nh, :nw] = cv2.resize(roi, (nw, nh))
                    return canvas
            
            # 使用bbox
            rx, ry, rw, rh = [max(0, int(v)) for v in ann.get('bbox', [0, 0, 0, 0])]
            rx -= offset_x
            ry -= offset_y
            if rw > 0 and rh > 0:
                rx = max(0, min(rx, img.shape[1] - 1))
                ry = max(0, min(ry, img.shape[0] - 1))
                rw = min(rw, img.shape[1] - rx)
                rh = min(rh, img.shape[0] - ry)
                if rw > 0 and rh > 0:
                    roi = img[ry:ry+rh, rx:rx+rw]
                    sc = min(ROI_SIZE[0] / roi.shape[1], ROI_SIZE[1] / roi.shape[0])
                    nw, nh = int(roi.shape[1] * sc), int(roi.shape[0] * sc)
                    if nw > 0 and nh > 0:
                        canvas[:nh, :nw] = cv2.resize(roi, (nw, nh))
            return canvas
        
        # 绘制每个ROI的对比
        for idx, (res, ann) in enumerate(zip(results, TEMPLATE_ANNOTATIONS[:len(results)])):
            row_i = idx // rois_per_row
            col_i = idx % rois_per_row
            x_off = 20 + col_i * (compare_width + 30)
            y_off = 60 + row_i * roi_row_height
            
            # 提取模板ROI和对齐后预测ROI
            t_roi = _extract_roi_viz(TEMPLATE_IMAGE, ann)
            
            # 对于对齐后的预测图，使用模板坐标（因为已经对齐）
            p_roi = _extract_roi_viz(aligned_pred, ann) if aligned_pred is not None else np.zeros_like(t_roi)
            
            max_h = max(t_roi.shape[0], p_roi.shape[0])
            canvas = np.full((max_h, compare_width, 3), COLOR_BG, dtype=np.uint8)
            canvas[:t_roi.shape[0], :ROI_SIZE[0]] = t_roi
            canvas[:p_roi.shape[0], ROI_SIZE[0]+10:ROI_SIZE[0]+10+p_roi.shape[1]] = p_roi
            cv2.line(canvas, (ROI_SIZE[0]+5, 0), (ROI_SIZE[0]+5, max_h), (128, 128, 128), 1)
            
            color = COLOR_ANOMALY if res.get('is_anomaly', False) else COLOR_NORMAL
            bordered = cv2.copyMakeBorder(canvas, 3, 3, 3, 3, cv2.BORDER_CONSTANT, value=color)
            rh2, rw2 = bordered.shape[:2]
            
            if y_off + rh2 <= row2.shape[0] and x_off + rw2 <= row2.shape[1]:
                row2[y_off:y_off+rh2, x_off:x_off+rw2] = bordered
            
            # 添加标签
            category = res.get('category', f'ROI{idx+1}')
            score = res.get('anomaly_score', 0)
            text_y = y_off + rh2 + 5
            row2 = cv2_put_chinese_text(row2, f"#{idx+1} {category}", (x_off, text_y), color, 12)
            text_y += 18
            row2 = cv2_put_chinese_text(row2, "异常" if res.get('is_anomaly') else "正常", (x_off, text_y), color, 12)
            text_y += 18
            row2 = cv2_put_chinese_text(row2, f"Score: {score:.3f}", (x_off, text_y), (180, 180, 180), 10)
        
        # 合并当前工件的所有行
        wp_section = np.vstack([wp_header, row1, row2])
        all_sections.append(wp_section)
    
    # 创建最终的总览图（缩放到统一宽度）
    overview_height = int(viz_overview.shape[0] * DETAIL_WIDTH / viz_overview.shape[1])
    overview_height = min(600, max(300, overview_height))  # 限制高度范围
    viz_overview_resized = cv2.resize(viz_overview, (DETAIL_WIDTH, overview_height))
    
    # 添加总览标题
    overview_header = np.full((50, DETAIL_WIDTH, 3), (30, 30, 30), dtype=np.uint8)
    overview_header = cv2_put_chinese_text(overview_header, "=== 总览图 ===", (20, 32), COLOR_TEXT, 24)
    viz_overview_final = np.vstack([overview_header, viz_overview_resized])
    
    # 添加分隔线
    separator = np.full((20, DETAIL_WIDTH, 3), (100, 100, 100), dtype=np.uint8)
    
    # 合并所有部分
    all_sections.insert(0, viz_overview_final)
    
    # 确保所有部分宽度一致
    max_width = max(section.shape[1] for section in all_sections)
    padded_sections = []
    for section in all_sections:
        if section.shape[1] < max_width:
            pad = np.full((section.shape[0], max_width - section.shape[1], 3), COLOR_BG, dtype=np.uint8)
            section = np.hstack([section, pad])
        padded_sections.append(section)
        padded_sections.append(separator[:, :max_width])
    
    # 移除最后一个分隔线
    if padded_sections:
        padded_sections.pop()
    
    final_viz = np.vstack(padded_sections) if padded_sections else viz_overview
    
    return final_viz


