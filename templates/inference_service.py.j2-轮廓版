def select_best_template_from_annotations(annotations_path: str) -> tuple:
    try:
        with open(annotations_path, 'r', encoding='utf-8') as f:
            data = json.load(f)

        images      = {img['id']: img for img in data.get('images', [])}
        annotations = data.get('annotations', [])

        no_flip = [
            ann for ann in annotations
            if not ann.get('horizontal_flip', False)
            and not ann.get('vertical_flip', False)
        ]
        if not no_flip:
            logger.warning("No annotations without flip found")
            return None, []

        no_flip.sort(key=lambda x: abs(x.get('angle', 0)))
        best     = no_flip[0]
        img_info = images.get(best.get('image_id'))
        if not img_info:
            logger.warning(f"Image {best.get('image_id')} not found")
            return None, []

        ann_dir   = Path(annotations_path).parent
        file_name = img_info.get('file_name', '')

        for candidate in [
            ann_dir / "raw_images" / file_name,
            ann_dir / file_name,
            ann_dir / "images" / file_name,
        ]:
            if candidate.exists():
                template_path = str(candidate)
                break
        else:
            logger.warning(f"Template image not found for {file_name}")
            return None, []

        template_annotations = [
            {
                'category':      str(ann.get('pos_id', '')),  # 使用 pos_id 作为 category，以便匹配模型
                'category_name': ann.get('label', ''),
                'pos_id':        ann.get('pos_id'),
                'bbox':          ann.get('bbox', [0, 0, 0, 0]),
                'segmentation':  ann.get('segmentation', []),
            }
            for ann in no_flip
            if ann.get('image_id') == best.get('image_id') and ann.get('label')
        ]

        logger.info(
            f"Selected template: {file_name}, angle={best.get('angle', 0)}, "
            f"annotations={len(template_annotations)}"
        )
        return template_path, template_annotations

    except Exception as e:
        logger.error(f"Failed to select template from annotations: {e}")
        return None, []


def get_workpiece_bbox_from_annotations(
    annotations: List[Dict],
    img_size: Optional[Tuple[int, int]] = None,
    padding: int = 30,
) -> Optional[tuple]:
    """
    从标注数据中计算工件区域（所有标注的bbox/segmentation的并集）
    Args:
        annotations: 标注列表，每个标注包含 bbox 和/或 segmentation
        img_size: 图像尺寸 (width, height)，用于裁剪边界
        padding: 边界扩展像素
    Returns:
        (x, y, w, h) 工件区域，或 None（无有效标注时）
    """
    if not annotations:
        return None
    
    all_points = []
    
    for ann in annotations:
        bbox = ann.get("bbox", [])
        segmentation = ann.get("segmentation", [])
        
        if segmentation and len(segmentation) > 0 and len(segmentation[0]) >= 4:
            pts = segmentation[0]
            for i in range(0, len(pts), 2):
                if i + 1 < len(pts):
                    all_points.append((float(pts[i]), float(pts[i+1])))
        elif bbox and len(bbox) >= 4:
            x, y, w, h = bbox
            all_points.extend([
                (x, y),
                (x + w, y),
                (x + w, y + h),
                (x, y + h)
            ])
    
    if not all_points:
        return None
    
    xs = [p[0] for p in all_points]
    ys = [p[1] for p in all_points]
    
    x_min = min(xs)
    y_min = min(ys)
    x_max = max(xs)
    y_max = max(ys)
    
    x_min = max(0, x_min - padding)
    y_min = max(0, y_min - padding)
    
    if img_size:
        w_img, h_img = img_size
        x_max = min(w_img, x_max + padding)
        y_max = min(h_img, y_max + padding)
    
    return (int(x_min), int(y_min), int(x_max - x_min), int(y_max - y_min))


def detect_workpiece_bbox(
    image: np.ndarray,
    padding: int = 30,
    min_area_ratio: float = 0.05,
    max_area_ratio: float = 0.92,
) -> Optional[tuple]:
    """检测单个工件区域"""
    h_img, w_img = image.shape[:2]
    img_area     = h_img * w_img

    gray     = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY) if len(image.shape) == 3 else image.copy()
    clahe    = cv2.createCLAHE(clipLimit=3.8, tileGridSize=(1,1))
    enhanced = clahe.apply(gray)
    blurred  = cv2.GaussianBlur(enhanced, (5, 5), 0)

    candidates = []
    for flag in (cv2.THRESH_BINARY + cv2.THRESH_OTSU,
                 cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU):
        _, binary = cv2.threshold(blurred, 0, 255, flag)
        candidates.append(binary)
    adaptive = cv2.adaptiveThreshold(
        blurred, 255,
        cv2.ADAPTIVE_THRESH_GAUSSIAN_C, cv2.THRESH_BINARY_INV,
        blockSize=51, C=5
    )
    candidates.append(adaptive)

    kernel_close = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (15, 15))
    kernel_open  = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))

    best_bbox       = None
    best_area_ratio = 0.0

    for binary in candidates:
        cleaned = cv2.morphologyEx(binary,  cv2.MORPH_CLOSE, kernel_close, iterations=2)
        cleaned = cv2.morphologyEx(cleaned, cv2.MORPH_OPEN,  kernel_open,  iterations=1)
        cnts, _ = cv2.findContours(cleaned, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        if not cnts:
            continue
        for cnt in sorted(cnts, key=cv2.contourArea, reverse=True):
            area_ratio = cv2.contourArea(cnt) / img_area
            if min_area_ratio <= area_ratio <= max_area_ratio:
                if area_ratio > best_area_ratio:
                    best_area_ratio = area_ratio
                    best_bbox = cv2.boundingRect(cnt)
                break

    if best_bbox is None:
        logger.warning(f"[detect_workpiece_bbox] 未检测到工件，回退到全图")
        return None

    x, y, w, h = best_bbox
    x1 = max(0, x - padding)
    y1 = max(0, y - padding)
    x2 = min(w_img, x + w + padding)
    y2 = min(h_img, y + h + padding)
    cw, ch = x2 - x1, y2 - y1
    logger.info(f"[detect_workpiece_bbox] bbox=({x1},{y1},{cw},{ch}), area_ratio={best_area_ratio:.2%}")
    return (x1, y1, cw, ch)


def detect_multiple_workpiece_bboxes(
    image: np.ndarray,
    padding: int = 30,
    min_area_ratio: float = 0.03,
    max_area_ratio: float = 0.95,
    min_distance_ratio: float = 0.15,
    expected_count: Optional[int] = None,
    background_frame: Optional[np.ndarray] = None,
    reference_workpiece_size: Optional[Tuple[int, int]] = None,  # (width, height)
) -> List[Tuple[int, int, int, int]]:
    """
    检测图像中的多个工件区域 - 改进版，支持金属件检测
    
    基于标注文件中的工件主体大小(1988x683, 占图像约20%)优化检测参数
    
    Args:
        image: 输入图像
        padding: 边界扩展像素
        min_area_ratio: 最小面积比例 (默认会根据参考尺寸自适应调整)
        max_area_ratio: 最大面积比例
        min_distance_ratio: 工件间最小距离比例
        expected_count: 期望检测到的工件数量（如果提供，会尝试找到这么多工件）
        background_frame: 可选的空托盘背景图（提供后将使用背景差分策略）
        reference_workpiece_size: 参考工件尺寸 (width, height)，用于自适应调整检测参数
        
    Returns:
        工件bbox列表 [(x, y, w, h), ...]
    """
    h_img, w_img = image.shape[:2]
    img_area = h_img * w_img

    if background_frame is None:
        default_bg_path = os.path.join(
            os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
            "test", "multi-demo-bg-light.jpg"
        )
        if os.path.exists(default_bg_path):
            background_frame = cv2.imread(default_bg_path)
            logger.info(f"[detect_multiple_workpiece_bboxes] 自动加载背景图: {default_bg_path}")

    # 根据参考工件尺寸自适应调整参数
    if reference_workpiece_size is not None:
        ref_w, ref_h = reference_workpiece_size
        ref_area = ref_w * ref_h
        ref_area_ratio = ref_area / img_area
        
        # 自适应调整面积比例范围
        # 允许工件大小在参考大小的 95% - 110% 范围内 (-5% 到 +10% 偏差)
        adaptive_min_ratio = max(0.03, ref_area_ratio * 0.95)
        adaptive_max_ratio = min(0.95, ref_area_ratio * 1.10)
        
        # 自适应最小尺寸 (参考尺寸的 40%)
        adaptive_min_width = int(ref_w * 0.40)
        adaptive_min_height = int(ref_h * 0.40)
        
        # 自适应长宽比范围 (参考比例的 0.5 - 2.0 倍)
        ref_aspect = ref_w / ref_h
        inv_aspect = ref_h / ref_w
        adaptive_aspect_min = max(0.10, inv_aspect * 0.5)
        adaptive_aspect_max = min(8.0,  ref_aspect * 2.0)
        
        logger.info(f"[detect_multiple_workpiece_bboxes] 使用自适应参数:")
        logger.info(f"  参考工件尺寸: {ref_w}x{ref_h}, 面积比例: {ref_area_ratio:.2%}")
        logger.info(f"  面积比例范围: {adaptive_min_ratio:.2%} - {adaptive_max_ratio:.2%}")
        logger.info(f"  最小尺寸: {adaptive_min_width}x{adaptive_min_height}")
        logger.info(f"  长宽比范围: {adaptive_aspect_min:.2f} - {adaptive_aspect_max:.2f}")
    else:
        # 使用默认参数
        adaptive_min_ratio = min_area_ratio
        adaptive_max_ratio = max_area_ratio
        adaptive_min_width = 100
        adaptive_min_height = 50
        adaptive_aspect_min = 0.15
        adaptive_aspect_max = 6.5
    
    min_distance = min(h_img, w_img) * min_distance_ratio
    
    # 使用改进的 WorkpieceDetector 进行检测
    detector = WorkpieceDetector(
        min_width=adaptive_min_width,
        min_height=adaptive_min_height,
        aspect_ratio_range=(adaptive_aspect_min, adaptive_aspect_max)
    )
    if background_frame is not None:
        detector.update_background(background_frame)
    
    all_bboxes = detector.detect(
        image, img_area, adaptive_min_ratio, adaptive_max_ratio, padding
    )

    logger.info(f"[detect_multiple_workpiece_bboxes] detector.detect() 返回 {len(all_bboxes)} 个bbox:")
    for i, bbox in enumerate(all_bboxes):
        x, y, bw, bh = bbox
        area = bw * bh
        area_ratio = area / img_area
        ref_w, ref_h = reference_workpiece_size if reference_workpiece_size else (0, 0)
        if reference_workpiece_size:
            ref_area = ref_w * ref_h
            ref_area_ratio = ref_area / img_area
            ratio = area_ratio / ref_area_ratio
            logger.info(f"  bbox[{i}]: ({x},{y},{bw},{bh}), 面积比例={area_ratio:.2%}, 参考比例={ratio:.2f}x")
            if area_ratio < adaptive_min_ratio:
                logger.info(f"    ❌ 被过滤: 面积比例 {area_ratio:.2%} < 最小阈值 {adaptive_min_ratio:.2%}")
            if area_ratio > adaptive_max_ratio:
                logger.info(f"    ❌ 被过滤: 面积比例 {area_ratio:.2%} > 最大阈值 {adaptive_max_ratio:.2%}")
            if ratio >= 1.8:
                logger.info(f"    ✅ 将触发连通域比例切割法 (ratio={ratio:.2f}x)")
        else:
            logger.info(f"  bbox[{i}]: ({x},{y},{bw},{bh}), 面积比例={area_ratio:.2%}")

    if reference_workpiece_size is not None:
        ref_w, ref_h = reference_workpiece_size
        ref_area = ref_w * ref_h
        ref_area_ratio = ref_area / img_area
        split_threshold_ratio_min = 1.8
        split_threshold_ratio_max = 4.2
        all_bboxes_split = []
        for bbox in all_bboxes:
            x, y, bw, bh = bbox
            cluster_area_ratio = (bw * bh) / img_area
            ratio = cluster_area_ratio / ref_area_ratio
            if ratio >= split_threshold_ratio_min and ratio <= split_threshold_ratio_max:
                logger.info(f"[detect_multiple_workpiece_bboxes] 检测到大面积连通域({ratio:.2f}x参考面积), 触发连通域比例切割法")
                split = _cluster_split_by_ratio(
                    bbox, img_area, reference_workpiece_size, padding,
                    adaptive_min_ratio, split_threshold_ratio_max
                )
                all_bboxes_split.extend(split)
            else:
                all_bboxes_split.append(bbox)
        all_bboxes = all_bboxes_split

    # 使用NMS合并重叠的bbox
    selected_bboxes = _nms_bboxes(all_bboxes, min_distance, w_img, h_img)
    
    # 如果主策略检测到的工件太少，尝试其他策略
    if len(selected_bboxes) < (expected_count or 1):
        logger.info(f"[detect_multiple_workpiece_bboxes] 主策略检测到 {len(selected_bboxes)} 个工件，尝试辅助策略")
        
        gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY) if image.ndim == 3 else image
        all_bboxes_aux = []
        
        # 策略1: 降低阈值使用边缘检测
        for canny_thresh1 in [20, 30]:
            for canny_thresh2 in [80, 100]:
                bboxes = _detect_workpieces_by_edges(
                    gray, img_area, adaptive_min_ratio * 0.5, adaptive_max_ratio, padding,
                    canny_thresh1, canny_thresh2
                )
                all_bboxes_aux.extend(bboxes)
        
        # 策略2: 使用阈值分割
        bboxes_thresh = _detect_workpieces_by_threshold(
            gray, img_area, adaptive_min_ratio * 0.5, adaptive_max_ratio, padding
        )
        all_bboxes_aux.extend(bboxes_thresh)
        
        # 合并并去重
        all_bboxes_aux.extend(selected_bboxes)
        if reference_workpiece_size is not None:
            ref_w, ref_h = reference_workpiece_size
            ref_area = ref_w * ref_h
            ref_area_ratio = ref_area / img_area
            split_threshold_ratio_min = 2.2
            split_threshold_ratio_max = 4.2
            all_bboxes_aux_split = []
            for bbox in all_bboxes_aux:
                bx, by, bw, bh = bbox
                cluster_area_ratio = (bw * bh) / img_area
                ratio = cluster_area_ratio / ref_area_ratio
                if ratio >= split_threshold_ratio_min and ratio <= split_threshold_ratio_max:
                    logger.info(f"[detect_multiple_workpiece_bboxes] 辅助策略检测到大面积连通域({ratio:.2f}x参考面积), 触发连通域比例切割法")
                    split = _cluster_split_by_ratio(
                        bbox, img_area, reference_workpiece_size, padding,
                        adaptive_min_ratio * 0.5, split_threshold_ratio_max
                    )
                    all_bboxes_aux_split.extend(split)
                elif ratio > split_threshold_ratio_max:
                    continue
                else:
                    all_bboxes_aux_split.append(bbox)
            all_bboxes_aux = all_bboxes_aux_split
        selected_bboxes = _nms_bboxes(all_bboxes_aux, min_distance * 0.5, w_img, h_img)
    
    # 按x坐标排序（从左到右）
    selected_bboxes.sort(key=lambda b: b[0])

    if reference_workpiece_size is not None:
        ref_w, ref_h = reference_workpiece_size
        aligned_bboxes = []
        for bbox in selected_bboxes:
            x, y, bw, bh = bbox
            center_x = x + bw / 2
            center_y = y + bh / 2
            w_ratio_normal = bw / ref_w
            h_ratio_normal = bh / ref_h
            w_ratio_rotated = bw / ref_h
            h_ratio_rotated = bh / ref_w
            normal_diff = abs(w_ratio_normal - 1.0) + abs(h_ratio_normal - 1.0)
            rotated_diff = abs(w_ratio_rotated - 1.0) + abs(h_ratio_rotated - 1.0)
            if rotated_diff < normal_diff:
                use_rotated = True
            else:
                use_rotated = False
            if use_rotated:
                w_ratio = w_ratio_rotated
                h_ratio = h_ratio_rotated
            else:
                w_ratio = w_ratio_normal
                h_ratio = h_ratio_normal
            need_align = False
            new_bw = bw
            new_bh = bh
            if w_ratio < 0.95:
                need_align = True
                new_bw = ref_h if use_rotated else ref_w
            if h_ratio < 0.95:
                need_align = True
                new_bh = ref_w if use_rotated else ref_h
            if need_align:
                new_x = int(center_x - new_bw / 2)
                new_y = int(center_y - new_bh / 2)
                new_x = max(0, min(new_x, w_img - new_bw))
                new_y = max(0, min(new_y, h_img - new_bh))
                aligned_bboxes.append((new_x, new_y, new_bw, new_bh))
            else:
                aligned_bboxes.append(bbox)
        selected_bboxes = aligned_bboxes

    logger.info(f"[detect_multiple_workpiece_bboxes] 检测到 {len(selected_bboxes)} 个工件")
    for i, bbox in enumerate(selected_bboxes):
        logger.info(f"  工件 {i+1}: bbox={bbox}")

    return selected_bboxes



def _detect_workpieces_by_edges(
    gray: np.ndarray,
    img_area: float,
    min_area_ratio: float,
    max_area_ratio: float,
    padding: int,
    canny_thresh1: int = 50,
    canny_thresh2: int = 150
) -> List[Tuple[int, int, int, int]]:
    """使用边缘检测检测工件"""
    h, w = gray.shape
    bboxes = []

    blurred = cv2.GaussianBlur(gray, (5, 5), 0)
    edges = cv2.Canny(blurred, canny_thresh1, canny_thresh2)

    kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (9, 9))
    edges_dilated = cv2.dilate(edges, kernel, iterations=3)

    kernel_close = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (15, 15))
    edges_closed = cv2.morphologyEx(edges_dilated, cv2.MORPH_CLOSE, kernel_close, iterations=2)

    contours, _ = cv2.findContours(edges_closed, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

    for cnt in contours:
        area = cv2.contourArea(cnt)
        area_ratio = area / img_area

        if min_area_ratio <= area_ratio <= max_area_ratio:
            x, y, bw, bh = cv2.boundingRect(cnt)
            if bw < 50 or bh < 50:
                continue
            bbox = (x, y, bw, bh)
            if area_ratio > max_area_ratio * 0.8 and bw > 150 and bh > 150:
                x1 = max(0, x - padding)
                y1 = max(0, y - padding)
                x2 = min(w, x + bw + padding)
                y2 = min(h, y + bh + padding)
                bboxes.append((x1, y1, x2 - x1, y2 - y1))
            else:
                x1 = max(0, x - padding)
                y1 = max(0, y - padding)
                x2 = min(w, x + bw + padding)
                y2 = min(h, y + bh + padding)
                bboxes.append((x1, y1, x2 - x1, y2 - y1))

    return bboxes


def _detect_workpieces_by_threshold(
    gray: np.ndarray,
    img_area: float,
    min_area_ratio: float,
    max_area_ratio: float,
    padding: int
) -> List[Tuple[int, int, int, int]]:
    """使用阈值分割检测工件"""
    h, w = gray.shape
    bboxes = []
    
    # 自适应阈值
    blurred = cv2.GaussianBlur(gray, (5, 5), 0)
    
    # 尝试多种阈值方法
    thresh_methods = [
        (cv2.THRESH_BINARY + cv2.THRESH_OTSU, 0),
        (cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU, 0),
        (cv2.ADAPTIVE_THRESH_GAUSSIAN_C, cv2.THRESH_BINARY_INV),
    ]
    
    for method, subtype in thresh_methods:
        if subtype == 0:
            _, binary = cv2.threshold(blurred, 0, 255, method)
        else:
            binary = cv2.adaptiveThreshold(blurred, 255, method, subtype, 51, 5)

        kernel_close = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (15, 15))
        kernel_open = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))

        cleaned = cv2.morphologyEx(binary, cv2.MORPH_CLOSE, kernel_close, iterations=2)
        cleaned = cv2.morphologyEx(cleaned, cv2.MORPH_OPEN, kernel_open, iterations=1)

        contours, _ = cv2.findContours(cleaned, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

        for cnt in contours:
            area = cv2.contourArea(cnt)
            area_ratio = area / img_area

            if min_area_ratio <= area_ratio <= max_area_ratio:
                x, y, bw, bh = cv2.boundingRect(cnt)
                bbox = (x, y, bw, bh)
                if area_ratio > max_area_ratio * 0.8 and bw > 150 and bh > 150:
                    x1 = max(0, x - padding)
                    y1 = max(0, y - padding)
                    x2 = min(w, x + bw + padding)
                    y2 = min(h, y + bh + padding)
                    bboxes.append((x1, y1, x2 - x1, y2 - y1))
                else:
                    x1 = max(0, x - padding)
                    y1 = max(0, y - padding)
                    x2 = min(w, x + bw + padding)
                    y2 = min(h, y + bh + padding)
                    bboxes.append((x1, y1, x2 - x1, y2 - y1))

    return bboxes


def _cluster_split_by_ratio(
    bbox: Tuple[int, int, int, int],
    img_area: float,
    ref_workpiece_size: Tuple[int, int],
    padding: int,
    min_area_ratio: float,
    split_threshold_ratio: float = 1.8,
) -> List[Tuple[int, int, int, int]]:
    """
    连通域比例切割法（Cluster Splitting）
    当连通域面积超过 split_threshold_ratio * ref_area 时，
    利用已知参考工件尺寸对该连通域进行数学等分切割。

    适用于：排列整齐、形状固定但边缘有微小粘连的刚性工件。

    Args:
        bbox: 待切割的大连通域 (x, y, w, h)
        img_area: 图像总面积
        ref_workpiece_size: 参考工件尺寸 (width, height)
        padding: 边界扩展像素
        min_area_ratio: 最小面积比例（用于过滤）
        split_threshold_ratio: 触发切割的面积倍数阈值（默认1.8）

    Returns:
        切割后的bbox列表
    """
    x, y, bw, bh = bbox
    h, w = bh, bw
    cluster_area = bw * bh
    ref_w, ref_h = ref_workpiece_size
    ref_area = ref_w * ref_h
    cluster_area_ratio = cluster_area / img_area
    ref_area_ratio = ref_area / img_area

    ratio = cluster_area_ratio / ref_area_ratio

    if ratio < split_threshold_ratio:
        return [bbox]

    n_pieces = int(round(ratio))
    n_pieces = max(2, min(n_pieces, 8))

    logger.info(f"[_cluster_split_by_ratio] 触发切割: ratio={ratio:.2f}x, 切割为 {n_pieces} 个工件")
    logger.info(f"  原始cluster bbox=({x},{y},{bw},{bh}), 面积比例={cluster_area_ratio:.2%}")

    split_bboxes = []

    overlap = 5
    piece_width = bw // n_pieces
    if piece_width < ref_w * 0.5:
        piece_width = int(ref_w * 0.6)

    for i in range(n_pieces):
        px = x + i * (piece_width - overlap)
        if px + piece_width > x + bw:
            px = x + bw - piece_width
        py = y
        pw = piece_width
        ph = bh

        piece_area = pw * ph
        piece_area_ratio = piece_area / img_area

        if piece_area_ratio < min_area_ratio:
            continue

        px1 = max(0, px - padding)
        py1 = max(0, py - padding)
        px2 = min(w, px + pw + padding)
        py2 = min(h, py + ph + padding)
        split_bboxes.append((px1, py1, px2 - px1, py2 - py1))

    logger.info(f"[_cluster_split_by_ratio] 切割后得到 {len(split_bboxes)} 个bbox")
    return split_bboxes if split_bboxes else [bbox]


def _detect_workpieces_by_template_matching(
    image: np.ndarray,
    template_gray: np.ndarray,
    img_area: float,
    min_area_ratio: float,
    max_area_ratio: float,
    padding: int,
    scales: List[float] = None,
) -> List[Tuple[int, int, int, int]]:
    """
    使用多尺度模板匹配检测工件
    
    Args:
        image: 输入图像 (BGR)
        template_gray: 模板图像 (灰度图)
        img_area: 图像总面积
        min_area_ratio: 最小面积比例
        max_area_ratio: 最大面积比例
        padding: 边界扩展像素
        scales: 缩放比例列表，默认 [0.8, 0.9, 1.0, 1.1, 1.2]
        
    Returns:
        检测到的工件bbox列表
    """
    if scales is None:
        scales = [0.8, 0.9, 1.0, 1.1, 1.2]
    
    h_img, w_img = image.shape[:2]
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY) if image.ndim == 3 else image
    
    # 模板尺寸
    tmpl_h, tmpl_w = template_gray.shape[:2]
    tmpl_area = tmpl_h * tmpl_w
    
    all_detections = []
    
    for scale in scales:
        # 缩放模板
        scaled_w = int(tmpl_w * scale)
        scaled_h = int(tmpl_h * scale)
        
        if scaled_w < 50 or scaled_h < 50:
            continue
        if scaled_w > w_img or scaled_h > h_img:
            continue
            
        resized_template = cv2.resize(template_gray, (scaled_w, scaled_h))
        
        # 模板匹配
        result = cv2.matchTemplate(gray, resized_template, cv2.TM_CCOEFF_NORMED)
        
        # 获取匹配结果
        threshold = 0.6  # 匹配阈值
        loc = np.where(result >= threshold)
        
        for pt in zip(*loc[::-1]):
            x, y = int(pt[0]), int(pt[1])
            w, h = scaled_w, scaled_h
            area = w * h
            area_ratio = area / img_area
            
            # 面积过滤
            if min_area_ratio <= area_ratio <= max_area_ratio:
                # 添加padding
                x1 = max(0, x - padding)
                y1 = max(0, y - padding)
                x2 = min(w_img, x + w + padding)
                y2 = min(h_img, y + h + padding)
                all_detections.append((x1, y1, x2 - x1, y2 - y1))
    
    return all_detections


import cv2
import numpy as np
from scipy import ndimage as ndi
from typing import List, Tuple, Optional


class WorkpieceDetector:
    """
    主策略：背景差分（稳定、抗高光）
    兜底策略：高光感知阈值（无参考图时使用）
    """

    def __init__(
        self,
        min_width: int = 100,
        min_height: int = 50,
        aspect_ratio_range: Tuple[float, float] = (0.15, 6.5),
    ):
        self.background: Optional[np.ndarray] = None
        self.bg_blur_ksize = 5
        self.min_width = min_width
        self.min_height = min_height
        self.aspect_ratio_range = aspect_ratio_range

    # ──────────────────────────────────────────────
    # 公开接口
    # ──────────────────────────────────────────────

    def update_background(self, frame: np.ndarray) -> None:
        gray = self._to_gray(frame)
        self.background = cv2.GaussianBlur(gray, (self.bg_blur_ksize,) * 2, 0)

    def detect(
        self,
        frame: np.ndarray,
        img_area: float,
        min_area_ratio: float,
        max_area_ratio: float,
        padding: int,
    ) -> List[Tuple[int, int, int, int]]:
        gray = self._to_gray(frame)

        if self.background is not None:
            fg_mask = self._background_subtraction(gray)
        else:
            fg_mask = self._highlight_aware_threshold(gray)

        fg_pixels = cv2.countNonZero(fg_mask)
        logger.info(f"[WorkpieceDetector.detect] 前景掩码: {fg_pixels} 像素 ({fg_pixels/img_area:.2%} of image)")

        bboxes = self._extract_bboxes(
            fg_mask, gray, img_area, min_area_ratio, max_area_ratio, padding
        )
        logger.info(f"[WorkpieceDetector.detect] 提取到 {len(bboxes)} 个bbox (过滤后)")
        return _nms(bboxes, iou_threshold=0.3)

    # ──────────────────────────────────────────────
    # 策略1：背景差分
    # ──────────────────────────────────────────────

    def _background_subtraction(self, gray: np.ndarray) -> np.ndarray:
        blurred = cv2.GaussianBlur(gray, (self.bg_blur_ksize,) * 2, 0)
        diff = cv2.absdiff(blurred, self.background)
        highlight_mask = self._extract_highlights(gray)
        _, diff_binary = cv2.threshold(diff, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
        combined = cv2.bitwise_or(diff_binary, highlight_mask)
        return self._morph_clean(combined, gray)

    # ──────────────────────────────────────────────
    # 策略2：高光感知阈值（兜底）
    # ──────────────────────────────────────────────

    def _highlight_aware_threshold(self, gray: np.ndarray) -> np.ndarray:
        base = cv2.morphologyEx(
            gray, cv2.MORPH_OPEN,
            cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (31, 31))
        )
        _, binary = cv2.threshold(base, 0, 255, cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)
        highlight_mask = self._extract_highlights(gray)
        combined = cv2.bitwise_or(binary, highlight_mask)
        return self._morph_clean(combined, gray)

    # ──────────────────────────────────────────────
    # 高光提取
    # ──────────────────────────────────────────────

    def _extract_highlights(self, gray: np.ndarray) -> np.ndarray:
        p95 = np.percentile(gray, 95)
        highlight_thresh = min(240, max(200, p95 * 0.97))
        _, highlights = cv2.threshold(gray, int(highlight_thresh), 255, cv2.THRESH_BINARY)
        kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (25, 25))
        return cv2.dilate(highlights, kernel, iterations=2)

    # ──────────────────────────────────────────────
    # 形态学清洗
    # ──────────────────────────────────────────────

    def _morph_clean(self, mask: np.ndarray, gray: np.ndarray) -> np.ndarray:
        h, w = gray.shape
        scale = min(h, w) / 1000.0
        ck = max(11, int(21 * scale) | 1)
        ok = max(5,  int(9  * scale) | 1)
        kernel_c = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (ck, ck))
        kernel_o = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (ok, ok))
        cleaned = cv2.morphologyEx(mask,    cv2.MORPH_CLOSE, kernel_c, iterations=3)
        cleaned = cv2.morphologyEx(cleaned, cv2.MORPH_OPEN,  kernel_o, iterations=2)
        return cleaned

    # ──────────────────────────────────────────────
    # 连通域提取 + 几何过滤（逻辑不变）
    # ──────────────────────────────────────────────

    def _extract_bboxes(
        self,
        mask: np.ndarray,
        gray: np.ndarray,
        img_area: float,
        min_area_ratio: float,
        max_area_ratio: float,
        padding: int,
    ) -> List[Tuple[int, int, int, int]]:
        h, w = gray.shape
        num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(mask, connectivity=8)
        bboxes = []
        aspect_min, aspect_max = self.aspect_ratio_range

        logger.info(f"[_extract_bboxes] 发现 {num_labels - 1} 个连通域")
        for i in range(1, num_labels):
            x, y, bw, bh, area = stats[i]
            area_ratio = area / img_area
            aspect = bw / max(bh, 1)

            reason = None
            if not (min_area_ratio <= area_ratio <= max_area_ratio):
                if area_ratio < min_area_ratio:
                    reason = f"面积比例 {area_ratio:.2%} < 最小阈值 {min_area_ratio:.2%}"
                else:
                    reason = f"面积比例 {area_ratio:.2%} > 最大阈值 {max_area_ratio:.2%}"
            elif bw < self.min_width or bh < self.min_height:
                reason = f"尺寸 ({bw}x{bh}) < 最小尺寸 ({self.min_width}x{self.min_height})"
            elif not (aspect_min <= aspect <= aspect_max):
                reason = f"长宽比 {aspect:.2f} 不在范围 [{aspect_min:.2f}, {aspect_max:.2f}]"
            else:
                roi_mask = (labels == i).astype(np.uint8) * 255
                cnts, _ = cv2.findContours(roi_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
                if cnts:
                    hull_area = cv2.contourArea(cv2.convexHull(cnts[0]))
                    if hull_area > 0 and (area / hull_area) < 0.35:
                        reason = f"填充率 {area/hull_area:.2%} < 35%"

            if reason:
                logger.info(f"  连通域[{i}]: ({x},{y},{bw},{bh}), 面积={area_ratio:.2%}, 长宽比={aspect:.2f} -> ❌ 过滤: {reason}")
            else:
                logger.info(f"  连通域[{i}]: ({x},{y},{bw},{bh}), 面积={area_ratio:.2%}, 长宽比={aspect:.2f} -> ✅ 通过")
                x1 = max(0, x - padding)
                y1 = max(0, y - padding)
                x2 = min(w, x + bw + padding)
                y2 = min(h, y + bh + padding)
                bboxes.append((x1, y1, x2 - x1, y2 - y1))

        return bboxes

    @staticmethod
    def _to_gray(frame: np.ndarray) -> np.ndarray:
        return cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY) if frame.ndim == 3 else frame


# ── NMS ─────────────────────────────────────────────────────────────
def _nms(bboxes, iou_threshold=0.3):
    if not bboxes:
        return []
    boxes = [(x, y, x + bw, y + bh, bw * bh) for x, y, bw, bh in bboxes]
    boxes.sort(key=lambda b: b[4], reverse=True)
    kept = []
    while boxes:
        best = boxes.pop(0)
        kept.append(best)
        boxes = [b for b in boxes if _iou(best, b) < iou_threshold]
    return [(b[0], b[1], b[2] - b[0], b[3] - b[1]) for b in kept]


def _iou(a, b) -> float:
    ix1 = max(a[0], b[0]); iy1 = max(a[1], b[1])
    ix2 = min(a[2], b[2]); iy2 = min(a[3], b[3])
    inter = max(0, ix2 - ix1) * max(0, iy2 - iy1)
    union = a[4] + b[4] - inter
    return inter / union if union > 0 else 0.0







def _nms_bboxes(
    bboxes: List[Tuple[int, int, int, int]],
    min_distance: float,
    img_w: int,
    img_h: int
) -> List[Tuple[int, int, int, int]]:
    """对bbox进行非极大值抑制"""
    if not bboxes:
        return []
    
    # 按面积排序
    bboxes_with_area = [(bbox, bbox[2] * bbox[3]) for bbox in bboxes]
    bboxes_with_area.sort(key=lambda x: x[1], reverse=True)
    
    selected = []
    selected_centers = []
    
    for bbox, area in bboxes_with_area:
        x, y, w, h = bbox
        cx, cy = x + w // 2, y + h // 2
        
        # 检查与已选bbox的距离
        too_close = False
        for sx, sy, sw, sh in selected:
            scx, scy = sx + sw // 2, sy + sh // 2
            distance = np.sqrt((cx - scx) ** 2 + (cy - scy) ** 2)
            
            # 计算IoU
            ix1 = max(x, sx)
            iy1 = max(y, sy)
            ix2 = min(x + w, sx + sw)
            iy2 = min(y + h, sy + sh)
            
            if ix2 > ix1 and iy2 > iy1:
                inter_area = (ix2 - ix1) * (iy2 - iy1)
                union_area = w * h + sw * sh - inter_area
                iou = inter_area / union_area if union_area > 0 else 0
                
                # 如果IoU大于0.3或距离太近，认为是同一个工件
                if iou > 0.3 or distance < min_distance:
                    too_close = True
                    break
        
        if not too_close:
            # 确保bbox在图像范围内
            x = max(0, min(x, img_w - 1))
            y = max(0, min(y, img_h - 1))
            w = min(w, img_w - x)
            h = min(h, img_h - y)
            
            if w > 50 and h > 50:  # 过滤太小的框
                selected.append((x, y, w, h))
    
    return selected



def _extract_roi_from_bbox(img: np.ndarray, bbox: List[float]) -> np.ndarray:
    x, y, w, h = [int(v) for v in bbox]
    img_h, img_w = img.shape[:2]
    x = max(0, min(x, img_w - 1))
    y = max(0, min(y, img_h - 1))
    w = max(1, min(w, img_w - x))
    h = max(1, min(h, img_h - y))
    return img[y:y + h, x:x + w]


def _extract_roi_from_segmentation(img: np.ndarray, segmentation: List[List[float]], pad_ratio: float = 0.05) -> Optional[np.ndarray]:
    if not segmentation:
        return None

    all_pts = []
    for seg in segmentation:
        pts = np.array(seg).reshape(-1, 2).astype(np.int32)
        all_pts.append(pts)

    if not all_pts:
        return None

    all_points = np.vstack(all_pts)
    x_min, y_min = np.min(all_points, axis=0)
    x_max, y_max = np.max(all_points, axis=0)

    w, h = x_max - x_min, y_max - y_min
    pad_x = int(w * pad_ratio)
    pad_y = int(h * pad_ratio)

    x_min = max(0, x_min - pad_x)
    y_min = max(0, y_min - pad_y)
    x_max = min(img.shape[1], x_max + pad_x)
    y_max = min(img.shape[0], y_max + pad_y)

    roi = img[y_min:y_max, x_min:x_max].copy()
    if roi.size == 0:
        return None

    mask = np.zeros((y_max - y_min, x_max - x_min), dtype=np.uint8)
    for pts in all_pts:
        pts_shifted = pts - [x_min, y_min]
        cv2.fillPoly(mask, [pts_shifted], 255)

    roi_masked = cv2.bitwise_and(roi, roi, mask=mask)
    return roi_masked


def _extract_roi(img: np.ndarray, ann: Dict) -> Optional[np.ndarray]:
    segmentation = ann.get("segmentation", [])
    if segmentation:
        roi = _extract_roi_from_segmentation(img, segmentation)
        if roi is not None:
            return roi
    bbox = ann.get("bbox", [0, 0, 0, 0])
    if bbox and len(bbox) >= 4:
        return _extract_roi_from_bbox(img, bbox)
    return None


def save_roi_screenshots(
    results:      List[Dict[str, Any]],
    template_img: np.ndarray,
    aligned_pred: np.ndarray,
    annotations:  List[Dict],
    request_id:   str = "",
) -> Dict[str, List[str]]:
    saved_paths = {"ok": [], "ng": []}
    if aligned_pred is None or aligned_pred.size == 0:
        return saved_paths
    if len(results) != len(annotations):
        return saved_paths

    for idx, (res, ann) in enumerate(zip(results, annotations)):
        anomaly_type  = res.get("anomaly_type", "normal")
        status_folder = "ok" if anomaly_type == "normal" else ("ng" if anomaly_type == "real_defect" else None)
        if status_folder is None:
            continue

        category = res.get("category", "unknown")
        save_dir = ROI_SAVE_DIR / category / status_folder

        template_roi = _extract_roi(template_img, ann)
        if template_roi is None or template_roi.size == 0:
            continue

        pred_roi = _extract_roi(aligned_pred, ann)
        if pred_roi is None or pred_roi.size == 0:
            continue

        try:
            save_dir.mkdir(parents=True, exist_ok=True)

            tmpl_filename = f"roi{idx+1}_{category}_{status_folder}_template.jpg"
            if cv2.imwrite(str(save_dir / tmpl_filename), template_roi):
                saved_paths[status_folder].append(str(save_dir / tmpl_filename))

            pred_filename = f"roi{idx+1}_{category}_{status_folder}_pred.jpg"
            if cv2.imwrite(str(save_dir / pred_filename), pred_roi):
                saved_paths[status_folder].append(str(save_dir / pred_filename))

        except Exception as e:
            logger.error(f"[{request_id}] 保存ROI截图失败: {e}")

    return saved_paths


