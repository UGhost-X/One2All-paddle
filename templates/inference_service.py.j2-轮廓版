REFERENCE_WORKPIECE_SIZE = (1988, 683)
REFERENCE_IMAGE_SIZE = (3200, 2100)


def get_workpiece_area_ratio_range(
    image_shape: Tuple[int, ...],
    reference_size: Tuple[int, int] = REFERENCE_WORKPIECE_SIZE,
    reference_image_size: Tuple[int, int] = REFERENCE_IMAGE_SIZE,
    tolerance: float = 0.15
) -> Tuple[float, float]:
    """
    根据模板工件占参考图像的比例，计算当前图像的合理面积筛选范围

    Args:
        image_shape: 当前图像的形状 (h, w, ...) 或 (h, w)
        reference_size: 模板工件参考尺寸 (width, height)
        reference_image_size: 参考图像尺寸 (width, height)
        tolerance: 允许的比例偏差 (默认 ±35%)

    Returns:
        (min_area_ratio, max_area_ratio): 面积比例范围
    """
    img_h, img_w = image_shape[:2]
    img_area = img_h * img_w

    ref_w, ref_h = reference_size
    ref_img_w, ref_img_h = reference_image_size

    # 模板工件占参考图像的比例
    ref_area_ratio = (ref_w * ref_h) / (ref_img_w * ref_img_h)

    # 根据当前图像尺寸换算期望的工件面积比例
    # 注意：如果相机距离变化，工件在图像中的占比会变化
    # 这里假设相机参数和拍摄距离保持一致
    min_ratio = ref_area_ratio * (1 - tolerance)
    max_ratio = ref_area_ratio * (1 + tolerance)

    # 限制范围在合理区间内
    min_ratio = max(0.03, min_ratio)  # 至少 3%
    max_ratio = min(0.50, max_ratio)  # 最多 50%

    return min_ratio, max_ratio


class ExecutorManager:
    """
    线程池管理器。
    - 用 asyncio.Lock 保证同一时刻只有一个协程在重建线程池
    - shutdown(wait=True) 在独立线程里执行，确保旧线程真正结束后
      旧线程里的 Paddle 张量才会被释放，避免 CUDA context 损坏
    """
    def __init__(self, max_workers: int = 1):
        self._executor   = ThreadPoolExecutor(max_workers=max_workers)
        self._max_workers = max_workers
        self._lock: Optional[asyncio.Lock] = None

    def init_lock(self):
        self._lock = asyncio.Lock()

    @property
    def executor(self) -> ThreadPoolExecutor:
        return self._executor

    async def rebuild(self, reason: str = ""):
        async with self._lock:
            old_executor    = self._executor
            self._executor  = ThreadPoolExecutor(max_workers=self._max_workers)
            if reason:
                logger.warning(f"[ExecutorManager] Rebuilding thread pool: {reason}")
            loop = asyncio.get_running_loop()
            loop.run_in_executor(None, old_executor.shutdown, True)


