        file: 上传的反例图像文件
        image: Base64编码的图像
    """
    if PATCHCORE_DETECTOR is None:
        raise HTTPException(status_code=500, detail="Models not loaded")
    
    if pos_id not in PATCHCORE_DETECTOR.models:
        raise HTTPException(status_code=404, detail=f"Model not found for pos_id={pos_id}")
    
    # 解码图像
    try:
        if file is not None:
            contents = await file.read()
            nparr = np.frombuffer(contents, np.uint8)
            roi = cv2.imdecode(nparr, cv2.IMREAD_COLOR)
        elif image is not None:
            b64 = image.split(",")[1] if "," in image else image
            nparr = np.frombuffer(base64.b64decode(b64), np.uint8)
            roi = cv2.imdecode(nparr, cv2.IMREAD_COLOR)
        else:
            raise HTTPException(status_code=400, detail="No image provided")
        
        if roi is None or roi.size == 0:
            raise HTTPException(status_code=400, detail="Invalid image")
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Image decode error: {str(e)}")
    
    # 确保反例库已初始化
    model = PATCHCORE_DETECTOR.models[pos_id]
    if not hasattr(model, 'neg_memory_bank') or model.neg_memory_bank is None:
        success = _initialize_negative_bank_for_pos_id(pos_id)
        if not success:
            raise HTTPException(status_code=500, detail=f"Failed to initialize negative bank for pos_id={pos_id}")
        model = PATCHCORE_DETECTOR.models[pos_id]  # 重新获取转换后的模型
    
    # 提取特征
    features = _extract_features_for_negative_bank(model, roi)
    if features is None:
        raise HTTPException(status_code=500, detail="Failed to extract features from image")
    
    # 添加到反例库
    try:
        device = model.device
        if model.neg_memory_bank is None or len(model.neg_memory_bank) == 0:
            model.neg_memory_bank = features.to(device)
        else:
            model.neg_memory_bank = torch.cat([model.neg_memory_bank, features.to(device)], dim=0)

        # 更新双库检测器
        if hasattr(model, 'dual_detector') and model.dual_detector is not None:
            model.dual_detector.neg_memory_bank = model.neg_memory_bank

        neg_size = len(model.neg_memory_bank)
        logger.info(f"Added negative example to pos_id={pos_id}, total size: {neg_size}")

        # 保存反例库到磁盘
        save_success = _save_negative_bank_to_disk(pos_id)
        neg_bank_path = _get_negative_bank_path(pos_id)

        # 保存反例图像到磁盘
        neg_samples_dir = PATCHCORE_DETECTOR.models_dir / pos_id / "neg_samples"
        neg_samples_dir.mkdir(parents=True, exist_ok=True)
        sample_index = neg_size
        sample_path = neg_samples_dir / f"neg_sample_{sample_index}.jpg"
        cv2.imwrite(str(sample_path), roi)
        logger.info(f"Saved negative sample image to {sample_path}")

        message = f"Negative example added successfully"
        if save_success:
            message += f", saved to {neg_bank_path}"
        else:
            message += ", but failed to save to disk"
        message += f", sample image saved to {sample_path}"

        return NegativeExampleResponse(
            success=True,
            pos_id=pos_id,
            message=message,
            negative_bank_size=neg_size,
            sample_image_path=str(sample_path),
        )
        
    except Exception as e:
        logger.error(f"Failed to add negative example: {e}")
        raise HTTPException(status_code=500, detail=f"Failed to add negative example: {str(e)}")


