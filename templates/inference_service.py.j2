class PerformanceMonitor:
    """性能监控器：记录CPU、内存、GPU使用情况和步骤耗时"""

    def __init__(self, request_id: str):
        self.request_id = request_id
        self.step_times: Dict[str, float] = {}
        self.resource_snapshots: Dict[str, Dict[str, Any]] = {}
        self._step_start_time: Optional[float] = None
        self._current_step: Optional[str] = None

    @staticmethod
    def get_cpu_info() -> Dict[str, Any]:
        """获取CPU信息"""
        cpu_percent = psutil.cpu_percent(interval=0.1)
        cpu_count = psutil.cpu_count()
        cpu_freq = psutil.cpu_freq()
        return {
            "usage_percent": round(cpu_percent, 1),
            "core_count": cpu_count,
            "freq_mhz": round(cpu_freq.current, 0) if cpu_freq else 0,
            "load_avg": [round(x, 2) for x in os.getloadavg()] if hasattr(os, 'getloadavg') else [],
        }

    @staticmethod
    def get_memory_info() -> Dict[str, Any]:
        """获取内存信息"""
        mem = psutil.virtual_memory()
        return {
            "total_gb": round(mem.total / (1024**3), 2),
            "available_gb": round(mem.available / (1024**3), 2),
            "used_gb": round(mem.used / (1024**3), 2),
            "usage_percent": mem.percent,
        }

    @staticmethod
    def get_gpu_info() -> Dict[str, Any]:
        """获取GPU显存信息"""
        try:
            allocated = paddle.device.cuda.memory_allocated(0)
            reserved = paddle.device.cuda.memory_reserved(0)
            max_memory = paddle.device.cuda.max_memory_allocated(0)
            return {
                "allocated_mb": round(allocated / 1024**2, 1),
                "reserved_mb": round(reserved / 1024**2, 1),
                "max_allocated_mb": round(max_memory / 1024**2, 1),
                "free_mb": round((reserved - allocated) / 1024**2, 1),
            }
        except Exception as e:
            return {"error": str(e)}

    def get_full_resource_snapshot(self) -> Dict[str, Any]:
        """获取完整的资源快照"""
        return {
            "cpu": self.get_cpu_info(),
            "memory": self.get_memory_info(),
            "gpu": self.get_gpu_info(),
            "timestamp": time.time(),
        }

    def start_step(self, step_name: str):
        """开始记录一个步骤"""
        self._current_step = step_name
        self._step_start_time = time.time()
        self.resource_snapshots[f"{step_name}_start"] = self.get_full_resource_snapshot()
        logger.info(f"[{self.request_id}] ▶️ STEP START: {step_name}")

    def end_step(self, step_name: str = None):
        """结束记录当前步骤"""
        step = step_name or self._current_step
        if step and self._step_start_time:
            elapsed = time.time() - self._step_start_time
            self.step_times[step] = elapsed
            self.resource_snapshots[f"{step}_end"] = self.get_full_resource_snapshot()

            # 计算资源变化
            start = self.resource_snapshots.get(f"{step}_start", {})
            end = self.resource_snapshots.get(f"{step}_end", {})

            # 构建详细日志
            log_parts = [f"[{self.request_id}] ✅ STEP END: {step} | Time: {elapsed:.3f}s"]

            # CPU变化
            cpu_start = start.get("cpu", {})
            cpu_end = end.get("cpu", {})
            if cpu_start and cpu_end:
                log_parts.append(f"CPU: {cpu_start.get('usage_percent', 0):.1f}% → {cpu_end.get('usage_percent', 0):.1f}%")

            # 内存变化
            mem_start = start.get("memory", {})
            mem_end = end.get("memory", {})
            if mem_start and mem_end:
                mem_delta = mem_end.get("used_gb", 0) - mem_start.get("used_gb", 0)
                log_parts.append(f"Memory: {mem_start.get('used_gb', 0):.2f}GB → {mem_end.get('used_gb', 0):.2f}GB (Δ{mem_delta:+.3f}GB)")

            # GPU变化
            gpu_start = start.get("gpu", {})
            gpu_end = end.get("gpu", {})
            if gpu_start and gpu_end and "error" not in gpu_start and "error" not in gpu_end:
                gpu_delta = gpu_end.get("allocated_mb", 0) - gpu_start.get("allocated_mb", 0)
                log_parts.append(f"GPU: {gpu_start.get('allocated_mb', 0):.1f}MB → {gpu_end.get('allocated_mb', 0):.1f}MB (Δ{gpu_delta:+.1f}MB)")

            logger.info(" | ".join(log_parts))

        self._current_step = None
        self._step_start_time = None

    @contextmanager
    def step(self, step_name: str):
        """上下文管理器方式记录步骤"""
        self.start_step(step_name)
        try:
            yield self
        finally:
            self.end_step(step_name)

    def log_summary(self):
        """输出完整摘要"""
        total_time = sum(self.step_times.values())
        logger.info(f"[{self.request_id}] 📊 PERFORMANCE SUMMARY (Total: {total_time:.3f}s)")
        for step, elapsed in sorted(self.step_times.items(), key=lambda x: x[1], reverse=True):
            pct = (elapsed / total_time * 100) if total_time > 0 else 0
            logger.info(f"[{self.request_id}]   - {step}: {elapsed:.3f}s ({pct:.1f}%)")


