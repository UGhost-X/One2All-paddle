def _save_roi_to_temp_sync(roi: np.ndarray, pos_id: str, category_name: str, wp_idx: int) -> Optional[Path]:
    """同步保存 ROI 到 temp 目录（在后台线程中执行）"""
    try:
        workpiece_temp_dir = OUTPUT_BASE_DIR / "temp" / str(wp_idx)
        temp_dir = workpiece_temp_dir / str(pos_id)
        temp_dir.mkdir(parents=True, exist_ok=True)
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S_%f")
        filename = f"roi_{timestamp}.jpg"
        save_path = temp_dir / filename
        cv2.imwrite(str(save_path), roi)
        logger.info(f"[ROI_TEMP] Saved ROI to {save_path} (category: {category_name})")
        return save_path
    except Exception as e:
        logger.warning(f"[ROI_TEMP] Failed to save ROI to temp: {e}")
        return None


async def async_save_roi(roi: np.ndarray, pos_id: str, category_name: str, wp_idx: int):
    """异步保存 ROI，不阻塞推理"""
    loop = asyncio.get_running_loop()
    await loop.run_in_executor(_save_executor, _save_roi_to_temp_sync, roi, pos_id, category_name, wp_idx)


