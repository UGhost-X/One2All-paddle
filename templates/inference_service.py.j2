class PerformanceMonitor:
    def __init__(self, request_id: str):
        self.request_id = request_id
        self.step_times: Dict[str, float] = {}
        self._step_start_time: Optional[float] = None
        self._current_step: Optional[str] = None

    def start_step(self, step_name: str):
        self._current_step = step_name
        self._step_start_time = time.time()
        logger.info(f"[{self.request_id}] ▶️ STEP START: {step_name}")

    def end_step(self, step_name: str = None):
        step = step_name or self._current_step
        if step and self._step_start_time:
            elapsed = time.time() - self._step_start_time
            self.step_times[step] = elapsed
            logger.info(f"[{self.request_id}] ✅ STEP END: {step} | Time: {elapsed:.3f}s")
        self._current_step = None
        self._step_start_time = None

    @contextmanager
    def step(self, step_name: str):
        self.start_step(step_name)
        try:
            yield self
        finally:
            self.end_step(step_name)

    def log_summary(self):
        total_time = sum(self.step_times.values())
        logger.info(f"[{self.request_id}] 📊 PERFORMANCE SUMMARY (Total: {total_time:.3f}s)")
        for step, elapsed in sorted(self.step_times.items(), key=lambda x: x[1], reverse=True):
            pct = (elapsed / total_time * 100) if total_time > 0 else 0
            logger.info(f"[{self.request_id}]   - {step}: {elapsed:.3f}s ({pct:.1f}%)")


