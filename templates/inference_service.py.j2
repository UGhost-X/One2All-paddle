MODELS: Dict[str, Any] = {}
MODEL_PATHS                                            = {{ models_config | tojson(indent=4) }}
DINORMALY_DETECTOR: Optional[MultiModelDetector] = None
TEMPLATE_IMAGE: Optional[np.ndarray] = None
TEMPLATE_ANNOTATIONS: List[Dict[str, Any]] = []


class WorkpieceResult(BaseModel):
    workpiece_id: int
    bbox: List[float]
    results: List[Dict[str, Any]]
    anomaly_count: int
    strategy: str = "none"
    error: Optional[str] = None


class PredictMultipleWorkpiecesResponse(BaseModel):
    workpiece_results: List[WorkpieceResult]
    total_workpieces: int
    total_anomalies: int
    processing_time: float
    visualization_b64: Optional[str] = None


def encode_image_to_base64(img: np.ndarray) -> str:
    if img is None:
        return ""
    _, buffer = cv2.imencode('.png', img)
    return base64.b64encode(buffer).decode('utf-8')


def load_models():
    global DINORMALY_DETECTOR, MODELS, TEMPLATE_IMAGE, TEMPLATE_ANNOTATIONS

    # 打印当前推理模式
    logger.info(f"[TRAIN_MODE] 当前推理模式: {TRAIN_MODE}")
    logger.info(f"[MODEL_PATHS] {MODEL_PATHS}")

    model_dirs = {
        path for key, path in MODEL_PATHS.items()
        if not key.endswith('_type') and key not in ('_labels', '_model_type', '_train_mode')
    }
    logger.info(f"[model_dirs] {model_dirs}")

    if not model_dirs:
        logger.warning("No model directories found")
        return

    base_dir = Path(list(model_dirs)[0]).parent
    logger.info(f"[base_dir] {base_dir}")
    DINORMALY_DETECTOR = MultiModelDetector(base_dir)
    if DINORMALY_DETECTOR.get_loaded_categories():
        MODELS = {
            cat: {'loaded': True, 'detector_type': 'dinomaly'}
            for cat in DINORMALY_DETECTOR.get_loaded_categories()
        }
        logger.info(f"Loaded Dinomaly models: {list(MODELS.keys())}")

        # by_category 模式下：建立 category_name -> category_id 的映射
        if TRAIN_MODE == "by_category":
            for cat_id in DINORMALY_DETECTOR.get_loaded_categories():
                config_path = base_dir / str(cat_id) / "config.json"
                if config_path.exists():
                    try:
                        with open(config_path, "r", encoding="utf-8") as f:
                            config = json.load(f)
                        category_label = config.get("category_label", "")
                        if category_label:
                            logger.info(f"[CATEGORY_MAPPING] {category_label} -> {cat_id}")
                    except Exception as e:
                        logger.warning(f"Failed to load config for {cat_id}: {e}")

    annotations_path = Path("product/{{ project_id }}/train/{{ task_uuid }}/annotations.json")
    if annotations_path.exists():
        tpl_path, tpl_anns = select_best_template_from_annotations(str(annotations_path))
        if tpl_path:
            TEMPLATE_IMAGE = cv2.imread(tpl_path)
            TEMPLATE_ANNOTATIONS = tpl_anns
            if TEMPLATE_IMAGE is not None:
                logger.info(f"Loaded template: {tpl_path}, {len(TEMPLATE_ANNOTATIONS)} annotations")

    if TEMPLATE_IMAGE is None:
        logger.warning("No template image found")
        return

    # 加载 LightGlue 模型（仅SuperPoint）
    _get_lightglue_models()

    # 预提取模板主体区域的变体特征
    subject_img, _, _ = extract_subject_region_from_annotations(
        TEMPLATE_IMAGE, TEMPLATE_ANNOTATIONS, subject_label="工件主体"
    )
    if subject_img is not None:
        default_rotations = list(range(0, 360, 15))
        # 传入 models_dir 以支持加载预计算的模板变体
        precompute_template_variant_features(subject_img, default_rotations, models_dir=base_dir)
    else:
        logger.warning("[LightGlue] 未找到工件主体标注，跳过预提取模板变体特征")

    if DINORMALY_DETECTOR and torch.cuda.is_available():
        dummy = np.zeros((224, 224, 3), dtype=np.uint8)
        for model_wrapper in DINORMALY_DETECTOR.models.values():
            try:
                model_wrapper.infer_batch_direct([dummy])
                logger.info(f"[warmup] {type(model_wrapper).__name__} GPU 预热完成")
            except Exception as e:
                logger.warning(f"[warmup] {type(model_wrapper).__name__} 预热失败: {e}")
        logger.info("[warmup] GPU 预热完成")


@app.on_event("startup")
async def startup_event():
    global _infer_semaphore
    _infer_semaphore = asyncio.Semaphore(4)
    _executor_manager.init_lock()
    loop = asyncio.get_event_loop()
    await loop.run_in_executor(_executor_manager.executor, load_models)


