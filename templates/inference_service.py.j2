def _load_single_model(pos_id_dir: Path) -> Optional[Tuple[str, Any, Dict[str, Any]]]:
    """
    加载单个模型的辅助函数（用于并行加载），仅支持 Dinomaly。

    Returns:
        (pos_id, wrapper, config) 元组，加载失败返回 None
    """
    pos_id = pos_id_dir.name

    # 加载配置
    config_path = pos_id_dir / "config.json"
    config = {}
    if config_path.exists():
        try:
            with open(config_path, "r", encoding="utf-8") as f:
                config = json.load(f)
        except Exception:
            pass

    # 查找 Dinomaly 模型文件
    # 首先检查 model.ckpt（训练时保存的格式）
    model_path = pos_id_dir / "model.ckpt"
    if not model_path.exists():
        # 兼容旧格式 dinomaly_model.pt
        model_path = pos_id_dir / "dinomaly_model.pt"
    if not model_path.exists():
        best = pos_id_dir / "best_model"
        if best.exists():
            model_path = best / "model.ckpt"
            if not model_path.exists():
                model_path = best / "dinomaly_model.pt"

    if not model_path.exists():
        logger.warning(f"Model not found for pos_id={pos_id}, skipping")
        return None

    try:
        # 加载 Dinomaly 模型
        wrapper = DinomalyWrapper(device="cuda" if torch.cuda.is_available() else "cpu")
        wrapper.load_from_checkpoint(str(model_path), str(config_path) if config_path.exists() else None)

        logger.info(
            f"Loaded Dinomaly model: pos_id={pos_id} "
            f"(threshold={wrapper.threshold}, "
            f"target_size={config.get('target_size', 'N/A')})"
        )

        return pos_id, wrapper, config
    except Exception as e:
        logger.error(f"Failed to load model pos_id={pos_id}: {e}")
        import traceback
        logger.error(traceback.format_exc())
        return None


class MultiModelDetector:
    def __init__(self, models_dir: Path, lazy_load: bool = True, max_workers: int = 4):
        self.models_dir = models_dir
        self.models: Dict[str, Any] = {}  # 仅支持 Dinomaly 模型
        self.configs: Dict[str, Dict[str, Any]] = {}
        self._model_metadata: Dict[str, Dict[str, Any]] = {}  # 懒加载用：存储模型元数据
        self._lazy_load = lazy_load
        self._max_workers = max_workers
        self._load_lock = asyncio.Lock() if lazy_load else None

        logger.info(f"[MultiModelDetector] 初始化 - TRAIN_MODE: {TRAIN_MODE}, models_dir: {models_dir}")

        if lazy_load:
            self._scan_model_metadata()
        else:
            self._load_models_parallel()

    def _scan_model_metadata(self):
        """懒加载模式：仅扫描模型元数据，不实际加载模型权重。"""
        logger.info(f"[_scan_model_metadata] 扫描目录: {self.models_dir}, exists={self.models_dir.exists()}")

        if not self.models_dir.exists():
            logger.warning(f"Models directory not found: {self.models_dir}")
            return

        subdirs = [d for d in self.models_dir.iterdir() if d.is_dir()]
        logger.info(f"[_scan_model_metadata] 子目录: {[d.name for d in subdirs]}")

        for pos_id_dir in self.models_dir.iterdir():
            if not pos_id_dir.is_dir():
                continue

            pos_id = pos_id_dir.name
            # 首先检查 model.ckpt（训练时保存的格式）
            model_path = pos_id_dir / "model.ckpt"
            if not model_path.exists():
                # 兼容旧格式 dinomaly_model.pt
                model_path = pos_id_dir / "dinomaly_model.pt"

            logger.info(f"[_scan_model_metadata] 检查: {pos_id}, model_path={model_path}, exists={model_path.exists()}")

            if not model_path.exists():
                best = pos_id_dir / "best_model"
                if best.exists():
                    model_path = best / "model.ckpt"
                    if not model_path.exists():
                        model_path = best / "dinomaly_model.pt"

            if not model_path.exists():
                logger.warning(f"[_scan_model_metadata] 模型文件不存在: {pos_id}")
                continue

            config_path = pos_id_dir / "config.json"
            config = {}
            if config_path.exists():
                try:
                    with open(config_path, "r", encoding="utf-8") as f:
                        config = json.load(f)
                except Exception as e:
                    logger.warning(f"Failed to load config for pos_id={pos_id}: {e}")

            self._model_metadata[pos_id] = {
                "model_path": str(model_path),
                "config_path": str(config_path) if config_path.exists() else None,
                "config": config,
            }
            logger.info(f"Scanned model metadata: pos_id={pos_id}")

        logger.info(f"[_scan_model_metadata] 扫描完成，共 {len(self._model_metadata)} 个模型")

    def _load_models_parallel(self):
        """并行加载所有模型（非懒加载模式）。"""
        if not self.models_dir.exists():
            logger.warning(f"Models directory not found: {self.models_dir}")
            return

        pos_id_dirs = [d for d in self.models_dir.iterdir() if d.is_dir()]

        if not pos_id_dirs:
            return

        logger.info(f"Loading {len(pos_id_dirs)} models in parallel with {self._max_workers} workers...")
        start_time = time.time()

        with ThreadPoolExecutor(max_workers=self._max_workers) as executor:
            futures = {executor.submit(_load_single_model, d): d for d in pos_id_dirs}
            for future in as_completed(futures):
                result = future.result()
                if result:
                    pos_id, wrapper, config = result
                    self.models[pos_id] = wrapper
                    self.configs[pos_id] = config

        elapsed = time.time() - start_time
        logger.info(f"Parallel model loading completed: {len(self.models)} models in {elapsed:.2f}s")

    async def _load_model_async(self, pos_id: str) -> Optional[DinomalyWrapper]:
        """异步加载单个模型（懒加载模式），带缓存。"""
        if pos_id in self.models:
            return self.models[pos_id]

        if pos_id not in self._model_metadata:
            return None

        async with self._load_lock:
            # 双重检查，避免并发重复加载
            if pos_id in self.models:
                return self.models[pos_id]

            metadata = self._model_metadata[pos_id]
            model_path = Path(metadata["model_path"])

            try:
                # 在线程池中执行同步的模型加载
                loop = asyncio.get_running_loop()
                result = await loop.run_in_executor(
                    None, _load_single_model, model_path.parent
                )

                if result:
                    _, wrapper, config = result
                    self.models[pos_id] = wrapper
                    self.configs[pos_id] = config
                    logger.info(f"Lazy loaded model for pos_id={pos_id}")
                    return wrapper
            except Exception as e:
                logger.error(f"Failed to lazy load model pos_id={pos_id}: {e}")

        return None

    async def detect_by_pos_id(
        self,
        rois: List[np.ndarray],
        category: str,
        request_id: str = "",
        annotations: List[Dict] = None,
    ) -> List[Dict[str, Any]]:
        total_rois = len(rois)
        if total_rois == 0:
            return []

        logger.info(f"[detect_by_pos_id] TRAIN_MODE: {TRAIN_MODE}, category: {category}, total_rois: {total_rois}")

        result_pairs: List[Optional[tuple]] = [None] * total_rois

        try:
            pos_id_groups: Dict[str, List[Tuple[int, np.ndarray, Dict]]] = {}
            for idx, roi in enumerate(rois):
                ann = annotations[idx] if annotations and idx < len(annotations) else {}

                if TRAIN_MODE == "by_category":
                    # by_category 模式下，所有 ROI 使用同一个 category 作为 lookup_key
                    lookup_key = str(category)
                else:
                    lookup_key = str(ann.get('pos_id', 'default'))

                pos_id_groups.setdefault(lookup_key, []).append((idx, roi, ann))

            all_pos_ids = list(pos_id_groups.keys())
            logger.info(f"[detect_by_pos_id] 分组结果: {all_pos_ids}")

            # 懒加载模式：按需加载所需模型
            if self._lazy_load:
                load_tasks = []
                for pos_id in all_pos_ids:
                    if pos_id not in self.models and pos_id in self._model_metadata:
                        load_tasks.append(self._load_model_async(pos_id))
                if load_tasks:
                    await asyncio.gather(*load_tasks, return_exceptions=True)

            loop = asyncio.get_running_loop()
            result_pairs = await loop.run_in_executor(
                _executor_manager.executor,
                self._detect_by_pos_id_original,
                pos_id_groups, category, request_id, total_rois
            )

        finally:
            if total_rois > 10:
                _cleanup(f"{category} done", force=False)

        return [
            r[0] if r is not None else
            {"is_anomaly": False, "anomaly_score": 0.0, "error": 0.0, "threshold": 0.0, "infer_failed": True}
            for r in result_pairs
        ]

    def _detect_by_pos_id_original(
        self,
        pos_id_groups: Dict[str, List[Tuple[int, np.ndarray, Dict]]],
        category: str,
        request_id: str,
        total_rois: int,
    ) -> List[Optional[tuple]]:
        result_pairs: List[Optional[tuple]] = [None] * total_rois

        for pos_id, group in pos_id_groups.items():
            if pos_id not in self.models:
                for idx, _, _ in group:
                    result_pairs[idx] = (
                        {"is_anomaly": False, "anomaly_score": 0.0,
                         "error": 0.0, "threshold": 0.0, "infer_failed": True}, True
                    )
                continue

            model = self.models[pos_id]
            config = self.configs[pos_id]

            # 获取阈值：Dinomaly 模型从 wrapper 获取
            threshold = model.threshold

            def make_result(error: float, infer_failed: bool = False) -> Dict[str, Any]:
                return {
                    "is_anomaly": (not infer_failed) and (error > threshold),
                    "anomaly_score": error,
                    "error": error,
                    "threshold": threshold,
                    "infer_failed": infer_failed,
                }

            rois_for_model = [roi for _, roi, _ in group]
            indices_for_model = [idx for idx, _, _ in group]

            # 分批处理，避免显存溢出
            try:
                for start in range(0, len(rois_for_model), INFERENCE_BATCH_SIZE):
                    end = start + INFERENCE_BATCH_SIZE
                    batch_rois = rois_for_model[start:end]
                    batch_indices = indices_for_model[start:end]
                    # 从每个 ROI 的 annotation 中提取真实的 pos_id，用于 SSIM 按位置匹配 FN 图片
                    # （by_category 模式下 pos_id 是类别名，ann['pos_id'] 才是实际位置ID）
                    batch_pos_ids = [str(ann.get('pos_id', pos_id)) for _, _, ann in group[start:end]]

                    batch_results = model.infer_batch_direct(batch_rois, pos_ids=batch_pos_ids)

                    # 如果全部失败，抛出异常触发 fallback
                    if all(r.get("infer_failed", False) for r in batch_results):
                        raise RuntimeError("infer_batch_direct all failed, falling back to infer_single")

                    for idx, result in zip(batch_indices, batch_results):
                        score = result["error"]
                        dinomaly_score = result.get("dinomaly_score", score)
                        ssim_score = result.get("ssim_score", 0.0)
                        is_ssim_anomaly = result.get("ssim_anomaly", False)
                        dinomaly_info = f" dinomaly={dinomaly_score:.4f}"
                        ssim_info = f" ssim={ssim_score:.4f}({'anomaly' if is_ssim_anomaly else 'normal'})"
                        logger.info(
                            f"[{request_id}] [{category}] ROI {idx+1}/{total_rois} "
                            f"pos_id={pos_id} roi_size={rois_for_model[start].shape[1]}x{rois_for_model[start].shape[0]} "
                            f"score={score:.4f} threshold={threshold:.4f}{dinomaly_info}{ssim_info} (batch)"
                        )
                        result_pairs[idx] = (make_result(score, result["infer_failed"]), False)

            except Exception as e:
                logger.error(f"[{request_id}] [{category}] Batch inference error pos_id={pos_id}: {e}")
                # 回退到单张推理
                for (roi, idx, ann) in zip(rois_for_model, indices_for_model, [a for _, _, a in group]):
                    try:
                        real_pos_id = str(ann.get('pos_id', pos_id))
                        result = model.infer_single(roi, pos_id=real_pos_id)
                        score = result["error"]
                        dinomaly_score = result.get("dinomaly_score", score)
                        ssim_score = result.get("ssim_score", 0.0)
                        is_ssim_anomaly = result.get("ssim_anomaly", False)
                        dinomaly_info = f" dinomaly={dinomaly_score:.4f}"
                        ssim_info = f" ssim={ssim_score:.4f}({'anomaly' if is_ssim_anomaly else 'normal'})"
                        logger.info(
                            f"[{request_id}] [{category}] ROI {idx+1}/{total_rois} "
                            f"pos_id={real_pos_id} roi_size={roi.shape[1]}x{roi.shape[0]} "
                            f"score={score:.4f} threshold={threshold:.4f}{dinomaly_info}{ssim_info} (single)"
                        )
                        result_pairs[idx] = (make_result(score, result["infer_failed"]), False)
                    except Exception as e2:
                        logger.error(f"[{request_id}] [{category}] Error ROI {idx+1} pos_id={pos_id}: {e2}")
                        result_pairs[idx] = (make_result(0.0, True), True)

        return result_pairs

    async def detect_category(
        self,
        rois: List[np.ndarray],
        category: str,
        request_id: str = "",
        annotations: List[Dict] = None,
    ) -> List[Dict[str, Any]]:
        return await self.detect_by_pos_id(
            rois=rois, category=category, request_id=request_id,
            annotations=annotations,
        )

    def get_loaded_categories(self) -> List[str]:
        """获取所有可用的类别（懒加载模式下包括未加载的）。"""
        if self._lazy_load:
            return list(self._model_metadata.keys())
        return list(self.models.keys())

    def is_model_loaded(self, pos_id: str) -> bool:
        """检查指定 pos_id 的模型是否已加载。"""
        return pos_id in self.models


# ─────────────────────────────────────────────────────────────────────────────
# 从 annotations.json 选择最佳模板图片
# ─────────────────────────────────────────────────────────────────────────────

def select_best_template_from_annotations(annotations_path: str) -> tuple:
    try:
        with open(annotations_path, 'r', encoding='utf-8') as f:
            data = json.load(f)

        images = {img['id']: img for img in data.get('images', [])}
        annotations = data.get('annotations', [])

        no_flip = [
            ann for ann in annotations
            if not ann.get('horizontal_flip', False) and not ann.get('vertical_flip', False)
        ]
        if not no_flip:
            logger.warning("No annotations without flip found")
            return None, []

        no_flip.sort(key=lambda x: abs(x.get('angle', 0)))
        best = no_flip[0]
        img_info = images.get(best.get('image_id'))
        if not img_info:
            logger.warning(f"Image {best.get('image_id')} not found")
            return None, []

        ann_dir = Path(annotations_path).parent
        file_name = img_info.get('file_name', '')

        for candidate in [
            ann_dir / "raw_images" / file_name,
            ann_dir / file_name,
            ann_dir / "images" / file_name,
        ]:
            if candidate.exists():
                template_path = str(candidate)
                break
        else:
            logger.warning(f"Template image not found for {file_name}")
            return None, []

        template_annotations = [
            {
                'category': str(ann.get('pos_id', '')),
                'category_name': ann.get('label', ''),
                'category_id': ann.get('category_id'),
                'pos_id': ann.get('pos_id'),
                'bbox': ann.get('bbox', [0, 0, 0, 0]),
                'segmentation': ann.get('segmentation', []),
            }
            for ann in no_flip
            if ann.get('image_id') == best.get('image_id') and ann.get('label')
        ]

        logger.info(
            f"Selected template: {file_name}, angle={best.get('angle', 0)}, "
            f"annotations={len(template_annotations)}"
        )
        return template_path, template_annotations

    except Exception as e:
        logger.error(f"Failed to select template from annotations: {e}")
        return None, []


# ─────────────────────────────────────────────────────────────────────────────
# ROI 提取工具
# ─────────────────────────────────────────────────────────────────────────────

def _extract_roi_from_bbox(img: np.ndarray, bbox: List[float]) -> np.ndarray:
    x, y, w, h = [int(v) for v in bbox]
    img_h, img_w = img.shape[:2]
    x = max(0, min(x, img_w - 1))
    y = max(0, min(y, img_h - 1))
    w = max(1, min(w, img_w - x))
    h = max(1, min(h, img_h - y))
    return img[y:y + h, x:x + w]


def _extract_roi_from_segmentation(img: np.ndarray, segmentation: List[List[float]],
                                   target_size: Optional[Tuple[int, int]] = (224, 224)) -> Optional[np.ndarray]:
    """从 segmentation 提取 ROI 并缩放到固定大小

    Args:
        img: 原始图片 (numpy array)
        segmentation: 多边形坐标列表
        target_size: 目标尺寸 (width, height)，默认 (224, 224)；如果为 None，则返回原始ROI不做缩放

    Returns:
        裁剪后的 ROI 图片，如果 target_size 不为空则缩放到指定大小，否则返回原始大小
    """
    if not segmentation:
        return None

    # 获取第一个 segmentation
    coords = segmentation[0]
    xs = coords[0::2]
    ys = coords[1::2]

    # 计算 tight bounding box
    x_min, x_max = int(min(xs)), int(max(xs))
    y_min, y_max = int(min(ys)), int(max(ys))

    # 确保不超出图片边界
    x_min = max(0, x_min)
    y_min = max(0, y_min)
    x_max = min(img.shape[1], x_max)
    y_max = min(img.shape[0], y_max)

    bbox_width = x_max - x_min
    bbox_height = y_max - y_min

    if bbox_width <= 0 or bbox_height <= 0:
        return None

    # 裁剪出 tight bounding box
    roi = img[y_min:y_max, x_min:x_max].copy()

    if roi.size == 0:
        return None

    # 如果 target_size 为 None，返回原始ROI不做缩放
    if target_size is None:
        return roi

    # 使用 letterbox_resize 保持宽高比，与训练预处理和 FN 图片保存一致
    roi_rgb = cv2.cvtColor(roi, cv2.COLOR_BGR2RGB)
    pil_img = Image.fromarray(roi_rgb)
    img_padded, _ = letterbox_resize(pil_img, (target_size[1], target_size[0]))
    roi_resized = cv2.cvtColor(np.array(img_padded), cv2.COLOR_RGB2BGR)

    return roi_resized


# ─────────────────────────────────────────────────────────────────────────────
# LightGlue 辅助函数 (仅支持SuperPoint)
# ─────────────────────────────────────────────────────────────────────────────

_LIGHTGLUE_EXTRACTOR = None
_LIGHTGLUE_MATCHER = None
_LIGHTGLUE_DEVICE = None

# 模板变体特征缓存: {rotations_tuple: [variant_dict, ...]}
_TEMPLATE_VARIANT_FEATURES: Dict[Tuple[float, ...], List[Dict]] = {}
_TEMPLATE_SUBJECT_IMG: Optional[np.ndarray] = None

# 本地模型缓存路径
SUPERPOINT_MODEL_PATH = Path(__file__).parent.parent / "models" / "pretrained" / "superpoint_v1.pth"


def _get_lightglue_models(use_fp16: bool = True):
    """加载LightGlue模型（仅支持SuperPoint，使用本地缓存）"""
    global _LIGHTGLUE_EXTRACTOR, _LIGHTGLUE_MATCHER, _LIGHTGLUE_DEVICE
    if _LIGHTGLUE_EXTRACTOR is None:
        try:
            from lightglue import LightGlue, SuperPoint
            import torch.hub
            
            device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
            
            # 设置本地模型缓存路径，阻止自动下载
            if SUPERPOINT_MODEL_PATH.exists():
                logger.info(f"[LightGlue] 使用本地SuperPoint模型: {SUPERPOINT_MODEL_PATH}")
                # 通过设置环境变量让lightglue使用本地模型
                os.environ["LIGHTGLUE_CACHE"] = str(SUPERPOINT_MODEL_PATH.parent)
                
                # 加载SuperPoint（使用本地权重）
                ext = SuperPoint(max_num_keypoints=8192).eval().to(device)
                
                # 加载本地权重
                if SUPERPOINT_MODEL_PATH.exists():
                    state_dict = torch.load(SUPERPOINT_MODEL_PATH, map_location=device)
                    ext.load_state_dict(state_dict)
                    logger.info(f"[LightGlue] 已加载本地SuperPoint权重")
            else:
                logger.warning(f"[LightGlue] 本地模型不存在: {SUPERPOINT_MODEL_PATH}，将尝试自动下载")
                ext = SuperPoint(max_num_keypoints=8192).eval().to(device)
            
            # 加载LightGlue匹配器（SuperPoint专用）
            mat = LightGlue(
                features="superpoint", depth_confidence=-1, width_confidence=-1
            ).eval().to(device)

            if use_fp16 and device.type == "cuda":
                import lightglue.superpoint as sp_module
                _orig_sample_descriptors = sp_module.sample_descriptors
                def _patched_sample_descriptors(keypoints, descriptors, s: int = 8):
                    return _orig_sample_descriptors(keypoints.half(), descriptors, s)
                sp_module.sample_descriptors = _patched_sample_descriptors
                ext = ext.half()
                mat = mat.half()
                logger.info(f"[LightGlue] 模型已转换为 FP16 模式")

            _LIGHTGLUE_EXTRACTOR = ext
            _LIGHTGLUE_MATCHER = mat
            _LIGHTGLUE_DEVICE = device
            logger.info(f"[LightGlue] SuperPoint模型加载完成 (device={device}, fp16={use_fp16 and device.type == 'cuda'})")
        except ImportError:
            logger.error("[LightGlue] 未安装，请执行: pip install lightglue")
        except Exception as e:
            logger.error(f"[LightGlue] 模型加载失败: {e}")
    return _LIGHTGLUE_EXTRACTOR, _LIGHTGLUE_MATCHER, _LIGHTGLUE_DEVICE


def _aug_img_to_tensor(bgr: np.ndarray) -> torch.Tensor:
    rgb = cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB)
    t = torch.from_numpy(rgb).permute(2, 0, 1).float() / 255.0
    return t.unsqueeze(0)


def _augment_template_variants(tmpl_bgr: np.ndarray, rotations: List[float]) -> List[Dict]:
    augmented = []
    h, w = tmpl_bgr.shape[:2]
    for angle in rotations:
        cx, cy = w / 2, h / 2
        M_rot = cv2.getRotationMatrix2D((cx, cy), -angle, 1.0)
        cos_a = abs(M_rot[0, 0])
        sin_a = abs(M_rot[0, 1])
        canvas_w = int(h * sin_a + w * cos_a)
        canvas_h = int(h * cos_a + w * sin_a)
        M_rot[0, 2] += canvas_w / 2 - cx
        M_rot[1, 2] += canvas_h / 2 - cy
        rotated = cv2.warpAffine(
            tmpl_bgr, M_rot, (canvas_w, canvas_h),
            flags=cv2.INTER_LINEAR, borderValue=(0, 0, 0)
        )
        augmented.append({"img": rotated, "angle": angle, "h": canvas_h, "w": canvas_w})
    return augmented


def _project_corners(M: np.ndarray, tmpl_h: int, tmpl_w: int) -> np.ndarray:
    corners = np.array([[0, 0], [tmpl_w, 0], [tmpl_w, tmpl_h], [0, tmpl_h]], dtype=np.float32)
    return cv2.transform(corners.reshape(1, -1, 2), M).reshape(-1, 2)


def _load_precomputed_template_variants(
    models_dir: Path,
    rotations: List[float],
    device: torch.device
) -> Optional[List[Dict]]:
    """
    从模型目录加载预计算的SuperPoint特征。
    检查 models_dir 下的所有子目录中的 template_variants 文件夹。
    返回包含预提取特征的变体列表，如果未找到则返回 None。
    """
    if not models_dir.exists():
        return None

    for model_dir in models_dir.iterdir():
        if not model_dir.is_dir():
            continue

        variants_dir = model_dir / "template_variants"
        if not variants_dir.exists():
            continue

        metadata_path = variants_dir / "metadata.json"
        if not metadata_path.exists():
            continue

        try:
            with open(metadata_path, 'r', encoding='utf-8') as f:
                metadata = json.load(f)

            # 检查旋转角度是否匹配
            saved_rotations = metadata.get('rotations', [])
            if saved_rotations != rotations:
                logger.debug(f"[LightGlue] Rotations mismatch in {variants_dir}: {saved_rotations} vs {rotations}")
                continue

            # 检查是否有预提取的特征
            features_extracted = metadata.get('features_extracted', False)
            if not features_extracted:
                logger.debug(f"[LightGlue] No pre-extracted features in {variants_dir}")
                continue

            # 从metadata获取原始尺寸
            original_size = metadata.get('original_size', {})
            orig_h = original_size.get('height', 0)
            orig_w = original_size.get('width', 0)

            # 只加载预提取的特征（不再加载图像）
            variants = []
            for angle in rotations:
                feature_path = variants_dir / f"features_{angle:03d}.npz"

                if not feature_path.exists():
                    logger.warning(f"[LightGlue] Missing feature file: {feature_path}")
                    break

                # 加载预提取的特征
                try:
                    feats_data = np.load(str(feature_path))
                    feats = {
                        'keypoints': torch.from_numpy(feats_data['keypoints']).to(device),
                        'descriptors': torch.from_numpy(feats_data['descriptors']).to(device),
                        'scores': torch.from_numpy(feats_data['scores']).to(device),
                    }
                    if 'scales' in feats_data:
                        feats['scales'] = torch.from_numpy(feats_data['scales']).to(device)
                    if 'oris' in feats_data:
                        feats['oris'] = torch.from_numpy(feats_data['oris']).to(device)
                except Exception as e:
                    logger.warning(f"[LightGlue] Failed to load features from {feature_path}: {e}")
                    break

                variants.append({
                    "angle": angle,
                    "h": orig_h,
                    "w": orig_w,
                    "feats": feats,  # 预提取的特征（GPU tensors）
                    # 缓存 numpy keypoints，避免 RANSAC 验证时重复 rbd()+.cpu().numpy()
                    "feats_np": {
                        "keypoints": feats_data['keypoints'].astype(np.float32)
                    }
                })

            if len(variants) == len(rotations):
                logger.info(f"[LightGlue] 从 {variants_dir} 加载了 {len(variants)} 个预计算模板变体（含特征）")
                return variants

        except Exception as e:
            logger.warning(f"[LightGlue] Failed to load precomputed variants from {variants_dir}: {e}")
            continue

    return None


def precompute_template_variant_features(
    template_subject_bgr: np.ndarray,
    rotations: List[float],
    models_dir: Optional[Path] = None
) -> List[Dict]:
    """
    预计算模板所有旋转变体的特征，并缓存到全局变量中（仅支持SuperPoint）。
    如果缓存已存在，直接返回缓存的特征。
    如果提供了 models_dir，会首先尝试从模型目录加载预计算的模板变体图及其特征。
    """
    global _TEMPLATE_VARIANT_FEATURES, _TEMPLATE_SUBJECT_IMG

    rotations_tuple = tuple(rotations)

    # 检查缓存是否已存在
    if rotations_tuple in _TEMPLATE_VARIANT_FEATURES:
        logger.info(f"[LightGlue] 使用缓存的模板变体特征 ({len(rotations)} 个变体)")
        return _TEMPLATE_VARIANT_FEATURES[rotations_tuple]

    # 获取提取器和设备
    extractor, _, device = _get_lightglue_models()
    if extractor is None:
        logger.error("[LightGlue] 提取器不可用，无法预计算特征")
        return []

    # 首先尝试从模型目录加载预计算的模板变体（包含预提取的特征）
    variants = None
    if models_dir is not None:
        variants = _load_precomputed_template_variants(models_dir, rotations, device)

    # 如果成功加载了包含预提取特征的变体
    if variants is not None and len(variants) > 0 and "feats" in variants[0]:
        logger.info(f"[LightGlue] 使用预计算的模板变体特征 ({len(variants)} 个)，跳过特征提取")
        # 存入缓存
        _TEMPLATE_VARIANT_FEATURES[rotations_tuple] = variants
        _TEMPLATE_SUBJECT_IMG = template_subject_bgr.copy() if template_subject_bgr is not None else None
        return variants

    # 如果没有找到预计算的变体，则实时生成并提取特征
    if variants is None:
        logger.info(f"[LightGlue] 预计算模板变体特征 ({len(rotations)} 个变体)...")
        t_start = time.time()
        variants = _augment_template_variants(template_subject_bgr, rotations)
        elapsed = time.time() - t_start
        logger.info(f"[LightGlue] 实时生成模板变体完成，耗时 {elapsed:.3f}s")
    else:
        logger.info(f"[LightGlue] 使用预计算的模板变体 ({len(variants)} 个)，需要提取特征")

    # 提取所有变体的特征
    t_start = time.time()
    with torch.no_grad():
        for v in variants:
            t_tensor = _aug_img_to_tensor(v["img"])
            # 如果模型是 FP16，输入也需要转换为 FP16
            if extractor.training is False and next(extractor.parameters()).dtype == torch.float16:
                t_tensor = t_tensor.half()
            v["feats"] = extractor.extract(t_tensor.to(device))
            # 同时缓存 numpy 版 keypoints，避免后续 RANSAC 验证时重复 rbd()+.cpu().numpy()
            v["feats_np"] = {
                "keypoints": v["feats"]["keypoints"][0].cpu().numpy().astype(np.float32)
            }

    # 存入缓存
    _TEMPLATE_VARIANT_FEATURES[rotations_tuple] = variants
    _TEMPLATE_SUBJECT_IMG = template_subject_bgr.copy() if template_subject_bgr is not None else None

    elapsed = time.time() - t_start
    logger.info(f"[LightGlue] 模板变体特征提取完成，耗时 {elapsed:.3f}s，共 {len(variants)} 个变体")

    return variants


def batch_match_template_variants(
    variants: List[Dict],
    feats_scene: Dict[str, torch.Tensor],
    matcher,
    device: torch.device,
    min_matches: int = 8
) -> List[Dict]:
    """
    批量匹配所有模板变体与场景特征，返回每个变体的匹配结果。
    使用 batch 推理提高效率。
    """
    try:
        from lightglue.utils import rbd
    except ImportError:
        logger.error("[LightGlue] 模块不可用")
        return []

    if not variants:
        return []

    n_variants = len(variants)

    # 收集所有变体的特征
    all_keypoints = []
    all_descriptors = []
    all_scales = []
    all_oris = []

    for v in variants:
        feats = v["feats"]
        all_keypoints.append(feats["keypoints"])  # [1, N, 2]
        all_descriptors.append(feats["descriptors"])  # [1, N, D]
        if "scales" in feats:
            all_scales.append(feats["scales"])  # [1, N]
        if "oris" in feats:
            all_oris.append(feats["oris"])  # [1, N]

    # 找到最大关键点数用于填充
    max_kpts = max(k.shape[1] for k in all_keypoints)

    # 填充所有变体特征到相同长度
    padded_keypoints = []
    padded_descriptors = []
    padded_scales = []
    padded_oris = []
    valid_masks = []

    for i in range(n_variants):
        kpts = all_keypoints[i]
        desc = all_descriptors[i]
        n_kpts = kpts.shape[1]

        if n_kpts < max_kpts:
            # 填充关键点
            pad_kpts = torch.zeros(1, max_kpts - n_kpts, 2, device=device, dtype=kpts.dtype)
            kpts = torch.cat([kpts, pad_kpts], dim=1)

            # 填充描述符
            pad_desc = torch.zeros(1, max_kpts - n_kpts, desc.shape[2], device=device, dtype=desc.dtype)
            desc = torch.cat([desc, pad_desc], dim=1)

        padded_keypoints.append(kpts)
        padded_descriptors.append(desc)

        # 创建有效掩码
        mask = torch.zeros(1, max_kpts, dtype=torch.bool, device=device)
        mask[:, :n_kpts] = True
        valid_masks.append(mask)

        # 处理 scales 和 oris
        if all_scales:
            scales = all_scales[i]
            if scales.shape[1] < max_kpts:
                pad_scales = torch.ones(1, max_kpts - scales.shape[1], device=device, dtype=scales.dtype)
                scales = torch.cat([scales, pad_scales], dim=1)
            padded_scales.append(scales)

        if all_oris:
            oris = all_oris[i]
            if oris.shape[1] < max_kpts:
                pad_oris = torch.zeros(1, max_kpts - oris.shape[1], device=device, dtype=oris.dtype)
                oris = torch.cat([oris, pad_oris], dim=1)
            padded_oris.append(oris)

    # 构建 batch 输入
    # 确保所有特征使用相同的 dtype（与场景特征保持一致）
    scene_dtype = feats_scene["keypoints"].dtype
    batch_feats0 = {
        "keypoints": torch.cat(padded_keypoints, dim=0).to(scene_dtype),  # [B, M, 2]
        "descriptors": torch.cat(padded_descriptors, dim=0).to(scene_dtype),  # [B, M, D]
    }
    if padded_scales:
        batch_feats0["scales"] = torch.cat(padded_scales, dim=0)  # [B, M]
    if padded_oris:
        batch_feats0["oris"] = torch.cat(padded_oris, dim=0)  # [B, M]

    # 场景特征复制 n_variants 份
    batch_feats1 = {
        "keypoints": feats_scene["keypoints"].repeat(n_variants, 1, 1),  # [B, N, 2]
        "descriptors": feats_scene["descriptors"].repeat(n_variants, 1, 1),  # [B, N, D]
    }
    if "scales" in feats_scene:
        batch_feats1["scales"] = feats_scene["scales"].repeat(n_variants, 1)
    if "oris" in feats_scene:
        batch_feats1["oris"] = feats_scene["oris"].repeat(n_variants, 1)

    # 确保 batch 输入与 matcher 使用相同的 dtype（避免 float32 vs float16 不匹配）
    matcher_dtype = next(matcher.parameters()).dtype
    for key in list(batch_feats0.keys()):
        if isinstance(batch_feats0[key], torch.Tensor) and batch_feats0[key].dtype != matcher_dtype:
            batch_feats0[key] = batch_feats0[key].to(matcher_dtype)
    for key in list(batch_feats1.keys()):
        if isinstance(batch_feats1[key], torch.Tensor) and batch_feats1[key].dtype != matcher_dtype:
            batch_feats1[key] = batch_feats1[key].to(matcher_dtype)

    # 批量匹配
    with torch.no_grad():
        batch_match_result = matcher({"image0": batch_feats0, "image1": batch_feats1})

    # 解析 batch 结果
    results = []
    for i in range(n_variants):
        v = variants[i]
        valid_mask = valid_masks[i]

        # 提取第 i 个变体的匹配结果
        matches0 = batch_match_result["matches0"][i]  # [M]
        mscores0 = batch_match_result["matching_scores0"][i]  # [M]

        # 只保留有效的匹配（关键点在有效范围内且匹配成功）
        n_valid_kpts = (valid_mask[0]).sum().item()

        # 对 matches0 和 mscores0 都截取有效长度
        matches0_valid = matches0[:n_valid_kpts]
        mscores0_valid = mscores0[:n_valid_kpts]

        valid_matches = (matches0_valid > -1)

        if valid_matches.sum().item() < min_matches:
            results.append({
                "variant": v,
                "matches": np.array([]).reshape(0, 2),
                "mscores": np.array([]),
                "n_matches": 0,
            })
            continue

        # 获取匹配的关键点索引
        m_indices_0 = torch.where(valid_matches)[0]
        m_indices_1 = matches0_valid[valid_matches]

        # 转换为 numpy
        matches_np = torch.stack([m_indices_0, m_indices_1], dim=1).cpu().numpy()
        mscores_np = mscores0_valid[valid_matches].cpu().numpy()

        results.append({
            "variant": v,
            "matches": matches_np,
            "mscores": mscores_np,
            "n_matches": len(matches_np),
        })

    return results


def _points_in_polygon(points: np.ndarray, poly: np.ndarray) -> np.ndarray:
    """
    向量化射线投射算法，一次性判断所有点是否在多边形内。

    只遍历多边形的边（通常 4~10 条），对数千个点做向量化运算，
    比逐点调用 cv2.pointPolygonTest 快 10-50x。

    Args:
        points: (N, 2) 待判断点坐标
        poly: (M, 2) 多边形顶点

    Returns:
        bool 数组 (N,), True=点在多边形内部
    """
    n_verts = len(poly)
    if n_verts < 3:
        return np.zeros(len(points), dtype=bool)

    x, y = points[:, 0], points[:, 1]
    inside = np.zeros(len(points), dtype=bool)

    x1 = poly[:, 0]
    y1 = poly[:, 1]
    x2 = np.roll(x1, -1)
    y2 = np.roll(y1, -1)

    for i in range(n_verts):
        # 射线(向右)与边 (x1[i],y1[i])→(x2[i],y2[i]) 相交测试
        dy = y2[i] - y1[i]
        # 跳过水平边
        if dy == 0:
            continue
        y_between = (y1[i] > y) != (y2[i] > y)
        x_intersect = x < (x2[i] - x1[i]) * (y - y1[i]) / dy + x1[i]
        mask = y_between & x_intersect
        inside[mask] = ~inside[mask]

    return inside


def filter_scene_features_by_polygon(
    feats_scene: Dict[str, torch.Tensor],
    poly: np.ndarray,
    device: torch.device,
    margin: int = 10
) -> Dict[str, torch.Tensor]:
    """
    根据多边形区域过滤场景特征，移除多边形内部的关键点。
    用于在找到工件后，从场景特征中移除已匹配区域，避免重复检测。

    Args:
        feats_scene: 原始场景特征字典
        poly: 工件区域多边形 (N, 2)
        device: 计算设备
        margin: 多边形外扩边距（像素）

    Returns:
        过滤后的场景特征字典
    """
    if feats_scene is None or poly is None or len(poly) < 3:
        return feats_scene

    # 获取关键点坐标
    kpts = feats_scene["keypoints"]  # [1, N, 2]
    n_kpts = kpts.shape[1]

    if n_kpts == 0:
        return feats_scene

    # 将关键点转换为 numpy 进行判断
    kpts_np = kpts[0].cpu().numpy()  # [N, 2]

    # 扩展多边形边距
    if margin > 0:
        # 计算多边形中心
        center = np.mean(poly, axis=0)
        # 向外扩展
        expanded_poly = []
        for pt in poly:
            direction = pt - center
            norm = np.linalg.norm(direction)
            if norm > 0:
                direction = direction / norm
                expanded_pt = pt + direction * margin
            else:
                expanded_pt = pt
            expanded_poly.append(expanded_pt)
        poly = np.array(expanded_poly, dtype=np.float32)

    # 向量化判断所有点是否在多边形内（比逐点 pointPolygonTest 快 10-50x）
    inside = _points_in_polygon(kpts_np, poly)

    # 保留在多边形外部的关键点
    valid_mask = ~inside
    valid_indices = np.where(valid_mask)[0]

    if len(valid_indices) == 0:
        # 所有点都被过滤，返回空特征
        return {
            "keypoints": torch.zeros((1, 0, 2), device=device, dtype=kpts.dtype),
            "descriptors": torch.zeros((1, 0, feats_scene["descriptors"].shape[2]), device=device, dtype=feats_scene["descriptors"].dtype),
        }

    # 根据有效索引过滤所有特征
    valid_indices_torch = torch.tensor(valid_indices, device=device, dtype=torch.long)

    filtered_feats = {
        "keypoints": kpts[:, valid_indices_torch, :],
        "descriptors": feats_scene["descriptors"][:, valid_indices_torch, :],
    }

    # 处理可选字段（scales, oris 等）
    if "scales" in feats_scene:
        filtered_feats["scales"] = feats_scene["scales"][:, valid_indices_torch]
    if "oris" in feats_scene:
        filtered_feats["oris"] = feats_scene["oris"][:, valid_indices_torch]

    return filtered_feats


def _polygon_is_valid(poly: np.ndarray, img_h: int, img_w: int) -> bool:
    area = abs(cv2.contourArea(poly.astype(np.float32)))
    if area < 100 or area > img_h * img_w * 0.8:
        return False
    margin = max(img_h, img_w) * 0.2
    if (np.any(poly < -margin) or
        np.any(poly[:, 0] > img_w + margin) or
        np.any(poly[:, 1] > img_h + margin)):
        return False
    return True


# ─────────────────────────────────────────────────────────────────────────────
# 提取工件主体区域（使用 segmentation）
# ─────────────────────────────────────────────────────────────────────────────

def extract_subject_region_from_annotations(
    image: np.ndarray,
    annotations: List[Dict],
    subject_label: str = "工件主体"
) -> Tuple[Optional[np.ndarray], Optional[np.ndarray], Optional[Tuple[int, int, int, int]]]:
    for ann in annotations:
        if ann.get("category_name") == subject_label or ann.get("label") == subject_label:
            segm = ann.get("segmentation", [])
            if segm and len(segm) > 0:
                all_pts = []
                for seg in segm:
                    pts = np.array(seg).reshape(-1, 2).astype(np.int32)
                    all_pts.append(pts)
                if all_pts:
                    all_points = np.vstack(all_pts)
                    x_min, y_min = np.min(all_points, axis=0)
                    x_max, y_max = np.max(all_points, axis=0)
                    x, y, w, h = int(x_min), int(y_min), int(x_max - x_min), int(y_max - y_min)
                    subject_img = image[y:y+h, x:x+w].copy()
                    M = np.array([
                        [1, 0, -x],
                        [0, 1, -y],
                        [0, 0, 1]
                    ], dtype=np.float64)
                    logger.info(f"使用 segmentation 提取工件主体: ({x},{y},{w},{h})")
                    return subject_img, M, (x, y, w, h)

            bbox = ann.get("bbox", [])
            if bbox and len(bbox) >= 4:
                x, y, w, h = [int(v) for v in bbox]
                subject_img = image[y:y+h, x:x+w].copy()
                M = np.array([
                    [1, 0, -x],
                    [0, 1, -y],
                    [0, 0, 1]
                ], dtype=np.float64)
                logger.info(f"使用 bbox 提取工件主体: ({x},{y},{w},{h})")
                return subject_img, M, (x, y, w, h)

    logger.warning("未找到工件主体标注，将使用整张模板图")
    h, w = image.shape[:2]
    return image, np.eye(3, dtype=np.float64), (0, 0, w, h)


# ─────────────────────────────────────────────────────────────────────────────
# LightGlue 多工件检测
# 修改：返回值新增 H_scene_to_roi，供后续正确变换标注坐标使用
# ─────────────────────────────────────────────────────────────────────────────

def detect_workpieces_with_lightglue(
    image: np.ndarray,
    template_subject_bgr: np.ndarray,
    subject_bbox_in_template: Tuple[int, int, int, int],
    rotations: List[float] = None,
    min_matches: int = 4,
    max_instances: int = 20,
    padding: int = 20,
) -> List[Tuple[np.ndarray, Dict, np.ndarray, np.ndarray, np.ndarray, np.ndarray]]:
    """
    返回列表中每个元素为：
        (roi_image, roi_info, A_subject_to_scene, A_template_to_scene, A_scene_to_roi, A_template_to_roi_image)
    使用仿射变换（Affine）替代透视变换，更适合刚体工件：
    - A_subject_to_scene: 工件主体 → 场景图的 3x3 仿射变换矩阵（第三行 [0,0,1]）
    - A_template_to_scene: 模板 → 场景图的 3x3 仿射变换矩阵
    - A_scene_to_roi: 场景图 → roi_image 的 3x3 仿射变换矩阵
    - A_template_to_roi_image: 直接计算的模板 → roi_image 仿射变换矩阵
    """
    if rotations is None:
        rotations = rotations = list(range(0, 360, 15))

    extractor, matcher, device = _get_lightglue_models()
    if extractor is None or matcher is None:
        logger.error("[LightGlue] 模型不可用，返回空结果")
        return []

    try:
        from lightglue.utils import rbd
    except ImportError:
        logger.error("[LightGlue] 模块不可用")
        return []

    scene_h, scene_w = image.shape[:2]
    scene_masked = image.copy()
    sub_h, sub_w = template_subject_bgr.shape[:2]

    # 使用预计算的模板变体特征（如果缓存不存在则自动计算）
    variants = precompute_template_variant_features(template_subject_bgr, rotations)

    results = []

    # 只提取一次场景特征，后续通过过滤已匹配区域来复用
    logger.info("[LightGlue] 提取场景特征（仅一次）...")
    scene_tensor = _aug_img_to_tensor(scene_masked)
    # 如果模型是 FP16，输入也需要转换为 FP16
    if extractor.training is False and next(extractor.parameters()).dtype == torch.float16:
        scene_tensor = scene_tensor.half()
    with torch.no_grad():
        feats_scene = extractor.extract(scene_tensor.to(device))
    n_scene_kpts_initial = feats_scene["keypoints"].shape[1]
    logger.info(f"[LightGlue] 初始场景特征点: {n_scene_kpts_initial}")

    for instance_idx in range(1, max_instances + 1):
        logger.info(f"[LightGlue] 开始寻找第 {instance_idx} 个工件...")

        n_scene_kpts = feats_scene["keypoints"].shape[1]
        if n_scene_kpts < min_matches:
            logger.info(f"[LightGlue] 场景特征点不足 ({n_scene_kpts})，结束检测")
            break

        # 使用批量匹配所有变体（更高效）
        batch_results = batch_match_template_variants(variants, feats_scene, matcher, device, min_matches)

        # 预提取场景特征 numpy keypoints（每轮只需一次，避免 RANSAC 循环中重复 rbd()）
        scene_kpts_np = feats_scene["keypoints"][0].cpu().numpy()

        best = None
        best_inliers = 0

        for result in batch_results:
            if result["n_matches"] < min_matches:
                continue

            v = result["variant"]
            matches = result["matches"]

            # 使用预缓存的 numpy keypoints 避免 rbd() + .cpu().numpy() 开销
            kpts0 = v.get("feats_np", {}).get("keypoints")
            if kpts0 is None:
                # 回退：兼容没有预缓存 keypoints 的旧变体
                f0 = rbd(v["feats"])
                kpts0 = f0["keypoints"][0].cpu().numpy()
            kpts1 = scene_kpts_np

            pts0 = kpts0[matches[:, 0]]
            pts1 = kpts1[matches[:, 1]]

            # 使用仿射变换替代透视变换，更适合刚体工件
            affine_matrix, inliers = cv2.estimateAffinePartial2D(
                pts0.reshape(-1, 1, 2), pts1.reshape(-1, 1, 2),
                method=cv2.RANSAC, ransacReprojThreshold=6, maxIters=2000, confidence=0.99
            )
            if affine_matrix is None or inliers is None:
                continue

            n_inliers = int(inliers.sum())
            if n_inliers < min_matches:
                continue

            # 将 2x3 仿射矩阵扩展为 3x3 仿射矩阵（第三行为 [0,0,1]）
            A_variant_to_scene = np.vstack([affine_matrix, [0, 0, 1]])

            src_pts_variant = np.array([
                [0, 0],
                [v["w"], 0],
                [v["w"], v["h"]],
                [0, v["h"]]
            ], dtype=np.float32).reshape(-1, 1, 2)
            # 使用仿射变换替代透视变换
            poly_variant = cv2.transform(src_pts_variant, A_variant_to_scene[:2]).reshape(-1, 2)

            if not _polygon_is_valid(poly_variant, scene_h, scene_w):
                continue

            if n_inliers > best_inliers:
                best_inliers = n_inliers
                best = {
                    "A": A_variant_to_scene,
                    "variant": v,
                    "inliers": n_inliers,
                }

        if best is None:
            logger.info(f"[LightGlue] 第 {instance_idx} 轮未找到有效匹配，结束")
            break

        v = best["variant"]
        A_variant_to_scene = best["A"]

        h_orig, w_orig = sub_h, sub_w
        cx = w_orig / 2.0
        cy = h_orig / 2.0
        angle_rad = np.radians(v["angle"])
        cos_a = np.cos(angle_rad)
        sin_a = np.sin(angle_rad)
        canvas_w = int(h_orig * abs(sin_a) + w_orig * abs(cos_a))
        canvas_h = int(h_orig * abs(cos_a) + w_orig * abs(sin_a))

        M_rot = np.array([
            [cos_a, -sin_a, 0],
            [sin_a, cos_a, 0]
        ], dtype=np.float64)
        M_rot[0, 2] = canvas_w / 2.0 - cx * cos_a + cy * sin_a
        M_rot[1, 2] = canvas_h / 2.0 - cx * sin_a - cy * cos_a
        T_variant = np.vstack([M_rot, [0, 0, 1]])

        A_subject_to_scene = A_variant_to_scene @ T_variant

        src_pts_subject = np.array([
            [0, 0],
            [w_orig, 0],
            [w_orig, h_orig],
            [0, h_orig]
        ], dtype=np.float32).reshape(-1, 1, 2)
        # 使用仿射变换替代透视变换
        poly = cv2.transform(src_pts_subject, A_subject_to_scene[:2]).reshape(-1, 2)

        rect = cv2.minAreaRect(poly.astype(np.float32))
        center_raw, size_raw, angle_raw = rect
        if size_raw[0] < size_raw[1]:
            angle = -(90 + angle_raw)
        else:
            angle = -angle_raw
        angle = angle % 360
        if angle > 180:
            angle -= 360

        logger.info(f"[LightGlue] 找到工件 {instance_idx}: 角度={angle:.2f}°, 内点数={best_inliers}")

        sx, sy, sw, sh = subject_bbox_in_template
        M_template_to_subject = np.array([
            [1, 0, -sx],
            [0, 1, -sy],
            [0, 0, 1]
        ], dtype=np.float64)
        A_template_to_scene = A_subject_to_scene @ M_template_to_subject

        # 提取矫正 ROI
        out_w = w_orig + 2 * padding
        out_h = h_orig + 2 * padding

        # ──────────────────────────────────────────────────────────────────────
        # 使用仿射变换求解模板 → roi_image 的变换矩阵
        # 模板工件主体的四角点（像素级精确）
        subject_corners_template = np.array([
            [sx, sy],
            [sx + sw, sy],
            [sx + sw, sy + sh],
            [sx, sy + sh]
        ], dtype=np.float32)

        # 矫正图像上对应工件主体应占据的位置（带 padding）
        dst_corners_roi = np.array([
            [padding, padding],
            [padding + sw, padding],
            [padding + sw, padding + sh],
            [padding, padding + sh]
        ], dtype=np.float32)

        # 使用仿射变换（estimateAffine2D）替代 findHomography
        # method=cv2.RANSAC 是 estimateAffine2D 支持的方法
        A_template_to_roi_direct, _ = cv2.estimateAffine2D(
            subject_corners_template, dst_corners_roi, method=cv2.RANSAC
        )
        if A_template_to_roi_direct is None:
            logger.warning(f"[LightGlue] 无法计算模板到ROI的仿射变换，跳过")
            break
        # 扩展为 3x3 矩阵
        A_template_to_roi_direct = np.vstack([A_template_to_roi_direct, [0, 0, 1]])

        # 计算场景图 → roi_image 的仿射变换（从场景图提取 ROI）
        # 使用三个点计算仿射变换（仿射变换只需要3对点）
        A_scene_to_roi = cv2.getAffineTransform(
            poly.astype(np.float32)[:3], dst_corners_roi[:3]
        )
        # 扩展为 3x3 矩阵
        A_scene_to_roi = np.vstack([A_scene_to_roi, [0, 0, 1]])

        roi = cv2.warpAffine(
            image, A_scene_to_roi[:2], (out_w, out_h),
            flags=cv2.INTER_LINEAR,
            borderMode=cv2.BORDER_CONSTANT,
            borderValue=(255, 255, 255),
        )

        x_min = max(0, int(poly[:, 0].min()) - padding)
        y_min = max(0, int(poly[:, 1].min()) - padding)
        x_max = min(scene_w, int(poly[:, 0].max()) + padding)
        y_max = min(scene_h, int(poly[:, 1].max()) + padding)

        roi_info = {
            "center": (float(center_raw[0]), float(center_raw[1])),
            "width": w_orig,
            "height": h_orig,
            "angle": angle,
            "inliers": best_inliers,
            "poly": poly.tolist(),
            "bbox": (x_min, y_min, x_max - x_min, y_max - y_min),
            "padding": padding,
            "similarity_pct": min(100.0, best_inliers * 2.0),
        }
        # 元组第6项 A_template_to_roi_direct（直接用仿射变换求解的矩阵）
        results.append((roi, roi_info, A_subject_to_scene, A_template_to_scene, A_scene_to_roi, A_template_to_roi_direct))

        # 过滤已匹配区域的关键点，避免重复检测
        feats_scene = filter_scene_features_by_polygon(feats_scene, poly, device, margin=padding)
        n_remaining = feats_scene["keypoints"].shape[1]
        logger.info(f"[LightGlue] 过滤后剩余特征点: {n_remaining}")

        # 同时更新图像掩码（用于可视化）
        hull = cv2.convexHull(poly.astype(np.int32))
        cv2.fillPoly(scene_masked, [hull], color=(0, 0, 0))

    logger.info(f"[LightGlue] 共检测到 {len(results)} 个工件")
    return results


# ─────────────────────────────────────────────────────────────────────────────
# 单工件 ROI 推理
# FIX: 新增 H_scene_to_roi 参数，用正确的透视变换替代错误的简单偏移
# ─────────────────────────────────────────────────────────────────────────────

def _transform_template_pts_to_roi(
    pts: np.ndarray,
    A_template_to_roi_image: np.ndarray,
) -> np.ndarray:
    """
    将模板坐标系的 N×2 点数组，通过仿射变换矩阵映射到 roi_image 坐标系。
    变换链：模板坐标 → (A_template_to_scene) → 场景坐标 → (A_scene_to_roi) → roi_image坐标
    A_template_to_roi_image = A_scene_to_roi @ A_template_to_scene
    使用仿射变换（cv2.transform）替代透视变换，更适合刚体工件
    """
    pts_f = pts.astype(np.float32).reshape(-1, 1, 2)
    # 使用仿射变换（取前2行）
    pts_out = cv2.transform(pts_f, A_template_to_roi_image[:2])
    return pts_out.reshape(-1, 2)


async def process_single_workpiece_roi(
    detector: MultiModelDetector,
    roi_image: np.ndarray,
    roi_info: Dict,
    A_template_to_scene: np.ndarray,
    A_scene_to_roi: np.ndarray,          # 场景→roi_image 的仿射变换
    A_template_to_roi_image: np.ndarray, # 直接计算的模板→roi_image 仿射变换矩阵
    template_annotations: List[Dict],
    template_image: np.ndarray = None,
    request_id: str = "",
    wp_idx: int = 1,
) -> Dict[str, Any]:
    """
    对单个工件的矫正 ROI 图像进行异常检测，并将结果坐标映射回原图。

    关键修复：
    - 原代码用 `pts + padding` 近似将模板坐标映射到 roi_image，
      这在存在旋转、透视变形或 subject 不在模板左上角时会产生严重偏移。
    - 正确做法：使用直接计算的 A_template_to_roi_image，避免中间累积误差。
    - 使用仿射变换替代透视变换，更适合刚体工件。
    """
    padding = roi_info.get("padding", 20)

    # 同步清理该 workpiece 的 temp 目录（仅一次，在异步保存之前）
    if SAVE_ROI_TO_TEMP:
        workpiece_temp_dir = OUTPUT_BASE_DIR / "temp" / str(wp_idx)
        if workpiece_temp_dir.exists():
            import shutil
            shutil.rmtree(workpiece_temp_dir)
            logger.info(f"[ROI_TEMP] Cleaned temp directory: {workpiece_temp_dir}")

    def _transform_bbox_to_roi(bbox: List[float]) -> Tuple[int, int, int, int]:
        """将模板 bbox 的四角点仿射变换到 roi_image，返回轴对齐外接矩形 (x,y,w,h)。"""
        x, y, w, h = bbox
        corners = np.array([[x, y], [x + w, y], [x + w, y + h], [x, y + h]], dtype=np.float32)
        corners_roi = _transform_template_pts_to_roi(corners, A_template_to_roi_image)
        x_min, y_min = corners_roi.min(axis=0)
        x_max, y_max = corners_roi.max(axis=0)
        return int(x_min), int(y_min), int(x_max - x_min), int(y_max - y_min)

    def _transform_segmentation_to_roi(segmentation: List[List[float]]) -> List[List[float]]:
        """将模板 segmentation 多边形点仿射变换到 roi_image 坐标系。"""
        seg_roi = []
        for seg in segmentation:
            pts = np.array(seg).reshape(-1, 2).astype(np.float32)
            pts_roi = _transform_template_pts_to_roi(pts, A_template_to_roi_image)
            seg_roi.append(pts_roi.flatten().tolist())
        return seg_roi

    # ──────────────────────────────────────────────────────────────────────────
    # 准备该工件的所有 ROI 列表
    # ──────────────────────────────────────────────────────────────────────────
    rois_for_inference = []
    anns_for_inference = []
    categories = []

    loaded_categories = detector.get_loaded_categories()
    logger.info(f"[process_single_workpiece_roi] TRAIN_MODE: {TRAIN_MODE}, loaded_categories: {loaded_categories}")

    for ann in template_annotations:
        if TRAIN_MODE == "by_category":
            # by_category 模式：直接使用 category_id 匹配模型目录名
            category = ann.get("category_id")
        else:
            # by_pos_id 模式：用 pos_id 匹配模型目录名
            category = ann.get("pos_id")

        # 转换为字符串进行比较
        category_str = str(category) if category is not None else ""
        loaded_categories_str = [str(c) for c in loaded_categories]

        if not category_str or category_str not in loaded_categories_str:
            logger.warning(f"[process_single_workpiece_roi] 跳过 annotation: category_id={ann.get('category_id')}, pos_id={ann.get('pos_id')}, loaded_categories={loaded_categories_str}")
            continue

        segmentation = ann.get("segmentation", [])
        bbox = ann.get("bbox", [0, 0, 0, 0])

        roi_sub = None
        roi_sub_raw = None  # 原始ROI，用于保存到temp目录（不做letterbox）

        # FIX: 用透视变换后的 segmentation 提取 ROI（替换原来的 pts + padding）
        if segmentation and len(segmentation) > 0:
            seg_roi_transformed = _transform_segmentation_to_roi(segmentation)
            # 先提取原始ROI用于保存
            roi_sub_raw = _extract_roi_from_segmentation(roi_image, seg_roi_transformed, target_size=None)
            # 再提取letterbox后的ROI用于推理
            roi_sub = _extract_roi_from_segmentation(roi_image, seg_roi_transformed)

        # FIX: fallback 用透视变换后的 bbox 提取 ROI（替换原来的 x += padding）
        if roi_sub is None or roi_sub.size == 0:
            if bbox and len(bbox) >= 4:
                rx, ry, rw, rh = _transform_bbox_to_roi(bbox)
                rx = max(0, min(rx, roi_image.shape[1] - 1))
                ry = max(0, min(ry, roi_image.shape[0] - 1))
                rw = min(rw, roi_image.shape[1] - rx)
                rh = min(rh, roi_image.shape[0] - ry)
                if rw > 0 and rh > 0:
                    roi_sub_raw = roi_image[ry:ry + rh, rx:rx + rw]
                    roi_sub = roi_sub_raw
            else:
                continue

        if roi_sub is not None and roi_sub.size > 0:
            rois_for_inference.append(roi_sub)
            anns_for_inference.append(ann)
            categories.append(category_str)  # 使用字符串版本

            # 异步保存ROI到临时目录（跳过工件主体）- 使用原始ROI，不做letterbox
            category_name = ann.get("category_name", ann.get("label", ""))
            if SAVE_ROI_TO_TEMP and category_name != "工件主体":
                pos_id_str = str(ann.get("pos_id", category_str))
                asyncio.create_task(async_save_roi(
                    roi_sub_raw if roi_sub_raw is not None else roi_sub,
                    pos_id_str, category_name, wp_idx
                ))

    if not rois_for_inference:
        return {
            "workpiece_id": wp_idx,
            "bbox": list(roi_info.get("bbox", (0, 0, 0, 0))),
            "results": [],
            "anomaly_count": 0,
            "strategy": "lightglue",
            "roi_info": roi_info,
        }

    # 按类别分组推理
    results_by_ann = {}
    for cat in set(categories):
        indices = [i for i, c in enumerate(categories) if c == cat]
        cat_rois = [rois_for_inference[i] for i in indices]
        cat_anns = [anns_for_inference[i] for i in indices]
        det_results = await detector.detect_category(cat_rois, cat, f"{request_id}_wp{wp_idx}", annotations=cat_anns)

        for idx, det_res in zip(indices, det_results):
            ann = anns_for_inference[idx]
            results_by_ann[id(ann)] = det_res

    # 构建最终结果，并将坐标映射回原图
    final_results = []
    for ann in template_annotations:
        det_res = results_by_ann.get(id(ann), {
            "is_anomaly": False,
            "anomaly_score": 0.0,
            "error": 0.0,
            "threshold": 0.0,
            "infer_failed": True,
        })

        bbox = ann.get("bbox", [0, 0, 0, 0])
        segm = ann.get("segmentation", [])

        # 转换 bbox 到原图（场景坐标系）
        bbox_in_pred = [0.0, 0.0, 0.0, 0.0]
        if bbox and len(bbox) >= 4:
            x, y, w, h = bbox
            corners = np.array([[x, y], [x+w, y], [x+w, y+h], [x, y+h]], dtype=np.float32).reshape(-1, 1, 2)
            # 使用仿射变换替代透视变换
            tc = cv2.transform(corners, A_template_to_scene[:2]).reshape(-1, 2)
            bbox_in_pred = [
                float(np.min(tc[:, 0])), float(np.min(tc[:, 1])),
                float(np.max(tc[:, 0]) - np.min(tc[:, 0])),
                float(np.max(tc[:, 1]) - np.min(tc[:, 1]))
            ]

        # 转换 bbox 四角点到原图（用于绘制旋转多边形）
        poly_in_pred = []
        if bbox and len(bbox) >= 4:
            x, y, w, h = bbox
            corners = np.array([[x, y], [x+w, y], [x+w, y+h], [x, y+h]], dtype=np.float32)
            # 使用仿射变换替代透视变换
            tc = cv2.transform(corners.reshape(1, -1, 2), A_template_to_scene[:2]).reshape(-1, 2)
            poly_in_pred = tc.flatten().tolist()

        # 转换 segmentation 到原图
        segm_in_pred = []
        if segm and len(segm) > 0 and len(segm[0]) >= 8:
            pts = np.array([[segm[0][i], segm[0][i+1]] for i in range(0, len(segm[0]), 2)],
                           dtype=np.float32).reshape(-1, 1, 2)
            # 使用仿射变换替代透视变换
            tp = cv2.transform(pts, A_template_to_scene[:2]).reshape(-1, 2)
            segm_in_pred = [float(v) for v in tp.flatten()]
            poly_in_pred = segm_in_pred

        # 构建结果
        result_item = {
            "category": ann.get("category_name", ann.get("category", "unknown")),
            "pos_id": ann.get("pos_id"),
            "bbox": bbox,
            "bbox_in_pred": bbox_in_pred,
            "poly_in_pred": poly_in_pred,
            "segmentation": segm,
            "segmentation_in_pred": segm_in_pred,
            "is_anomaly": det_res.get("is_anomaly", False),
            "anomaly_score": det_res.get("anomaly_score", 0.0),
            "error": det_res.get("error", 0.0),
            "threshold": det_res.get("threshold", 0.0),
            "infer_failed": det_res.get("infer_failed", False),
            "anomaly_type": "real_defect" if det_res.get("is_anomaly", False) else "normal",
        }

        final_results.append(result_item)

    anomaly_count = sum(1 for r in final_results if r.get("is_anomaly", False))

    template_rois = []
    if template_image is not None:
        for ann in template_annotations:
            bbox = ann.get("bbox", [0, 0, 0, 0])
            segmentation = ann.get("segmentation", [])
            t_roi = None
            if segmentation and len(segmentation) > 0:
                t_roi = _extract_roi_from_segmentation(template_image, segmentation)
            if t_roi is None or t_roi.size == 0:
                if bbox and len(bbox) >= 4:
                    t_roi = _extract_roi_from_bbox(template_image, bbox)
            if t_roi is not None and t_roi.size > 0:
                template_rois.append(t_roi)
            else:
                template_rois.append(None)

    return {
        "workpiece_id": wp_idx,
        "bbox": list(roi_info.get("bbox", (0, 0, 0, 0))),
        "results": final_results,
        "anomaly_count": anomaly_count,
        "strategy": "lightglue",
        "roi_info": roi_info,
        "template_rois": template_rois,
        "aligned_roi": roi_image,
        "A_template_to_roi_image": A_template_to_roi_image.tolist(),
    }


# ─────────────────────────────────────────────────────────────────────────────
# 多工件检测主流程
# FIX: 解包新增的 H_scene_to_roi 并传给 process_single_workpiece_roi
# ─────────────────────────────────────────────────────────────────────────────

async def detect_multiple_workpieces(
    detector: MultiModelDetector,
    image: np.ndarray,
    template_image: np.ndarray,
    annotations: List[Dict],
    request_id: str = "",
    monitor: Optional[PerformanceMonitor] = None,
    return_visualization: bool = False,
    lightglue_rotations: List[float] = None,
    lightglue_min_matches: int = 4,
    lightglue_max_instances: int = 20,
    lightglue_padding: int = 20,
) -> Dict[str, Any]:
    if template_image is None or not annotations:
        return {"workpiece_results": [], "visualization": None, "total_workpieces": 0, "total_anomalies": 0}

    local_monitor = monitor if monitor else PerformanceMonitor(request_id or "internal")

    # 1. 提取工件主体区域及变换
    subject_img, M_template_to_subject, subject_bbox = extract_subject_region_from_annotations(
        template_image, annotations, subject_label="工件主体"
    )
    if subject_img is None:
        logger.error(f"[{request_id}] 未找到工件主体标注，无法进行多工件检测")
        return {"workpiece_results": [], "visualization": None, "total_workpieces": 0, "total_anomalies": 0}

    # 2. LightGlue 检测所有工件
    local_monitor.start_step("lightglue_detect")
    detections = detect_workpieces_with_lightglue(
        image=image,
        template_subject_bgr=subject_img,
        subject_bbox_in_template=subject_bbox,
        rotations=lightglue_rotations,
        min_matches=lightglue_min_matches,
        max_instances=lightglue_max_instances,
        padding=lightglue_padding,
    )
    local_monitor.end_step("lightglue_detect")

    if not detections:
        logger.warning(f"[{request_id}] LightGlue未检测到工件，返回空结果")
        return {
            "workpiece_results": [],
            "visualization": None,
            "total_workpieces": 0,
            "total_anomalies": 0,
        }

    # 3. 对每个工件并行执行异常检测
    local_monitor.start_step("per_workpiece_inference")
    num_wp = len(detections)
    logger.info(f"[{request_id}] 并行处理 {num_wp} 个工件")
    t_parallel = time.time()

    # 使用 asyncio.gather 并行处理所有工件
    tasks = []
    for i, (roi, info, _, A_template, A_scene_to_roi, A_template_to_roi_image) in enumerate(detections):
        task = process_single_workpiece_roi(
            detector,
            roi,
            info,
            A_template,       # A_template_to_scene
            A_scene_to_roi,   # 场景→roi_image 仿射变换
            A_template_to_roi_image,  # 直接计算的模板→roi_image 仿射变换矩阵
            annotations,
            template_image,
            f"{request_id}_wp{i+1}",
            i + 1
        )
        tasks.append(task)

    # 并行执行所有任务
    wp_results_list = await asyncio.gather(*tasks, return_exceptions=True)

    # 处理结果
    wp_results: List[Dict] = []
    for i, result in enumerate(wp_results_list):
        if isinstance(result, Exception):
            logger.error(f"[{request_id}] 工件 {i+1} 推理异常: {result}")
            _, info, _, _, _, _ = detections[i]
            wp_results.append({
                "workpiece_id": i + 1,
                "bbox": list(info.get("bbox", (0, 0, 0, 0))),
                "results": [],
                "anomaly_count": 0,
                "strategy": "lightglue",
                "roi_info": info,
                "error": str(result),
            })
        else:
            wp_results.append(result)

    logger.info(f"[{request_id}] 并行处理完成，总耗时 {time.time()-t_parallel:.3f}s")
    local_monitor.end_step("per_workpiece_inference")

    wp_results = [r for r in wp_results if r is not None]
    wp_results.sort(key=lambda x: x["workpiece_id"])
    total_anomalies = sum(wp.get("anomaly_count", 0) for wp in wp_results)

    visualization = None
    if return_visualization:
        visualization = create_multi_workpiece_visualization_with_roi(
            image, template_image, wp_results, request_id
        )

    return {
        "workpiece_results": wp_results,
        "visualization": visualization,
        "total_workpieces": len(wp_results),
        "total_anomalies": total_anomalies,
    }


def create_multi_workpiece_visualization_with_roi(
    original_image: np.ndarray,
    template_image: np.ndarray,
    workpiece_results: List[Dict],
    request_id: str = "",
) -> np.ndarray:
    COLOR_NORMAL = (0, 255, 0)
    COLOR_ANOMALY = (0, 0, 255)
    COLOR_WORKPIECE = (255, 128, 0)
    COLOR_TEXT = (255, 255, 255)
    COLOR_NORMAL_ROI = (0, 255, 255)
    COLOR_BG = (40, 40, 40)
    COLOR_TEMPLATE = (255, 128, 0)

    viz_overview = original_image.copy()

    for wp_result in workpiece_results:
        wp_id = wp_result.get("workpiece_id", 0)
        anomaly_count = wp_result.get("anomaly_count", 0)
        roi_info = wp_result.get("roi_info", {})

        center = roi_info.get("center")
        angle = roi_info.get("angle", 0)
        similarity_pct = roi_info.get("similarity_pct", 0)

        wp_color = COLOR_ANOMALY if anomaly_count > 0 else COLOR_NORMAL

        poly = roi_info.get("poly")
        if poly:
            pts = np.array(poly, dtype=np.int32).reshape(-1, 1, 2)
            cv2.polylines(viz_overview, [pts], True, wp_color, 10)
            if center is not None:
                cx, cy = center
                # 工件状态标签
                label = f"WP{wp_id}: {'NG' if anomaly_count > 0 else 'OK'} ({similarity_pct:.0f}%)"
                viz_overview = cv2_put_chinese_text(viz_overview, label, (int(cx) - 60, max(int(cy) - 100, 0)), wp_color, 56)
                # 旋转角度标签
                angle_label = f"{angle:.1f}°"
                viz_overview = cv2_put_chinese_text(viz_overview, angle_label, (int(cx) - 30, max(int(cy) - 60, 0)), wp_color, 48)
        else:
            bbox = wp_result.get("bbox", (0, 0, 0, 0))
            wx, wy, ww, wh = [int(v) for v in bbox]
            cv2.rectangle(viz_overview, (wx, wy), (wx + ww, wy + wh), wp_color, 10)
            # 工件状态标签
            label = f"WP{wp_id}: {'NG' if anomaly_count > 0 else 'OK'}"
            viz_overview = cv2_put_chinese_text(viz_overview, label, (wx, max(wy - 70, 0)), wp_color, 56)
            # 旋转角度标签
            angle_label = f"{angle:.1f}°"
            viz_overview = cv2_put_chinese_text(viz_overview, angle_label, (wx, max(wy - 35, 0)), wp_color, 48)

        for idx, roi_result in enumerate(wp_result.get("results", [])):
            is_anomaly = roi_result.get("is_anomaly", False)
            roi_color = COLOR_ANOMALY if is_anomaly else COLOR_NORMAL_ROI

            segm = roi_result.get("segmentation_in_pred", [])
            bbox = roi_result.get("bbox_in_pred", [0, 0, 0, 0])
            category = roi_result.get("category", f"ROI{idx+1}")

            roi_drawn = False

            if segm and len(segm) >= 8:
                try:
                    pts = np.array([[segm[i], segm[i+1]] for i in range(0, len(segm), 2)],
                                   dtype=np.int32).reshape(-1, 1, 2)
                    cv2.polylines(viz_overview, [pts], True, roi_color, 10)
                    if len(pts) > 0:
                        label_pos = (int(pts[0][0][0]), max(int(pts[0][0][1]) - 5, 0))
                        viz_overview = cv2_put_chinese_text(viz_overview, category, label_pos, roi_color, 48)
                    roi_drawn = True
                except Exception:
                    pass

            if not roi_drawn and bbox and len(bbox) >= 4:
                try:
                    bx, by, bw, bh = [int(v) for v in bbox]
                    h, w = viz_overview.shape[:2]
                    bx = max(0, min(bx, w-1))
                    by = max(0, min(by, h-1))
                    bw = min(bw, w-bx)
                    bh = min(bh, h-by)

                    if bw > 0 and bh > 0:
                        cv2.rectangle(viz_overview, (bx, by), (bx + bw, by + bh), roi_color, 10)
                        viz_overview = cv2_put_chinese_text(viz_overview, category, (bx, max(by - 5, 0)), roi_color, 14)
                        roi_drawn = True
                except Exception:
                    pass

            if is_anomaly and roi_drawn and bbox and len(bbox) >= 4:
                score = roi_result.get("anomaly_score", 0)
                bx, by, bw, bh = [int(v) for v in bbox]
                viz_overview = cv2_put_chinese_text(viz_overview, f"{score:.2f}", (bx, by + bh + 15), COLOR_ANOMALY, 12)

    total_wp = len(workpiece_results)
    total_ng = sum(wp.get("anomaly_count", 0) > 0 for wp in workpiece_results)
    total_rois = sum(len(wp.get("results", [])) for wp in workpiece_results)
    summary = f"工件: {total_wp} (NG:{total_ng} OK:{total_wp-total_ng}) | ROI: {total_rois}"
    viz_overview = cv2_put_chinese_text(viz_overview, summary, (10, 30), COLOR_TEXT, 24)

    legend_y = 60
    viz_overview = cv2_put_chinese_text(viz_overview, "图例: 正常ROI", (10, legend_y), COLOR_NORMAL_ROI, 16)
    viz_overview = cv2_put_chinese_text(viz_overview, "异常ROI", (150, legend_y), COLOR_ANOMALY, 16)
    viz_overview = cv2_put_chinese_text(viz_overview, "正常工件", (250, legend_y), COLOR_NORMAL, 16)
    viz_overview = cv2_put_chinese_text(viz_overview, "异常工件", (360, legend_y), COLOR_ANOMALY, 16)

    if not workpiece_results:
        return viz_overview

    DETAIL_WIDTH = 1050

    all_sections = []

    for wp_idx, wp_result in enumerate(workpiece_results):
        wp_id = wp_result.get("workpiece_id", wp_idx + 1)
        bbox = wp_result.get("bbox", (0, 0, 0, 0))
        wx, wy, ww, wh = [int(v) for v in bbox]
        anomaly_count = wp_result.get("anomaly_count", 0)
        strategy = wp_result.get("strategy", "lightglue")
        results = wp_result.get("results", [])
        aligned_pred = wp_result.get("aligned_roi")

        workpiece_image = original_image[wy:wy+wh, wx:wx+ww].copy() if wy+wh <= original_image.shape[0] and wx+ww <= original_image.shape[1] else np.zeros((wh, ww, 3), dtype=np.uint8)

        wp_color = COLOR_ANOMALY if anomaly_count > 0 else COLOR_NORMAL
        wp_header = np.full((50, DETAIL_WIDTH, 3), (60, 60, 60), dtype=np.uint8)
        wp_title = f"工件 {wp_id} | 策略: {strategy} | ROI数: {len(results)} | 异常: {anomaly_count} | 正常: {len(results)-anomaly_count}"
        wp_header = cv2_put_chinese_text(wp_header, wp_title, (20, 32), wp_color, 22)

        DISPLAY_SIZE = (350, 350)

        def _resize(img, size=DISPLAY_SIZE):
            if img is None or img.size == 0:
                return np.zeros((size[1], size[0], 3), dtype=np.uint8)
            return cv2.resize(img, size)

        col1 = np.full((DISPLAY_SIZE[1] + 50, DISPLAY_SIZE[0], 3), COLOR_BG, dtype=np.uint8)
        if template_image is not None:
            tmpl_viz = _resize(template_image).copy()
            sx = DISPLAY_SIZE[0] / template_image.shape[1]
            sy = DISPLAY_SIZE[1] / template_image.shape[0]

            for i, ann in enumerate(TEMPLATE_ANNOTATIONS):
                segmentation = ann.get("segmentation", [])
                if segmentation:
                    for seg in segmentation:
                        pts = np.array(seg).reshape(-1, 2).astype(np.float32)
                        pts[:, 0] *= sx
                        pts[:, 1] *= sy
                        cv2.polylines(tmpl_viz, [pts.astype(np.int32)], True, COLOR_TEMPLATE, 2)
                else:
                    x, y, w, h = ann.get("bbox", [0, 0, 0, 0])
                    cv2.rectangle(tmpl_viz, (int(x*sx), int(y*sy)), (int((x+w)*sx), int((y+h)*sy)), COLOR_TEMPLATE, 2)

            col1[50:] = tmpl_viz
        col1 = cv2_put_chinese_text(col1, "1. 模板图像 + 标注", (10, 30), COLOR_TEXT, 18)

        col2 = np.full((DISPLAY_SIZE[1] + 50, DISPLAY_SIZE[0], 3), COLOR_BG, dtype=np.uint8)
        if aligned_pred is not None and aligned_pred.size > 0:
            aligned_viz = _resize(aligned_pred).copy()
            sx_a = DISPLAY_SIZE[0] / aligned_pred.shape[1]
            sy_a = DISPLAY_SIZE[1] / aligned_pred.shape[0]

            A_template_to_roi = wp_result.get("A_template_to_roi_image")
            if A_template_to_roi is not None:
                A_template_to_roi = np.array(A_template_to_roi, dtype=np.float32)

            for idx, res in enumerate(results):
                is_anomaly = res.get("is_anomaly", False)
                color = COLOR_ANOMALY if is_anomaly else COLOR_NORMAL

                if idx < len(TEMPLATE_ANNOTATIONS):
                    ann = TEMPLATE_ANNOTATIONS[idx]
                    segmentation = ann.get("segmentation", [])
                    if segmentation and A_template_to_roi is not None:
                        for seg in segmentation:
                            pts = np.array(seg).reshape(-1, 2).astype(np.float32).reshape(-1, 1, 2)
                            # 使用仿射变换替代透视变换
                            pts_roi = cv2.transform(pts, A_template_to_roi[:2]).reshape(-1, 2)
                            pts_roi[:, 0] *= sx_a
                            pts_roi[:, 1] *= sy_a
                            cv2.polylines(aligned_viz, [pts_roi.astype(np.int32)], True, color, 2)
                    elif A_template_to_roi is not None:
                        x, y, w, h = ann.get("bbox", [0, 0, 0, 0])
                        corners = np.array([[x, y], [x+w, y], [x+w, y+h], [x, y+h]], dtype=np.float32).reshape(-1, 1, 2)
                        # 使用仿射变换替代透视变换
                        corners_roi = cv2.transform(corners, A_template_to_roi[:2]).reshape(-1, 2)
                        corners_roi[:, 0] *= sx_a
                        corners_roi[:, 1] *= sy_a
                        cv2.polylines(aligned_viz, [corners_roi.astype(np.int32)], True, color, 2)

            col2[50:] = aligned_viz
        col2 = cv2_put_chinese_text(col2, "2. 对齐后预测图 + 结果", (10, 30), COLOR_TEXT, 18)

        col3 = np.full((DISPLAY_SIZE[1] + 50, DISPLAY_SIZE[0], 3), COLOR_BG, dtype=np.uint8)
        if workpiece_image.size > 0:
            orig_viz = _resize(workpiece_image).copy()
            sx_o = DISPLAY_SIZE[0] / workpiece_image.shape[1] if workpiece_image.shape[1] > 0 else 1
            sy_o = DISPLAY_SIZE[1] / workpiece_image.shape[0] if workpiece_image.shape[0] > 0 else 1

            for idx, res in enumerate(results):
                is_anomaly = res.get("is_anomaly", False)
                color = COLOR_ANOMALY if is_anomaly else COLOR_NORMAL_ROI
                category = res.get("category", f"ROI{idx+1}")

                segm = res.get("segmentation_in_pred", [])
                bbox_pred = res.get("bbox_in_pred", [0, 0, 0, 0])

                if segm and len(segm) >= 8:
                    try:
                        pts = np.array([[segm[i] - wx, segm[i+1] - wy] for i in range(0, len(segm), 2)],
                                       dtype=np.float32)
                        pts[:, 0] *= sx_o
                        pts[:, 1] *= sy_o
                        cv2.polylines(orig_viz, [pts.astype(np.int32)], True, color, 2)
                    except Exception:
                        pass
                elif bbox_pred and len(bbox_pred) >= 4:
                    try:
                        bx, by, bw, bh = bbox_pred
                        bx_rel = (bx - wx) * sx_o
                        by_rel = (by - wy) * sy_o
                        bw_rel = bw * sx_o
                        bh_rel = bh * sy_o
                        cv2.rectangle(orig_viz, (int(bx_rel), int(by_rel)),
                                     (int(bx_rel + bw_rel), int(by_rel + bh_rel)), color, 2)
                    except Exception:
                        pass

            col3[50:] = orig_viz
        col3 = cv2_put_chinese_text(col3, "3. 原始工件图", (10, 30), COLOR_TEXT, 18)

        row1 = np.hstack([col1, col2, col3])

        ROI_SIZE = (140, 140)
        rois_per_row = 3
        n_results = len(results)
        n_rows = max(1, (n_results + rois_per_row - 1) // rois_per_row)
        compare_width = ROI_SIZE[0] * 2 + 20
        roi_row_height = ROI_SIZE[1] + 80
        row2_width = row1.shape[1]
        row2 = np.full((roi_row_height * n_rows + 60, row2_width, 3), COLOR_BG, dtype=np.uint8)
        row2 = cv2_put_chinese_text(row2, "4. ROI 对比详情 (模板 | 对齐后预测)", (20, 30), COLOR_TEXT, 20)

        def _extract_roi_viz(img, ann, offset_x=0, offset_y=0):
            """提取ROI用于可视化"""
            if img is None or img.size == 0:
                return np.zeros((ROI_SIZE[1], ROI_SIZE[0], 3), dtype=np.uint8)

            canvas = np.zeros((ROI_SIZE[1], ROI_SIZE[0], 3), dtype=np.uint8)
            segmentation = ann.get('segmentation', [])

            if segmentation and len(segmentation) > 0:
                all_pts = []
                for seg in segmentation:
                    pts = np.array(seg).reshape(-1, 2).astype(np.int32)
                    pts[:, 0] -= offset_x
                    pts[:, 1] -= offset_y
                    all_pts.append(pts)

                if all_pts:
                    all_points = np.vstack(all_pts)
                    x_min, y_min = np.min(all_points, axis=0)
                    x_max, y_max = np.max(all_points, axis=0)
                    # 无padding
                    x_min = max(0, x_min)
                    y_min = max(0, y_min)
                    x_max = min(img.shape[1], x_max)
                    y_max = min(img.shape[0], y_max)

                    if x_max > x_min and y_max > y_min:
                        roi = img[y_min:y_max, x_min:x_max].copy()
                        if roi.size > 0:
                            mask = np.zeros((y_max - y_min, x_max - x_min), dtype=np.uint8)
                            for pts in all_pts:
                                cv2.fillPoly(mask, [pts - [x_min, y_min]], 255)
                            roi = cv2.bitwise_and(roi, roi, mask=mask)
                            sc = min(ROI_SIZE[0] / roi.shape[1], ROI_SIZE[1] / roi.shape[0])
                            nw, nh = int(roi.shape[1] * sc), int(roi.shape[0] * sc)
                            if nw > 0 and nh > 0:
                                canvas[:nh, :nw] = cv2.resize(roi, (nw, nh))
                return canvas

            rx, ry, rw, rh = [max(0, int(v)) for v in ann.get('bbox', [0, 0, 0, 0])]
            rx -= offset_x
            ry -= offset_y
            if rw > 0 and rh > 0:
                rx = max(0, min(rx, img.shape[1] - 1))
                ry = max(0, min(ry, img.shape[0] - 1))
                rw = min(rw, img.shape[1] - rx)
                rh = min(rh, img.shape[0] - ry)
                if rw > 0 and rh > 0:
                    roi = img[ry:ry+rh, rx:rx+rw]
                    sc = min(ROI_SIZE[0] / roi.shape[1], ROI_SIZE[1] / roi.shape[0])
                    nw, nh = int(roi.shape[1] * sc), int(roi.shape[0] * sc)
                    if nw > 0 and nh > 0:
                        canvas[:nh, :nw] = cv2.resize(roi, (nw, nh))
            return canvas

        def _extract_aligned_roi_viz(img, ann, A_template_to_roi):
            """从对齐后的预测图中提取 ROI"""
            if img is None or img.size == 0 or A_template_to_roi is None:
                return np.zeros((ROI_SIZE[1], ROI_SIZE[0], 3), dtype=np.uint8)

            canvas = np.zeros((ROI_SIZE[1], ROI_SIZE[0], 3), dtype=np.uint8)
            segmentation = ann.get('segmentation', [])

            # 优先使用segmentation
            if segmentation and len(segmentation) > 0:
                all_pts = []
                for seg in segmentation:
                    pts = np.array(seg).reshape(-1, 2).astype(np.float32).reshape(-1, 1, 2)
                    # 使用仿射变换替代透视变换
                    pts_roi = cv2.transform(pts, A_template_to_roi[:2]).reshape(-1, 2)
                    all_pts.append(pts_roi)

                if all_pts:
                    all_points = np.vstack(all_pts)
                    x_min, y_min = np.min(all_points, axis=0)
                    x_max, y_max = np.max(all_points, axis=0)
                    # 无padding
                    x_min = max(0, int(x_min))
                    y_min = max(0, int(y_min))
                    x_max = min(img.shape[1], int(x_max))
                    y_max = min(img.shape[0], int(y_max))

                    if x_max > x_min and y_max > y_min:
                        roi = img[y_min:y_max, x_min:x_max].copy()
                        if roi.size > 0:
                            mask = np.zeros((y_max - y_min, x_max - x_min), dtype=np.uint8)
                            for pts in all_pts:
                                pts_shifted = pts - [x_min, y_min]
                                cv2.fillPoly(mask, [pts_shifted.astype(np.int32)], 255)
                            roi = cv2.bitwise_and(roi, roi, mask=mask)
                            sc = min(ROI_SIZE[0] / roi.shape[1], ROI_SIZE[1] / roi.shape[0])
                            nw, nh = int(roi.shape[1] * sc), int(roi.shape[0] * sc)
                            if nw > 0 and nh > 0:
                                canvas[:nh, :nw] = cv2.resize(roi, (nw, nh))
                return canvas

            # 使用 bbox
            x, y, w, h = ann.get('bbox', [0, 0, 0, 0])
            corners = np.array([[x, y], [x+w, y], [x+w, y+h], [x, y+h]], dtype=np.float32).reshape(-1, 1, 2)
            # 使用仿射变换替代透视变换
            corners_roi = cv2.transform(corners, A_template_to_roi[:2]).reshape(-1, 2)
            x_min, y_min = np.min(corners_roi, axis=0)
            x_max, y_max = np.max(corners_roi, axis=0)
            # 无padding
            x_min = max(0, int(x_min))
            y_min = max(0, int(y_min))
            x_max = min(img.shape[1], int(x_max))
            y_max = min(img.shape[0], int(y_max))

            if x_max > x_min and y_max > y_min:
                roi = img[y_min:y_max, x_min:x_max]
                sc = min(ROI_SIZE[0] / roi.shape[1], ROI_SIZE[1] / roi.shape[0])
                nw, nh = int(roi.shape[1] * sc), int(roi.shape[0] * sc)
                if nw > 0 and nh > 0:
                    canvas[:nh, :nw] = cv2.resize(roi, (nw, nh))
            return canvas

        for idx, (res, ann) in enumerate(zip(results, TEMPLATE_ANNOTATIONS[:len(results)])):
            row_i = idx // rois_per_row
            col_i = idx % rois_per_row
            x_off = 20 + col_i * (compare_width + 30)
            y_off = 60 + row_i * roi_row_height

            t_roi = _extract_roi_viz(template_image, ann)
            p_roi = _extract_aligned_roi_viz(aligned_pred, ann, A_template_to_roi) if aligned_pred is not None else np.zeros_like(t_roi)

            max_h = max(t_roi.shape[0], p_roi.shape[0])
            canvas = np.full((max_h, compare_width, 3), COLOR_BG, dtype=np.uint8)
            canvas[:t_roi.shape[0], :ROI_SIZE[0]] = t_roi
            canvas[:p_roi.shape[0], ROI_SIZE[0]+10:ROI_SIZE[0]+10+p_roi.shape[1]] = p_roi
            cv2.line(canvas, (ROI_SIZE[0]+5, 0), (ROI_SIZE[0]+5, max_h), (128, 128, 128), 1)

            color = COLOR_ANOMALY if res.get('is_anomaly', False) else COLOR_NORMAL
            bordered = cv2.copyMakeBorder(canvas, 3, 3, 3, 3, cv2.BORDER_CONSTANT, value=color)
            rh2, rw2 = bordered.shape[:2]

            if y_off + rh2 <= row2.shape[0] and x_off + rw2 <= row2.shape[1]:
                row2[y_off:y_off+rh2, x_off:x_off+rw2] = bordered

            category = res.get('category', f'ROI{idx+1}')
            score = res.get('anomaly_score', 0)
            text_y = y_off + rh2 + 5
            row2 = cv2_put_chinese_text(row2, f"#{idx+1} {category}", (x_off, text_y), color, 12)
            text_y += 18
            row2 = cv2_put_chinese_text(row2, "异常" if res.get('is_anomaly') else "正常", (x_off, text_y), color, 12)
            text_y += 18
            row2 = cv2_put_chinese_text(row2, f"Score: {score:.3f}", (x_off, text_y), (180, 180, 180), 10)

        wp_section = np.vstack([wp_header, row1, row2])
        all_sections.append(wp_section)

    overview_height = int(viz_overview.shape[0] * DETAIL_WIDTH / viz_overview.shape[1])
    overview_height = min(600, max(300, overview_height))
    viz_overview_resized = cv2.resize(viz_overview, (DETAIL_WIDTH, overview_height))

    overview_header = np.full((50, DETAIL_WIDTH, 3), (30, 30, 30), dtype=np.uint8)
    overview_header = cv2_put_chinese_text(overview_header, "=== 总览图 ===", (20, 32), COLOR_TEXT, 24)
    viz_overview_final = np.vstack([overview_header, viz_overview_resized])

    separator = np.full((20, DETAIL_WIDTH, 3), (100, 100, 100), dtype=np.uint8)

    all_sections.insert(0, viz_overview_final)

    max_width = max(section.shape[1] for section in all_sections)
    padded_sections = []
    for section in all_sections:
        if section.shape[1] < max_width:
            pad = np.full((section.shape[0], max_width - section.shape[1], 3), COLOR_BG, dtype=np.uint8)
            section = np.hstack([section, pad])
        padded_sections.append(section)
        padded_sections.append(separator[:, :max_width])

    if padded_sections:
        padded_sections.pop()

    final_viz = np.vstack(padded_sections) if padded_sections else viz_overview

    return final_viz


