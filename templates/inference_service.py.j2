def _safe_empty_cache():
    """安全地清空 GPU 缓存，兼容不同 Paddle 版本"""
    try:
        paddle.device.cuda.empty_cache()
    except Exception:
        try:
            paddle.fluid.core._cuda_empty_cache()
        except Exception:
            pass


def _cleanup(label: str = ""):
    """
    显存 + Python GC 统一清理入口。

    修复：移除 paddle.device.cuda.synchronize()。
    原因：synchronize() 在 CUDA context 已损坏时会永久挂起，
          导致 executor 线程卡死 → asyncio timeout → shutdown(wait=False)
          → 旧线程仍在跑 → CUDA context 再次损坏，形成死循环最终崩溃。
    paddle 的 .numpy() 调用已隐式完成 GPU→CPU 同步，此处无需额外 synchronize。
    """
    gc.collect()
    _safe_empty_cache()
    if label:
        logger.debug(f"[cleanup] {label}")


def _get_gpu_memory_info() -> Dict[str, Any]:
    """获取 GPU 显存信息，用于健康检查和监控"""
    try:
        allocated = paddle.device.cuda.memory_allocated(0)
        reserved  = paddle.device.cuda.memory_reserved(0)
        return {
            "allocated_mb": round(allocated / 1024 ** 2, 1),
            "reserved_mb":  round(reserved  / 1024 ** 2, 1),
        }
    except Exception:
        return {}


def _preprocess_roi(roi: np.ndarray) -> np.ndarray:
    """
    将单个 ROI 预处理为 CHW float32 numpy 数组（ImageNet 归一化）
    返回 shape: (3, 224, 224)
    """
    img = roi.copy()
    if len(img.shape) == 2:
        img = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)
    elif img.shape[2] == 4:
        img = cv2.cvtColor(img, cv2.COLOR_BGRA2RGB)
    else:
        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

    img  = cv2.resize(img, (224, 224)).astype(np.float32) / 255.0
    mean = np.array([0.485, 0.456, 0.406], dtype=np.float32)
    std  = np.array([0.229, 0.224, 0.225], dtype=np.float32)
    img  = (img - mean) / std
    return np.transpose(img, (2, 0, 1))   # HWC -> CHW


# ─────────────────────────────────────────────────────────────────────────────
# STFPM 异常检测模型
# ─────────────────────────────────────────────────────────────────────────────

def create_stfpm_model(backbone_name="resnet18"):
    from paddleseg.models.backbones.resnet_ms3 import ResNet_MS3

    class STFPMModel(nn.Layer):
        def __init__(self, backbone_name):
            super(STFPMModel, self).__init__()
            self.student = ResNet_MS3(pretrained=False, arch=backbone_name)
            self.teacher = ResNet_MS3(pretrained=True,  arch=backbone_name)
            for param in self.teacher.parameters():
                param.stop_gradient = True

        def forward(self, x):
            stu = self.student(x)
            if self.teacher.training:
                self.teacher.eval()
            with paddle.no_grad():
                tea = self.teacher(x)
            if self.student.training:
                return [[stu, tea]]
            else:
                H, W = x.shape[2], x.shape[3]
                maps = []
                for j in range(len(tea)):
                    t  = F.normalize(tea[j], axis=1)
                    s  = F.normalize(stu[j], axis=1)
                    sm = paddle.sum((t - s) ** 2, axis=1, keepdim=True)
                    sm = F.interpolate(
                        sm, size=(H, W),
                        mode='bilinear', align_corners=False
                    )
                    maps.append(sm)
                score_map = paddle.prod(paddle.stack(maps, axis=0), axis=0)
                return score_map   # [B, 1, H, W]

        def infer_single(self, roi_np: np.ndarray) -> Dict[str, Any]:
            """
            单张推理。

            修复：
            - finally 块中加入对 roi_np 引用的 del，确保中间张量及时释放
            - 移除多余的 synchronize（.numpy() 已隐式同步）
            - 返回字典含 infer_failed 字段，方便上层精确标记
            """
            tensor    = None
            score_map = None
            try:
                tensor = paddle.to_tensor(roi_np[np.newaxis])   # [1, 3, 224, 224]
                with paddle.no_grad():
                    with paddle.amp.auto_cast(enable=True, level='O1'):
                        score_map = self.forward(tensor)
                    if isinstance(score_map, (list, tuple)):
                        score_map = score_map[0]
                    score = float(paddle.max(score_map).numpy())
                return {"error": score, "infer_failed": False}
            except Exception as e:
                logger.error(f"[infer_single] failed: {e}")
                return {"error": 0.0, "infer_failed": True}
            finally:
                # 修复：主动 del 所有中间张量，不依赖 GC 时机
                if score_map is not None:
                    del score_map
                if tensor is not None:
                    del tensor
                del roi_np
                gc.collect()
                _safe_empty_cache()

        def infer_batch(self, rois_np: np.ndarray) -> Dict[str, Any]:
            """
            批量推理 [B, 3, 224, 224]。

            修复：
            - finally 块中 del rois_np（调用方传入的 batch numpy）
            - 移除多余的 synchronize
            - 返回字典含 infer_failed 字段
            """
            batch_tensor = None
            score_map    = None
            try:
                batch_tensor = paddle.to_tensor(rois_np)
                with paddle.no_grad():
                    with paddle.amp.auto_cast(enable=True, level='O1'):
                        score_map = self.forward(batch_tensor)
                    if isinstance(score_map, (list, tuple)):
                        score_map = score_map[0]
                    B      = score_map.shape[0]
                    scores = paddle.max(
                        score_map.reshape([B, -1]), axis=1
                    ).numpy()
                return {"scores": scores.astype(np.float32), "infer_failed": False}
            except Exception as e:
                logger.error(f"[infer_batch] failed: {e}")
                return {
                    "scores":       np.zeros(rois_np.shape[0], dtype=np.float32),
                    "infer_failed": True,
                }
            finally:
                if score_map is not None:
                    del score_map
                if batch_tensor is not None:
                    del batch_tensor
                del rois_np
                gc.collect()
                _safe_empty_cache()

    return STFPMModel(backbone_name)


class MultiSTFPMDetector:
    def __init__(self, models_dir):
        self.models_dir = Path(models_dir)
        self.models:  Dict[str, Any] = {}
        self.configs: Dict[str, Any] = {}
        self._load_models()

    def _load_models(self):
        if not self.models_dir.exists():
            logger.warning(f"Models directory not found: {self.models_dir}")
            return

        for category in self.models_dir.iterdir():
            if not category.is_dir():
                continue

            model_path  = category / 'model.pdparams'
            config_path = category / 'config.json'

            if not model_path.exists():
                best = category / 'best_model'
                if best.exists():
                    model_path  = best / 'model.pdparams'
                    config_path = best / 'config.json'

            if model_path.exists():
                try:
                    config = {}
                    if config_path.exists():
                        with open(config_path, 'r') as f:
                            config = json.load(f)

                    backbone_name = config.get("backbone", "resnet18")
                    model = create_stfpm_model(backbone_name)
                    model.set_state_dict(paddle.load(str(model_path)))
                    model.eval()

                    self.models[category.name]  = model
                    self.configs[category.name] = config
                    logger.info(
                        f"Loaded model: {category.name} (backbone: {backbone_name})"
                    )
                except Exception as e:
                    logger.error(f"Failed to load model {category.name}: {e}")

    def detect_category(
        self,
        rois: List[np.ndarray],
        category: str,
        request_id: str = ""
    ) -> List[Dict[str, Any]]:
        """
        对同一 category 的多个 ROI 进行推理。
        优先批量推理；批量失败（OOM 等）自动降级为逐个推理。

        修复：
        - 批量 numpy 数组在传入 infer_batch 前用 try/finally 确保释放
        - 逐个推理时每个 ROI 独立标记 infer_failed，不再污染整批结果
        - category 处理完统一 cleanup 一次
        """
        if category not in self.models:
            return [
                {
                    "error": 0.0, "is_anomaly": False,
                    "anomaly_score": 0.0, "threshold": 0.0,
                    "infer_failed": True,
                }
            ] * len(rois)

        model     = self.models[category]
        config    = self.configs[category]
        threshold = config.get('threshold', 0.5)

        def _make_result(error: float, infer_failed: bool = False) -> Dict[str, Any]:
            return {
                'is_anomaly':    (not infer_failed) and (error > threshold),
                'anomaly_score': min(error / threshold, 1.0) if threshold > 0 else error,
                'error':         error,
                'threshold':     threshold,
                'infer_failed':  infer_failed,
            }

        # 收集各 ROI 的 (error, infer_failed)，最终统一构建结果
        result_pairs: List[tuple] = []   # [(error, infer_failed), ...]

        try:
            # ── 尝试批量推理 ──────────────────────────────────────────────
            if len(rois) > 1:
                # 修复：batch_np 在 try/finally 中显式释放
                batch_np = np.stack([_preprocess_roi(r) for r in rois], axis=0)
                try:
                    batch_result = model.infer_batch(batch_np)
                    # infer_batch 内部已 del rois_np，此处 batch_np 已无效，
                    # 但变量仍持有引用，需手动 del
                finally:
                    del batch_np

                if not batch_result["infer_failed"]:
                    scores = batch_result["scores"]
                    result_pairs = [(float(s), False) for s in scores]
                    logger.info(
                        f"[{request_id}] [{category}] batch inference OK, "
                        f"count={len(rois)}"
                    )
                else:
                    logger.warning(
                        f"[{request_id}] [{category}] batch inference failed, "
                        "falling back to single inference"
                    )
                    _cleanup(f"{category} batch failed")

            # ── 降级：逐个推理（批量失败 或 只有 1 个 ROI）─────────────
            if not result_pairs:
                for idx, roi in enumerate(rois):
                    roi_np = _preprocess_roi(roi)
                    # infer_single 内部会 del roi_np
                    result = model.infer_single(roi_np)

                    # 修复：每个 ROI 独立记录 infer_failed，不相互污染
                    result_pairs.append((result["error"], result["infer_failed"]))

                    if result["infer_failed"]:
                        logger.error(
                            f"[{request_id}] [{category}] single inference "
                            f"{idx+1}/{len(rois)} failed, using 0.0"
                        )
                    else:
                        logger.info(
                            f"[{request_id}] [{category}] single inference "
                            f"{idx+1}/{len(rois)} OK, "
                            f"error={result['error']:.4f}"
                        )

        finally:
            # category 处理完，统一清理一次
            _cleanup(f"{category} done")

        return [_make_result(error, failed) for error, failed in result_pairs]

    def get_loaded_categories(self) -> List[str]:
        return list(self.models.keys())


# ─────────────────────────────────────────────────────────────────────────────
# 从 annotations.json 选择最佳模板图片
# ─────────────────────────────────────────────────────────────────────────────

def select_best_template_from_annotations(annotations_path: str) -> tuple:
    try:
        with open(annotations_path, 'r', encoding='utf-8') as f:
            data = json.load(f)

        images      = {img['id']: img for img in data.get('images', [])}
        annotations = data.get('annotations', [])

        no_flip = [
            ann for ann in annotations
            if not ann.get('horizontal_flip', False)
            and not ann.get('vertical_flip', False)
        ]
        if not no_flip:
            logger.warning("No annotations without flip found")
            return None, []

        no_flip.sort(key=lambda x: abs(x.get('angle', 0)))
        best     = no_flip[0]
        img_info = images.get(best.get('image_id'))
        if not img_info:
            logger.warning(f"Image {best.get('image_id')} not found")
            return None, []

        ann_dir   = Path(annotations_path).parent
        file_name = img_info.get('file_name', '')

        for candidate in [
            ann_dir / "raw_images" / file_name,
            ann_dir / file_name,
            ann_dir / "images" / file_name,
        ]:
            if candidate.exists():
                template_path = str(candidate)
                break
        else:
            logger.warning(f"Template image not found for {file_name}")
            return None, []

        template_annotations = [
            {
                'category': ann.get('label', ''),
                'bbox':     ann.get('bbox', [0, 0, 0, 0]),
            }
            for ann in no_flip
            if ann.get('image_id') == best.get('image_id') and ann.get('label')
        ]

        logger.info(
            f"Selected template: {file_name}, angle={best.get('angle', 0)}, "
            f"annotations={len(template_annotations)}"
        )
        return template_path, template_annotations

    except Exception as e:
        logger.error(f"Failed to select template from annotations: {e}")
        return None, []


