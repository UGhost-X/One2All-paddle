class DinomalyWrapper:
    """Dinomaly 推理包装器"""

    # SSIM 阈值：如果 top-k 平均 SSIM 得分大于此值，判定为异常
    SSIM_THRESHOLD = 0.6
    SSIM_TOP_K = 3  # 取 top-k 张 FN 图片的 SSIM 平均值，避免单张幸运匹配

    def __init__(self, device: str = "cuda"):
        self.device = torch.device(device if torch.cuda.is_available() else "cpu")
        self.model = None
        self.engine = None
        self.config: Dict[str, Any] = {}
        self.input_size = (224, 224)
        self.normalize_brightness_config = False
        self.normalize_contrast_config = False
        self.threshold = 0.5
        self.fn_images_by_pos: Dict[str, List[np.ndarray]] = {}  # 按 pos_id 组织的 FN 图片
        self.fn_masks_by_pos: Dict[str, List[np.ndarray]] = {}   # 按 pos_id 组织的 FN mask

    def load_from_checkpoint(self, model_path: str, config_path: str = None):
        """从 checkpoint 加载模型"""
        from anomalib.models import Dinomaly
        from anomalib.engine import Engine

        # 加载配置
        if config_path and os.path.exists(config_path):
            self.load_config(config_path)

        try:
            import torch
            checkpoint = torch.load(model_path, map_location=self.device, weights_only=False)
            self.model = Dinomaly.load_from_checkpoint(model_path, map_location=self.device, weights_only=False)
        except TypeError:
            # 旧版本 PyTorch 不支持 weights_only 参数
            try:
                self.model = Dinomaly.load_from_checkpoint(model_path, map_location=self.device)
            except TypeError:
                # 更旧版本不支持 map_location
                self.model = Dinomaly.load_from_checkpoint(model_path)

        self.model = self.model.to(self.device)
        self.model.eval()

        # 创建 engine 用于推理
        self.engine = Engine(
            accelerator='gpu' if torch.cuda.is_available() else 'cpu',
            devices=1,
        )

        # 获取阈值
        self.threshold = self._get_threshold()

        # 加载 FN 图片（用于 SSIM 比对）
        self._load_fn_images(model_path)

        logger.info(f"Dinomaly model loaded. Threshold: {self.threshold:.4f}, FN positions: {len(self.fn_images_by_pos)}")

    def _load_fn_images(self, model_path: str):
        """加载模型目录下的 FN 图片和 mask，按 pos_id 组织用于 SSIM 比对"""
        model_dir = Path(model_path).parent
        fn_dir = model_dir / "fn_images"
        fn_masks_dir = model_dir / "masks" / "fn"

        # 本目录找不到时，去兄弟目录里找 {pos_id} 子目录
        if not fn_dir.exists():
            pos_id = model_dir.name          # e.g. "2"
            parent = model_dir.parent
            for sibling in sorted(parent.iterdir()):
                if not sibling.is_dir() or sibling == model_dir:
                    continue
                candidate = sibling / "fn_images" / pos_id
                if candidate.exists():
                    logger.info(
                        f"[SSIM] Redirecting fn_images: "
                        f"{fn_dir} → {sibling / 'fn_images'} (pos_id={pos_id})"
                    )
                    fn_dir = sibling / "fn_images"
                    fn_masks_dir = sibling / "masks" / "fn"
                    break

        logger.info(f"[SSIM] Looking for FN images in: {fn_dir}")
        logger.info(f"[SSIM] Looking for FN masks in: {fn_masks_dir}")

        if not fn_dir.exists():
            logger.warning(f"[SSIM] FN images directory not found: {fn_dir}")
            return

        self.fn_images_by_pos = {}
        self.fn_masks_by_pos = {}

        # 检查是否按 pos_id 分文件夹（新格式）还是扁平结构（旧格式兼容）
        subdirs = [d for d in fn_dir.iterdir() if d.is_dir()]
        if subdirs:
            # 新格式：fn_images/{pos_id}/fn_xxxx.npy（灰度 numpy 数组）
            for pos_dir in sorted(subdirs):
                pos_id = pos_dir.name
                # .npy 优先：避免同一 stem 的 .npy 和 .jpg 重复加载
                npy_files = sorted(pos_dir.glob("*.npy"))
                npy_stems = {f.stem for f in npy_files}
                jpg_files = sorted(pos_dir.glob("*.jpg"))
                legacy_jpg = [f for f in jpg_files if f.stem not in npy_stems]
                all_files = npy_files + legacy_jpg
                if len(legacy_jpg) < len(jpg_files):
                    skipped = len(jpg_files) - len(legacy_jpg)
                    logger.info(f"[SSIM] pos_id={pos_id}: Found {len(npy_files)} npy + {len(legacy_jpg)} jpg FN images (skipped {skipped} duplicate jpg)")
                else:
                    logger.info(f"[SSIM] pos_id={pos_id}: Found {len(npy_files)} npy + {len(legacy_jpg)} jpg FN images")

                images = []
                masks = []
                pos_mask_dir = fn_masks_dir / pos_id

                for img_path in all_files:
                    try:
                        # 加载图像：优先 .npy（灰度数组），其次 .jpg（BGR 图片）
                        if img_path.suffix == '.npy':
                            gray = np.load(str(img_path))
                        else:
                            img = cv2.imread(str(img_path))
                            if img is None:
                                logger.warning(f"[SSIM] Failed to read FN image: {img_path}")
                                continue
                            if len(img.shape) == 3:
                                gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
                            else:
                                gray = img

                        mask = None
                        mask_path = pos_mask_dir / f"{img_path.stem}.npy"
                        if mask_path.exists():
                            try:
                                mask = np.load(mask_path)
                                if mask.shape != (self.input_size[1], self.input_size[0]):
                                    logger.warning(f"[SSIM] Mask shape mismatch for {img_path.name}: {mask.shape}")
                                    mask = None
                            except Exception as e:
                                logger.warning(f"[SSIM] Failed to load mask for {img_path.name}: {e}")

                        if mask is None:
                            mask = np.ones((self.input_size[1], self.input_size[0]), dtype=bool)

                        # 统一尺寸
                        if gray.shape != (self.input_size[1], self.input_size[0]):
                            gray = cv2.resize(gray, self.input_size)
                        images.append(gray)
                        masks.append(mask)

                    except Exception as e:
                        logger.warning(f"[SSIM] Failed to load FN image {img_path}: {e}")

                if images:
                    self.fn_images_by_pos[pos_id] = images
                    self.fn_masks_by_pos[pos_id] = masks
                    logger.info(f"[SSIM] Loaded {len(images)} FN images for pos_id={pos_id}")
        else:
            # 旧格式兼容：fn_images/fn_xxxx.npy 或 fn_xxxx.jpg（扁平结构，图片归到 "default" pos_id）
            npy_files = sorted(fn_dir.glob("*.npy"))
            npy_stems = {f.stem for f in npy_files}
            jpg_files = sorted(fn_dir.glob("*.jpg"))
            legacy_jpg = [f for f in jpg_files if f.stem not in npy_stems]
            all_files = npy_files + legacy_jpg
            skipped = len(jpg_files) - len(legacy_jpg)
            logger.info(f"[SSIM] Legacy format: Found {len(npy_files)} npy + {len(legacy_jpg)} jpg FN images (skipped {skipped} duplicate jpg, will use pos_id='default')")

            images = []
            masks = []
            for img_path in all_files:
                try:
                    if img_path.suffix == '.npy':
                        gray = np.load(str(img_path))
                    else:
                        img = cv2.imread(str(img_path))
                        if img is None:
                            continue
                        if len(img.shape) == 3:
                            gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
                        else:
                            gray = img

                    mask = None
                    mask_path = fn_masks_dir / f"{img_path.stem}.npy"
                    if mask_path.exists():
                        try:
                            mask = np.load(mask_path)
                        except Exception:
                            pass

                    if mask is None:
                        mask = np.ones((self.input_size[1], self.input_size[0]), dtype=bool)

                    # 统一尺寸
                    if gray.shape != (self.input_size[1], self.input_size[0]):
                        gray = cv2.resize(gray, self.input_size)
                    images.append(gray)
                    masks.append(mask)
                except Exception as e:
                    logger.warning(f"[SSIM] Failed to load FN image {img_path}: {e}")

            if images:
                self.fn_images_by_pos["default"] = images
                self.fn_masks_by_pos["default"] = masks

        total_images = sum(len(v) for v in self.fn_images_by_pos.values())
        total_positions = len(self.fn_images_by_pos)
        if total_images > 0:
            logger.info(f"[SSIM] Total loaded {total_images} FN images across {total_positions} positions")
        else:
            logger.warning(f"[SSIM] No valid FN images loaded from {fn_dir}")

    def _save_ssim_visualization(self, roi_gray: np.ndarray, fn_gray: np.ndarray,
                                  roi_mask: np.ndarray, fn_mask: np.ndarray,
                                  ssim_score: float, idx: int = 0, pos_id: str = None):
        """保存 SSIM 对比可视化图片到日志目录"""
        try:
            import matplotlib
            matplotlib.use('Agg')
            import matplotlib.pyplot as plt

            # 计算 mask 的交集
            valid_mask = roi_mask & fn_mask

            # 裁剪到有效区域
            rows = np.any(valid_mask, axis=1)
            cols = np.any(valid_mask, axis=0)
            if not np.any(rows) or not np.any(cols):
                return
            rmin, rmax = np.where(rows)[0][[0, -1]]
            cmin, cmax = np.where(cols)[0][[0, -1]]

            roi_crop = roi_gray[rmin:rmax+1, cmin:cmax+1]
            fn_crop = fn_gray[rmin:rmax+1, cmin:cmax+1]

            # 计算差异图
            diff = np.abs(roi_crop.astype(float) - fn_crop.astype(float))

            # 创建可视化
            fig, axes = plt.subplots(2, 2, figsize=(12, 10))
            fig.suptitle(f'SSIM Comparison - Score: {ssim_score:.4f}', fontsize=14)

            # ROI 图片
            axes[0, 0].imshow(roi_crop, cmap='gray')
            axes[0, 0].set_title('Input ROI')
            axes[0, 0].axis('off')

            # FN 图片
            axes[0, 1].imshow(fn_crop, cmap='gray')
            axes[0, 1].set_title('FN Image')
            axes[0, 1].axis('off')

            # 差异热力图
            im = axes[1, 0].imshow(diff, cmap='hot', vmin=0, vmax=255)
            axes[1, 0].set_title('Difference Map')
            axes[1, 0].axis('off')
            plt.colorbar(im, ax=axes[1, 0], fraction=0.046, pad=0.04)

            # 叠加对比
            axes[1, 1].imshow(roi_crop, cmap='gray', alpha=0.5)
            axes[1, 1].imshow(fn_crop, cmap='gray', alpha=0.5)
            axes[1, 1].set_title('Overlay (ROI + FN)')
            axes[1, 1].axis('off')

            plt.tight_layout()

            # 保存图片
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S_%f")
            pos_str = f"_{pos_id}" if pos_id else ""
            filename = f"ssim_viz{pos_str}_fn{idx}_{timestamp}_score{ssim_score:.4f}.png"
            save_path = LOG_DIR / filename
            plt.savefig(str(save_path), dpi=150, bbox_inches='tight')
            plt.close(fig)

            logger.info(f"[SSIM_VIZ] Saved visualization to {save_path}")
        except Exception as e:
            logger.warning(f"[SSIM_VIZ] Failed to save visualization: {e}")

    def calculate_ssim(self, roi_gray: np.ndarray, fn_gray: np.ndarray,
                       roi_mask: np.ndarray = None, fn_mask: np.ndarray = None,
                       save_viz: bool = False, viz_idx: int = 0, pos_id: str = None) -> float:
        """
        计算 ROI 与 FN 图片的 SSIM 相似度（标准滑动窗口法），只比较有效区域。
        roi_gray / fn_gray 应为已预处理的灰度图，尺寸一致 (224×224)。

        Args:
            roi_gray: ROI 灰度图
            fn_gray: FN 灰度图
            roi_mask: ROI 有效区域 mask
            fn_mask: FN 有效区域 mask
            save_viz: 是否保存可视化图片
            viz_idx: 可视化图片索引
            pos_id: 位置 ID，用于文件名

        Returns:
            SSIM 得分 (0-1, 1 表示完全相同)
        """
        if not SSIM_AVAILABLE:
            return 0.0

        try:
            # 输入已是灰度图，直接使用
            gray_roi = roi_gray
            gray_fn = fn_gray

            # 如果没有提供 mask，创建全 True 的 mask
            if roi_mask is None:
                roi_mask = np.ones(gray_roi.shape, dtype=bool)
            if fn_mask is None:
                fn_mask = np.ones(gray_fn.shape, dtype=bool)

            # 计算 mask 的交集（只比较两个都有效的区域）
            valid_mask = roi_mask & fn_mask

            # 如果没有有效区域，返回 0
            if not np.any(valid_mask):
                return 0.0

            # 裁剪到有效区域的 bounding box（letterbox 的有效区域是矩形）
            rows = np.any(valid_mask, axis=1)
            cols = np.any(valid_mask, axis=0)
            rmin, rmax = np.where(rows)[0][[0, -1]]
            cmin, cmax = np.where(cols)[0][[0, -1]]

            roi_crop = gray_roi[rmin:rmax+1, cmin:cmax+1]
            fn_crop = gray_fn[rmin:rmax+1, cmin:cmax+1]

            # 确保裁剪区域足够大（至少 7x7，即 SSIM 默认 win_size）
            min_side = min(roi_crop.shape[0], roi_crop.shape[1])
            if min_side < 7:
                return 0.0

            # 使用 skimage 标准窗口化 SSIM
            win_size = min(7, min_side if min_side % 2 == 1 else min_side - 1)
            ssim_value = ssim(roi_crop, fn_crop, data_range=255, win_size=win_size)

            # 保存可视化（如果启用）
            if save_viz:
                self._save_ssim_visualization(roi_gray, fn_gray, roi_mask, fn_mask,
                                              ssim_value, viz_idx, pos_id)

            return float(ssim_value)

        except Exception as e:
            logger.warning(f"SSIM calculation failed: {e}")
            return 0.0

    def check_ssim_anomaly(self, roi: np.ndarray, pos_id: str = None) -> Tuple[bool, float]:
        """
        使用 SSIM 检查 ROI 是否与同位置的 FN 图片相似。
        取 top-k 张 FN 图片的 SSIM 平均值，避免单张幸运匹配导致误判。

        Args:
            roi: 输入 ROI
            pos_id: 位置 ID，用于匹配同位置的 FN 图片。为 None 时使用所有 FN 图片。

        Returns:
            (is_anomaly, avg_ssim_score)
            - is_anomaly: 如果 top-k 平均 SSIM > SSIM_THRESHOLD 返回 True
            - avg_ssim_score: top-k 平均 SSIM 得分
        """
        if not self.fn_images_by_pos or not SSIM_AVAILABLE:
            return False, 0.0

        # 根据 pos_id 选择 FN 图片
        if pos_id is not None and pos_id in self.fn_images_by_pos:
            fn_images = self.fn_images_by_pos[pos_id]
            fn_masks = self.fn_masks_by_pos[pos_id]
        elif pos_id is not None:
            # 指定了 pos_id 但没有对应的 FN 图片，尝试使用 "default"
            if "default" in self.fn_images_by_pos:
                fn_images = self.fn_images_by_pos["default"]
                fn_masks = self.fn_masks_by_pos["default"]
                logger.debug(f"[SSIM] pos_id={pos_id} not found, using 'default' FN images")
            else:
                logger.debug(f"[SSIM] No FN images for pos_id={pos_id}")
                return False, 0.0
        else:
            # 未指定 pos_id，使用所有 FN 图片（兼容旧逻辑）
            fn_images = []
            fn_masks = []
            for imgs, mks in zip(self.fn_images_by_pos.values(), self.fn_masks_by_pos.values()):
                fn_images.extend(imgs)
                fn_masks.extend(mks)

        if not fn_images:
            return False, 0.0

        # 对 ROI 进行预处理（与 FN 图片保存时的预处理一致），同时获取 mask
        roi_processed, roi_mask = self._preprocess_for_ssim(roi)

        all_scores = []
        roi_shape = roi.shape if roi is not None else "None"
        processed_shape = roi_processed.shape
        logger.debug(f"[SSIM] Checking anomaly for ROI shape={roi_shape} -> processed={processed_shape}, pos_id={pos_id}, FN images={len(fn_images)}")

        for idx, (fn_img, fn_mask) in enumerate(zip(fn_images, fn_masks)):
            ssim_score = self.calculate_ssim(roi_processed, fn_img, roi_mask, fn_mask,
                                              save_viz=False, viz_idx=idx, pos_id=pos_id)
            all_scores.append(ssim_score)
            logger.debug(f"[SSIM] Compared with FN[{idx}]: score={ssim_score:.4f}")

        # 取 top-k 平均，比单张 max 更鲁棒
        k = min(self.SSIM_TOP_K, len(all_scores))
        top_k_scores = sorted(all_scores, reverse=True)[:k]
        avg_ssim = sum(top_k_scores) / len(top_k_scores)

        # 调试可视化默认关闭（matplotlib 保存耗时 0.5-2s），需要时设置环境变量启用
        if top_k_scores and os.environ.get("SSIM_DEBUG_VIZ"):
            top1_score = top_k_scores[0]
            top1_idx = all_scores.index(top1_score)
            self.calculate_ssim(roi_processed, fn_images[top1_idx], roi_mask, fn_masks[top1_idx],
                                save_viz=True, viz_idx=top1_idx, pos_id=pos_id)

        is_anomaly = avg_ssim > self.SSIM_THRESHOLD
        logger.info(f"[SSIM] Result: pos_id={pos_id}, top{k}_avg={avg_ssim:.4f} (scores={[f'{s:.4f}' for s in top_k_scores]}), threshold={self.SSIM_THRESHOLD}, is_anomaly={is_anomaly}")
        return is_anomaly, avg_ssim

    def load_config(self, config_path: str):
        """加载配置文件"""
        if os.path.exists(config_path):
            with open(config_path, "r", encoding="utf-8") as f:
                self.config = json.load(f)
                self.normalize_brightness_config = self.config.get("normalize_brightness", False)
                self.normalize_contrast_config = self.config.get("normalize_contrast", False)
                self.target_size = self.config.get("target_size", None)
                self.threshold = self.config.get("threshold", 0.5)
                if self.target_size:
                    logger.info(f"Loaded target_size from config: {self.target_size}")

    def _get_threshold(self) -> float:
        """获取模型阈值"""
        if self.model is None:
            return 0.5
        for attr in ('image_threshold', 'threshold'):
            obj = getattr(self.model, attr, None)
            if obj is not None:
                val = getattr(obj, 'value', None)
                if val is not None:
                    return float(val)
        return self.threshold

    def infer_single(self, roi: np.ndarray, target_size: Tuple[int, int] = None,
                     normalize_brightness: bool = None, normalize_contrast: bool = None,
                     pos_id: str = None) -> Dict[str, Any]:
        """单张推理"""
        if self.model is None:
            return {"error": 0.0, "infer_failed": True}

        if normalize_brightness is None:
            normalize_brightness = self.normalize_brightness_config
        if normalize_contrast is None:
            normalize_contrast = self.normalize_contrast_config
        if target_size is None:
            target_size = getattr(self, 'target_size', None)

        # 首先使用 Dinomaly 进行推理
        try:
            # 直接预处理为 tensor，跳过磁盘 I/O
            image_batch, masks = self._preprocess_rois_to_batch(
                [roi], target_size, normalize_brightness, normalize_contrast
            )

            if image_batch is None:
                raise RuntimeError("_preprocess_rois_to_batch returned None")

            # 直接调用 torch model（与 predict_step 一致，不经过 post_processor）
            with torch.no_grad():
                output = self.model.model(image_batch)

            # 提取分数
            score = self._extract_score_with_mask([output], masks[0])
            dinomaly_score = float(score)

            # 如果 Dinomaly 已判定为异常，跳过 SSIM 检查
            if dinomaly_score > self.threshold:
                logger.info(f"[Dinomaly] Anomaly detected: dinomaly={dinomaly_score:.4f} > threshold={self.threshold:.4f}, skip SSIM")
                return {"error": dinomaly_score, "infer_failed": False, "ssim_score": 0.0, "dinomaly_score": dinomaly_score}

            # Dinomaly 判定正常，再使用 SSIM 检查是否与同位置的 FN 图片相似
            is_ssim_anomaly, ssim_score = self.check_ssim_anomaly(roi, pos_id=pos_id)
            if is_ssim_anomaly:
                logger.info(f"[SSIM] Anomaly detected: dinomaly={dinomaly_score:.4f}, ssim={ssim_score:.4f} > {self.SSIM_THRESHOLD}")
                return {"error": 1.0, "infer_failed": False, "ssim_score": float(ssim_score), "ssim_anomaly": True, "dinomaly_score": dinomaly_score}

            return {"error": dinomaly_score, "infer_failed": False, "ssim_score": float(ssim_score), "dinomaly_score": dinomaly_score}

        except Exception as e:
            logger.error(f"[DinomalyWrapper] inference failed: {e}")
            return {"error": 0.0, "infer_failed": True}

    def infer_batch(self, rois: List[np.ndarray],
                    target_size: Tuple[int, int] = None,
                    normalize_brightness: bool = None,
                    normalize_contrast: bool = None,
                    pos_ids: List[str] = None) -> List[Dict[str, Any]]:
        """批量推理"""
        if self.model is None:
            return [{"error": 0.0, "infer_failed": True}] * len(rois)

        if len(rois) == 0:
            return []

        if normalize_brightness is None:
            normalize_brightness = self.normalize_brightness_config
        if normalize_contrast is None:
            normalize_contrast = self.normalize_contrast_config
        if target_size is None:
            target_size = getattr(self, 'target_size', None)

        # 初始化结果列表
        results = [{"error": 0.0, "infer_failed": True, "ssim_score": 0.0} for _ in range(len(rois))]

        # 首先使用 Dinomaly 对所有 ROI 进行批量推理
        try:
            # 直接预处理为 tensor batch，跳过磁盘 I/O
            image_batch, masks = self._preprocess_rois_to_batch(
                rois, target_size, normalize_brightness, normalize_contrast
            )

            if image_batch is None:
                raise RuntimeError("_preprocess_rois_to_batch returned None")

            # 直接调用 torch model（与 predict_step 一致，不经过 post_processor）
            with torch.no_grad():
                output = self.model.model(image_batch)

            # 提取分数
            scores = self._extract_scores_with_masks([output], masks)

            # 填充 Dinomaly 推理结果
            for i in range(len(rois)):
                if i < len(scores):
                    dinomaly_score = float(scores[i])
                    results[i] = {
                        "error": dinomaly_score,
                        "infer_failed": False,
                        "ssim_score": 0.0,
                        "dinomaly_score": dinomaly_score
                    }

        except Exception as e:
            logger.error(f"[DinomalyWrapper] batch inference failed: {e}")
            return results

        # 对 Dinomaly 判定为正常的 ROI，再使用 SSIM 检查
        dinomaly_normal_count = 0
        for i, roi in enumerate(rois):
            if results[i].get("infer_failed", True):
                continue
            dinomaly_score = results[i]["error"]
            if dinomaly_score > self.threshold:
                logger.debug(f"[Dinomaly] ROI[{i}] anomaly detected, skip SSIM: score={dinomaly_score:.4f} > {self.threshold:.4f}")
                continue

            # Dinomaly 判定正常，进行 SSIM 检查
            dinomaly_normal_count += 1
            pos_id = pos_ids[i] if pos_ids and i < len(pos_ids) else None
            is_ssim_anomaly, ssim_score = self.check_ssim_anomaly(roi, pos_id=pos_id)
            results[i]["ssim_score"] = float(ssim_score)
            if is_ssim_anomaly:
                logger.info(f"[SSIM] ROI[{i}] anomaly detected: dinomaly={dinomaly_score:.4f}, ssim={ssim_score:.4f} > {self.SSIM_THRESHOLD}")
                results[i] = {
                    "error": 1.0,
                    "infer_failed": False,
                    "ssim_score": float(ssim_score),
                    "ssim_anomaly": True,
                    "dinomaly_score": dinomaly_score
                }

        if dinomaly_normal_count > 0:
            ssim_anomaly_count = sum(1 for r in results if r.get("ssim_anomaly", False))
            logger.info(f"[SSIM] Checked {dinomaly_normal_count} Dinomaly-normal ROIs, {ssim_anomaly_count} SSIM anomalies found")

        return results

    def infer_batch_direct(self, rois: List[np.ndarray],
                           target_size: Tuple[int, int] = None,
                           normalize_brightness: bool = None,
                           normalize_contrast: bool = None,
                           pos_ids: List[str] = None) -> List[Dict[str, Any]]:
        """批量推理 - 直接调用模型 forward，跳过磁盘 I/O 和 engine.predict。"""
        # 直接复用 infer_batch 的实现，确保一致性
        return self.infer_batch(rois, target_size, normalize_brightness, normalize_contrast, pos_ids=pos_ids)

    def _preprocess_for_ssim(self, roi: np.ndarray) -> Tuple[np.ndarray, np.ndarray]:
        """
        预处理 ROI 用于 SSIM 比对，与 FN 图片保存时的预处理一致。

        Args:
            roi: 输入 ROI (BGR 格式)

        Returns:
            (roi_gray, mask): 预处理后的灰度图 (224, 224) 和有效区域 mask (224, 224)
        """
        h, w = roi.shape[:2]
        th, tw = self.input_size  # (224, 224)

        # 转换为 PIL Image 格式以使用 letterbox_resize
        if len(roi.shape) == 2:
            roi_rgb = cv2.cvtColor(roi, cv2.COLOR_GRAY2RGB)
        elif roi.shape[2] == 4:
            roi_rgb = cv2.cvtColor(roi, cv2.COLOR_BGRA2RGB)
        elif roi.shape[2] == 3:
            roi_rgb = cv2.cvtColor(roi, cv2.COLOR_BGR2RGB)
        else:
            roi_rgb = roi

        pil_img = Image.fromarray(roi_rgb)

        # 应用亮度/对比度归一化（在 letterbox_resize 之前，与训练时一致）
        if self.normalize_brightness_config:
            pil_img = self._normalize_brightness_pil(pil_img)
        if self.normalize_contrast_config:
            pil_img = ImageOps.autocontrast(pil_img)

        # letterbox_resize 到 224x224（与 FN 图片保存时一致），同时获取 mask
        img_padded, mask = letterbox_resize(pil_img, self.input_size)

        # 转换为 numpy 数组 (RGB) → 灰度图（SSIM 计算只需要灰度）
        roi_np = np.array(img_padded)
        roi_gray = cv2.cvtColor(roi_np, cv2.COLOR_RGB2GRAY)

        return roi_gray, mask

    @staticmethod
    def _normalize_brightness_pil(img: Image.Image, target_mean: float = 168.0, threshold: int = 10) -> Image.Image:
        """对 PIL Image 进行亮度归一化，与训练时的 normalize_brightness 保持一致"""
        arr = np.array(img).astype(np.float32)
        brightness = arr.mean(axis=2) if len(arr.shape) == 3 else arr
        hole_mask = brightness > threshold
        if np.sum(hole_mask) == 0:
            return img
        current_mean = arr[hole_mask].mean()
        if current_mean > 0:
            scale = target_mean / current_mean
            arr[hole_mask] = np.clip(arr[hole_mask] * scale, 0, 255)
        return Image.fromarray(arr.astype(np.uint8))

    @staticmethod
    def _normalize_brightness_np(img_np: np.ndarray, target_mean: float = 168.0, threshold: int = 10) -> np.ndarray:
        """numpy 原生亮度归一化，避免 PIL 往返。热路径优化版。"""
        arr = img_np.astype(np.float32)
        brightness = arr.mean(axis=2) if len(arr.shape) == 3 else arr
        hole_mask = brightness > threshold
        if np.sum(hole_mask) == 0:
            return img_np
        current_mean = arr[hole_mask].mean()
        if current_mean > 0:
            scale = target_mean / current_mean
            arr[hole_mask] = np.clip(arr[hole_mask] * scale, 0, 255)
        return arr.astype(np.uint8)

    @staticmethod
    def _autocontrast_np(img_np: np.ndarray, cutoff: float = 0.0) -> np.ndarray:
        """numpy 原生自动对比度，等价于 PIL ImageOps.autocontrast。热路径优化版。"""
        arr = img_np.astype(np.float32)
        for c in range(arr.shape[2]):
            channel = arr[:, :, c]
            if cutoff > 0:
                lo, hi = np.percentile(channel, [cutoff, 100 - cutoff])
            else:
                lo, hi = channel.min(), channel.max()
            if hi > lo:
                channel = np.clip((channel - lo) * 255.0 / (hi - lo), 0, 255)
            arr[:, :, c] = channel
        return arr.astype(np.uint8)

    def _preprocess_for_save(self, roi: np.ndarray, target_size: Tuple[int, int] = None,
                             normalize_brightness: bool = False, normalize_contrast: bool = False) -> Tuple[np.ndarray, np.ndarray]:
        """
        预处理 ROI 用于保存，返回处理后的图像和 mask。
        使用 letterbox_resize 保持宽高比，与训练时一致。

        Returns:
            processed_roi: 预处理后的图像
            mask: 有效区域 mask (H, W) bool
        """
        # 转换为 PIL Image 格式以使用 letterbox_resize
        if len(roi.shape) == 2:
            roi_rgb = cv2.cvtColor(roi, cv2.COLOR_GRAY2RGB)
        elif roi.shape[2] == 4:
            roi_rgb = cv2.cvtColor(roi, cv2.COLOR_RGBA2RGB)
        elif roi.shape[2] == 3:
            roi_rgb = cv2.cvtColor(roi, cv2.COLOR_BGR2RGB)
        else:
            roi_rgb = roi

        pil_img = Image.fromarray(roi_rgb)

        # 应用亮度和对比度归一化（在 letterbox_resize 之前）
        if normalize_brightness:
            pil_img = self._normalize_brightness_pil(pil_img)
        if normalize_contrast:
            pil_img = self._normalize_contrast_pil(pil_img)

        # 使用 letterbox_resize 保持宽高比（与训练时一致）
        if target_size is not None:
            img_padded, mask = letterbox_resize(pil_img, target_size)
        else:
            img_padded, mask = letterbox_resize(pil_img, self.input_size)

        # 转换为 numpy 数组并 resize 到模型输入尺寸
        roi_np = np.array(img_padded)
        roi_resized = cv2.resize(roi_np, self.input_size, interpolation=cv2.INTER_LINEAR)

        # resize mask 到 input_size
        mask_resized = cv2.resize(mask.astype(np.uint8), self.input_size, interpolation=cv2.INTER_NEAREST)
        mask = mask_resized.astype(bool)

        return roi_resized, mask

    def _preprocess_rois_to_batch(
        self,
        rois: List[np.ndarray],
        target_size: Tuple[int, int] = None,
        normalize_brightness: bool = False,
        normalize_contrast: bool = False,
    ) -> Tuple[Optional[torch.Tensor], List[np.ndarray]]:
        """将 ROI 列表预处理为可直接送入模型的归一化 tensor batch。

        跳过磁盘 I/O：letterbox + 亮度/对比度归一化 + Resize→CenterCrop→Normalize。
        返回 (image_batch_on_device, masks_list)。
        """
        if self.model is None:
            return None, []

        # 从模型的 pre_processor 提取变换参数，回退到 DinoV2 默认值
        try:
            pre_transform = self.model.pre_processor.transform
            resize_size = None
            crop_size = 392  # DinoV2 default
            for t in pre_transform.transforms:
                if isinstance(t, transforms.Resize):
                    resize_size = t.size  # (H, W) or int
                elif isinstance(t, transforms.CenterCrop):
                    crop_size = t.size  # int or (H, W)
            if resize_size is None:
                resize_size = (448, 448)
            if isinstance(resize_size, int):
                resize_size = (resize_size, resize_size)
            if isinstance(crop_size, (list, tuple)):
                crop_size = crop_size[0]
        except Exception:
            resize_size = (448, 448)
            crop_size = 392

        imagenet_mean = torch.tensor([0.485, 0.456, 0.406])
        imagenet_std = torch.tensor([0.229, 0.224, 0.225])

        tensors = []
        masks_out = []

        for roi in rois:
            # BGR → RGB（保持 numpy，避免 PIL 创建/销毁开销）
            if len(roi.shape) == 2:
                roi_rgb = cv2.cvtColor(roi, cv2.COLOR_GRAY2RGB)
            elif roi.shape[2] == 4:
                roi_rgb = cv2.cvtColor(roi, cv2.COLOR_RGBA2RGB)
            elif roi.shape[2] == 3:
                roi_rgb = cv2.cvtColor(roi, cv2.COLOR_BGR2RGB)
            else:
                roi_rgb = roi

            # 亮度/对比度归一化（numpy 原生实现，避免 PIL 往返）
            if normalize_brightness:
                roi_rgb = self._normalize_brightness_np(roi_rgb)
            if normalize_contrast:
                roi_rgb = self._autocontrast_np(roi_rgb)

            # letterbox_resize（cv2 版本，避免 PIL Image.new/paste 开销）
            _ts = target_size if target_size is not None else self.input_size
            img_padded, mask = letterbox_resize_cv2(roi_rgb, _ts)

            # Resize → CenterCrop → ToTensor → Normalize
            # F.to_tensor 直接接受 numpy (H,W,C) uint8，无需 PIL 中转
            t = transforms.functional.to_tensor(img_padded)  # (3, H, W) float [0,1]
            t = transforms.functional.resize(t, list(resize_size), antialias=True)
            t = transforms.functional.center_crop(t, crop_size)
            t = transforms.functional.normalize(
                t, mean=imagenet_mean.tolist(), std=imagenet_std.tolist()
            )

            tensors.append(t)
            masks_out.append(mask)

        batch = torch.stack(tensors).to(self.device)
        return batch, masks_out

    def _extract_score_with_mask(self, predictions, mask: np.ndarray) -> float:
        """
        从预测结果中提取单个分数，使用 mask 处理 anomaly_map。
        参考 anomalib_benchmark.py 中的实现，将 mask 区域外的 anomaly_map 清零。
        """
        score_keys = ['pred_score', 'anomaly_score', 'pred_scores', 'anomaly_scores']
        anomaly_map_keys = ['anomaly_map', 'anomaly_maps']

        for batch in predictions:
            # 尝试获取 anomaly_map
            anomaly_map = None
            for key in anomaly_map_keys:
                val = getattr(batch, key, None)
                if val is None and isinstance(batch, dict):
                    val = batch.get(key)
                if val is not None and isinstance(val, torch.Tensor):
                    # 取第一个样本的 anomaly_map
                    amap = val[0].squeeze().detach().cpu().numpy()
                    mask_resized = cv2.resize(
                        mask.astype(np.float32),
                        (amap.shape[1], amap.shape[0]),
                        interpolation=cv2.INTER_LINEAR
                    ) > 0.5
                    # 将 mask 外的区域清零
                    amap_masked = np.where(mask_resized, amap, 0.0)
                    # 使用有效区域的 top-1% 均值作为分数
                    valid_values = amap_masked[mask_resized]
                    if len(valid_values) > 0:
                        return float(np.percentile(valid_values, 99))
                    else:
                        return float(amap_masked.max())
            
            # 如果没有 anomaly_map，使用 pred_score
            for key in score_keys:
                val = getattr(batch, key, None)
                if val is None and isinstance(batch, dict):
                    val = batch.get(key)
                if val is not None:
                    if isinstance(val, torch.Tensor):
                        return float(val.detach().cpu().item())
                    else:
                        return float(val)
        
        return 0.0

    def _extract_scores_with_masks(self, predictions, masks: List[np.ndarray]) -> List[float]:
        """
        从预测结果中提取批量分数，使用 mask 处理 anomaly_map。
        """
        scores = []
        score_keys = ['pred_score', 'anomaly_score', 'pred_scores', 'anomaly_scores']
        anomaly_map_keys = ['anomaly_map', 'anomaly_maps']

        mask_idx = 0
        for batch in predictions:
            # 尝试获取 anomaly_map
            anomaly_maps = None
            for key in anomaly_map_keys:
                val = getattr(batch, key, None)
                if val is None and isinstance(batch, dict):
                    val = batch.get(key)
                if val is not None and isinstance(val, torch.Tensor):
                    anomaly_maps = val
                    break
            
            if anomaly_maps is not None:
                # 处理 batch 中的每个样本
                batch_size = anomaly_maps.shape[0]
                for i in range(batch_size):
                    if mask_idx >= len(masks):
                        break
                    mask = masks[mask_idx]
                    amap = anomaly_maps[i].squeeze().detach().cpu().numpy()
                    mask_resized = cv2.resize(
                        mask.astype(np.float32),
                        (amap.shape[1], amap.shape[0]),
                        interpolation=cv2.INTER_LINEAR
                    ) > 0.5
                    # 将 mask 外的区域清零
                    amap_masked = np.where(mask_resized, amap, 0.0)
                    # 使用有效区域的 top-1% 均值作为分数
                    valid_values = amap_masked[mask_resized]
                    if len(valid_values) > 0:
                        score = float(np.percentile(valid_values, 99))
                    else:
                        score = float(amap_masked.max())
                    scores.append(score)
                    mask_idx += 1
            else:
                # 如果没有 anomaly_map，使用 pred_score
                for key in score_keys:
                    val = getattr(batch, key, None)
                    if val is None and isinstance(batch, dict):
                        val = batch.get(key)
                    if val is not None:
                        if isinstance(val, torch.Tensor):
                            batch_scores = val.detach().cpu().numpy().flatten().tolist()
                            scores.extend(batch_scores)
                        else:
                            scores.append(float(val))
                        break
        
        return scores


