def letterbox_resize(
    img: Image.Image,
    target_size: Tuple[int, int],
    fill_color: Tuple[int, int, int] = (0, 0, 0),
) -> Tuple[Image.Image, np.ndarray]:
    """
    保持宽高比地将图片 padding 到 target_size，并返回有效区域的 binary mask。

    Returns:
        img_padded: PIL Image，尺寸为 target_size (H×W)
        mask:       np.ndarray bool (H, W)，True 表示原始像素，False 表示填充像素
    """
    th, tw = target_size
    ow, oh = img.size

    scale = min(tw / ow, th / oh)
    new_w = int(ow * scale)
    new_h = int(oh * scale)

    img_resized = img.resize((new_w, new_h), Image.BILINEAR)

    pad_left = (tw - new_w) // 2
    pad_top = (th - new_h) // 2

    img_padded = Image.new("RGB", (tw, th), fill_color)
    img_padded.paste(img_resized, (pad_left, pad_top))

    mask = np.zeros((th, tw), dtype=bool)
    mask[pad_top: pad_top + new_h, pad_left: pad_left + new_w] = True

    return img_padded, mask


def letterbox_resize_cv2(
    img_np: np.ndarray,
    target_size: Tuple[int, int],
    fill_color: Tuple[int, int, int] = (0, 0, 0),
) -> Tuple[np.ndarray, np.ndarray]:
    """
    cv2/numpy 版 letterbox_resize，避免 PIL Image 创建/粘贴开销。
    直接操作 numpy 数组，在热路径 (_preprocess_rois_to_batch) 中替代 PIL 版本。

    Args:
        img_np: RGB numpy 数组 (H, W, 3), uint8
        target_size: (H, W)
        fill_color: RGB 填充色

    Returns:
        img_padded: numpy 数组 (target_size[0], target_size[1], 3), uint8
        mask: bool 数组 (target_size[0], target_size[1]), True=有效像素
    """
    h, w = img_np.shape[:2]
    th, tw = target_size

    scale = min(tw / w, th / h)
    new_w = int(w * scale)
    new_h = int(h * scale)

    img_resized = cv2.resize(img_np, (new_w, new_h), interpolation=cv2.INTER_LINEAR)

    pad_left = (tw - new_w) // 2
    pad_top = (th - new_h) // 2

    img_padded = np.full((th, tw, 3), fill_color, dtype=np.uint8)
    img_padded[pad_top:pad_top + new_h, pad_left:pad_left + new_w] = img_resized

    mask = np.zeros((th, tw), dtype=bool)
    mask[pad_top:pad_top + new_h, pad_left:pad_left + new_w] = True

    return img_padded, mask


class ExecutorManager:
    def __init__(self, max_workers: int = 1):
        self._executor = ThreadPoolExecutor(max_workers=max_workers)
        self._max_workers = max_workers
        self._lock: Optional[asyncio.Lock] = None

    def init_lock(self):
        self._lock = asyncio.Lock()

    @property
    def executor(self) -> ThreadPoolExecutor:
        return self._executor

    async def rebuild(self, reason: str = ""):
        async with self._lock:
            old_executor = self._executor
            self._executor = ThreadPoolExecutor(max_workers=self._max_workers)
            if reason:
                logger.warning(f"[ExecutorManager] Rebuilding thread pool: {reason}")
            loop = asyncio.get_running_loop()
            loop.run_in_executor(None, old_executor.shutdown, True)


