@app.post("/predict", response_model=PredictROIResponse)
async def predict(
    file:  UploadFile = File(None),
    image: str        = Form(None)
):
    """
    支持文件上传（file=）和 base64（image=）两种方式。

    修复：
    - 使用 asyncio.get_running_loop()（替代已废弃的 get_event_loop()）
    - 超时/异常后先 cleanup 再调用 ExecutorManager.rebuild()，
      rebuild() 内部用 wait=True 确保旧线程真正结束，
      彻底避免旧线程里的 Paddle 张量与新线程产生 CUDA context 冲突
    - Semaphore 保证同一时刻只有一个请求进入推理链路
    - 新增：完整的性能监控和资源使用日志
    """
    start_time = time.time()
    request_id = f"{int(start_time * 1000)}"

    # 初始化性能监控器
    monitor = PerformanceMonitor(request_id)

    logger.info(f"[{request_id}] ========== PREDICTION REQUEST ==========")

    # 记录请求开始时的系统资源状态
    initial_resources = monitor.get_full_resource_snapshot()
    logger.info(f"[{request_id}] 🖥️ INITIAL SYSTEM STATE:")
    logger.info(f"[{request_id}]    CPU: {initial_resources['cpu']['usage_percent']:.1f}% (cores: {initial_resources['cpu']['core_count']})")
    logger.info(f"[{request_id}]    Memory: {initial_resources['memory']['used_gb']:.2f}GB / {initial_resources['memory']['total_gb']:.2f}GB ({initial_resources['memory']['usage_percent']}%)")
    if 'error' not in initial_resources['gpu']:
        logger.info(f"[{request_id}]    GPU: {initial_resources['gpu']['allocated_mb']:.1f}MB allocated, {initial_resources['gpu']['reserved_mb']:.1f}MB reserved")

    async with _infer_semaphore:
        try:
            # ── 解码图片 ──────────────────────────────────────────────────
            with monitor.step("image_decode"):
                image_data: Optional[np.ndarray] = None

                if file is not None:
                    logger.info(f"[{request_id}] file upload: {file.filename}")
                    contents   = await file.read()
                    nparr      = np.frombuffer(contents, np.uint8)
                    image_data = cv2.imdecode(nparr, cv2.IMREAD_COLOR)
                    logger.info(f"[{request_id}] file size={len(contents)} bytes")
                elif image is not None:
                    logger.info(f"[{request_id}] base64 input")
                    b64        = image.split(",")[1] if "," in image else image
                    nparr      = np.frombuffer(base64.b64decode(b64), np.uint8)
                    image_data = cv2.imdecode(nparr, cv2.IMREAD_COLOR)
                else:
                    raise HTTPException(status_code=400, detail="No image provided")

                if image_data is None:
                    raise HTTPException(status_code=400, detail="Invalid image")

                logger.info(f"[{request_id}] decoded image shape={image_data.shape}")

            if STFPM_DETECTOR is None:
                raise HTTPException(status_code=500, detail="Models not loaded")
            if TEMPLATE_IMAGE is None:
                raise HTTPException(status_code=500, detail="Template image not loaded")
            if not TEMPLATE_ANNOTATIONS:
                raise HTTPException(
                    status_code=400, detail="No template annotations available"
                )

            # ── 带超时的推理 ──────────────────────────────────────────────
            monitor.start_step("total_inference")
            loop = asyncio.get_running_loop()
            try:
                roi_results = await asyncio.wait_for(
                    loop.run_in_executor(
                        _executor_manager.executor,
                        lambda: detect_with_annotations(
                            STFPM_DETECTOR,
                            image_data,
                            TEMPLATE_IMAGE,
                            TEMPLATE_ANNOTATIONS,
                            request_id,
                            CACHED_TEMPLATE_GRAY,
                            monitor,  # 传递monitor到内部
                        )
                    ),
                    timeout=INFERENCE_TIMEOUT_SEC
                )
                monitor.end_step("total_inference")
            except asyncio.TimeoutError:
                monitor.end_step("total_inference")
                logger.error(
                    f"[{request_id}] Inference timeout after {INFERENCE_TIMEOUT_SEC}s, "
                    "rebuilding thread pool"
                )
                _cleanup(f"[{request_id}] timeout cleanup")
                await _executor_manager.rebuild(reason=f"timeout [{request_id}]")
                raise HTTPException(
                    status_code=503, detail="Inference timeout, please retry"
                )
            except Exception as exec_err:
                monitor.end_step("total_inference")
                logger.error(
                    f"[{request_id}] Executor error: {exec_err}, rebuilding thread pool"
                )
                _cleanup(f"[{request_id}] executor error cleanup")
                await _executor_manager.rebuild(reason=f"executor error [{request_id}]")
                raise

            processing_time    = time.time() - start_time
            anomaly_count      = sum(1 for r in roi_results if r.get('is_anomaly', False))
            infer_failed_count = sum(1 for r in roi_results if r.get('infer_failed', False))

            # 输出性能摘要
            monitor.log_summary()

            logger.info(f"[{request_id}] ========== RESULTS ==========")
            logger.info(
                f"[{request_id}] ROIs={len(roi_results)}, "
                f"anomalies={anomaly_count}, "
                f"infer_failed={infer_failed_count}, "
                f"time={processing_time:.3f}s"
            )
            for i, r in enumerate(roi_results):
                failed_tag = " [FAILED]" if r.get('infer_failed') else ""
                logger.info(
                    f"[{request_id}] ROI {i+1:2d}: "
                    f"{r.get('category','?'):8s} | "
                    f"{'ANOMALY' if r.get('is_anomaly') else 'NORMAL ':7s} | "
                    f"score={r.get('anomaly_score',0):.3f} | "
                    f"error={r.get('error',0):.3f} | "
                    f"threshold={r.get('threshold',0):.3f} | "
                    f"strategy={r.get('alignment_strategy','?')}"
                    f"{failed_tag}"
                )

            # 记录请求结束时的系统资源状态
            final_resources = monitor.get_full_resource_snapshot()
            logger.info(f"[{request_id}] 🖥️ FINAL SYSTEM STATE:")
            logger.info(f"[{request_id}]    CPU: {final_resources['cpu']['usage_percent']:.1f}%")
            logger.info(f"[{request_id}]    Memory: {final_resources['memory']['used_gb']:.2f}GB ({final_resources['memory']['usage_percent']}%)")
            if 'error' not in final_resources['gpu']:
                logger.info(f"[{request_id}]    GPU: {final_resources['gpu']['allocated_mb']:.1f}MB allocated")

            logger.info(f"[{request_id}] ========== REQUEST COMPLETED ==========")
            for handler in logger.handlers:
                handler.flush()

            return PredictROIResponse(
                results=roi_results,
                processing_time=processing_time,
                total_detections=len(roi_results),
                anomaly_count=anomaly_count,
                infer_failed_count=infer_failed_count,
            )

        except HTTPException:
            raise
        except Exception as e:
            logger.error(f"[{request_id}] Prediction error: {e}", exc_info=True)
            raise HTTPException(status_code=500, detail=str(e))


def signal_handler(sig, frame):
    logger.info("Shutting down inference service...")
    sys.exit(0)


signal.signal(signal.SIGINT,  signal_handler)
signal.signal(signal.SIGTERM, signal_handler)

