@app.post("/predict", response_model=PredictMultipleWorkpiecesResponse)
async def predict_multiple(
    file: UploadFile = File(None),
    image: str = Form(None),
    return_viz: bool = Form(False),
    rotations: str = Form(None),
    min_matches: int = Form(8),
    max_instances: int = Form(20),
):
    start_time = time.time()
    request_id = f"{int(start_time * 1000)}"
    monitor = PerformanceMonitor(request_id)

    logger.info(f"[{request_id}] ========== PREDICT REQUEST ==========")

    async with _infer_semaphore:
        try:
            with monitor.step("image_decode"):
                image_data: Optional[np.ndarray] = None
                decode_start = time.time()
                if file is not None:
                    contents = await file.read()
                    image_data = decode_image(contents, use_turbo=True)
                    decode_elapsed = time.time() - decode_start
                    turbo_status = "TurboJPEG" if is_turbo_jpeg_available() else "OpenCV"
                    logger.info(f"[{request_id}] 文件上传: {file.filename}, {len(contents)} bytes, 解码耗时: {decode_elapsed*1000:.1f}ms ({turbo_status})")
                elif image is not None:
                    b64 = image.split(",")[1] if "," in image else image
                    contents = base64.b64decode(b64)
                    image_data = decode_image(contents, use_turbo=True)
                    decode_elapsed = time.time() - decode_start
                    turbo_status = "TurboJPEG" if is_turbo_jpeg_available() else "OpenCV"
                    logger.info(f"[{request_id}] Base64输入, 解码耗时: {decode_elapsed*1000:.1f}ms ({turbo_status})")
                else:
                    raise HTTPException(status_code=400, detail="No image provided")

                if image_data is None:
                    raise HTTPException(status_code=400, detail="Invalid image")
                logger.info(f"[{request_id}] 图像解码成功 shape={image_data.shape}")

            if DINORMALY_DETECTOR is None:
                raise HTTPException(status_code=500, detail="Models not loaded")
            if TEMPLATE_IMAGE is None:
                raise HTTPException(status_code=500, detail="Template image not loaded")
            if not TEMPLATE_ANNOTATIONS:
                raise HTTPException(status_code=400, detail="No template annotations available")

            parsed_rotations = None
            if rotations:
                try:
                    parsed_rotations = json.loads(rotations)
                except Exception:
                    logger.warning(f"[{request_id}] 无法解析rotations参数: {rotations}")

            monitor.start_step("total_inference")
            try:
                detect_result = await asyncio.wait_for(
                    detect_multiple_workpieces(
                        DINORMALY_DETECTOR,
                        image_data,
                        TEMPLATE_IMAGE,
                        TEMPLATE_ANNOTATIONS,
                        request_id,
                        monitor,
                        return_visualization=return_viz,
                        lightglue_rotations=parsed_rotations,
                        lightglue_min_matches=min_matches,
                        lightglue_max_instances=max_instances,
                    ),
                    timeout=INFERENCE_TIMEOUT_SEC * 3,
                )
                monitor.end_step("total_inference")
            except asyncio.TimeoutError:
                monitor.end_step("total_inference")
                logger.error(f"[{request_id}] 推理超时 ({INFERENCE_TIMEOUT_SEC * 3}s)")
                _cleanup(f"[{request_id}] timeout")
                await _executor_manager.rebuild(reason=f"timeout [{request_id}]")
                raise HTTPException(status_code=503, detail="Inference timeout, please retry")
            except Exception as exec_err:
                monitor.end_step("total_inference")
                logger.error(f"[{request_id}] Executor error: {exec_err}")
                _cleanup(f"[{request_id}] executor error")
                await _executor_manager.rebuild(reason=f"executor error [{request_id}]")
                raise

            wp_results_raw = detect_result["workpiece_results"]
            visualization = detect_result.get("visualization")
            total_wp = detect_result.get("total_workpieces", 0)
            total_anoms = detect_result.get("total_anomalies", 0)
            processing_time = time.time() - start_time

            monitor.log_summary()
            logger.info(
                f"[{request_id}] 完成: workpieces={total_wp}, anomalies={total_anoms}, "
                f"time={processing_time:.3f}s"
            )
            logger.info(f"[{request_id}] ========== REQUEST COMPLETED ==========")
            for handler in logger.handlers:
                handler.flush()

            wp_results_pydantic = [
                WorkpieceResult(
                    workpiece_id=wp.get("workpiece_id", 0),
                    bbox=list(wp.get("bbox", [0, 0, 0, 0])),
                    results=wp.get("results", []),
                    anomaly_count=wp.get("anomaly_count", 0),
                    strategy=wp.get("strategy", "none"),
                    error=wp.get("error"),
                )
                for wp in wp_results_raw
            ]

            return PredictMultipleWorkpiecesResponse(
                workpiece_results=wp_results_pydantic,
                total_workpieces=total_wp,
                total_anomalies=total_anoms,
                processing_time=processing_time,
                visualization_b64=encode_image_to_base64(visualization) if visualization is not None else None,
            )

        except HTTPException:
            raise
        except Exception as e:
            logger.error(f"[{request_id}] Prediction error: {e}", exc_info=True)
            raise HTTPException(status_code=500, detail=str(e))


class GetRoiImagesRequest(BaseModel):
    task_uuid: str
    workpiece_id: str
    pos_id: str
    roi_filenames: Optional[List[str]] = None  # 如果为None，则返回该pos_id下的所有ROI
    normalize_brightness: bool = False  # 是否进行亮度归一化
    normalize_contrast: bool = False    # 是否进行对比度归一化


class RoiImageData(BaseModel):
    filename: str
    image_b64: str  # Base64编码的图像数据
    mask_b64: str   # Base64编码的mask数据
    width: int
    height: int


class GetRoiImagesResponse(BaseModel):
    success: bool
    message: str
    rois: List[RoiImageData] = []


def _encode_image_to_base64(img: np.ndarray) -> str:
    """将numpy图像编码为base64字符串"""
    _, buffer = cv2.imencode('.jpg', img)
    return base64.b64encode(buffer).decode('utf-8')


@app.post("/get_roi_images", response_model=GetRoiImagesResponse)
async def get_roi_images(request: GetRoiImagesRequest):
    """
    获取临时保存的ROI图像数据（经过预处理），以Base64格式返回。
    支持获取多张ROI图像。
    """
    try:
        # 构建源目录路径: output/{product_id}/{task_uuid}/temp/{workpiece_id}/{pos_id}/
        source_dir = PROJECT_ROOT / "output" / PROJECT_ID / request.task_uuid / "temp" / request.workpiece_id / request.pos_id

        if not source_dir.exists():
            return GetRoiImagesResponse(
                success=False,
                message=f"Source directory not found: {source_dir}",
                rois=[]
            )

        roi_images = []

        # 确定要处理的文件列表
        if request.roi_filenames:
            # 获取指定的文件
            source_files = []
            for filename in request.roi_filenames:
                file_path = source_dir / filename
                if file_path.exists():
                    source_files.append(file_path)
                else:
                    logger.warning(f"[GET_ROI] File not found: {file_path}")
        else:
            # 获取该目录下的所有jpg文件
            source_files = sorted(source_dir.glob("*.jpg"))

        if not source_files:
            return GetRoiImagesResponse(
                success=False,
                message=f"No ROI files found in {source_dir}",
                rois=[]
            )

        for source_file in source_files:
            try:
                # 读取原始ROI图像
                roi = cv2.imread(str(source_file))
                if roi is None:
                    logger.warning(f"[GET_ROI] Failed to read ROI: {source_file}")
                    continue

                # 直接返回原图，不做预处理
                image_b64 = _encode_image_to_base64(roi)

                height, width = roi.shape[:2]

                roi_images.append(RoiImageData(
                    filename=source_file.name,
                    image_b64=image_b64,
                    mask_b64="",
                    width=width,
                    height=height
                ))

                logger.info(f"[GET_ROI] Processed ROI: {source_file.name}")

            except Exception as e:
                logger.warning(f"[GET_ROI] Failed to process {source_file}: {e}")
                continue

        if roi_images:
            return GetRoiImagesResponse(
                success=True,
                message=f"Successfully processed {len(roi_images)} ROI(s)",
                rois=roi_images
            )
        else:
            return GetRoiImagesResponse(
                success=False,
                message="No ROIs were successfully processed",
                rois=[]
            )

    except Exception as e:
        logger.error(f"[GET_ROI] Error getting ROI images: {e}", exc_info=True)
        return GetRoiImagesResponse(
            success=False,
            message=f"Error: {str(e)}",
            rois=[]
        )


@app.get("/list_temp_rois")
async def list_temp_rois(task_uuid: str, workpiece_id: str, pos_id: str):
    """
    列出临时目录中保存的所有ROI文件。
    用于前端展示可供选择的ROI列表。
    """
    try:
        temp_dir = PROJECT_ROOT / "output" / PROJECT_ID / task_uuid / "temp" / workpiece_id / pos_id

        if not temp_dir.exists():
            return {
                "success": True,
                "rois": [],
                "message": "No temp directory found"
            }

        roi_files = sorted(temp_dir.glob("*.jpg"))
        roi_list = []

        for roi_file in roi_files:
            try:
                # 获取文件信息
                stat = roi_file.stat()
                roi_list.append({
                    "filename": roi_file.name,
                    "path": str(roi_file.relative_to(PROJECT_ROOT)),
                    "size_bytes": stat.st_size,
                    "created_at": datetime.fromtimestamp(stat.st_ctime).isoformat()
                })
            except Exception as e:
                logger.warning(f"[LIST_TEMP] Failed to get info for {roi_file}: {e}")
                continue

        return {
            "success": True,
            "rois": roi_list,
            "count": len(roi_list)
        }

    except Exception as e:
        logger.error(f"[LIST_TEMP] Error listing temp ROIs: {e}", exc_info=True)
        return {
            "success": False,
            "rois": [],
            "message": f"Error: {str(e)}"
        }


