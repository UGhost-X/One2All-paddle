def select_best_template_from_annotations(annotations_path: str) -> tuple:
    try:
        with open(annotations_path, 'r', encoding='utf-8') as f:
            data = json.load(f)

        images      = {img['id']: img for img in data.get('images', [])}
        annotations = data.get('annotations', [])

        no_flip = [
            ann for ann in annotations
            if not ann.get('horizontal_flip', False) and not ann.get('vertical_flip', False)
        ]
        if not no_flip:
            logger.warning("No annotations without flip found")
            return None, []

        no_flip.sort(key=lambda x: abs(x.get('angle', 0)))
        best      = no_flip[0]
        img_info  = images.get(best.get('image_id'))
        if not img_info:
            logger.warning(f"Image {best.get('image_id')} not found")
            return None, []

        ann_dir   = Path(annotations_path).parent
        file_name = img_info.get('file_name', '')

        for candidate in [
            ann_dir / "raw_images" / file_name,
            ann_dir / file_name,
            ann_dir / "images" / file_name,
        ]:
            if candidate.exists():
                template_path = str(candidate)
                break
        else:
            logger.warning(f"Template image not found for {file_name}")
            return None, []

        template_annotations = [
            {'category': ann.get('label', ''), 'bbox': ann.get('bbox', [0, 0, 0, 0])}
            for ann in no_flip
            if ann.get('image_id') == best.get('image_id') and ann.get('label')
        ]

        logger.info(
            f"Selected template: {file_name}, angle={best.get('angle', 0)}, "
            f"annotations={len(template_annotations)}"
        )
        return template_path, template_annotations

    except Exception as e:
        logger.error(f"Failed to select template from annotations: {e}")
        return None, []


# ─────────────────────────────────────────────────────────────────────────────
# Homography 对齐
# ─────────────────────────────────────────────────────────────────────────────

def enhance_for_matching(image):
    gray     = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    clahe    = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
    enhanced = clahe.apply(gray)
    return cv2.GaussianBlur(enhanced, (3, 3), 0)


def align_orb_homography(tg, pg, min_matches=10):
    orb = cv2.ORB_create(nfeatures=3000, scaleFactor=1.2, nlevels=8,
                         edgeThreshold=15, patchSize=31)
    kp1, des1 = orb.detectAndCompute(tg, None)
    kp2, des2 = orb.detectAndCompute(pg, None)
    if des1 is None or des2 is None or len(kp1) < min_matches or len(kp2) < min_matches:
        return None
    bf      = cv2.BFMatcher(cv2.NORM_HAMMING, crossCheck=True)
    matches = sorted(bf.match(des1, des2), key=lambda x: x.distance)
    if not matches:
        return None
    max_dist = max(m.distance for m in matches)
    good     = [m for m in matches if m.distance < 0.7 * max_dist]
    if len(good) < min_matches:
        return None
    pts1 = np.float32([kp1[m.queryIdx].pt for m in good]).reshape(-1, 1, 2)
    pts2 = np.float32([kp2[m.trainIdx].pt for m in good]).reshape(-1, 1, 2)
    H, _  = cv2.findHomography(pts1, pts2, cv2.RANSAC, 4.0)
    return H


def align_ecc(tg, pg):
    scale       = 0.5
    warp_matrix = np.eye(2, 3, dtype=np.float32)
    criteria    = (cv2.TERM_CRITERIA_EPS | cv2.TERM_CRITERIA_COUNT, 200, 1e-6)
    try:
        _, warp_matrix = cv2.findTransformECC(
            cv2.resize(tg, None, fx=scale, fy=scale),
            cv2.resize(pg, None, fx=scale, fy=scale),
            warp_matrix, cv2.MOTION_AFFINE, criteria
        )
        warp_matrix[0, 2] /= scale
        warp_matrix[1, 2] /= scale
        return np.vstack([warp_matrix, [0, 0, 1]])
    except Exception:
        return None


def align_contour_affine(ti, pi):
    def get_rect(img):
        gray     = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY) if len(img.shape) == 3 else img
        _, bin_  = cv2.threshold(gray, 0, 255, cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)
        kernel   = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (9, 9))
        bin_     = cv2.morphologyEx(bin_, cv2.MORPH_CLOSE, kernel, iterations=3)
        cnts, _  = cv2.findContours(bin_, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        return cv2.minAreaRect(max(cnts, key=cv2.contourArea)) if cnts else None

    rt, rp = get_rect(ti), get_rect(pi)
    if rt is None or rp is None:
        return None
    (cx_t, cy_t), (tw, th), at = rt
    (cx_p, cy_p), (pw, ph), ap = rp
    sx = pw / tw if tw > 0 else 1.0
    sy = ph / th if th > 0 else 1.0
    da = ap - at
    ca, sa = np.cos(np.radians(da)), np.sin(np.radians(da))
    return np.array([
        [sx * ca, -sx * sa, cx_p - sx * (ca * cx_t - sa * cy_t)],
        [sy * sa,  sy * ca, cy_p - sy * (sa * cx_t + ca * cy_t)],
        [0, 0, 1]
    ], dtype=np.float64)


def find_alignment_homography(template_img, pred_img):
    MATCH_SIZE = (512, 512)

    def resize_with_scale(img):
        h, w   = img.shape[:2]
        r      = cv2.resize(img, MATCH_SIZE)
        return r, w / MATCH_SIZE[0], h / MATCH_SIZE[1]

    tr, t_sx, t_sy = resize_with_scale(template_img)
    pr, p_sx, p_sy = resize_with_scale(pred_img)
    tg, pg         = enhance_for_matching(tr), enhance_for_matching(pr)

    H, strategy = None, None
    for fn, name in [
        (lambda: align_orb_homography(tg, pg), "ORB"),
        (lambda: align_ecc(tg, pg),            "ECC"),
        (lambda: align_contour_affine(tr, pr), "轮廓仿射对齐"),
    ]:
        H = fn()
        if H is not None:
            strategy = name
            break

    if H is None:
        return None, None

    S_t     = np.diag([1.0 / t_sx, 1.0 / t_sy, 1.0])
    S_p_inv = np.diag([p_sx, p_sy, 1.0])
    H_orig  = S_p_inv @ H @ S_t

    logger.info(f"[Homography] strategy={strategy}, "
                f"template=({template_img.shape[1]},{template_img.shape[0]}), "
                f"pred=({pred_img.shape[1]},{pred_img.shape[0]})")
    logger.info(f"[Homography] H_orig:\n{H_orig}")
    return H_orig, strategy


def transform_bbox_with_H(bbox, H, img_size=None):
    x, y, w, h = bbox
    corners = np.array(
        [[x, y], [x+w, y], [x+w, y+h], [x, y+h]], dtype=np.float32
    ).reshape(-1, 1, 2)
    t   = cv2.perspectiveTransform(corners, H).reshape(-1, 2)
    x0, y0 = np.min(t[:, 0]), np.min(t[:, 1])
    x1, y1 = np.max(t[:, 0]), np.max(t[:, 1])
    if img_size:
        iw, ih = img_size
        x0, y0 = max(0, min(x0, iw)), max(0, min(y0, ih))
        x1, y1 = max(0, min(x1, iw)), max(0, min(y1, ih))
    return [float(x0), float(y0), float(x1 - x0), float(y1 - y0)]


# ─────────────────────────────────────────────────────────────────────────────
# 主推理流程
# ─────────────────────────────────────────────────────────────────────────────

def detect_with_annotations(
    detector: MultiSTFPMDetector,
    image: np.ndarray,
    template_image: np.ndarray,
    annotations: List[Dict],
    request_id: str = ""
) -> List[Dict[str, Any]]:
    """
    Homography 对齐 + 按 category 批量推理（带 OOM 自动降级）。

    显存管理策略：
      - 批量推理失败时立即降级为逐个推理，并在失败后 cleanup
      - 每个 category 处理完后 cleanup 一次（category 间隙）
      - 整个函数 finally 里再 cleanup 一次兜底
    """
    if template_image is None or not annotations:
        return []

    pred_h, pred_w = image.shape[:2]
    results_map: Dict[int, Dict] = {}
    skipped_count = 0

    # ── 1. Homography 对齐 ────────────────────────────────────────────────
    H, strategy = find_alignment_homography(template_image, image)
    if H is None:
        logger.warning(f"[{request_id}] Homography 对齐失败，使用原图坐标")
        H, strategy = np.eye(3, dtype=np.float64), "none"
    else:
        logger.info(f"[{request_id}] Homography 对齐成功，策略: {strategy}")

    # ── 2. 变换 bbox，收集有效 ROI，按 category 分组 ─────────────────────
    pending: Dict[str, List] = {}   # {category: [(ann_idx, roi, base_item)]}

    for i, ann in enumerate(annotations):
        category      = ann.get('category')
        template_bbox = ann.get('bbox')

        if not category or not template_bbox or category not in detector.models:
            logger.warning(
                f"[{request_id}] Annotation {i+1}: 跳过 - "
                f"category={category}, in_models={category in detector.models if category else False}"
            )
            skipped_count += 1
            continue

        pred_bbox = transform_bbox_with_H(template_bbox, H, img_size=(pred_w, pred_h))
        x, y, w, h = [int(v) for v in pred_bbox]

        x_clip = max(0, min(x, pred_w - 1))
        y_clip = max(0, min(y, pred_h - 1))
        w_clip = max(0, min(w, pred_w - x_clip))
        h_clip = max(0, min(h, pred_h - y_clip))
        is_outside = (x < 0 or y < 0 or x + w > pred_w or y + h > pred_h)

        if w_clip < 5 or h_clip < 5:
            logger.warning(
                f"[{request_id}] Annotation {i+1} ({category}): 跳过 - "
                f"ROI太小 ({w_clip}x{h_clip})"
            )
            skipped_count += 1
            continue

        roi = image[y_clip:y_clip + h_clip, x_clip:x_clip + w_clip]
        if roi.size == 0:
            logger.warning(f"[{request_id}] Annotation {i+1} ({category}): 跳过 - ROI为空")
            skipped_count += 1
            continue

        t_x, t_y, t_w, t_h = template_bbox
        t_iw, t_ih = template_image.shape[1], template_image.shape[0]
        logger.info(
            f"[{request_id}] Annotation {i+1} ({category}): "
            f"template rel=({t_x/t_iw:.3f},{t_y/t_ih:.3f},{t_w/t_iw:.3f},{t_h/t_ih:.3f}) "
            f"pred rel=({x/pred_w:.3f},{y/pred_h:.3f},{w/pred_w:.3f},{h/pred_h:.3f}) "
            f"outside={is_outside}"
        )

        base_item = {
            'category':           category,
            'template_bbox':      template_bbox,
            'bbox':               [float(x), float(y), float(w), float(h)],
            'bbox_clipped':       [float(x_clip), float(y_clip), float(w_clip), float(h_clip)],
            'is_outside':         is_outside,
            'alignment_strategy': strategy,
        }
        pending.setdefault(category, []).append((i, roi, base_item))

    # ── 3. 按 category 批量推理（内置 OOM 降级 + category 间隙清理）──────
    try:
        for category, items in pending.items():
            ann_indices  = [it[0] for it in items]
            rois         = [it[1] for it in items]
            base_items   = [it[2] for it in items]

            logger.info(
                f"[{request_id}] Inferring category={category}, count={len(rois)}"
            )
            detections = detector.detect_category(rois, category, request_id)

            for ann_idx, base_item, det in zip(ann_indices, base_items, detections):
                result_item = dict(base_item)
                if det:
                    result_item.update(det)
                else:
                    result_item.update({
                        'is_anomaly': False, 'anomaly_score': 0.0,
                        'error': 0.0, 'threshold': 0.0,
                    })
                results_map[ann_idx] = result_item
    finally:
        # 兜底清理（即使中途异常也执行）
        _cleanup(f"[{request_id}] detect_with_annotations finally")

    results = [results_map[idx] for idx in sorted(results_map.keys())]
    logger.info(
        f"[{request_id}] Completed: {len(results)} processed, "
        f"{skipped_count} skipped, total {len(annotations)}"
    )
    return results


# ─────────────────────────────────────────────────────────────────────────────
# FastAPI
# ─────────────────────────────────────────────────────────────────────────────

MODELS: Dict[str, Any] = {}
MODEL_PATHS = {{ models_config | tojson(indent=4) }}
STFPM_DETECTOR: Optional[MultiSTFPMDetector] = None
TEMPLATE_IMAGE: Optional[np.ndarray] = None
TEMPLATE_ANNOTATIONS: List[Dict[str, Any]] = []


class PredictROIResponse(BaseModel):
    results: List[Dict[str, Any]]
    processing_time: float
    total_detections: int
    anomaly_count: int


def load_models():
    global STFPM_DETECTOR, MODELS, TEMPLATE_IMAGE, TEMPLATE_ANNOTATIONS

    model_dirs = {
        path for key, path in MODEL_PATHS.items()
        if not key.endswith('_type') and key not in ('_labels', '_model_type')
    }
    if not model_dirs:
        logger.warning("No model directories found")
        return

    base_dir       = Path(list(model_dirs)[0]).parent
    STFPM_DETECTOR = MultiSTFPMDetector(base_dir)
    MODELS         = {cat: {'loaded': True} for cat in STFPM_DETECTOR.get_loaded_categories()}
    logger.info(f"Loaded {len(MODELS)} models: {list(MODELS.keys())}")

    # 优先从 annotations.json 加载模板
    annotations_path = Path("{{ annotations_path }}") if "{{ annotations_path }}" else None
    if annotations_path and annotations_path.exists():
        tpl_path, tpl_anns = select_best_template_from_annotations(str(annotations_path))
        if tpl_path:
            TEMPLATE_IMAGE       = cv2.imread(tpl_path)
            TEMPLATE_ANNOTATIONS = tpl_anns
            if TEMPLATE_IMAGE is not None:
                logger.info(
                    f"Loaded template from annotations: {tpl_path}, "
                    f"annotations={len(TEMPLATE_ANNOTATIONS)}"
                )

    # 回退：从模型目录找 template.jpg
    if TEMPLATE_IMAGE is None:
        for model_dir in model_dirs:
            tpl = Path(model_dir) / "template.jpg"
            if tpl.exists():
                TEMPLATE_IMAGE = cv2.imread(str(tpl))
                if TEMPLATE_IMAGE is not None:
                    logger.info(f"Loaded template from: {tpl}")
                    break

    if TEMPLATE_IMAGE is None:
        logger.warning("No template image found")


@app.on_event("startup")
async def startup_event():
    load_models()


@app.get("/health")
async def health_check():
    return {
        "status":        "healthy",
        "service_id":    "{{ service_id }}",
        "project_id":    "{{ project_id }}",
        "task_uuid":     "{{ task_uuid }}",
        "loaded_models": list(MODELS.keys()),
        "total_models":  len(MODELS),
    }


@app.get("/models")
async def list_models():
    return {"models": list(MODELS.keys()), "loaded": list(MODELS.keys())}


@app.post("/predict", response_model=PredictROIResponse)
async def predict(
    file:  UploadFile = File(None),
    image: str        = Form(None)
):
    """
    支持文件上传（file=）和 base64（image=）两种方式。
    推理设有超时保护（INFERENCE_TIMEOUT_SEC），超时后自动重建线程池。
    """
    global executor

    start_time = time.time()
    request_id = f"{int(start_time * 1000)}"
    logger.info(f"[{request_id}] ========== PREDICTION REQUEST ==========")

    try:
        # ── 解码图片 ──────────────────────────────────────────────────────
        image_data: Optional[np.ndarray] = None

        if file is not None:
            logger.info(f"[{request_id}] file upload: {file.filename}")
            contents   = await file.read()
            nparr      = np.frombuffer(contents, np.uint8)
            image_data = cv2.imdecode(nparr, cv2.IMREAD_COLOR)
            logger.info(f"[{request_id}] file size={len(contents)} bytes")
        elif image is not None:
            logger.info(f"[{request_id}] base64 input")
            b64 = image.split(",")[1] if "," in image else image
            nparr      = np.frombuffer(base64.b64decode(b64), np.uint8)
            image_data = cv2.imdecode(nparr, cv2.IMREAD_COLOR)
        else:
            raise HTTPException(status_code=400, detail="No image provided")

        if image_data is None:
            raise HTTPException(status_code=400, detail="Invalid image")

        logger.info(f"[{request_id}] decoded image shape={image_data.shape}")

        if STFPM_DETECTOR is None:
            raise HTTPException(status_code=500, detail="Models not loaded")
        if TEMPLATE_IMAGE is None:
            raise HTTPException(status_code=500, detail="Template image not loaded")
        if not TEMPLATE_ANNOTATIONS:
            raise HTTPException(status_code=400, detail="No template annotations available")

        # ── 带超时的推理 ──────────────────────────────────────────────────
        loop = asyncio.get_event_loop()
        try:
            roi_results = await asyncio.wait_for(
                loop.run_in_executor(
                    executor,
                    detect_with_annotations,
                    STFPM_DETECTOR,
                    image_data,
                    TEMPLATE_IMAGE,
                    TEMPLATE_ANNOTATIONS,
                    request_id
                ),
                timeout=INFERENCE_TIMEOUT_SEC
            )
        except asyncio.TimeoutError:
            # 线程挂起（常见于 GPU OOM 后 Paddle 不抛异常的情况）
            logger.error(
                f"[{request_id}] Inference timeout after {INFERENCE_TIMEOUT_SEC}s, "
                "rebuilding thread pool"
            )
            executor.shutdown(wait=False)
            executor = ThreadPoolExecutor(max_workers=1)
            raise HTTPException(status_code=503, detail="Inference timeout, please retry")
        except Exception as exec_err:
            # 线程内抛出异常，同样重建线程池防止后续请求卡住
            logger.error(
                f"[{request_id}] Executor error, rebuilding thread pool: {exec_err}"
            )
            executor.shutdown(wait=False)
            executor = ThreadPoolExecutor(max_workers=1)
            raise

        processing_time = time.time() - start_time
        anomaly_count   = sum(1 for r in roi_results if r.get('is_anomaly', False))

        logger.info(f"[{request_id}] ========== RESULTS ==========")
        logger.info(f"[{request_id}] ROIs={len(roi_results)}, anomalies={anomaly_count}, "
                    f"time={processing_time:.3f}s")
        for i, r in enumerate(roi_results):
            logger.info(
                f"[{request_id}] ROI {i+1:2d}: {r.get('category','?'):8s} | "
                f"{'ANOMALY' if r.get('is_anomaly') else 'NORMAL ':7s} | "
                f"score={r.get('anomaly_score',0):.3f} | "
                f"error={r.get('error',0):.3f} | "
                f"threshold={r.get('threshold',0):.3f} | "
                f"strategy={r.get('alignment_strategy','?')}"
            )
        logger.info(f"[{request_id}] ========== REQUEST COMPLETED ==========")

        return PredictROIResponse(
            results=roi_results,
            processing_time=processing_time,
            total_detections=len(roi_results),
            anomaly_count=anomaly_count
        )

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"[{request_id}] Prediction error: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail=str(e))


def signal_handler(sig, frame):
    logger.info("Shutting down inference service...")
    sys.exit(0)


signal.signal(signal.SIGINT, signal_handler)
signal.signal(signal.SIGTERM, signal_handler)

