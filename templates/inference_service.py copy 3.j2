def _extract_features_for_negative_bank(model_wrapper, roi: np.ndarray) -> Optional[torch.Tensor]:
    """
    从ROI图像中提取特征，用于添加到反例库
    
    Args:
        model_wrapper: 模型包装器
        roi: ROI图像
        
    Returns:
        特征张量 [H*W, C] 或 None
    """
    try:
        
        if hasattr(model_wrapper, 'preprocess_roi'):
            tensor = model_wrapper.preprocess_roi(roi).unsqueeze(0).to(model_wrapper.device)
        else:
            
            if len(roi.shape) == 2:
                roi = cv2.cvtColor(roi, cv2.COLOR_GRAY2RGB)
            elif roi.shape[2] == 4:
                roi = cv2.cvtColor(roi, cv2.COLOR_RGBA2RGB)
            elif roi.shape[2] == 3:
                roi = cv2.cvtColor(roi, cv2.COLOR_BGR2RGB)
            
            roi_resized = cv2.resize(roi, (224, 224))
            roi_normalized = roi_resized.astype(np.float32) / 255.0
            mean = np.array([0.485, 0.456, 0.406], dtype=np.float32)
            std = np.array([0.229, 0.224, 0.225], dtype=np.float32)
            roi_normalized = (roi_normalized - mean) / std
            tensor = torch.from_numpy(roi_normalized.transpose(2, 0, 1)).unsqueeze(0).to(model_wrapper.device)
        
        with torch.no_grad():
            
            features = model_wrapper.model.feature_extractor(tensor)
            features = {layer: model_wrapper.model.feature_pooler(feature) for layer, feature in features.items()}
            embedding = model_wrapper.model.generate_embedding(features)
            
            
            B, C, H, W = embedding.shape
            embedding_reshaped = embedding.permute(0, 2, 3, 1).reshape(-1, C)
            
            
            embedding_reshaped = torch.nn.functional.normalize(embedding_reshaped, dim=-1)
            
        return embedding_reshaped.cpu()
        
    except Exception as e:
        logger.error(f"Failed to extract features for negative bank: {e}")
        return None


def _initialize_negative_bank_for_pos_id(pos_id: str) -> bool:
    """
    为指定pos_id初始化反例库
    
    Args:
        pos_id: 位置ID
        
    Returns:
        是否成功初始化
    """
    global PATCHCORE_DETECTOR
    
    if PATCHCORE_DETECTOR is None or pos_id not in PATCHCORE_DETECTOR.models:
        logger.error(f"Model not found for pos_id={pos_id}")
        return False
    
    model = PATCHCORE_DETECTOR.models[pos_id]
    
    
    if hasattr(model, 'neg_memory_bank') and model.neg_memory_bank is not None:
        logger.info(f"Negative bank already exists for pos_id={pos_id}")
        return True
    
    
    if not hasattr(model, 'neg_memory_bank'):
        logger.info(f"Converting model to dual-bank for pos_id={pos_id}")
        
        
        try:
            new_model = AnomalibPatchCoreWrapperDual(
                backbone=model.backbone,
                layers=model.layers,
                num_neighbors=model.num_neighbors,
                device=str(model.device),
            )
            
            
            new_model.model = model.model
            new_model.pos_memory_bank = model.memory_bank if hasattr(model, 'memory_bank') else model.pos_memory_bank
            new_model.config = model.config
            new_model.input_size = model.input_size
            new_model.normalize_brightness_config = model.normalize_brightness_config
            new_model.normalize_contrast_config = model.normalize_contrast_config
            
            
            feature_dim = new_model.pos_memory_bank.shape[1]
            new_model.neg_memory_bank = torch.empty(0, feature_dim).to(model.device)
            
            
            new_model.dual_detector = DualMemoryBankDetector(
                new_model.pos_memory_bank,
                new_model.neg_memory_bank
            )
            new_model.dual_detector.num_neighbors = model.num_neighbors
            
            
            PATCHCORE_DETECTOR.models[pos_id] = new_model
            
            logger.info(f"Successfully initialized negative bank for pos_id={pos_id}")
            return True
            
        except Exception as e:
            logger.error(f"Failed to initialize negative bank for pos_id={pos_id}: {e}")
            return False
    
    
    if hasattr(model, 'pos_memory_bank') and model.pos_memory_bank is not None:
        feature_dim = model.pos_memory_bank.shape[1]
        model.neg_memory_bank = torch.empty(0, feature_dim).to(model.device)
        model.dual_detector.neg_memory_bank = model.neg_memory_bank
        logger.info(f"Initialized empty negative bank for pos_id={pos_id}")
        return True
    
    return False


@app.get("/negative_banks", response_model=NegativeBankListResponse)
async def list_negative_banks():
    """
    获取所有模型的反例库信息
    """
    if PATCHCORE_DETECTOR is None:
        raise HTTPException(status_code=500, detail="Models not loaded")
    
    banks = []
    models_with_negative = 0
    
    for pos_id, model in PATCHCORE_DETECTOR.models.items():
        has_negative = hasattr(model, 'neg_memory_bank') and model.neg_memory_bank is not None
        if has_negative:
            models_with_negative += 1
            neg_size = len(model.neg_memory_bank) if model.neg_memory_bank is not None else 0
        else:
            neg_size = 0
        
        pos_size = 0
        if hasattr(model, 'pos_memory_bank') and model.pos_memory_bank is not None:
            pos_size = len(model.pos_memory_bank)
        elif hasattr(model, 'memory_bank') and model.memory_bank is not None:
            pos_size = len(model.memory_bank)
        
        banks.append(NegativeBankInfo(
            pos_id=pos_id,
            has_negative_bank=has_negative and neg_size > 0,
            negative_bank_size=neg_size,
            positive_bank_size=pos_size,
        ))
    
    return NegativeBankListResponse(
        total_models=len(banks),
        models_with_negative=models_with_negative,
        banks=banks,
    )


@app.post("/negative_banks/{pos_id}/initialize")
async def initialize_negative_bank(pos_id: str):
    """
    为指定pos_id初始化反例库
    
    Args:
        pos_id: 位置ID
    """
    if PATCHCORE_DETECTOR is None:
        raise HTTPException(status_code=500, detail="Models not loaded")
    
    if pos_id not in PATCHCORE_DETECTOR.models:
        raise HTTPException(status_code=404, detail=f"Model not found for pos_id={pos_id}")
    
    success = _initialize_negative_bank_for_pos_id(pos_id)
    
    if success:
        model = PATCHCORE_DETECTOR.models[pos_id]
        neg_size = len(model.neg_memory_bank) if hasattr(model, 'neg_memory_bank') and model.neg_memory_bank is not None else 0
        return {
            "success": True,
            "pos_id": pos_id,
            "message": "Negative bank initialized successfully",
            "negative_bank_size": neg_size,
        }
    else:
        raise HTTPException(status_code=500, detail=f"Failed to initialize negative bank for pos_id={pos_id}")


@app.post("/negative_banks/{pos_id}/add", response_model=NegativeExampleResponse)
async def add_negative_example(
    pos_id: str,
    file: UploadFile = File(None),
    image: str = Form(None),
):
    """
    为指定pos_id添加反例图像
    
    Args:
        pos_id: 位置ID
        file: 上传的反例图像文件
        image: Base64编码的图像
    """
    if PATCHCORE_DETECTOR is None:
        raise HTTPException(status_code=500, detail="Models not loaded")
    
    if pos_id not in PATCHCORE_DETECTOR.models:
        raise HTTPException(status_code=404, detail=f"Model not found for pos_id={pos_id}")
    
    
    try:
        if file is not None:
            contents = await file.read()
            nparr = np.frombuffer(contents, np.uint8)
            roi = cv2.imdecode(nparr, cv2.IMREAD_COLOR)
        elif image is not None:
            b64 = image.split(",")[1] if "," in image else image
            nparr = np.frombuffer(base64.b64decode(b64), np.uint8)
            roi = cv2.imdecode(nparr, cv2.IMREAD_COLOR)
        else:
            raise HTTPException(status_code=400, detail="No image provided")
        
        if roi is None or roi.size == 0:
            raise HTTPException(status_code=400, detail="Invalid image")
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Image decode error: {str(e)}")
    
    
    model = PATCHCORE_DETECTOR.models[pos_id]
    if not hasattr(model, 'neg_memory_bank') or model.neg_memory_bank is None:
        success = _initialize_negative_bank_for_pos_id(pos_id)
        if not success:
            raise HTTPException(status_code=500, detail=f"Failed to initialize negative bank for pos_id={pos_id}")
        model = PATCHCORE_DETECTOR.models[pos_id]  
    
    
    features = _extract_features_for_negative_bank(model, roi)
    if features is None:
        raise HTTPException(status_code=500, detail="Failed to extract features from image")
    
    
    try:
        device = model.device
        if model.neg_memory_bank is None or len(model.neg_memory_bank) == 0:
            model.neg_memory_bank = features.to(device)
        else:
            model.neg_memory_bank = torch.cat([model.neg_memory_bank, features.to(device)], dim=0)

        
        if hasattr(model, 'dual_detector') and model.dual_detector is not None:
            model.dual_detector.neg_memory_bank = model.neg_memory_bank

        neg_size = len(model.neg_memory_bank)
        logger.info(f"Added negative example to pos_id={pos_id}, total size: {neg_size}")

        
        save_success = _save_negative_bank_to_disk(pos_id)
        neg_bank_path = _get_negative_bank_path(pos_id)

        
        neg_samples_dir = PATCHCORE_DETECTOR.models_dir / pos_id / "neg_samples"
        neg_samples_dir.mkdir(parents=True, exist_ok=True)
        sample_index = neg_size
        sample_path = neg_samples_dir / f"neg_sample_{sample_index}.jpg"
        cv2.imwrite(str(sample_path), roi)
        logger.info(f"Saved negative sample image to {sample_path}")

        message = f"Negative example added successfully"
        if save_success:
            message += f", saved to {neg_bank_path}"
        else:
            message += ", but failed to save to disk"
        message += f", sample image saved to {sample_path}"

        return NegativeExampleResponse(
            success=True,
            pos_id=pos_id,
            message=message,
            negative_bank_size=neg_size,
            sample_image_path=str(sample_path),
        )
        
    except Exception as e:
        logger.error(f"Failed to add negative example: {e}")
        raise HTTPException(status_code=500, detail=f"Failed to add negative example: {str(e)}")


