def chunked_cdist(x: torch.Tensor, y: torch.Tensor, chunk_size: int = 1024) -> torch.Tensor:
    """
    分块计算cdist，避免大矩阵OOM
    Args:
        x: [N, D] 查询向量
        y: [M, D] 记忆库
        chunk_size: 每块大小
    Returns:
        distances: [N, M]
    """
    n = x.shape[0]
    m = y.shape[0]
    
    
    if n * m < chunk_size * chunk_size * 4:
        return torch.cdist(x, y)
    
    
    distances = []
    for i in range(0, n, chunk_size):
        end_i = min(i + chunk_size, n)
        chunk_x = x[i:end_i]
        
        chunk_dist = torch.cdist(chunk_x, y)
        distances.append(chunk_dist)
    
    return torch.cat(distances, dim=0)


def _preprocess_roi(roi: np.ndarray) -> np.ndarray:
    """
    将单个 ROI 预处理为 CHW float32 numpy 数组（ImageNet 归一化）
    返回 shape: (3, 224, 224)
    """
    img = roi.copy()
    if len(img.shape) == 2:
        img = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)
    elif img.shape[2] == 4:
        img = cv2.cvtColor(img, cv2.COLOR_BGRA2RGB)
    else:
        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

    img  = cv2.resize(img, (224, 224)).astype(np.float32) / 255.0
    mean = np.array([0.485, 0.456, 0.406], dtype=np.float32)
    std  = np.array([0.229, 0.224, 0.225], dtype=np.float32)
    img  = (img - mean) / std
    return np.transpose(img, (2, 0, 1))


def cv2_put_chinese_text(img, text, position, color, font_size=20):
    from PIL import Image, ImageDraw, ImageFont
    color_rgb = (color[2], color[1], color[0])
    pil_img   = Image.fromarray(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
    draw      = ImageDraw.Draw(pil_img)
    font = None
    for fp in [
        "/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc",
        "/usr/share/fonts/truetype/wqy/wqy-microhei.ttc",
        "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
    ]:
        if os.path.exists(fp):
            try:
                font = ImageFont.truetype(fp, font_size)
                break
            except Exception:
                continue
    if font is None:
        font = ImageFont.load_default()
    draw.text(position, text, font=font, fill=color_rgb)
    return cv2.cvtColor(np.array(pil_img), cv2.COLOR_RGB2BGR)






class MultiScaleFeatureExtractor(torch_nn.Module):
    GRAY_CHANNELS = 4

    UPSAMPLE_TARGETS = {
        "micro": (16, 16),
        "tiny": (16, 16),
        "small": (32, 32),
        "medium": (64, 64),
    }

    SIZE_THRESHOLD_MICRO = 8
    SIZE_THRESHOLD_SMALL = 16
    SIZE_THRESHOLD_MEDIUM = 32

    def __init__(self, backbone_name: str = "resnet18"):
        super().__init__()

        if backbone_name == "resnet50":
            backbone = torchvision_models.resnet50(pretrained=True)
            self.layer1_channels = 256
            self.layer2_channels = 512
        else:
            backbone = torchvision_models.resnet18(pretrained=True)
            self.layer1_channels = 64
            self.layer2_channels = 128

        self.stem = torch_nn.Sequential(
            backbone.conv1,
            backbone.bn1,
            backbone.relu,
            torch_nn.MaxPool2d(kernel_size=3, stride=1, padding=1),
        )

        self.layer1 = backbone.layer1
        self.layer2 = backbone.layer2

        if hasattr(self.layer2[0], 'conv1'):
            if hasattr(self.layer2[0], 'downsample') and self.layer2[0].downsample is not None:
                for module in self.layer2[0].downsample:
                    if isinstance(module, torch_nn.Conv2d):
                        module.stride = (1, 1)
            self.layer2[0].conv1.stride = (1, 1)
        elif hasattr(self.layer2[0], 'conv2'):
            if hasattr(self.layer2[0], 'downsample') and self.layer2[0].downsample is not None:
                for module in self.layer2[0].downsample:
                    if isinstance(module, torch_nn.Conv2d):
                        module.stride = (1, 1)
            self.layer2[0].conv2.stride = (1, 1)

        self.out_channels = self.layer1_channels + self.layer2_channels + self.GRAY_CHANNELS

        for param in self.parameters():
            param.requires_grad = False

    def _get_target_size(self, x: torch.Tensor) -> tuple:
        max_size = max(x.shape[2], x.shape[3])
        if max_size <= self.SIZE_THRESHOLD_MICRO:
            return self.UPSAMPLE_TARGETS["micro"]
        elif max_size <= self.SIZE_THRESHOLD_SMALL:
            return self.UPSAMPLE_TARGETS["tiny"]
        elif max_size <= self.SIZE_THRESHOLD_MEDIUM:
            return self.UPSAMPLE_TARGETS["small"]
        else:
            return self.UPSAMPLE_TARGETS["medium"]

    def _compute_gray_features(self, x: torch.Tensor, target_size: tuple) -> torch.Tensor:
        gray = x.mean(dim=1, keepdim=True)
        gray_feat = F_torch.interpolate(
            gray,
            size=target_size,
            mode="bilinear",
            align_corners=False,
        )
        gray_feat = gray_feat.repeat(1, self.GRAY_CHANNELS, 1, 1)
        return F_torch.normalize(gray_feat, dim=1)

    def forward(self, x: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
        """
        返回 (patches, valid_mask)
        patches:    [B, H*W, C]  已 L2 归一化
        valid_mask: [B, H*W]     True 表示有效区域（非 padding）
        """
        orig_h, orig_w = x.shape[2], x.shape[3]
        target_size = self._get_target_size(x)
        need_upsample = x.shape[2:] != target_size
        if need_upsample:
            x = F_torch.interpolate(
                x,
                size=target_size,
                mode="bilinear",
                align_corners=False
            )

        x_stem = self.stem(x)
        f1 = self.layer1(x_stem)
        f2 = self.layer2(f1)

        f1_norm = F_torch.normalize(f1, dim=1)
        f2_norm = F_torch.normalize(f2, dim=1)

        if x.shape[1] == 3:
            gray_feat = self._compute_gray_features(x, f2.shape[-2:])
            combined = torch.cat([f1_norm, f2_norm, gray_feat], dim=1)
        else:
            combined = torch.cat([f1_norm, f2_norm], dim=1)

        B, C, H, W = combined.shape
        patches = combined.permute(0, 2, 3, 1).reshape(B, H * W, C)
        patches = F_torch.normalize(patches, dim=-1)

        
        if need_upsample:
            up_h, up_w = H, W
            valid_h = min(orig_h, up_h)
            valid_w = min(orig_w, up_w)
            top  = int((up_h - valid_h) // 2)
            left = int((up_w - valid_w) // 2)
            mask = torch.zeros(B, H, W, dtype=torch.bool, device=patches.device)
            mask[:, top:top + valid_h, left:left + valid_w] = True
            valid_mask = mask.reshape(B, H * W)
        else:
            valid_mask = torch.ones(B, H * W, dtype=torch.bool, device=patches.device)

        return patches, valid_mask






from anomalib.models.image.patchcore.torch_model import PatchcoreModel as AnomalibPatchCoreModel


class AnomalibPatchCoreWrapper:
    """
    基于 anomalib PatchCore 的推理封装类
    参考 predict_patchcore.py 重构
    """

    def __init__(self, backbone: str, layers: list, num_neighbors: int = 9, device: str = "cuda"):
        self.backbone = backbone
        self.layers = layers
        self.num_neighbors = num_neighbors
        self.device = torch.device(device if torch.cuda.is_available() else "cpu")
        self.model: Optional[AnomalibPatchCoreModel] = None
        self.memory_bank: Optional[torch.Tensor] = None
        self.config: Dict[str, Any] = {}
        self.input_size = (224, 224)

        self.normalize_brightness_config = False
        self.normalize_contrast_config = False

    def load_from_checkpoint(self, model_path: str):
        checkpoint = torch.load(model_path, map_location=self.device)
        self.load_from_checkpoint_dict(checkpoint)

    def load_from_checkpoint_dict(self, checkpoint: Dict):
        """从已加载的checkpoint字典初始化，避免重复加载文件"""
        
        layers = checkpoint.get("layers", ["layer2", "layer3"])
        backbone = checkpoint.get("backbone", "resnet18")
        num_neighbors = checkpoint.get("num_neighbors", 9)

        self.backbone = backbone
        self.layers = layers
        self.num_neighbors = num_neighbors
        self.input_size = (224, 224)

        
        self.config = {
            "layers": layers,
            "backbone": backbone,
            "num_neighbors": num_neighbors,
        }

        self.model = AnomalibPatchCoreModel(
            layers=layers,
            backbone=backbone,
            pre_trained=False,
            num_neighbors=num_neighbors,
        ).to(self.device)

        self.model.load_state_dict(checkpoint["model_state_dict"])
        self.model.eval()

        
        self.memory_bank = checkpoint.get("memory_bank")
        if self.memory_bank is not None:
            self.memory_bank = self.memory_bank.to(self.device)
            self.model.memory_bank = self.memory_bank

    def load_config(self, config_path: str):
        """加载 config.json 配置"""
        if os.path.exists(config_path):
            with open(config_path, "r", encoding="utf-8") as f:
                config = json.load(f)
                self.config.update(config)
                self.normalize_brightness_config = config.get("normalize_brightness", False)
                self.normalize_contrast_config = config.get("normalize_contrast", False)
                
                self.target_size = config.get("target_size", None)
                if self.target_size:
                    logger.info(f"Loaded target_size from config: {self.target_size}")

    @staticmethod
    def _normalize_brightness(image: np.ndarray, target_mean: float = 168.0, threshold: int = 10) -> np.ndarray:
        """对图片进行亮度归一化"""
        arr = image.astype(np.float32)
        brightness = arr.mean(axis=2)
        hole_mask = brightness > threshold
        if np.sum(hole_mask) == 0:
            return image
        current_mean = arr[hole_mask].mean()
        if current_mean > 0:
            scale = target_mean / current_mean
            arr[hole_mask] = np.clip(arr[hole_mask] * scale, 0, 255)
        return arr.astype(np.uint8)

    @staticmethod
    def _normalize_contrast(image: np.ndarray, target_std: float = 65.0, threshold: int = 10) -> np.ndarray:
        """对图片进行对比度归一化"""
        arr = image.astype(np.float32)
        brightness = arr.mean(axis=2)
        hole_mask = brightness > threshold
        if np.sum(hole_mask) == 0:
            return image
        current_mean = arr[hole_mask].mean()
        current_std = arr[hole_mask].std()
        if current_std > 0:
            arr[hole_mask] = (arr[hole_mask] - current_mean) / current_std * target_std + current_mean
            arr = np.clip(arr, 0, 255)
        return arr.astype(np.uint8)

    @staticmethod
    def _pad_to_size(roi: np.ndarray, target_size: Tuple[int, int]) -> np.ndarray:
        """
        通过 padding 将 ROI 调整到目标尺寸（保持居中）
        
        Args:
            roi: 输入图片 (H, W, C)
            target_size: 目标尺寸 (width, height)
            
        Returns:
            padding 后的图片
        """
        current_height, current_width = roi.shape[:2]
        target_width, target_height = target_size

        
        if current_width >= target_width and current_height >= target_height:
            return roi

        
        pad_left = (target_width - current_width) // 2
        pad_right = target_width - current_width - pad_left
        pad_top = (target_height - current_height) // 2
        pad_bottom = target_height - current_height - pad_top

        
        if len(roi.shape) == 3:
            padded = np.zeros((target_height, target_width, roi.shape[2]), dtype=roi.dtype)
        else:
            padded = np.zeros((target_height, target_width), dtype=roi.dtype)

        
        padded[pad_top:pad_top + current_height, pad_left:pad_left + current_width] = roi

        return padded

    def preprocess_roi(self, roi: np.ndarray, target_size: Tuple[int, int] = None, normalize_brightness: bool = False, normalize_contrast: bool = False) -> torch.Tensor:
        """预处理 ROI 图片"""
        if len(roi.shape) == 2:
            roi = cv2.cvtColor(roi, cv2.COLOR_GRAY2RGB)
        elif roi.shape[2] == 4:
            roi = cv2.cvtColor(roi, cv2.COLOR_RGBA2RGB)
        elif roi.shape[2] == 3:
            roi = cv2.cvtColor(roi, cv2.COLOR_BGR2RGB)

        
        if target_size is not None:
            roi = self._pad_to_size(roi, target_size)

        
        if normalize_brightness:
            roi = self._normalize_brightness(roi)

        
        if normalize_contrast:
            roi = self._normalize_contrast(roi)

        
        roi_resized = cv2.resize(roi, self.input_size, interpolation=cv2.INTER_LINEAR)

        
        roi_normalized = roi_resized.astype(np.float32) / 255.0
        tensor = torch.from_numpy(roi_normalized).permute(2, 0, 1)

        normalize = transforms.Normalize(
            mean=[0.485, 0.456, 0.406],
            std=[0.229, 0.224, 0.225]
        )
        tensor = normalize(tensor)
        return tensor

    def infer_single(self, roi: np.ndarray, target_size: Tuple[int, int] = None, normalize_brightness: bool = None, normalize_contrast: bool = None) -> Dict[str, Any]:
        """
        推理单张图片
        参考 predict_patchcore.py 的推理逻辑重构
        """
        if self.model is None:
            return {"error": 0.0, "infer_failed": True}

        
        if normalize_brightness is None:
            normalize_brightness = self.normalize_brightness_config
        if normalize_contrast is None:
            normalize_contrast = self.normalize_contrast_config
        
        if target_size is None:
            target_size = getattr(self, 'target_size', None)

        try:
            tensor = self.preprocess_roi(roi, target_size, normalize_brightness, normalize_contrast).unsqueeze(0).to(self.device)

            with torch.no_grad():
                
                features = self.model.feature_extractor(tensor)
                features = {layer: self.model.feature_pooler(feature) for layer, feature in features.items()}
                embedding = self.model.generate_embedding(features)

                
                batch_size, channels, height, width = embedding.shape
                embedding_reshaped = embedding.permute(0, 2, 3, 1).reshape(-1, channels)

                
                distances = chunked_cdist(embedding_reshaped, self.model.memory_bank, chunk_size=1024)

                
                top_k_plus_1_distances, _ = torch.topk(
                    distances, k=self.num_neighbors + 1, largest=False, dim=1
                )
                
                top_k_distances = top_k_plus_1_distances[:, 1:]
                patch_scores = top_k_distances.mean(dim=1)

                
                patch_scores_map = patch_scores.reshape(batch_size, height, width)

                
                anomaly_map = torch.nn.functional.interpolate(
                    patch_scores_map.unsqueeze(1),
                    size=(224, 224),
                    mode='bilinear',
                    align_corners=False
                ).squeeze(1)

                
                anomaly_score = anomaly_map.max()

            return {"error": float(anomaly_score.item()), "infer_failed": False}

        except Exception as e:
            logger.error(f"[AnomalibPatchCoreWrapper] inference failed: {e}")
            return {"error": 0.0, "infer_failed": True}

        finally:
            if self.device.type == "cuda":
                torch.cuda.empty_cache()






class DualMemoryBankDetector:
    """
    双库推理检测器 - 同时维护正例库和反例库
    
    核心逻辑：
    1. 正例库（Positive Memory Bank）：存储正常样本特征
    2. 反例库（Negative Memory Bank）：存储已知缺陷样本特征
    
    推理时：
    - 计算与正例库的距离（distance_to_positive）
    - 计算与反例库的距离（distance_to_negative）
    - 综合判断：如果与反例库距离很近，即使与正例库距离较远，也应判定为异常
    """
    
    def __init__(self, pos_memory_bank: torch.Tensor, neg_memory_bank: Optional[torch.Tensor] = None):
        self.pos_memory_bank = pos_memory_bank  
        self.neg_memory_bank = neg_memory_bank  
        self.num_neighbors = 9
        
    def compute_dual_scores(self, embedding: torch.Tensor) -> Dict[str, float]:
        """
        计算双库分数
        
        Args:
            embedding: 特征嵌入 [B, C, H, W] 或 [B*H*W, C]
            
        Returns:
            dict: 包含正例分数、反例分数、综合异常分数
        """
        
        if embedding.dim() == 4:
            B, C, H, W = embedding.shape
            embedding = embedding.permute(0, 2, 3, 1).reshape(-1, C)
        
        
        distances_to_pos = chunked_cdist(embedding, self.pos_memory_bank, chunk_size=1024)
        top_k_pos, _ = torch.topk(distances_to_pos, k=min(self.num_neighbors, distances_to_pos.shape[1]), 
                                   largest=False, dim=1)
        pos_score = top_k_pos.mean(dim=1).max().item()
        
        result = {
            "positive_score": pos_score,
            "negative_score": 0.0,
            "combined_score": pos_score,
            "is_negative_match": False,
        }
        
        
        if self.neg_memory_bank is not None and len(self.neg_memory_bank) > 0:
            distances_to_neg = chunked_cdist(embedding, self.neg_memory_bank, chunk_size=1024)
            top_k_neg, _ = torch.topk(distances_to_neg, k=min(self.num_neighbors, distances_to_neg.shape[1]),
                                      largest=False, dim=1)
            neg_score = top_k_neg.mean(dim=1).min().item()
            
            result["negative_score"] = neg_score
            
            if neg_score < neg_threshold:
                result["is_negative_match"] = True
                anomaly_from_neg = max(0.0, (neg_threshold - neg_score) / neg_threshold)
                result["combined_score"] = min(1.0, pos_score + anomaly_from_neg * 0.8)
            else:
                result["is_negative_match"] = False
                result["combined_score"] = pos_score
                
        return result


class AnomalibPatchCoreWrapperDual:
    """
    基于双库架构的PatchCore推理封装类
    支持正例库和反例库的双重验证
    """

    def __init__(self, backbone: str, layers: list, num_neighbors: int = 9, device: str = "cuda"):
        self.backbone = backbone
        self.layers = layers
        self.num_neighbors = num_neighbors
        self.device = torch.device(device if torch.cuda.is_available() else "cpu")
        self.model: Optional[AnomalibPatchCoreModel] = None
        self.pos_memory_bank: Optional[torch.Tensor] = None  
        self.neg_memory_bank: Optional[torch.Tensor] = None  
        self.dual_detector: Optional[DualMemoryBankDetector] = None
        self.config: Dict[str, Any] = {}
        self.input_size = (224, 224)

        self.normalize_brightness_config = False
        self.normalize_contrast_config = False
        
        
        self.pos_threshold = 0.5  
        self.neg_threshold = 0.3  
        self.dual_weight = 0.6    

    def load_from_checkpoint(self, model_path: str):
        """加载模型检查点，支持双库"""
        checkpoint = torch.load(model_path, map_location=self.device)
        self.load_from_checkpoint_dict(checkpoint)

    def load_from_checkpoint_dict(self, checkpoint: Dict):
        """从已加载的checkpoint字典初始化，避免重复加载文件"""
        
        layers = checkpoint.get("layers", ["layer2", "layer3"])
        backbone = checkpoint.get("backbone", "resnet18")
        num_neighbors = checkpoint.get("num_neighbors", 9)

        self.backbone = backbone
        self.layers = layers
        self.num_neighbors = num_neighbors
        self.input_size = (224, 224)

        
        self.config = {
            "layers": layers,
            "backbone": backbone,
            "num_neighbors": num_neighbors,
        }

        self.model = AnomalibPatchCoreModel(
            layers=layers,
            backbone=backbone,
            pre_trained=False,
            num_neighbors=num_neighbors,
        ).to(self.device)

        self.model.load_state_dict(checkpoint["model_state_dict"])
        self.model.eval()

        
        self.pos_memory_bank = checkpoint.get("memory_bank")
        if self.pos_memory_bank is not None:
            self.pos_memory_bank = self.pos_memory_bank.to(self.device)
            self.model.memory_bank = self.pos_memory_bank
            
        
        self.neg_memory_bank = checkpoint.get("negative_memory_bank")
        if self.neg_memory_bank is not None:
            self.neg_memory_bank = self.neg_memory_bank.to(self.device)
            logger.info(f"Loaded negative memory bank: {self.neg_memory_bank.shape}")
        else:
            logger.warning("No negative memory bank found in checkpoint")
            
        
        self.dual_detector = DualMemoryBankDetector(
            self.pos_memory_bank, 
            self.neg_memory_bank
        )
        self.dual_detector.num_neighbors = num_neighbors

    def load_config(self, config_path: str):
        """加载 config.json 配置"""
        if os.path.exists(config_path):
            with open(config_path, "r", encoding="utf-8") as f:
                config = json.load(f)
                self.config.update(config)
                self.normalize_brightness_config = config.get("normalize_brightness", False)
                self.normalize_contrast_config = config.get("normalize_contrast", False)
                
                self.target_size = config.get("target_size", None)
                
                self.pos_threshold = config.get("positive_threshold", 0.5)
                self.neg_threshold = config.get("negative_threshold", 0.3)
                self.dual_weight = config.get("dual_weight", 0.6)
                if self.target_size:
                    logger.info(f"Loaded target_size from config: {self.target_size}")

    @staticmethod
    def _normalize_brightness(image: np.ndarray, target_mean: float = 168.0, threshold: int = 10) -> np.ndarray:
        """对图片进行亮度归一化"""
        arr = image.astype(np.float32)
        brightness = arr.mean(axis=2)
        hole_mask = brightness > threshold
        if np.sum(hole_mask) == 0:
            return image
        current_mean = arr[hole_mask].mean()
        if current_mean > 0:
            scale = target_mean / current_mean
            arr[hole_mask] = np.clip(arr[hole_mask] * scale, 0, 255)
        return arr.astype(np.uint8)

    @staticmethod
    def _normalize_contrast(image: np.ndarray, target_std: float = 65.0, threshold: int = 10) -> np.ndarray:
        """对图片进行对比度归一化"""
        arr = image.astype(np.float32)
        brightness = arr.mean(axis=2)
        hole_mask = brightness > threshold
        if np.sum(hole_mask) == 0:
            return image
        current_mean = arr[hole_mask].mean()
        current_std = arr[hole_mask].std()
        if current_std > 0:
            arr[hole_mask] = (arr[hole_mask] - current_mean) / current_std * target_std + current_mean
            arr = np.clip(arr, 0, 255)
        return arr.astype(np.uint8)

    @staticmethod
    def _pad_to_size(roi: np.ndarray, target_size: Tuple[int, int]) -> np.ndarray:
        """
        通过 padding 将 ROI 调整到目标尺寸（保持居中）
        """
        current_height, current_width = roi.shape[:2]
        target_width, target_height = target_size

        if current_width >= target_width and current_height >= target_height:
            return roi

        pad_left = (target_width - current_width) // 2
        pad_right = target_width - current_width - pad_left
        pad_top = (target_height - current_height) // 2
        pad_bottom = target_height - current_height - pad_top

        if len(roi.shape) == 3:
            padded = np.zeros((target_height, target_width, roi.shape[2]), dtype=roi.dtype)
        else:
            padded = np.zeros((target_height, target_width), dtype=roi.dtype)

        padded[pad_top:pad_top + current_height, pad_left:pad_left + current_width] = roi
        return padded

    def preprocess_roi(self, roi: np.ndarray, target_size: Tuple[int, int] = None, 
                       normalize_brightness: bool = False, normalize_contrast: bool = False) -> torch.Tensor:
        """预处理 ROI 图片"""
        if len(roi.shape) == 2:
            roi = cv2.cvtColor(roi, cv2.COLOR_GRAY2RGB)
        elif roi.shape[2] == 4:
            roi = cv2.cvtColor(roi, cv2.COLOR_RGBA2RGB)
        elif roi.shape[2] == 3:
            roi = cv2.cvtColor(roi, cv2.COLOR_BGR2RGB)

        if target_size is not None:
            roi = self._pad_to_size(roi, target_size)

        if normalize_brightness:
            roi = self._normalize_brightness(roi)

        if normalize_contrast:
            roi = self._normalize_contrast(roi)

        roi_resized = cv2.resize(roi, self.input_size, interpolation=cv2.INTER_LINEAR)
        roi_normalized = roi_resized.astype(np.float32) / 255.0
        mean = np.array([0.485, 0.456, 0.406], dtype=np.float32)
        std = np.array([0.229, 0.224, 0.225], dtype=np.float32)
        roi_normalized = (roi_normalized - mean) / std
        tensor = torch.from_numpy(roi_normalized.transpose(2, 0, 1))
        return tensor

    def infer_single(self, roi: np.ndarray, target_size: Tuple[int, int] = None,
                     normalize_brightness: bool = None, normalize_contrast: bool = None) -> Dict[str, Any]:
        """
        双库推理单张图片
        返回包含正例分数、反例分数、综合分数的详细结果
        """
        if self.model is None:
            return {"error": 0.0, "infer_failed": True, "dual_info": {}}

        if normalize_brightness is None:
            normalize_brightness = self.normalize_brightness_config
        if normalize_contrast is None:
            normalize_contrast = self.normalize_contrast_config
        if target_size is None:
            target_size = getattr(self, 'target_size', None)

        try:
            tensor = self.preprocess_roi(roi, target_size, normalize_brightness, normalize_contrast)\
                .unsqueeze(0).to(self.device)

            with torch.no_grad():
                
                features = self.model.feature_extractor(tensor)
                features = {layer: self.model.feature_pooler(feature) for layer, feature in features.items()}
                embedding = self.model.generate_embedding(features)

                
                batch_size, channels, height, width = embedding.shape
                embedding_reshaped = embedding.permute(0, 2, 3, 1).reshape(-1, channels)

                
                if self.dual_detector is not None and self.neg_memory_bank is not None and len(self.neg_memory_bank) > 0:
                    dual_scores = self.dual_detector.compute_dual_scores(embedding)
                    
                    
                    anomaly_score = dual_scores["combined_score"]
                    
                    dual_info = {
                        "positive_score": dual_scores["positive_score"],
                        "negative_score": dual_scores["negative_score"],
                        "is_negative_match": dual_scores["is_negative_match"],
                        "pos_threshold": self.pos_threshold,
                        "neg_threshold": self.neg_threshold,
                        "neg_bank_size": len(self.neg_memory_bank),
                    }
                else:
                    
                    fallback_reason = "unknown"
                    if self.dual_detector is None:
                        fallback_reason = "dual_detector is None"
                    elif self.neg_memory_bank is None:
                        fallback_reason = "neg_memory_bank is None"
                    elif len(self.neg_memory_bank) == 0:
                        fallback_reason = "neg_memory_bank is empty"
                    
                    distances = chunked_cdist(embedding_reshaped, self.pos_memory_bank, chunk_size=1024)
                    top_k_plus_1, _ = torch.topk(distances, k=self.num_neighbors + 1, 
                                                 largest=False, dim=1)
                    top_k = top_k_plus_1[:, 1:]
                    patch_scores = top_k.mean(dim=1)
                    patch_scores_map = patch_scores.reshape(batch_size, height, width)
                    anomaly_map = torch.nn.functional.interpolate(
                        patch_scores_map.unsqueeze(1),
                        size=(224, 224),
                        mode='bilinear', align_corners=False
                    ).squeeze(1)
                    anomaly_score = anomaly_map.max().item()
                    dual_info = {
                        "mode": "single_bank_fallback",
                        "fallback_reason": fallback_reason,
                        "has_dual_detector": self.dual_detector is not None,
                        "has_neg_bank": self.neg_memory_bank is not None,
                        "neg_bank_size": len(self.neg_memory_bank) if self.neg_memory_bank is not None else 0,
                    }

            return {
                "error": float(anomaly_score), 
                "infer_failed": False,
                "dual_info": dual_info,
            }

        except Exception as e:
            logger.error(f"[AnomalibPatchCoreWrapperDual] inference failed: {e}")
            return {"error": 0.0, "infer_failed": True, "dual_info": {"error": str(e)}}

        finally:
            if self.device.type == "cuda":
                torch.cuda.empty_cache()






class MultiPatchCoreDetector:
    def __init__(self, models_dir: Path, use_dual_bank: bool = True):
        self.models_dir   = models_dir
        self.use_dual_bank = use_dual_bank  
        self.models:        Dict[str, Any] = {}  
        self.configs:       Dict[str, Dict[str, Any]]   = {}
        self._load_models()

    def _load_models(self):
        if not self.models_dir.exists():
            logger.warning(f"Models directory not found: {self.models_dir}")
            return

        
        for pos_id_dir in self.models_dir.iterdir():
            if not pos_id_dir.is_dir():
                continue

            pos_id = pos_id_dir.name
            model_path = pos_id_dir / "patchcore_model.pt"

            if not model_path.exists():
                best = pos_id_dir / "best_model"
                if best.exists():
                    model_path = best / "patchcore_model.pt"

            if not model_path.exists():
                logger.warning(f"PatchCore model not found for pos_id={pos_id}, skipping")
                continue

            try:
                
                checkpoint = torch.load(model_path, map_location="cpu")
                backbone = checkpoint.get("backbone", "resnet18")
                layers = checkpoint.get("layers", ["layer2", "layer3"])
                num_neighbors = checkpoint.get("num_neighbors", 9)
                
                
                has_negative_bank = "negative_memory_bank" in checkpoint and \
                                    checkpoint["negative_memory_bank"] is not None
                
                
                if self.use_dual_bank and has_negative_bank:
                    wrapper = AnomalibPatchCoreWrapperDual(
                        backbone=backbone,
                        layers=layers,
                        num_neighbors=num_neighbors,
                        device="cuda" if torch.cuda.is_available() else "cpu",
                    )
                    logger.info(f"Using DUAL-BANK architecture for pos_id={pos_id}")
                else:
                    wrapper = AnomalibPatchCoreWrapper(
                        backbone=backbone,
                        layers=layers,
                        num_neighbors=num_neighbors,
                        device="cuda" if torch.cuda.is_available() else "cpu",
                    )
                    if self.use_dual_bank and not has_negative_bank:
                        logger.warning(f"No negative bank found for pos_id={pos_id}, using single bank")

                
                wrapper.load_from_checkpoint_dict(checkpoint)

                
                config_path = pos_id_dir / "config.json"
                config = {}
                if config_path.exists():
                    with open(config_path, "r", encoding="utf-8") as f:
                        config = json.load(f)
                    wrapper.load_config(str(config_path))

                
                self.models[pos_id] = wrapper
                self.configs[pos_id] = config

                
                if hasattr(wrapper, 'pos_memory_bank') and wrapper.pos_memory_bank is not None:
                    pos_shape = wrapper.pos_memory_bank.shape
                else:
                    pos_shape = wrapper.memory_bank.shape if hasattr(wrapper, 'memory_bank') else "N/A"
                    
                neg_info = ""
                if hasattr(wrapper, 'neg_memory_bank') and wrapper.neg_memory_bank is not None:
                    neg_info = f", neg_bank={wrapper.neg_memory_bank.shape}"

                logger.info(
                    f"Loaded PatchCore model: pos_id={pos_id} "
                    f"(backbone={backbone}, layers={layers}, "
                    f"pos_bank={pos_shape}{neg_info}, "
                    f"threshold={config.get('threshold', 'N/A')}, "
                    f"target_size={config.get('target_size', 'N/A')})"
                )

            except Exception as e:
                logger.error(f"Failed to load PatchCore model pos_id={pos_id}: {e}")

    def detect_by_pos_id(
        self,
        rois:        List[np.ndarray],
        category:    str,
        request_id:  str = "",
        annotations: List[Dict] = None,
        save_preprocessed_dir: str = None,
    ) -> List[Dict[str, Any]]:
        """
        根据每个 ROI 的 pos_id 选择对应的模型进行推理
        """
        if save_preprocessed_dir:
            os.makedirs(save_preprocessed_dir, exist_ok=True)

        total_rois = len(rois)
        logger.info(f"[{request_id}] [{category}] Total ROIs to process: {total_rois}")

        result_pairs: List[tuple] = []

        try:
            for idx, roi in enumerate(rois):
                pos_id = "default"
                if annotations and idx < len(annotations):
                    pos_id = str(annotations[idx].get('pos_id', 'default'))

                if pos_id not in self.models:
                    logger.warning(
                        f"[{request_id}] [{category}] No model found for pos_id={pos_id}, "
                        f"skipping ROI {idx+1}"
                    )
                    result_pairs.append((0.0, True))
                    continue

                model = self.models[pos_id]
                config = self.configs[pos_id]
                raw_threshold = config.get("threshold", 0.5)
                threshold_buffer = config.get("threshold_buffer", 1.3)
                threshold = raw_threshold * threshold_buffer

                def make_result(error: float, infer_failed: bool = False, dual_info: Dict = None) -> Dict[str, Any]:
                    result = {
                        "is_anomaly":    (not infer_failed) and (error > threshold),
                        "anomaly_score": min(error / threshold, 1.0) if threshold > 0 else error,
                        "error":         error,
                        "threshold":     threshold,
                        "infer_failed":  infer_failed,
                    }
                    
                    if dual_info:
                        result["dual_info"] = dual_info
                    return result

                try:
                    
                    result = model.infer_single(roi)
                    score = result["error"]
                    dual_info = result.get("dual_info", {})

                    
                    if dual_info and "positive_score" in dual_info:
                        log_msg = (
                            f"[{request_id}] [{category}] ROI {idx+1}/{total_rois} "
                            f"pos_id={pos_id} roi_size={roi.shape[1]}x{roi.shape[0]} "
                            f"combined_score={score:.4f} threshold={threshold:.4f} "
                            f"pos_score={dual_info.get('positive_score', 0):.4f} "
                            f"neg_score={dual_info.get('negative_score', 0):.4f}"
                        )
                        if dual_info.get("is_negative_match"):
                            log_msg += " [NEGATIVE_MATCH]"
                        logger.info(log_msg)
                    else:
                        logger.info(
                            f"[{request_id}] [{category}] ROI {idx+1}/{total_rois} "
                            f"pos_id={pos_id} roi_size={roi.shape[1]}x{roi.shape[0]} "
                            f"score={score:.4f} threshold={threshold:.4f} (raw={raw_threshold:.4f} x {threshold_buffer})"
                        )

                    result_pairs.append((make_result(score, result["infer_failed"], dual_info), False))

                except Exception as e:
                    logger.error(f"[{request_id}] [{category}] Error ROI {idx+1} pos_id={pos_id}: {e}")
                    result_pairs.append((make_result(0.0, True), True))

            logger.info(f"[{request_id}] [{category}] Processed {len(result_pairs)}/{total_rois} ROIs")
        finally:
            _cleanup(f"{category} done")

        
        return [r[0] for r in result_pairs]

    def detect_category(
        self,
        rois:        List[np.ndarray],
        category:    str,
        request_id:  str = "",
        annotations: List[Dict] = None,
        save_preprocessed_dir: str = None,
    ) -> List[Dict[str, Any]]:
        """
        兼容旧接口，实际调用 detect_by_pos_id
        """
        return self.detect_by_pos_id(
            rois=rois,
            category=category,
            request_id=request_id,
            annotations=annotations,
            save_preprocessed_dir=save_preprocessed_dir,
        )

    def get_loaded_categories(self) -> List[str]:
        return list(self.models.keys())






def select_best_template_from_annotations(annotations_path: str) -> tuple:
    try:
        with open(annotations_path, 'r', encoding='utf-8') as f:
            data = json.load(f)

        images      = {img['id']: img for img in data.get('images', [])}
        annotations = data.get('annotations', [])

        no_flip = [
            ann for ann in annotations
            if not ann.get('horizontal_flip', False)
            and not ann.get('vertical_flip', False)
        ]
        if not no_flip:
            logger.warning("No annotations without flip found")
            return None, []

        no_flip.sort(key=lambda x: abs(x.get('angle', 0)))
        best     = no_flip[0]
        img_info = images.get(best.get('image_id'))
        if not img_info:
            logger.warning(f"Image {best.get('image_id')} not found")
            return None, []

        ann_dir   = Path(annotations_path).parent
        file_name = img_info.get('file_name', '')

        for candidate in [
            ann_dir / "raw_images" / file_name,
            ann_dir / file_name,
            ann_dir / "images" / file_name,
        ]:
            if candidate.exists():
                template_path = str(candidate)
                break
        else:
            logger.warning(f"Template image not found for {file_name}")
            return None, []

        template_annotations = [
            {
                'category':      str(ann.get('pos_id', '')),  
                'category_name': ann.get('label', ''),
                'pos_id':        ann.get('pos_id'),
                'bbox':          ann.get('bbox', [0, 0, 0, 0]),
                'segmentation':  ann.get('segmentation', []),
            }
            for ann in no_flip
            if ann.get('image_id') == best.get('image_id') and ann.get('label')
        ]

        logger.info(
            f"Selected template: {file_name}, angle={best.get('angle', 0)}, "
            f"annotations={len(template_annotations)}"
        )
        return template_path, template_annotations

    except Exception as e:
        logger.error(f"Failed to select template from annotations: {e}")
        return None, []


def get_workpiece_bbox_from_annotations(
    annotations: List[Dict],
    img_size: Optional[Tuple[int, int]] = None,
    padding: int = 30,
) -> Optional[tuple]:
    """
    从标注数据中计算工件区域（所有标注的bbox/segmentation的并集）
    Args:
        annotations: 标注列表，每个标注包含 bbox 和/或 segmentation
        img_size: 图像尺寸 (width, height)，用于裁剪边界
        padding: 边界扩展像素
    Returns:
        (x, y, w, h) 工件区域，或 None（无有效标注时）
    """
    if not annotations:
        return None
    
    all_points = []
    
    for ann in annotations:
        bbox = ann.get("bbox", [])
        segmentation = ann.get("segmentation", [])
        
        if segmentation and len(segmentation) > 0 and len(segmentation[0]) >= 4:
            pts = segmentation[0]
            for i in range(0, len(pts), 2):
                if i + 1 < len(pts):
                    all_points.append((float(pts[i]), float(pts[i+1])))
        elif bbox and len(bbox) >= 4:
            x, y, w, h = bbox
            all_points.extend([
                (x, y),
                (x + w, y),
                (x + w, y + h),
                (x, y + h)
            ])
    
    if not all_points:
        return None
    
    xs = [p[0] for p in all_points]
    ys = [p[1] for p in all_points]
    
    x_min = min(xs)
    y_min = min(ys)
    x_max = max(xs)
    y_max = max(ys)
    
    x_min = max(0, x_min - padding)
    y_min = max(0, y_min - padding)
    
    if img_size:
        w_img, h_img = img_size
        x_max = min(w_img, x_max + padding)
        y_max = min(h_img, y_max + padding)
    
    return (int(x_min), int(y_min), int(x_max - x_min), int(y_max - y_min))


def detect_workpiece_bbox(
    image: np.ndarray,
    padding: int = 30,
    min_area_ratio: float = 0.05,
    max_area_ratio: float = 0.92,
) -> Optional[tuple]:
    """检测单个工件区域"""
    h_img, w_img = image.shape[:2]
    img_area     = h_img * w_img

    gray     = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY) if len(image.shape) == 3 else image.copy()
    clahe    = cv2.createCLAHE(clipLimit=3.8, tileGridSize=(1,1))
    enhanced = clahe.apply(gray)
    blurred  = cv2.GaussianBlur(enhanced, (5, 5), 0)

    candidates = []
    for flag in (cv2.THRESH_BINARY + cv2.THRESH_OTSU,
                 cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU):
        _, binary = cv2.threshold(blurred, 0, 255, flag)
        candidates.append(binary)
    adaptive = cv2.adaptiveThreshold(
        blurred, 255,
        cv2.ADAPTIVE_THRESH_GAUSSIAN_C, cv2.THRESH_BINARY_INV,
        blockSize=51, C=5
    )
    candidates.append(adaptive)

    kernel_close = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (15, 15))
    kernel_open  = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))

    best_bbox       = None
    best_area_ratio = 0.0

    for binary in candidates:
        cleaned = cv2.morphologyEx(binary,  cv2.MORPH_CLOSE, kernel_close, iterations=2)
        cleaned = cv2.morphologyEx(cleaned, cv2.MORPH_OPEN,  kernel_open,  iterations=1)
        cnts, _ = cv2.findContours(cleaned, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        if not cnts:
            continue
        for cnt in sorted(cnts, key=cv2.contourArea, reverse=True):
            area_ratio = cv2.contourArea(cnt) / img_area
            if min_area_ratio <= area_ratio <= max_area_ratio:
                if area_ratio > best_area_ratio:
                    best_area_ratio = area_ratio
                    best_bbox = cv2.boundingRect(cnt)
                break

    if best_bbox is None:
        logger.warning(f"[detect_workpiece_bbox] 未检测到工件，回退到全图")
        return None

    x, y, w, h = best_bbox
    x1 = max(0, x - padding)
    y1 = max(0, y - padding)
    x2 = min(w_img, x + w + padding)
    y2 = min(h_img, y + h + padding)
    cw, ch = x2 - x1, y2 - y1
    logger.info(f"[detect_workpiece_bbox] bbox=({x1},{y1},{cw},{ch}), area_ratio={best_area_ratio:.2%}")
    return (x1, y1, cw, ch)


def detect_multiple_workpiece_bboxes(
    image: np.ndarray,
    padding: int = 30,
    min_area_ratio: float = 0.03,
    max_area_ratio: float = 0.95,
    min_distance_ratio: float = 0.15,
    expected_count: Optional[int] = None,
    background_frame: Optional[np.ndarray] = None,
    
    reference_workpiece_size: Optional[Tuple[int, int]] = None,  
) -> List[Tuple[int, int, int, int]]:
    """
    检测图像中的多个工件区域 - 改进版，支持金属件检测
    
    基于标注文件中的工件主体大小(1988x683, 占图像约20%)优化检测参数
    
    Args:
        image: 输入图像
        padding: 边界扩展像素
        min_area_ratio: 最小面积比例 (默认会根据参考尺寸自适应调整)
        max_area_ratio: 最大面积比例
        min_distance_ratio: 工件间最小距离比例
        expected_count: 期望检测到的工件数量（如果提供，会尝试找到这么多工件）
        background_frame: 可选的空托盘背景图（提供后将使用背景差分策略）
        reference_workpiece_size: 参考工件尺寸 (width, height)，用于自适应调整检测参数
        
    Returns:
        工件bbox列表 [(x, y, w, h), ...]
    """
    h_img, w_img = image.shape[:2]
    img_area = h_img * w_img
    
    
    if reference_workpiece_size is not None:
        ref_w, ref_h = reference_workpiece_size
        ref_area = ref_w * ref_h
        ref_area_ratio = ref_area / img_area
        
        
        
        adaptive_min_ratio = max(0.03, ref_area_ratio * 0.95)
        adaptive_max_ratio = min(0.95, ref_area_ratio * 1.10)
        
        
        adaptive_min_width = int(ref_w * 0.40)
        adaptive_min_height = int(ref_h * 0.40)
        
        
        ref_aspect = ref_w / ref_h
        adaptive_aspect_min = max(0.15, ref_aspect * 0.5)
        adaptive_aspect_max = min(6.5, ref_aspect * 2.0)
        
        logger.info(f"[detect_multiple_workpiece_bboxes] 使用自适应参数:")
        logger.info(f"  参考工件尺寸: {ref_w}x{ref_h}, 面积比例: {ref_area_ratio:.2%}")
        logger.info(f"  面积比例范围: {adaptive_min_ratio:.2%} - {adaptive_max_ratio:.2%}")
        logger.info(f"  最小尺寸: {adaptive_min_width}x{adaptive_min_height}")
        logger.info(f"  长宽比范围: {adaptive_aspect_min:.2f} - {adaptive_aspect_max:.2f}")
    else:
        
        adaptive_min_ratio = min_area_ratio
        adaptive_max_ratio = max_area_ratio
        adaptive_min_width = 100
        adaptive_min_height = 50
        adaptive_aspect_min = 0.15
        adaptive_aspect_max = 6.5
    
    min_distance = min(h_img, w_img) * min_distance_ratio
    
    
    detector = WorkpieceDetector(
        min_width=adaptive_min_width,
        min_height=adaptive_min_height,
        aspect_ratio_range=(adaptive_aspect_min, adaptive_aspect_max)
    )
    if background_frame is not None:
        detector.update_background(background_frame)
    
    all_bboxes = detector.detect(
        image, img_area, adaptive_min_ratio, adaptive_max_ratio, padding
    )
    
    
    selected_bboxes = _nms_bboxes(all_bboxes, min_distance, w_img, h_img)
    
    
    if len(selected_bboxes) < (expected_count or 1):
        logger.info(f"[detect_multiple_workpiece_bboxes] 主策略检测到 {len(selected_bboxes)} 个工件，尝试辅助策略")
        
        gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY) if image.ndim == 3 else image
        all_bboxes_aux = []
        
        
        for canny_thresh1 in [20, 30]:
            for canny_thresh2 in [80, 100]:
                bboxes = _detect_workpieces_by_edges(
                    gray, img_area, adaptive_min_ratio * 0.5, adaptive_max_ratio, padding,
                    canny_thresh1, canny_thresh2
                )
                all_bboxes_aux.extend(bboxes)
        
        
        bboxes_thresh = _detect_workpieces_by_threshold(
            gray, img_area, adaptive_min_ratio * 0.5, adaptive_max_ratio, padding
        )
        all_bboxes_aux.extend(bboxes_thresh)
        
        
        all_bboxes_aux.extend(selected_bboxes)
        selected_bboxes = _nms_bboxes(all_bboxes_aux, min_distance * 0.5, w_img, h_img)
    
    
    if expected_count and len(selected_bboxes) < expected_count:
        logger.info(f"[detect_multiple_workpiece_bboxes] 检测到 {len(selected_bboxes)} 个工件，期望 {expected_count} 个，尝试更低阈值")
        gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY) if image.ndim == 3 else image
        all_bboxes_low = []
        for canny_thresh1 in [15, 25]:
            for canny_thresh2 in [60, 80]:
                bboxes = _detect_workpieces_by_edges(
                    gray, img_area, adaptive_min_ratio * 0.3, adaptive_max_ratio, padding,
                    canny_thresh1, canny_thresh2
                )
                all_bboxes_low.extend(bboxes)
        
        
        all_bboxes_low.extend(selected_bboxes)
        selected_bboxes_low = _nms_bboxes(all_bboxes_low, min_distance * 0.3, w_img, h_img)
        if len(selected_bboxes_low) > len(selected_bboxes):
            selected_bboxes = selected_bboxes_low
    
    
    selected_bboxes.sort(key=lambda b: b[0])
    
    logger.info(f"[detect_multiple_workpiece_bboxes] 检测到 {len(selected_bboxes)} 个工件")
    for i, bbox in enumerate(selected_bboxes):
        logger.info(f"  工件 {i+1}: bbox={bbox}")
    
    return selected_bboxes


def _detect_workpieces_by_edges(
    gray: np.ndarray,
    img_area: float,
    min_area_ratio: float,
    max_area_ratio: float,
    padding: int,
    canny_thresh1: int = 50,
    canny_thresh2: int = 150
) -> List[Tuple[int, int, int, int]]:
    """使用边缘检测检测工件"""
    h, w = gray.shape
    bboxes = []
    
    
    blurred = cv2.GaussianBlur(gray, (5, 5), 0)
    edges = cv2.Canny(blurred, canny_thresh1, canny_thresh2)
    
    
    kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (9, 9))
    edges_dilated = cv2.dilate(edges, kernel, iterations=3)
    
    
    kernel_close = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (15, 15))
    edges_closed = cv2.morphologyEx(edges_dilated, cv2.MORPH_CLOSE, kernel_close, iterations=2)
    
    
    contours, _ = cv2.findContours(edges_closed, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    
    for cnt in contours:
        area = cv2.contourArea(cnt)
        area_ratio = area / img_area
        
        if min_area_ratio <= area_ratio <= max_area_ratio:
            x, y, bw, bh = cv2.boundingRect(cnt)
            
            if bw < 50 or bh < 50:
                continue
            
            x1 = max(0, x - padding)
            y1 = max(0, y - padding)
            x2 = min(w, x + bw + padding)
            y2 = min(h, y + bh + padding)
            bboxes.append((x1, y1, x2 - x1, y2 - y1))
    
    return bboxes


def _detect_workpieces_by_threshold(
    gray: np.ndarray,
    img_area: float,
    min_area_ratio: float,
    max_area_ratio: float,
    padding: int
) -> List[Tuple[int, int, int, int]]:
    """使用阈值分割检测工件"""
    h, w = gray.shape
    bboxes = []
    
    
    blurred = cv2.GaussianBlur(gray, (5, 5), 0)
    
    
    thresh_methods = [
        (cv2.THRESH_BINARY + cv2.THRESH_OTSU, 0),
        (cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU, 0),
        (cv2.ADAPTIVE_THRESH_GAUSSIAN_C, cv2.THRESH_BINARY_INV),
    ]
    
    for method, subtype in thresh_methods:
        if subtype == 0:
            _, binary = cv2.threshold(blurred, 0, 255, method)
        else:
            binary = cv2.adaptiveThreshold(blurred, 255, method, subtype, 51, 5)
        
        
        kernel_close = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (15, 15))
        kernel_open = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))
        
        cleaned = cv2.morphologyEx(binary, cv2.MORPH_CLOSE, kernel_close, iterations=2)
        cleaned = cv2.morphologyEx(cleaned, cv2.MORPH_OPEN, kernel_open, iterations=1)
        
        contours, _ = cv2.findContours(cleaned, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        
        for cnt in contours:
            area = cv2.contourArea(cnt)
            area_ratio = area / img_area
            
            if min_area_ratio <= area_ratio <= max_area_ratio:
                x, y, bw, bh = cv2.boundingRect(cnt)
                
                x1 = max(0, x - padding)
                y1 = max(0, y - padding)
                x2 = min(w, x + bw + padding)
                y2 = min(h, y + bh + padding)
                bboxes.append((x1, y1, x2 - x1, y2 - y1))
    
    return bboxes


def _detect_workpieces_by_template_matching(
    image: np.ndarray,
    template_gray: np.ndarray,
    img_area: float,
    min_area_ratio: float,
    max_area_ratio: float,
    padding: int,
    scales: List[float] = None,
) -> List[Tuple[int, int, int, int]]:
    """
    使用多尺度模板匹配检测工件
    
    Args:
        image: 输入图像 (BGR)
        template_gray: 模板图像 (灰度图)
        img_area: 图像总面积
        min_area_ratio: 最小面积比例
        max_area_ratio: 最大面积比例
        padding: 边界扩展像素
        scales: 缩放比例列表，默认 [0.8, 0.9, 1.0, 1.1, 1.2]
        
    Returns:
        检测到的工件bbox列表
    """
    if scales is None:
        scales = [0.8, 0.9, 1.0, 1.1, 1.2]
    
    h_img, w_img = image.shape[:2]
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY) if image.ndim == 3 else image
    
    
    tmpl_h, tmpl_w = template_gray.shape[:2]
    tmpl_area = tmpl_h * tmpl_w
    
    all_detections = []
    
    for scale in scales:
        
        scaled_w = int(tmpl_w * scale)
        scaled_h = int(tmpl_h * scale)
        
        if scaled_w < 50 or scaled_h < 50:
            continue
        if scaled_w > w_img or scaled_h > h_img:
            continue
            
        resized_template = cv2.resize(template_gray, (scaled_w, scaled_h))
        
        
        result = cv2.matchTemplate(gray, resized_template, cv2.TM_CCOEFF_NORMED)
        
        
        threshold = 0.6  
        loc = np.where(result >= threshold)
        
        for pt in zip(*loc[::-1]):
            x, y = int(pt[0]), int(pt[1])
            w, h = scaled_w, scaled_h
            area = w * h
            area_ratio = area / img_area
            
            
            if min_area_ratio <= area_ratio <= max_area_ratio:
                
                x1 = max(0, x - padding)
                y1 = max(0, y - padding)
                x2 = min(w_img, x + w + padding)
                y2 = min(h_img, y + h + padding)
                all_detections.append((x1, y1, x2 - x1, y2 - y1))
    
    return all_detections


class WorkpieceDetector:
    """
    主策略：背景差分（稳定、抗高光）
    兜底策略：高光感知阈值（无参考图时使用）
    """

    def __init__(
        self,
        min_width: int = 100,
        min_height: int = 50,
        aspect_ratio_range: Tuple[float, float] = (0.15, 6.5),
    ):
        self.background: Optional[np.ndarray] = None
        self.bg_blur_ksize = 5
        self.min_width = min_width
        self.min_height = min_height
        self.aspect_ratio_range = aspect_ratio_range

    
    
    

    def update_background(self, frame: np.ndarray) -> None:
        """拍摄空托盘时调用一次，之后检测自动使用差分"""
        gray = self._to_gray(frame)
        self.background = cv2.GaussianBlur(gray, (self.bg_blur_ksize,) * 2, 0)

    def detect(
        self,
        frame: np.ndarray,
        img_area: float,
        min_area_ratio: float,
        max_area_ratio: float,
        padding: int,
    ) -> List[Tuple[int, int, int, int]]:
        gray = self._to_gray(frame)

        if self.background is not None:
            fg_mask = self._background_subtraction(gray)
        else:
            
            fg_mask = self._highlight_aware_threshold(gray)

        bboxes = self._extract_bboxes(
            fg_mask, gray, img_area, min_area_ratio, max_area_ratio, padding
        )
        return _nms(bboxes, iou_threshold=0.3)

    
    
    

    def _background_subtraction(self, gray: np.ndarray) -> np.ndarray:
        blurred = cv2.GaussianBlur(gray, (self.bg_blur_ksize,) * 2, 0)

        
        diff = cv2.absdiff(blurred, self.background)

        
        
        
        highlight_mask = self._extract_highlights(gray)

        
        _, diff_binary = cv2.threshold(diff, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)

        
        combined = cv2.bitwise_or(diff_binary, highlight_mask)

        return self._morph_clean(combined, gray)

    
    
    

    def _highlight_aware_threshold(self, gray: np.ndarray) -> np.ndarray:
        
        
        base = cv2.morphologyEx(
            gray,
            cv2.MORPH_OPEN,
            cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (31, 31))
        )
        
        _, binary = cv2.threshold(base, 0, 255, cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)

        
        highlight_mask = self._extract_highlights(gray)
        combined = cv2.bitwise_or(binary, highlight_mask)

        return self._morph_clean(combined, gray)

    
    
    

    def _extract_highlights(self, gray: np.ndarray) -> np.ndarray:
        """
        金属高光区域灰度接近255且成片分布。
        用高阈值 + 膨胀，将高光扩展到工件轮廓内部。
        """
        
        p95 = np.percentile(gray, 95)
        highlight_thresh = min(240, max(200, p95 * 0.97))

        _, highlights = cv2.threshold(gray, int(highlight_thresh), 255, cv2.THRESH_BINARY)

        
        kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (25, 25))
        return cv2.dilate(highlights, kernel, iterations=2)

    
    
    

    def _morph_clean(self, mask: np.ndarray, gray: np.ndarray) -> np.ndarray:
        h, w = gray.shape
        scale = min(h, w) / 1000.0
        ck = max(11, int(21 * scale) | 1)
        ok = max(5,  int(9  * scale) | 1)

        kernel_c = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (ck, ck))
        kernel_o = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (ok, ok))

        cleaned = cv2.morphologyEx(mask,    cv2.MORPH_CLOSE, kernel_c, iterations=3)
        cleaned = cv2.morphologyEx(cleaned, cv2.MORPH_OPEN,  kernel_o, iterations=2)
        return cleaned

    
    
    

    def _extract_bboxes(
        self,
        mask: np.ndarray,
        gray: np.ndarray,
        img_area: float,
        min_area_ratio: float,
        max_area_ratio: float,
        padding: int,
    ) -> List[Tuple[int, int, int, int]]:
        h, w = gray.shape
        num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(
            mask, connectivity=8
        )
        bboxes = []
        
        aspect_min, aspect_max = self.aspect_ratio_range

        for i in range(1, num_labels):
            x, y, bw, bh, area = stats[i]

            
            if not (min_area_ratio <= area / img_area <= max_area_ratio):
                continue
            
            if bw < self.min_width or bh < self.min_height:
                continue
            
            if not (aspect_min <= bw / max(bh, 1) <= aspect_max):
                continue
            
            roi_mask = (labels == i).astype(np.uint8) * 255
            cnts, _ = cv2.findContours(roi_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
            if cnts:
                hull_area = cv2.contourArea(cv2.convexHull(cnts[0]))
                if hull_area > 0 and (area / hull_area) < 0.35:
                    continue  

            x1 = max(0, x - padding)
            y1 = max(0, y - padding)
            x2 = min(w, x + bw + padding)
            y2 = min(h, y + bh + padding)
            bboxes.append((x1, y1, x2 - x1, y2 - y1))

        return bboxes

    @staticmethod
    def _to_gray(frame: np.ndarray) -> np.ndarray:
        return cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY) if frame.ndim == 3 else frame



def _nms(bboxes, iou_threshold=0.3):
    if not bboxes:
        return []

    
    boxes = [(x, y, x + bw, y + bh, bw * bh) for x, y, bw, bh in bboxes]
    boxes.sort(key=lambda b: b[4], reverse=True)

    kept = []
    while boxes:
        best = boxes.pop(0)
        kept.append(best)
        boxes = [
            b for b in boxes
            if _iou(best, b) < iou_threshold
        ]

    return [(b[0], b[1], b[2] - b[0], b[3] - b[1]) for b in kept]


def _iou(a, b) -> float:
    ix1 = max(a[0], b[0]); iy1 = max(a[1], b[1])
    ix2 = min(a[2], b[2]); iy2 = min(a[3], b[3])
    inter = max(0, ix2 - ix1) * max(0, iy2 - iy1)
    union = a[4] + b[4] - inter
    return inter / union if union > 0 else 0.0




















def _nms_bboxes(
    bboxes: List[Tuple[int, int, int, int]],
    min_distance: float,
    img_w: int,
    img_h: int
) -> List[Tuple[int, int, int, int]]:
    """对bbox进行非极大值抑制"""
    if not bboxes:
        return []
    
    
    bboxes_with_area = [(bbox, bbox[2] * bbox[3]) for bbox in bboxes]
    bboxes_with_area.sort(key=lambda x: x[1], reverse=True)
    
    selected = []
    selected_centers = []
    
    for bbox, area in bboxes_with_area:
        x, y, w, h = bbox
        cx, cy = x + w // 2, y + h // 2
        
        
        too_close = False
        for sx, sy, sw, sh in selected:
            scx, scy = sx + sw // 2, sy + sh // 2
            distance = np.sqrt((cx - scx) ** 2 + (cy - scy) ** 2)
            
            
            ix1 = max(x, sx)
            iy1 = max(y, sy)
            ix2 = min(x + w, sx + sw)
            iy2 = min(y + h, sy + sh)
            
            if ix2 > ix1 and iy2 > iy1:
                inter_area = (ix2 - ix1) * (iy2 - iy1)
                union_area = w * h + sw * sh - inter_area
                iou = inter_area / union_area if union_area > 0 else 0
                
                
                if iou > 0.3 or distance < min_distance:
                    too_close = True
                    break
        
        if not too_close:
            
            x = max(0, min(x, img_w - 1))
            y = max(0, min(y, img_h - 1))
            w = min(w, img_w - x)
            h = min(h, img_h - y)
            
            if w > 50 and h > 50:  
                selected.append((x, y, w, h))
    
    return selected



def _extract_roi_from_bbox(img: np.ndarray, bbox: List[float]) -> np.ndarray:
    x, y, w, h = [int(v) for v in bbox]
    img_h, img_w = img.shape[:2]
    x = max(0, min(x, img_w - 1))
    y = max(0, min(y, img_h - 1))
    w = max(1, min(w, img_w - x))
    h = max(1, min(h, img_h - y))
    return img[y:y + h, x:x + w]


def _extract_roi_from_segmentation(img: np.ndarray, segmentation: List[List[float]], pad_ratio: float = 0.05) -> Optional[np.ndarray]:
    if not segmentation:
        return None

    all_pts = []
    for seg in segmentation:
        pts = np.array(seg).reshape(-1, 2).astype(np.int32)
        all_pts.append(pts)

    if not all_pts:
        return None

    all_points = np.vstack(all_pts)
    x_min, y_min = np.min(all_points, axis=0)
    x_max, y_max = np.max(all_points, axis=0)

    w, h = x_max - x_min, y_max - y_min
    pad_x = int(w * pad_ratio)
    pad_y = int(h * pad_ratio)

    x_min = max(0, x_min - pad_x)
    y_min = max(0, y_min - pad_y)
    x_max = min(img.shape[1], x_max + pad_x)
    y_max = min(img.shape[0], y_max + pad_y)

    roi = img[y_min:y_max, x_min:x_max].copy()
    if roi.size == 0:
        return None

    mask = np.zeros((y_max - y_min, x_max - x_min), dtype=np.uint8)
    for pts in all_pts:
        pts_shifted = pts - [x_min, y_min]
        cv2.fillPoly(mask, [pts_shifted], 255)

    roi_masked = cv2.bitwise_and(roi, roi, mask=mask)
    return roi_masked


def _extract_roi(img: np.ndarray, ann: Dict) -> Optional[np.ndarray]:
    segmentation = ann.get("segmentation", [])
    if segmentation:
        roi = _extract_roi_from_segmentation(img, segmentation)
        if roi is not None:
            return roi
    bbox = ann.get("bbox", [0, 0, 0, 0])
    if bbox and len(bbox) >= 4:
        return _extract_roi_from_bbox(img, bbox)
    return None


def save_roi_screenshots(
    results:      List[Dict[str, Any]],
    template_img: np.ndarray,
    aligned_pred: np.ndarray,
    annotations:  List[Dict],
    request_id:   str = "",
) -> Dict[str, List[str]]:
    saved_paths = {"ok": [], "ng": []}
    if aligned_pred is None or aligned_pred.size == 0:
        return saved_paths
    if len(results) != len(annotations):
        return saved_paths

    for idx, (res, ann) in enumerate(zip(results, annotations)):
        anomaly_type  = res.get("anomaly_type", "normal")
        status_folder = "ok" if anomaly_type == "normal" else ("ng" if anomaly_type == "real_defect" else None)
        if status_folder is None:
            continue

        category = res.get("category", "unknown")
        save_dir = ROI_SAVE_DIR / category / status_folder

        template_roi = _extract_roi(template_img, ann)
        if template_roi is None or template_roi.size == 0:
            continue

        pred_roi = _extract_roi(aligned_pred, ann)
        if pred_roi is None or pred_roi.size == 0:
            continue

        try:
            save_dir.mkdir(parents=True, exist_ok=True)

            tmpl_filename = f"roi{idx+1}_{category}_{status_folder}_template.jpg"
            if cv2.imwrite(str(save_dir / tmpl_filename), template_roi):
                saved_paths[status_folder].append(str(save_dir / tmpl_filename))

            pred_filename = f"roi{idx+1}_{category}_{status_folder}_pred.jpg"
            if cv2.imwrite(str(save_dir / pred_filename), pred_roi):
                saved_paths[status_folder].append(str(save_dir / pred_filename))

        except Exception as e:
            logger.error(f"[{request_id}] 保存ROI截图失败: {e}")

    return saved_paths


def transform_bbox_with_H(bbox, H, img_size=None):
    x, y, w, h = bbox
    corners = np.array([[x,y],[x+w,y],[x+w,y+h],[x,y+h]], dtype=np.float32).reshape(-1,1,2)
    t = cv2.perspectiveTransform(corners, H).reshape(-1, 2)
    x0, y0 = np.min(t[:,0]), np.min(t[:,1])
    x1, y1 = np.max(t[:,0]), np.max(t[:,1])
    if img_size:
        iw, ih = img_size
        x0, y0 = max(0, min(x0, iw)), max(0, min(y0, ih))
        x1, y1 = max(0, min(x1, iw)), max(0, min(y1, ih))
    return [float(x0), float(y0), float(x1-x0), float(y1-y0)]


def detect_with_template_coords(
    detector,
    image:           np.ndarray,
    template_image:  np.ndarray,
    annotations:     List[Dict],
    request_id:      str = "",
    monitor:         Optional[PerformanceMonitor] = None,
) -> Dict[str, Any]:
    if template_image is None or not annotations:
        return {"results": [], "strategy": "none", "aligned_pred": None}

    local_monitor = monitor if monitor else PerformanceMonitor(request_id or "internal")
    tmpl_h, tmpl_w = template_image.shape[:2]

    local_monitor.start_step("detect_workpiece")
    global CACHED_TEMPLATE_WORKPIECE
    if CACHED_TEMPLATE_WORKPIECE is not None:
        tmpl_workpiece = CACHED_TEMPLATE_WORKPIECE
    else:
        tmpl_workpiece = get_workpiece_bbox_from_annotations(
            annotations, img_size=(tmpl_w, tmpl_h), padding=30
        )
        if tmpl_workpiece is None:
            tmpl_workpiece = detect_workpiece_bbox(template_image, padding=30) or (0, 0, tmpl_w, tmpl_h)
            logger.info(f"[{request_id}] Template workpiece from auto-detection: {tmpl_workpiece}")
        else:
            logger.info(f"[{request_id}] Template workpiece from annotations: {tmpl_workpiece}")
        CACHED_TEMPLATE_WORKPIECE = tmpl_workpiece
    
    min_ratio, max_ratio = get_workpiece_area_ratio_range(image.shape)
    pred_workpiece = detect_workpiece_bbox(
        image, padding=30,
        min_area_ratio=min_ratio,
        max_area_ratio=max_ratio
    ) or (0, 0, image.shape[1], image.shape[0])
    logger.info(f"[{request_id}] Workpiece detection ratio range: [{min_ratio:.2%}, {max_ratio:.2%}], "
                f"detected: {pred_workpiece}")
    local_monitor.end_step("detect_workpiece")

    local_monitor.start_step("sift_alignment")
    tx, ty, tw, th = tmpl_workpiece
    px, py, pw, ph = pred_workpiece
    tmpl_roi = template_image[ty:ty+th, tx:tx+tw]
    pred_roi = image[py:py+ph, px:px+pw]

    sift = cv2.SIFT_create(5000)
    bf   = cv2.BFMatcher(cv2.NORM_L2)
    tmpl_gray = cv2.cvtColor(tmpl_roi, cv2.COLOR_BGR2GRAY) if len(tmpl_roi.shape) == 3 else tmpl_roi
    pred_gray = cv2.cvtColor(pred_roi, cv2.COLOR_BGR2GRAY) if len(pred_roi.shape) == 3 else pred_roi

    clahe = cv2.createCLAHE(clipLimit=3.8, tileGridSize=(1,1))
    tmpl_gray = clahe.apply(tmpl_gray)
    pred_gray = clahe.apply(pred_gray)

    H = None; strategy = "none"
    if tmpl_gray.size > 0 and pred_gray.size > 0:
        kp_tmpl, des_tmpl = sift.detectAndCompute(tmpl_gray, None)
        kp_pred, des_pred = sift.detectAndCompute(pred_gray, None)

        if des_tmpl is not None and des_pred is not None and len(kp_tmpl) > 10 and len(kp_pred) > 10:
            matches = bf.knnMatch(des_tmpl, des_pred, k=2)
            good    = [m for m_n in matches if len(m_n)==2 for m, n in [m_n] if m.distance < 0.75*n.distance]
            if len(good) > 10:
                src_pts = np.float32([[kp_tmpl[m.queryIdx].pt[0]+tx, kp_tmpl[m.queryIdx].pt[1]+ty] for m in good]).reshape(-1,1,2)
                dst_pts = np.float32([[kp_pred[m.trainIdx].pt[0]+px, kp_pred[m.trainIdx].pt[1]+py] for m in good]).reshape(-1,1,2)

                H_partial, inliers = cv2.estimateAffinePartial2D(
                    dst_pts, src_pts,
                    method=cv2.RANSAC,
                    ransacReprojThreshold=6.0,
                    maxIters=2000
                )

                if H_partial is not None:
                    
                    SCALE_MIN, SCALE_MAX = 0.9, 1.1
                    affine_matrix = H_partial[:2, :2]
                    scale_x = np.linalg.norm(affine_matrix[:, 0])
                    scale_y = np.linalg.norm(affine_matrix[:, 1])
                    current_scale = (scale_x + scale_y) / 2.0

                    if current_scale < SCALE_MIN or current_scale > SCALE_MAX:
                        logger.warning(f"[{request_id}] 缩放因子 {current_scale:.3f} 超出范围 [{SCALE_MIN}~{SCALE_MAX}]，进行修正")
                        clamped_scale = max(SCALE_MIN, min(SCALE_MAX, current_scale))
                        affine_matrix = (affine_matrix / current_scale) * clamped_scale
                        current_scale = clamped_scale

                    if current_scale > 1e-6:
                        rotation_matrix = affine_matrix / current_scale
                    else:
                        rotation_matrix = affine_matrix

                    H_partial_scaled = np.array([
                        [rotation_matrix[0, 0], rotation_matrix[0, 1], H_partial[0, 2]],
                        [rotation_matrix[1, 0], rotation_matrix[1, 1], H_partial[1, 2]]
                    ], dtype=np.float64)

                    H = np.vstack([H_partial_scaled, [0, 0, 1]])

                    inlier_ratio = np.sum(inliers) / len(good) if inliers is not None else 0
                    strategy = "sift_workpiece"
                    logger.info(f"[{request_id}] SIFT 工件对齐成功(缩放范围 {SCALE_MIN}~{SCALE_MAX})，匹配点数: {len(good)}, 内点率: {inlier_ratio:.1%}, "
                                f"缩放因子: {current_scale:.3f}, tmpl_roi=({tw}x{th}), pred_roi=({pw}x{ph})")

    rotation_angle = 0.0
    if H is not None:
        affine_matrix = H[:2, :2]
        angle_rad = np.arctan2(affine_matrix[1, 0], affine_matrix[0, 0])
        rotation_angle = float(np.degrees(angle_rad))

    if H is None:
        H = np.eye(3, dtype=np.float64)
    local_monitor.end_step("sift_alignment")

    local_monitor.start_step("warp_image")
    H_2x3 = H[:2, :]  
    aligned_pred = cv2.warpAffine(
        image, H_2x3, (tmpl_w, tmpl_h),
        flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_CONSTANT, borderValue=(0,0,0)
    )
    local_monitor.end_step("warp_image")

    local_monitor.start_step("roi_inference")
    category_rois:    Dict[str, List[tuple]] = {}
    category_indices: Dict[str, List[int]]   = {}

    for i, ann in enumerate(annotations):
        category = ann.get("category")
        if not category or category not in detector.models:
            continue

        roi = None
        segmentation = ann.get("segmentation", [])
        bbox = ann.get("bbox", [0, 0, 0, 0])

        if segmentation and len(segmentation) > 0:
            roi = _extract_roi_from_segmentation(aligned_pred, segmentation, pad_ratio=0.0)

        if roi is None or roi.size == 0:
            if not bbox or len(bbox) < 4:
                continue
            x, y, w, h = [int(v) for v in bbox]
            x = max(0, min(x, tmpl_w-1)); y = max(0, min(y, tmpl_h-1))
            w = min(w, tmpl_w-x);         h = min(h, tmpl_h-y)
            if w <= 0 or h <= 0:
                continue
            roi = aligned_pred[y:y+h, x:x+w]

        if roi is None or roi.size == 0:
            continue

        category_rois.setdefault(category, []).append(roi)
        category_indices.setdefault(category, []).append((i, ann.get("category_name", category)))

    results_map: Dict[int, Dict] = {}
    for category, rois in category_rois.items():
        indices_info         = category_indices[category]
        category_annotations = [annotations[idx] for idx, _ in indices_info]
        det_results = detector.detect_category(
            rois, category, request_id,
            annotations=category_annotations,
        )
        H_inv = np.linalg.inv(H) if H is not None else np.eye(3, dtype=np.float64)

        for idx, det_result in enumerate(det_results):
            ann_idx, category_name = indices_info[idx]
            ann  = annotations[ann_idx]
            bbox = ann.get("bbox", [0,0,0,0])
            segm = ann.get("segmentation", [])

            x, y, w, h = [float(v) for v in bbox]
            corners = np.array([[x,y],[x+w,y],[x+w,y+h],[x,y+h]], dtype=np.float64).reshape(-1,1,2)
            tc      = cv2.perspectiveTransform(corners, H_inv).reshape(-1,2)
            
            
            bbox_in_pred_aligned = [float(np.min(tc[:,0])), float(np.min(tc[:,1])),
                            float(np.max(tc[:,0])-np.min(tc[:,0])), float(np.max(tc[:,1])-np.min(tc[:,1]))]
            
            
            
            
            
            bx, by, bw, bh = bbox_in_pred_aligned
            bbox_in_pred = [bx, by, bw, bh]

            segm_in_pred = []
            if segm and len(segm) > 0 and len(segm[0]) >= 8:
                pts = np.array([[segm[0][i], segm[0][i+1]] for i in range(0, len(segm[0]), 2)],
                               dtype=np.float64).reshape(-1,1,2)
                tp  = cv2.perspectiveTransform(pts, H_inv).reshape(-1, 2)
                
                segm_in_pred = [float(v) for v in tp.flatten()]

            results_map[ann_idx] = {
                "category":             category_name,
                "pos_id":               ann.get("pos_id"),
                "bbox":                 bbox,
                "bbox_in_pred":         bbox_in_pred,
                "bbox_clipped":         bbox,
                "segmentation":         segm,
                "segmentation_in_pred": segm_in_pred,
                "is_anomaly":           det_result.get("is_anomaly", False),
                "anomaly_score":        det_result.get("anomaly_score", 0.0),
                "error":                det_result.get("error", 0.0),
                "threshold":            det_result.get("threshold", 0.0),
                "infer_failed":         det_result.get("infer_failed", False),
                "anomaly_type":         "real_defect" if det_result.get("is_anomaly", False) else "normal",
            }

    local_monitor.end_step("roi_inference")

    results = [results_map.get(i, {
        "category":             annotations[i].get("category", "unknown"),
        "pos_id":               annotations[i].get("pos_id"),
        "bbox":                 annotations[i].get("bbox", [0,0,0,0]),
        "bbox_in_pred":         annotations[i].get("bbox", [0,0,0,0]),
        "segmentation":         annotations[i].get("segmentation", []),
        "segmentation_in_pred": [],
        "is_anomaly":           False,
        "anomaly_score":        0.0,
        "error":                0.0,
        "threshold":            0.0,
        "infer_failed":         True,
        "anomaly_type":         "infer_failed",
    }) for i in range(len(annotations))]

    saved_roi_paths = save_roi_screenshots(results, template_image, aligned_pred, annotations, request_id)
    logger.info(f"[{request_id}] ROI截图: OK={len(saved_roi_paths['ok'])}, NG={len(saved_roi_paths['ng'])}")

    return {
        "results":            results,
        "strategy":           strategy,
        "aligned_pred":       aligned_pred,
        "H":                  H,
        "template_workpiece": tmpl_workpiece,
        "pred_workpiece":     pred_workpiece,
        "saved_roi_paths":    saved_roi_paths,
    }


def detect_multiple_workpieces(
    detector,
    image: np.ndarray,
    template_image: np.ndarray,
    annotations: List[Dict],
    request_id: str = "",
    monitor: Optional[PerformanceMonitor] = None,
    reference_workpiece_size: Optional[Tuple[int, int]] = None,
) -> Dict[str, Any]:
    """
    检测图像中的多个工件，对每个工件分别进行对齐和ROI检测

    Args:
        detector: 检测器
        image: 预测图像（可能包含多个工件）
        template_image: 模板图像（单个工件）
        annotations: 模板标注信息
        request_id: 请求ID
        monitor: 性能监控器
        reference_workpiece_size: 参考工件尺寸 (width, height)，用于自适应调整检测参数

    Returns:
        包含所有工件检测结果的字典
    """
    if template_image is None or not annotations:
        return {
            "workpiece_results": [],
            "total_workpieces": 0,
            "total_anomalies": 0,
        }

    local_monitor = monitor if monitor else PerformanceMonitor(request_id or "internal")


    local_monitor.start_step("detect_multiple_workpieces")
    workpiece_bboxes = detect_multiple_workpiece_bboxes(
        image,
        padding=30,
        reference_workpiece_size=reference_workpiece_size
    )

    if not workpiece_bboxes:
        logger.warning(f"[{request_id}] 未检测到任何工件，回退到单工件检测")
        single_result = detect_with_template_coords(
            detector, image, template_image, annotations,
            request_id, monitor
        )
        return {
            "workpiece_results": [{
                "workpiece_id": 0,
                "bbox": single_result.get("pred_workpiece", (0, 0, image.shape[1], image.shape[0])),
                "results": single_result.get("results", []),
                "anomaly_count": sum(1 for r in single_result.get("results", []) if r.get("is_anomaly", False)),
                "strategy": single_result.get("strategy", "none"),
            }],
            "total_workpieces": 1,
            "total_anomalies": single_result.get("anomaly_count", 0),
        }

    local_monitor.end_step("detect_multiple_workpieces")


    workpiece_results = []
    total_anomalies = 0

    for wp_idx, wp_bbox in enumerate(workpiece_bboxes):
        wp_id = wp_idx + 1
        wx, wy, ww, wh = wp_bbox

        logger.info(f"[{request_id}] 处理工件 {wp_id}/{len(workpiece_bboxes)}, bbox={wp_bbox}")


        workpiece_image = image[wy:wy+wh, wx:wx+ww]
        if workpiece_image.size == 0:
            logger.warning(f"[{request_id}] 工件 {wp_id} 区域为空，跳过")
            continue


        try:
            local_monitor.start_step(f"workpiece_{wp_id}_inference")

            single_result = detect_with_template_coords(
                detector,
                workpiece_image,
                template_image,
                annotations,
                f"{request_id}_wp{wp_id}",
                None,
            )

            local_monitor.end_step(f"workpiece_{wp_id}_inference")



            results = single_result.get("results", [])
            logger.info(f"[{request_id}] 工件 {wp_id} 坐标转换: 工件bbox=({wx},{wy},{ww},{wh}), 结果数={len(results)}")

            for r_idx, r in enumerate(results):


                if "bbox_in_pred" in r:
                    bx, by, bw, bh = r["bbox_in_pred"]

                    bx, by, bw, bh = float(bx), float(by), float(bw), float(bh)
                    orig_bbox = [bx, by, bw, bh]
                    r["bbox_in_pred"] = [bx + wx, by + wy, bw, bh]
                    logger.info(f"[{request_id}] 工件 {wp_id} ROI {r_idx}: bbox_in_pred 原始={orig_bbox}, 转换后={r['bbox_in_pred']}")


                if "segmentation_in_pred" in r and r["segmentation_in_pred"]:
                    seg = r["segmentation_in_pred"]
                    orig_seg = seg.copy()

                    r["segmentation_in_pred"] = [
                        float(v) + (wx if i % 2 == 0 else wy)
                        for i, v in enumerate(seg)
                    ]
                    logger.info(f"[{request_id}] 工件 {wp_id} ROI {r_idx}: segmentation 原始前4个={orig_seg[:4]}, 转换后={r['segmentation_in_pred'][:4]}")


                if "bbox_clipped" in r:
                    bc = r["bbox_clipped"]
                    if isinstance(bc, (list, tuple)) and len(bc) >= 4:
                        r["bbox_clipped"] = [float(bc[0]) + wx, float(bc[1]) + wy, float(bc[2]), float(bc[3])]

            wp_anomaly_count = sum(1 for r in results if r.get("is_anomaly", False))
            total_anomalies += wp_anomaly_count

            workpiece_results.append({
                "workpiece_id": wp_id,
                "workpiece_bbox": wp_bbox,
                "results": results,
                "anomaly_count": wp_anomaly_count,
                "total_rois": len(results),
                "alignment_strategy": single_result.get("alignment_strategy", single_result.get("strategy", "none")),
                "visualization_b64": single_result.get("visualization_b64"),
            })

        except Exception as e:
            logger.error(f"[{request_id}] 工件 {wp_id} 检测失败: {e}")
            workpiece_results.append({
                "workpiece_id": wp_id,
                "workpiece_bbox": wp_bbox,
                "results": [],
                "anomaly_count": 0,
                "total_rois": 0,
                "alignment_strategy": "failed",
                "visualization_b64": None,
            })


    return {
        "workpiece_results": workpiece_results,
        "total_workpieces": len(workpiece_results),
        "total_anomalies": total_anomalies,
    }


