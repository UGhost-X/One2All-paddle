def _safe_empty_cache():
    try:
        paddle.device.cuda.empty_cache()
    except Exception:
        try:
            paddle.fluid.core._cuda_empty_cache()
        except Exception:
            pass


# 全局清理计数器，用于控制清理频率
_cleanup_counter = 0
_cleanup_interval = 10  # 每10次请求清理一次

def _cleanup(label: str = "", force: bool = False):
    """清理GPU缓存，但控制频率避免影响性能"""
    global _cleanup_counter
    _cleanup_counter += 1
    
    # 只有强制清理或达到间隔时才执行
    if force or (_cleanup_counter % _cleanup_interval == 0):
        gc.collect()
        _safe_empty_cache()
        if label:
            logger.debug(f"[cleanup] {label} (counter={_cleanup_counter})")
    else:
        if label:
            logger.debug(f"[cleanup skip] {label} (counter={_cleanup_counter})")


def _get_gpu_memory_info() -> Dict[str, Any]:
    try:
        allocated = paddle.device.cuda.memory_allocated(0)
        reserved  = paddle.device.cuda.memory_reserved(0)
        return {
            "allocated_mb": round(allocated / 1024**2, 1),
            "reserved_mb":  round(reserved  / 1024**2, 1),
        }
    except Exception:
        return {}


def chunked_cdist(x: torch.Tensor, y: torch.Tensor, chunk_size: int = 1024) -> torch.Tensor:
    """
    分块计算cdist，避免大矩阵OOM
    Args:
        x: [N, D] 查询向量
        y: [M, D] 记忆库
        chunk_size: 每块大小
    Returns:
        distances: [N, M]
    """
    n = x.shape[0]
    m = y.shape[0]
    
    # 如果矩阵不大，直接计算
    if n * m < chunk_size * chunk_size * 4:
        return torch.cdist(x, y)
    
    # 分块计算
    distances = []
    for i in range(0, n, chunk_size):
        end_i = min(i + chunk_size, n)
        chunk_x = x[i:end_i]
        # 对当前块计算与所有y的距离
        chunk_dist = torch.cdist(chunk_x, y)
        distances.append(chunk_dist)
    
    return torch.cat(distances, dim=0)


def _preprocess_roi(roi: np.ndarray) -> np.ndarray:
    """
    将单个 ROI 预处理为 CHW float32 numpy 数组（ImageNet 归一化）
    返回 shape: (3, 224, 224)
    """
    img = roi.copy()
    if len(img.shape) == 2:
        img = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)
    elif img.shape[2] == 4:
        img = cv2.cvtColor(img, cv2.COLOR_BGRA2RGB)
    else:
        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

    img  = cv2.resize(img, (224, 224)).astype(np.float32) / 255.0
    mean = np.array([0.485, 0.456, 0.406], dtype=np.float32)
    std  = np.array([0.229, 0.224, 0.225], dtype=np.float32)
    img  = (img - mean) / std
    return np.transpose(img, (2, 0, 1))


def cv2_put_chinese_text(img, text, position, color, font_size=20):
    from PIL import Image, ImageDraw, ImageFont
    color_rgb = (color[2], color[1], color[0])
    pil_img   = Image.fromarray(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
    draw      = ImageDraw.Draw(pil_img)
    font = None
    for fp in [
        "/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc",
        "/usr/share/fonts/truetype/wqy/wqy-microhei.ttc",
        "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
    ]:
        if os.path.exists(fp):
            try:
                font = ImageFont.truetype(fp, font_size)
                break
            except Exception:
                continue
    if font is None:
        font = ImageFont.load_default()
    draw.text(position, text, font=font, fill=color_rgb)
    return cv2.cvtColor(np.array(pil_img), cv2.COLOR_RGB2BGR)


