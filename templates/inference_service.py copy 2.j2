from anomalib.models.image.patchcore.torch_model import PatchcoreModel as AnomalibPatchCoreModel


class AnomalibPatchCoreWrapper:
    """
    基于 anomalib PatchCore 的推理封装类
    参考 predict_patchcore.py 重构
    """

    def __init__(self, backbone: str, layers: list, num_neighbors: int = 9, device: str = "cuda"):
        self.backbone = backbone
        self.layers = layers
        self.num_neighbors = num_neighbors
        self.device = torch.device(device if torch.cuda.is_available() else "cpu")
        self.model: Optional[AnomalibPatchCoreModel] = None
        self.memory_bank: Optional[torch.Tensor] = None
        self.config: Dict[str, Any] = {}
        self.input_size = (224, 224)

        self.normalize_brightness_config = False
        self.normalize_contrast_config = False

    def load_from_checkpoint(self, model_path: str):
        checkpoint = torch.load(model_path, map_location=self.device)
        self.load_from_checkpoint_dict(checkpoint)

    def load_from_checkpoint_dict(self, checkpoint: Dict):
        """从已加载的checkpoint字典初始化，避免重复加载文件"""
        # 直接从 checkpoint 读取配置（与新的训练代码格式一致）
        layers = checkpoint.get("layers", ["layer2", "layer3"])
        backbone = checkpoint.get("backbone", "resnet18")
        num_neighbors = checkpoint.get("num_neighbors", 9)

        self.backbone = backbone
        self.layers = layers
        self.num_neighbors = num_neighbors
        self.input_size = (224, 224)

        # 更新 config
        self.config = {
            "layers": layers,
            "backbone": backbone,
            "num_neighbors": num_neighbors,
        }

        self.model = AnomalibPatchCoreModel(
            layers=layers,
            backbone=backbone,
            pre_trained=False,
            num_neighbors=num_neighbors,
        ).to(self.device)

        self.model.load_state_dict(checkpoint["model_state_dict"])
        self.model.eval()

        # 直接使用 checkpoint 中的 memory_bank
        self.memory_bank = checkpoint.get("memory_bank")
        if self.memory_bank is not None:
            self.memory_bank = self.memory_bank.to(self.device)
            self.model.memory_bank = self.memory_bank

    def load_config(self, config_path: str):
        """加载 config.json 配置"""
        if os.path.exists(config_path):
            with open(config_path, "r", encoding="utf-8") as f:
                config = json.load(f)
                self.config.update(config)
                self.normalize_brightness_config = config.get("normalize_brightness", False)
                self.normalize_contrast_config = config.get("normalize_contrast", False)
                # 加载 target_size（用于 ROI padding）
                self.target_size = config.get("target_size", None)
                if self.target_size:
                    logger.info(f"Loaded target_size from config: {self.target_size}")

    @staticmethod
    def _normalize_brightness(image: np.ndarray, target_mean: float = 168.0, threshold: int = 10) -> np.ndarray:
        """对图片进行亮度归一化"""
        arr = image.astype(np.float32)
        brightness = arr.mean(axis=2)
        hole_mask = brightness > threshold
        if np.sum(hole_mask) == 0:
            return image
        current_mean = arr[hole_mask].mean()
        if current_mean > 0:
            scale = target_mean / current_mean
            arr[hole_mask] = np.clip(arr[hole_mask] * scale, 0, 255)
        return arr.astype(np.uint8)

    @staticmethod
    def _normalize_contrast(image: np.ndarray, target_std: float = 65.0, threshold: int = 10) -> np.ndarray:
        """对图片进行对比度归一化"""
        arr = image.astype(np.float32)
        brightness = arr.mean(axis=2)
        hole_mask = brightness > threshold
        if np.sum(hole_mask) == 0:
            return image
        current_mean = arr[hole_mask].mean()
        current_std = arr[hole_mask].std()
        if current_std > 0:
            arr[hole_mask] = (arr[hole_mask] - current_mean) / current_std * target_std + current_mean
            arr = np.clip(arr, 0, 255)
        return arr.astype(np.uint8)

    @staticmethod
    def _pad_to_size(roi: np.ndarray, target_size: Tuple[int, int]) -> np.ndarray:
        """
        通过 padding 将 ROI 调整到目标尺寸（保持居中）
        
        Args:
            roi: 输入图片 (H, W, C)
            target_size: 目标尺寸 (width, height)
            
        Returns:
            padding 后的图片
        """
        current_height, current_width = roi.shape[:2]
        target_width, target_height = target_size

        # 如果当前尺寸已经大于等于目标尺寸，直接返回
        if current_width >= target_width and current_height >= target_height:
            return roi

        # 计算需要 padding 的尺寸
        pad_left = (target_width - current_width) // 2
        pad_right = target_width - current_width - pad_left
        pad_top = (target_height - current_height) // 2
        pad_bottom = target_height - current_height - pad_top

        # 创建黑色背景
        if len(roi.shape) == 3:
            padded = np.zeros((target_height, target_width, roi.shape[2]), dtype=roi.dtype)
        else:
            padded = np.zeros((target_height, target_width), dtype=roi.dtype)

        # 将原图粘贴到中心
        padded[pad_top:pad_top + current_height, pad_left:pad_left + current_width] = roi

        return padded

    def preprocess_roi(self, roi: np.ndarray, target_size: Tuple[int, int] = None, normalize_brightness: bool = False, normalize_contrast: bool = False) -> torch.Tensor:
        """预处理 ROI 图片"""
        if len(roi.shape) == 2:
            roi = cv2.cvtColor(roi, cv2.COLOR_GRAY2RGB)
        elif roi.shape[2] == 4:
            roi = cv2.cvtColor(roi, cv2.COLOR_RGBA2RGB)
        elif roi.shape[2] == 3:
            roi = cv2.cvtColor(roi, cv2.COLOR_BGR2RGB)

        # 如果指定了目标尺寸，通过 padding 调整
        if target_size is not None:
            roi = self._pad_to_size(roi, target_size)

        # 亮度归一化
        if normalize_brightness:
            roi = self._normalize_brightness(roi)

        # 对比度归一化
        if normalize_contrast:
            roi = self._normalize_contrast(roi)

        # resize 到 224x224
        roi_resized = cv2.resize(roi, self.input_size, interpolation=cv2.INTER_LINEAR)

        # 归一化为 tensor
        roi_normalized = roi_resized.astype(np.float32) / 255.0
        tensor = torch.from_numpy(roi_normalized).permute(2, 0, 1)

        normalize = transforms.Normalize(
            mean=[0.485, 0.456, 0.406],
            std=[0.229, 0.224, 0.225]
        )
        tensor = normalize(tensor)
        return tensor

    def infer_single(self, roi: np.ndarray, target_size: Tuple[int, int] = None, normalize_brightness: bool = None, normalize_contrast: bool = None) -> Dict[str, Any]:
        """
        推理单张图片
        参考 predict_patchcore.py 的推理逻辑重构
        """
        if self.model is None:
            return {"error": 0.0, "infer_failed": True}

        # 如果未指定，使用模型配置
        if normalize_brightness is None:
            normalize_brightness = self.normalize_brightness_config
        if normalize_contrast is None:
            normalize_contrast = self.normalize_contrast_config
        # 如果未指定 target_size，使用模型配置中的 target_size
        if target_size is None:
            target_size = getattr(self, 'target_size', None)

        try:
            tensor = self.preprocess_roi(roi, target_size, normalize_brightness, normalize_contrast).unsqueeze(0).to(self.device)

            with torch.no_grad():
                # 1. 提取特征
                features = self.model.feature_extractor(tensor)
                features = {layer: self.model.feature_pooler(feature) for layer, feature in features.items()}
                embedding = self.model.generate_embedding(features)

                # 2. reshape embedding: [B, C, H, W] -> [B*H*W, C]
                batch_size, channels, height, width = embedding.shape
                embedding_reshaped = embedding.permute(0, 2, 3, 1).reshape(-1, channels)

                # 3. 计算与 memory bank 的距离（使用分块计算避免OOM）
                distances = chunked_cdist(embedding_reshaped, self.model.memory_bank, chunk_size=1024)

                # 4. 取 k+1 个最近邻（包含自身），然后排除第一个（自身距离≈0）
                top_k_plus_1_distances, _ = torch.topk(
                    distances, k=self.num_neighbors + 1, largest=False, dim=1
                )
                # 排除第一个（自身），取后面的 k 个
                top_k_distances = top_k_plus_1_distances[:, 1:]
                patch_scores = top_k_distances.mean(dim=1)

                # 5. reshape 回图像形状
                patch_scores_map = patch_scores.reshape(batch_size, height, width)

                # 6. 上采样到原图大小
                anomaly_map = torch.nn.functional.interpolate(
                    patch_scores_map.unsqueeze(1),
                    size=(224, 224),
                    mode='bilinear',
                    align_corners=False
                ).squeeze(1)

                # 7. 计算整体异常分数（取异常图的最大值）
                anomaly_score = anomaly_map.max()

            return {"error": float(anomaly_score.item()), "infer_failed": False}

        except Exception as e:
            logger.error(f"[AnomalibPatchCoreWrapper] inference failed: {e}")
            return {"error": 0.0, "infer_failed": True}

        finally:
            if self.device.type == "cuda":
                torch.cuda.empty_cache()


# ─────────────────────────────────────────────────────────────────────────────
# 双库推理架构 - 正例库 + 反例库
# ─────────────────────────────────────────────────────────────────────────────

class DualMemoryBankDetector:
    """
    双库推理检测器 - 同时维护正例库和反例库
    
    核心逻辑：
    1. 正例库（Positive Memory Bank）：存储正常样本特征
    2. 反例库（Negative Memory Bank）：存储已知缺陷样本特征
    
    推理时：
    - 计算与正例库的距离（distance_to_positive）
    - 计算与反例库的距离（distance_to_negative）
    - 综合判断：如果与反例库距离很近，即使与正例库距离较远，也应判定为异常
    """
    
    def __init__(self, pos_memory_bank: torch.Tensor, neg_memory_bank: Optional[torch.Tensor] = None):
        self.pos_memory_bank = pos_memory_bank  # 正例库 [N_pos, C]
        self.neg_memory_bank = neg_memory_bank  # 反例库 [N_neg, C] (可选)
        self.num_neighbors = 9
        
    def compute_dual_scores(self, embedding: torch.Tensor) -> Dict[str, float]:
        """
        计算双库分数
        
        Args:
            embedding: 特征嵌入 [B, C, H, W] 或 [B*H*W, C]
            
        Returns:
            dict: 包含正例分数、反例分数、综合异常分数
        """
        # 确保 embedding 是 2D [N, C]
        if embedding.dim() == 4:
            B, C, H, W = embedding.shape
            embedding = embedding.permute(0, 2, 3, 1).reshape(-1, C)
        
        # 计算与正例库的距离
        distances_to_pos = chunked_cdist(embedding, self.pos_memory_bank, chunk_size=1024)
        top_k_pos, _ = torch.topk(distances_to_pos, k=min(self.num_neighbors, distances_to_pos.shape[1]), 
                                   largest=False, dim=1)
        pos_score = top_k_pos.mean(dim=1).max().item()
        
        result = {
            "positive_score": pos_score,
            "negative_score": 0.0,
            "combined_score": pos_score,
            "is_negative_match": False,
        }
        
        # 如果存在反例库，计算与反例库的距离
        if self.neg_memory_bank is not None and len(self.neg_memory_bank) > 0:
            distances_to_neg = chunked_cdist(embedding, self.neg_memory_bank, chunk_size=1024)
            top_k_neg, _ = torch.topk(distances_to_neg, k=min(self.num_neighbors, distances_to_neg.shape[1]),
                                      largest=False, dim=1)
            neg_score = top_k_neg.mean(dim=1).min().item()
            
            result["negative_score"] = neg_score
            
            if neg_score < neg_threshold:
                result["is_negative_match"] = True
                anomaly_from_neg = max(0.0, (neg_threshold - neg_score) / neg_threshold)
                result["combined_score"] = min(1.0, pos_score + anomaly_from_neg * 0.8)
            else:
                result["is_negative_match"] = False
                result["combined_score"] = pos_score
                
        return result


class AnomalibPatchCoreWrapperDual:
    """
    基于双库架构的PatchCore推理封装类
    支持正例库和反例库的双重验证
    """

    def __init__(self, backbone: str, layers: list, num_neighbors: int = 9, device: str = "cuda"):
        self.backbone = backbone
        self.layers = layers
        self.num_neighbors = num_neighbors
        self.device = torch.device(device if torch.cuda.is_available() else "cpu")
        self.model: Optional[AnomalibPatchCoreModel] = None
        self.pos_memory_bank: Optional[torch.Tensor] = None  # 正例库
        self.neg_memory_bank: Optional[torch.Tensor] = None  # 反例库
        self.dual_detector: Optional[DualMemoryBankDetector] = None
        self.config: Dict[str, Any] = {}
        self.input_size = (224, 224)

        self.normalize_brightness_config = False
        self.normalize_contrast_config = False
        
        # 双库阈值配置
        self.pos_threshold = 0.5  # 正例库阈值
        self.neg_threshold = 0.3  # 反例库阈值（距离小于此值视为匹配反例）
        self.dual_weight = 0.6    # 正例分数权重

    def load_from_checkpoint(self, model_path: str):
        """加载模型检查点，支持双库"""
        checkpoint = torch.load(model_path, map_location=self.device)
        self.load_from_checkpoint_dict(checkpoint)

    def load_from_checkpoint_dict(self, checkpoint: Dict):
        """从已加载的checkpoint字典初始化，避免重复加载文件"""
        # 直接从 checkpoint 读取配置
        layers = checkpoint.get("layers", ["layer2", "layer3"])
        backbone = checkpoint.get("backbone", "resnet18")
        num_neighbors = checkpoint.get("num_neighbors", 9)

        self.backbone = backbone
        self.layers = layers
        self.num_neighbors = num_neighbors
        self.input_size = (224, 224)

        # 更新 config
        self.config = {
            "layers": layers,
            "backbone": backbone,
            "num_neighbors": num_neighbors,
        }

        self.model = AnomalibPatchCoreModel(
            layers=layers,
            backbone=backbone,
            pre_trained=False,
            num_neighbors=num_neighbors,
        ).to(self.device)

        self.model.load_state_dict(checkpoint["model_state_dict"])
        self.model.eval()

        # 加载正例库
        self.pos_memory_bank = checkpoint.get("memory_bank")
        if self.pos_memory_bank is not None:
            self.pos_memory_bank = self.pos_memory_bank.to(self.device)
            self.model.memory_bank = self.pos_memory_bank
            
        # 加载反例库（如果存在）
        self.neg_memory_bank = checkpoint.get("negative_memory_bank")
        if self.neg_memory_bank is not None:
            self.neg_memory_bank = self.neg_memory_bank.to(self.device)
            logger.info(f"Loaded negative memory bank: {self.neg_memory_bank.shape}")
        else:
            logger.warning("No negative memory bank found in checkpoint")
            
        # 初始化双库检测器
        self.dual_detector = DualMemoryBankDetector(
            self.pos_memory_bank, 
            self.neg_memory_bank
        )
        self.dual_detector.num_neighbors = num_neighbors

    def load_config(self, config_path: str):
        """加载 config.json 配置"""
        if os.path.exists(config_path):
            with open(config_path, "r", encoding="utf-8") as f:
                config = json.load(f)
                self.config.update(config)
                self.normalize_brightness_config = config.get("normalize_brightness", False)
                self.normalize_contrast_config = config.get("normalize_contrast", False)
                # 加载 target_size（用于 ROI padding）
                self.target_size = config.get("target_size", None)
                # 加载双库阈值配置
                self.pos_threshold = config.get("positive_threshold", 0.5)
                self.neg_threshold = config.get("negative_threshold", 0.3)
                self.dual_weight = config.get("dual_weight", 0.6)
                if self.target_size:
                    logger.info(f"Loaded target_size from config: {self.target_size}")

    @staticmethod
    def _normalize_brightness(image: np.ndarray, target_mean: float = 168.0, threshold: int = 10) -> np.ndarray:
        """对图片进行亮度归一化"""
        arr = image.astype(np.float32)
        brightness = arr.mean(axis=2)
        hole_mask = brightness > threshold
        if np.sum(hole_mask) == 0:
            return image
        current_mean = arr[hole_mask].mean()
        if current_mean > 0:
            scale = target_mean / current_mean
            arr[hole_mask] = np.clip(arr[hole_mask] * scale, 0, 255)
        return arr.astype(np.uint8)

    @staticmethod
    def _normalize_contrast(image: np.ndarray, target_std: float = 65.0, threshold: int = 10) -> np.ndarray:
        """对图片进行对比度归一化"""
        arr = image.astype(np.float32)
        brightness = arr.mean(axis=2)
        hole_mask = brightness > threshold
        if np.sum(hole_mask) == 0:
            return image
        current_mean = arr[hole_mask].mean()
        current_std = arr[hole_mask].std()
        if current_std > 0:
            arr[hole_mask] = (arr[hole_mask] - current_mean) / current_std * target_std + current_mean
            arr = np.clip(arr, 0, 255)
        return arr.astype(np.uint8)

    @staticmethod
    def _pad_to_size(roi: np.ndarray, target_size: Tuple[int, int]) -> np.ndarray:
        """
        通过 padding 将 ROI 调整到目标尺寸（保持居中）
        """
        current_height, current_width = roi.shape[:2]
        target_width, target_height = target_size

        if current_width >= target_width and current_height >= target_height:
            return roi

        pad_left = (target_width - current_width) // 2
        pad_right = target_width - current_width - pad_left
        pad_top = (target_height - current_height) // 2
        pad_bottom = target_height - current_height - pad_top

        if len(roi.shape) == 3:
            padded = np.zeros((target_height, target_width, roi.shape[2]), dtype=roi.dtype)
        else:
            padded = np.zeros((target_height, target_width), dtype=roi.dtype)

        padded[pad_top:pad_top + current_height, pad_left:pad_left + current_width] = roi
        return padded

    def preprocess_roi(self, roi: np.ndarray, target_size: Tuple[int, int] = None, 
                       normalize_brightness: bool = False, normalize_contrast: bool = False) -> torch.Tensor:
        """预处理 ROI 图片"""
        if len(roi.shape) == 2:
            roi = cv2.cvtColor(roi, cv2.COLOR_GRAY2RGB)
        elif roi.shape[2] == 4:
            roi = cv2.cvtColor(roi, cv2.COLOR_RGBA2RGB)
        elif roi.shape[2] == 3:
            roi = cv2.cvtColor(roi, cv2.COLOR_BGR2RGB)

        if target_size is not None:
            roi = self._pad_to_size(roi, target_size)

        if normalize_brightness:
            roi = self._normalize_brightness(roi)

        if normalize_contrast:
            roi = self._normalize_contrast(roi)

        roi_resized = cv2.resize(roi, self.input_size, interpolation=cv2.INTER_LINEAR)
        roi_normalized = roi_resized.astype(np.float32) / 255.0
        mean = np.array([0.485, 0.456, 0.406], dtype=np.float32)
        std = np.array([0.229, 0.224, 0.225], dtype=np.float32)
        roi_normalized = (roi_normalized - mean) / std
        tensor = torch.from_numpy(roi_normalized.transpose(2, 0, 1))
        return tensor

    def infer_single(self, roi: np.ndarray, target_size: Tuple[int, int] = None,
                     normalize_brightness: bool = None, normalize_contrast: bool = None) -> Dict[str, Any]:
        """
        双库推理单张图片
        返回包含正例分数、反例分数、综合分数的详细结果
        """
        if self.model is None:
            return {"error": 0.0, "infer_failed": True, "dual_info": {}}

        if normalize_brightness is None:
            normalize_brightness = self.normalize_brightness_config
        if normalize_contrast is None:
            normalize_contrast = self.normalize_contrast_config
        if target_size is None:
            target_size = getattr(self, 'target_size', None)

        try:
            tensor = self.preprocess_roi(roi, target_size, normalize_brightness, normalize_contrast)\
                .unsqueeze(0).to(self.device)

            with torch.no_grad():
                # 1. 提取特征
                features = self.model.feature_extractor(tensor)
                features = {layer: self.model.feature_pooler(feature) for layer, feature in features.items()}
                embedding = self.model.generate_embedding(features)

                # 2. reshape embedding: [B, C, H, W] -> [B*H*W, C]
                batch_size, channels, height, width = embedding.shape
                embedding_reshaped = embedding.permute(0, 2, 3, 1).reshape(-1, channels)

                # 3. 双库推理
                if self.dual_detector is not None and self.neg_memory_bank is not None and len(self.neg_memory_bank) > 0:
                    dual_scores = self.dual_detector.compute_dual_scores(embedding)
                    
                    # 使用综合分数作为最终异常分数
                    anomaly_score = dual_scores["combined_score"]
                    
                    dual_info = {
                        "positive_score": dual_scores["positive_score"],
                        "negative_score": dual_scores["negative_score"],
                        "is_negative_match": dual_scores["is_negative_match"],
                        "pos_threshold": self.pos_threshold,
                        "neg_threshold": self.neg_threshold,
                        "neg_bank_size": len(self.neg_memory_bank),
                    }
                else:
                    # 回退到单库推理
                    fallback_reason = "unknown"
                    if self.dual_detector is None:
                        fallback_reason = "dual_detector is None"
                    elif self.neg_memory_bank is None:
                        fallback_reason = "neg_memory_bank is None"
                    elif len(self.neg_memory_bank) == 0:
                        fallback_reason = "neg_memory_bank is empty"
                    
                    distances = chunked_cdist(embedding_reshaped, self.pos_memory_bank, chunk_size=1024)
                    top_k_plus_1, _ = torch.topk(distances, k=self.num_neighbors + 1, 
                                                 largest=False, dim=1)
                    top_k = top_k_plus_1[:, 1:]
                    patch_scores = top_k.mean(dim=1)
                    patch_scores_map = patch_scores.reshape(batch_size, height, width)
                    anomaly_map = torch.nn.functional.interpolate(
                        patch_scores_map.unsqueeze(1),
                        size=(224, 224),
                        mode='bilinear', align_corners=False
                    ).squeeze(1)
                    anomaly_score = anomaly_map.max().item()
                    dual_info = {
                        "mode": "single_bank_fallback",
                        "fallback_reason": fallback_reason,
                        "has_dual_detector": self.dual_detector is not None,
                        "has_neg_bank": self.neg_memory_bank is not None,
                        "neg_bank_size": len(self.neg_memory_bank) if self.neg_memory_bank is not None else 0,
                    }

            return {
                "error": float(anomaly_score), 
                "infer_failed": False,
                "dual_info": dual_info,
            }

        except Exception as e:
            logger.error(f"[AnomalibPatchCoreWrapperDual] inference failed: {e}")
            return {"error": 0.0, "infer_failed": True, "dual_info": {"error": str(e)}}

        finally:
            if self.device.type == "cuda":
                torch.cuda.empty_cache()


# ─────────────────────────────────────────────────────────────────────────────
# 多模型管理器（支持双库架构）
# ─────────────────────────────────────────────────────────────────────────────

class MultiPatchCoreDetector:
    def __init__(self, models_dir: Path, use_dual_bank: bool = True):
        self.models_dir   = models_dir
        self.use_dual_bank = use_dual_bank  # 是否启用双库架构
        self.models:        Dict[str, Any] = {}  # 可以是 AnomalibPatchCoreWrapper 或 AnomalibPatchCoreWrapperDual
        self.configs:       Dict[str, Dict[str, Any]]   = {}
        self._load_models()

    def _load_models(self):
        if not self.models_dir.exists():
            logger.warning(f"Models directory not found: {self.models_dir}")
            return

        # 遍历 task_uuid 目录下的所有 pos_id 目录
        for pos_id_dir in self.models_dir.iterdir():
            if not pos_id_dir.is_dir():
                continue

            pos_id = pos_id_dir.name
            model_path = pos_id_dir / "patchcore_model.pt"

            if not model_path.exists():
                best = pos_id_dir / "best_model"
                if best.exists():
                    model_path = best / "patchcore_model.pt"

            if not model_path.exists():
                logger.warning(f"PatchCore model not found for pos_id={pos_id}, skipping")
                continue

            try:
                # 只加载一次模型文件
                checkpoint = torch.load(model_path, map_location="cpu")
                backbone = checkpoint.get("backbone", "resnet18")
                layers = checkpoint.get("layers", ["layer2", "layer3"])
                num_neighbors = checkpoint.get("num_neighbors", 9)
                
                # 检查是否存在反例库
                has_negative_bank = "negative_memory_bank" in checkpoint and \
                                    checkpoint["negative_memory_bank"] is not None
                
                # 根据配置选择单库或双库包装器
                if self.use_dual_bank and has_negative_bank:
                    wrapper = AnomalibPatchCoreWrapperDual(
                        backbone=backbone,
                        layers=layers,
                        num_neighbors=num_neighbors,
                        device="cuda" if torch.cuda.is_available() else "cpu",
                    )
                    logger.info(f"Using DUAL-BANK architecture for pos_id={pos_id}")
                else:
                    wrapper = AnomalibPatchCoreWrapper(
                        backbone=backbone,
                        layers=layers,
                        num_neighbors=num_neighbors,
                        device="cuda" if torch.cuda.is_available() else "cpu",
                    )
                    if self.use_dual_bank and not has_negative_bank:
                        logger.warning(f"No negative bank found for pos_id={pos_id}, using single bank")

                # 直接从已加载的checkpoint初始化，避免重复加载
                wrapper.load_from_checkpoint_dict(checkpoint)

                # 从 config.json 读取阈值等其他配置
                config_path = pos_id_dir / "config.json"
                config = {}
                if config_path.exists():
                    with open(config_path, "r", encoding="utf-8") as f:
                        config = json.load(f)
                    wrapper.load_config(str(config_path))

                # 使用 pos_id 作为模型 key
                self.models[pos_id] = wrapper
                self.configs[pos_id] = config

                # 获取内存库信息
                if hasattr(wrapper, 'pos_memory_bank') and wrapper.pos_memory_bank is not None:
                    pos_shape = wrapper.pos_memory_bank.shape
                else:
                    pos_shape = wrapper.memory_bank.shape if hasattr(wrapper, 'memory_bank') else "N/A"
                    
                neg_info = ""
                if hasattr(wrapper, 'neg_memory_bank') and wrapper.neg_memory_bank is not None:
                    neg_info = f", neg_bank={wrapper.neg_memory_bank.shape}"

                logger.info(
                    f"Loaded PatchCore model: pos_id={pos_id} "
                    f"(backbone={backbone}, layers={layers}, "
                    f"pos_bank={pos_shape}{neg_info}, "
                    f"threshold={config.get('threshold', 'N/A')}, "
                    f"target_size={config.get('target_size', 'N/A')})"
                )

            except Exception as e:
                logger.error(f"Failed to load PatchCore model pos_id={pos_id}: {e}")

    def detect_by_pos_id(
        self,
        rois:        List[np.ndarray],
        category:    str,
        request_id:  str = "",
        annotations: List[Dict] = None,
        save_preprocessed_dir: str = None,
    ) -> List[Dict[str, Any]]:
        """
        根据每个 ROI 的 pos_id 选择对应的模型进行推理
        """
        if save_preprocessed_dir:
            os.makedirs(save_preprocessed_dir, exist_ok=True)

        total_rois = len(rois)
        logger.info(f"[{request_id}] [{category}] Total ROIs to process: {total_rois}")

        result_pairs: List[tuple] = []

        try:
            for idx, roi in enumerate(rois):
                pos_id = "default"
                if annotations and idx < len(annotations):
                    pos_id = str(annotations[idx].get('pos_id', 'default'))

                if pos_id not in self.models:
                    logger.warning(
                        f"[{request_id}] [{category}] No model found for pos_id={pos_id}, "
                        f"skipping ROI {idx+1}"
                    )
                    result_pairs.append((0.0, True))
                    continue

                model = self.models[pos_id]
                config = self.configs[pos_id]
                raw_threshold = config.get("threshold", 0.5)
                threshold_buffer = config.get("threshold_buffer", 1.3)
                threshold = raw_threshold * threshold_buffer

                def make_result(error: float, infer_failed: bool = False, dual_info: Dict = None) -> Dict[str, Any]:
                    result = {
                        "is_anomaly":    (not infer_failed) and (error > threshold),
                        "anomaly_score": min(error / threshold, 1.0) if threshold > 0 else error,
                        "error":         error,
                        "threshold":     threshold,
                        "infer_failed":  infer_failed,
                    }
                    # 添加双库推理信息（如果存在）
                    if dual_info:
                        result["dual_info"] = dual_info
                    return result

                try:
                    # 使用模型配置中的 target_size 进行推理
                    result = model.infer_single(roi)
                    score = result["error"]
                    dual_info = result.get("dual_info", {})

                    # 双库推理日志
                    if dual_info and "positive_score" in dual_info:
                        log_msg = (
                            f"[{request_id}] [{category}] ROI {idx+1}/{total_rois} "
                            f"pos_id={pos_id} roi_size={roi.shape[1]}x{roi.shape[0]} "
                            f"combined_score={score:.4f} threshold={threshold:.4f} "
                            f"pos_score={dual_info.get('positive_score', 0):.4f} "
                            f"neg_score={dual_info.get('negative_score', 0):.4f}"
                        )
                        if dual_info.get("is_negative_match"):
                            log_msg += " [NEGATIVE_MATCH]"
                        logger.info(log_msg)
                    else:
                        logger.info(
                            f"[{request_id}] [{category}] ROI {idx+1}/{total_rois} "
                            f"pos_id={pos_id} roi_size={roi.shape[1]}x{roi.shape[0]} "
                            f"score={score:.4f} threshold={threshold:.4f} (raw={raw_threshold:.4f} x {threshold_buffer})"
                        )

                    result_pairs.append((make_result(score, result["infer_failed"], dual_info), False))

                except Exception as e:
                    logger.error(f"[{request_id}] [{category}] Error ROI {idx+1} pos_id={pos_id}: {e}")
                    result_pairs.append((make_result(0.0, True), True))

            logger.info(f"[{request_id}] [{category}] Processed {len(result_pairs)}/{total_rois} ROIs")
        finally:
            _cleanup(f"{category} done")

        # 提取结果
        return [r[0] for r in result_pairs]

    def detect_category(
        self,
        rois:        List[np.ndarray],
        category:    str,
        request_id:  str = "",
        annotations: List[Dict] = None,
        save_preprocessed_dir: str = None,
    ) -> List[Dict[str, Any]]:
        """
        兼容旧接口，实际调用 detect_by_pos_id
        """
        return self.detect_by_pos_id(
            rois=rois,
            category=category,
            request_id=request_id,
            annotations=annotations,
            save_preprocessed_dir=save_preprocessed_dir,
        )

    def get_loaded_categories(self) -> List[str]:
        return list(self.models.keys())


# ─────────────────────────────────────────────────────────────────────────────
# 从 annotations.json 选择最佳模板图片
# ─────────────────────────────────────────────────────────────────────────────

def select_best_template_from_annotations(annotations_path: str) -> tuple:
    try:
        with open(annotations_path, 'r', encoding='utf-8') as f:
            data = json.load(f)

        images      = {img['id']: img for img in data.get('images', [])}
        annotations = data.get('annotations', [])

        no_flip = [
            ann for ann in annotations
            if not ann.get('horizontal_flip', False)
            and not ann.get('vertical_flip', False)
        ]
        if not no_flip:
            logger.warning("No annotations without flip found")
            return None, []

        no_flip.sort(key=lambda x: abs(x.get('angle', 0)))
        best     = no_flip[0]
        img_info = images.get(best.get('image_id'))
        if not img_info:
            logger.warning(f"Image {best.get('image_id')} not found")
            return None, []

        ann_dir   = Path(annotations_path).parent
        file_name = img_info.get('file_name', '')

        for candidate in [
            ann_dir / "raw_images" / file_name,
            ann_dir / file_name,
            ann_dir / "images" / file_name,
        ]:
            if candidate.exists():
                template_path = str(candidate)
                break
        else:
            logger.warning(f"Template image not found for {file_name}")
            return None, []

        template_annotations = [
            {
                'category':      str(ann.get('pos_id', '')),  # 使用 pos_id 作为 category，以便匹配模型
                'category_name': ann.get('label', ''),
                'pos_id':        ann.get('pos_id'),
                'bbox':          ann.get('bbox', [0, 0, 0, 0]),
                'segmentation':  ann.get('segmentation', []),
            }
            for ann in no_flip
            if ann.get('image_id') == best.get('image_id') and ann.get('label')
        ]

        logger.info(
            f"Selected template: {file_name}, angle={best.get('angle', 0)}, "
            f"annotations={len(template_annotations)}"
        )
        return template_path, template_annotations

    except Exception as e:
        logger.error(f"Failed to select template from annotations: {e}")
        return None, []


# ─────────────────────────────────────────────────────────────────────────────
# Homography 对齐
# ─────────────────────────────────────────────────────────────────────────────

def enhance_for_matching(image):
    gray     = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    clahe    = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
    enhanced = clahe.apply(gray)
    return cv2.GaussianBlur(enhanced, (3, 3), 0)


def align_orb_homography(tg, pg, min_matches=10):
    orb = cv2.ORB_create(
        nfeatures=3000, scaleFactor=1.2, nlevels=8,
        edgeThreshold=15, patchSize=31
    )
    kp1, des1 = orb.detectAndCompute(tg, None)
    kp2, des2 = orb.detectAndCompute(pg, None)
    if (des1 is None or des2 is None
            or len(kp1) < min_matches or len(kp2) < min_matches):
        return None
    bf      = cv2.BFMatcher(cv2.NORM_HAMMING, crossCheck=True)
    matches = sorted(bf.match(des1, des2), key=lambda x: x.distance)
    if not matches:
        return None
    max_dist = max(m.distance for m in matches)
    good     = [m for m in matches if m.distance < 0.7 * max_dist]
    if len(good) < min_matches:
        return None
    pts1 = np.float32([kp1[m.queryIdx].pt for m in good]).reshape(-1, 1, 2)
    pts2 = np.float32([kp2[m.trainIdx].pt for m in good]).reshape(-1, 1, 2)
    H, _ = cv2.findHomography(pts1, pts2, cv2.RANSAC, 4.0)
    return H


def align_ecc(tg, pg):
    scale       = 0.5
    warp_matrix = np.eye(2, 3, dtype=np.float32)
    criteria    = (cv2.TERM_CRITERIA_EPS | cv2.TERM_CRITERIA_COUNT, 200, 1e-6)
    try:
        _, warp_matrix = cv2.findTransformECC(
            cv2.resize(tg, None, fx=scale, fy=scale),
            cv2.resize(pg, None, fx=scale, fy=scale),
            warp_matrix, cv2.MOTION_AFFINE, criteria
        )
        warp_matrix[0, 2] /= scale
        warp_matrix[1, 2] /= scale
        return np.vstack([warp_matrix, [0, 0, 1]])
    except Exception:
        return None


def align_contour_affine(ti, pi):
    def get_rect(img):
        gray    = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY) if len(img.shape) == 3 else img
        _, bin_ = cv2.threshold(gray, 0, 255, cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)
        kernel  = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (9, 9))
        bin_    = cv2.morphologyEx(bin_, cv2.MORPH_CLOSE, kernel, iterations=3)
        cnts, _ = cv2.findContours(bin_, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        return cv2.minAreaRect(max(cnts, key=cv2.contourArea)) if cnts else None

    rt, rp = get_rect(ti), get_rect(pi)
    if rt is None or rp is None:
        return None
    (cx_t, cy_t), (tw, th), at = rt
    (cx_p, cy_p), (pw, ph), ap = rp
    sx = pw / tw if tw > 0 else 1.0
    sy = ph / th if th > 0 else 1.0
    da = ap - at
    ca, sa = np.cos(np.radians(da)), np.sin(np.radians(da))
    return np.array([
        [sx * ca, -sx * sa, cx_p - sx * (ca * cx_t - sa * cy_t)],
        [sy * sa,  sy * ca, cy_p - sy * (sa * cx_t + ca * cy_t)],
        [0, 0, 1]
    ], dtype=np.float64)


def detect_workpiece_bbox(
    image: np.ndarray,
    padding: int = 30,
    min_area_ratio: float = 0.05,
    max_area_ratio: float = 0.92,
) -> Optional[tuple]:
    h_img, w_img = image.shape[:2]
    img_area     = h_img * w_img

    gray     = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY) if len(image.shape) == 3 else image.copy()
    clahe    = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(8, 8))
    enhanced = clahe.apply(gray)
    blurred  = cv2.GaussianBlur(enhanced, (5, 5), 0)

    candidates = []
    for flag in (cv2.THRESH_BINARY + cv2.THRESH_OTSU,
                 cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU):
        _, binary = cv2.threshold(blurred, 0, 255, flag)
        candidates.append(binary)
    adaptive = cv2.adaptiveThreshold(
        blurred, 255,
        cv2.ADAPTIVE_THRESH_GAUSSIAN_C, cv2.THRESH_BINARY_INV,
        blockSize=51, C=5
    )
    candidates.append(adaptive)

    kernel_close = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (15, 15))
    kernel_open  = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))

    best_bbox       = None
    best_area_ratio = 0.0

    for binary in candidates:
        cleaned = cv2.morphologyEx(binary,  cv2.MORPH_CLOSE, kernel_close, iterations=2)
        cleaned = cv2.morphologyEx(cleaned, cv2.MORPH_OPEN,  kernel_open,  iterations=1)
        cnts, _ = cv2.findContours(cleaned, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        if not cnts:
            continue
        for cnt in sorted(cnts, key=cv2.contourArea, reverse=True):
            area_ratio = cv2.contourArea(cnt) / img_area
            if min_area_ratio <= area_ratio <= max_area_ratio:
                if area_ratio > best_area_ratio:
                    best_area_ratio = area_ratio
                    best_bbox = cv2.boundingRect(cnt)
                break

    if best_bbox is None:
        logger.warning(f"[detect_workpiece_bbox] 未检测到工件，回退到全图")
        return None

    x, y, w, h = best_bbox
    x1 = max(0, x - padding)
    y1 = max(0, y - padding)
    x2 = min(w_img, x + w + padding)
    y2 = min(h_img, y + h + padding)
    cw, ch = x2 - x1, y2 - y1
    logger.info(f"[detect_workpiece_bbox] bbox=({x1},{y1},{cw},{ch}), area_ratio={best_area_ratio:.2%}")
    return (x1, y1, cw, ch)


def compute_workpiece_bbox_from_annotations(
    annotations: List[Dict],
    padding: int = 30,
    img_shape: tuple = None,
) -> Optional[tuple]:
    """
    从标注的 segmentation / bbox 计算模板中工件主体的外接矩形。
    取所有标注区域的联合外接矩形作为工件区域，比图像阈值法更准确。

    Args:
        annotations: 标注列表，每项含 segmentation 或 bbox
        padding:     外扩像素
        img_shape:   图像 shape，用于裁剪越界坐标

    Returns:
        (x, y, w, h) 或 None
    """
    all_points = []
    for ann in annotations:
        seg = ann.get("segmentation", [])
        if seg:
            for s in seg:
                pts = np.array(s).reshape(-1, 2)
                all_points.append(pts)
        elif ann.get("bbox"):
            x, y, w, h = [float(v) for v in ann["bbox"]]
            all_points.append(np.array([[x, y], [x+w, y], [x+w, y+h], [x, y+h]]))

    if not all_points:
        logger.warning("[compute_workpiece_bbox_from_annotations] 无有效标注，返回 None")
        return None

    all_pts = np.vstack(all_points)
    x_min   = max(0, int(np.min(all_pts[:, 0])) - padding)
    y_min   = max(0, int(np.min(all_pts[:, 1])) - padding)
    x_max   = int(np.max(all_pts[:, 0])) + padding
    y_max   = int(np.max(all_pts[:, 1])) + padding

    if img_shape is not None:
        h_img, w_img = img_shape[:2]
        x_max = min(x_max, w_img)
        y_max = min(y_max, h_img)

    logger.info(
        f"[compute_workpiece_bbox_from_annotations] "
        f"工件bbox=({x_min},{y_min},{x_max-x_min},{y_max-y_min}), "
        f"共 {len(annotations)} 个标注"
    )
    return (x_min, y_min, x_max - x_min, y_max - y_min)


def detect_workpieces_by_template_matching(
    pred_image: np.ndarray,
    template_image: np.ndarray,
    template_workpiece_bbox: tuple,
    match_threshold: float = 0.35,
    nms_iou_threshold: float = 0.3,
    max_workpieces: int = 16,
) -> List[tuple]:
    """
    用模板裁剪区域在预测图中做多尺度 matchTemplate，找到所有工件实例。

    核心思路：
    - 用 annotation 外接矩形裁出模板工件区域
    - 在预测图中滑窗搜索，支持 ±15% 尺度变化
    - NMS 去重后返回所有工件 bbox

    Args:
        pred_image:              预测输入图像
        template_image:          模板图像
        template_workpiece_bbox: 模板中工件的 (x, y, w, h)
        match_threshold:         匹配分数阈值（0~1，越高越严格）
        nms_iou_threshold:       NMS IoU 阈值
        max_workpieces:          最大返回工件数

    Returns:
        List[(x, y, w, h)]  每个工件在预测图中的 bbox
    """
    tx, ty, tw, th = template_workpiece_bbox
    tmpl_crop = template_image[ty:ty + th, tx:tx + tw]

    if tmpl_crop.size == 0:
        logger.warning("[detect_workpieces_by_template_matching] 模板裁剪区域为空，退化为全图")
        h_img, w_img = pred_image.shape[:2]
        return [(0, 0, w_img, h_img)]

    tmpl_gray = (cv2.cvtColor(tmpl_crop, cv2.COLOR_BGR2GRAY)
                 if len(tmpl_crop.shape) == 3 else tmpl_crop.copy())
    pred_gray = (cv2.cvtColor(pred_image, cv2.COLOR_BGR2GRAY)
                 if len(pred_image.shape) == 3 else pred_image.copy())

    h_img, w_img = pred_gray.shape[:2]
    h_t,   w_t   = tmpl_gray.shape[:2]

    # 预测图小于模板，退化为全图
    if h_img < h_t or w_img < w_t:
        logger.warning("[detect_workpieces_by_template_matching] 预测图小于模板，退化为全图")
        return [(0, 0, w_img, h_img)]

    # CLAHE 对比度增强，减少光照影响
    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
    tmpl_gray = clahe.apply(tmpl_gray)
    pred_gray = clahe.apply(pred_gray)

    # 多尺度匹配（±15% 缩放，5 个尺度）
    best_boxes: List[tuple] = []   # [(score, x, y, w, h)]
    for scale in [0.85, 0.92, 1.0, 1.08, 1.15]:
        nw, nh = int(w_t * scale), int(h_t * scale)
        if nw > w_img or nh > h_img or nw < 10 or nh < 10:
            continue
        scaled_tmpl = cv2.resize(tmpl_gray, (nw, nh))
        res         = cv2.matchTemplate(pred_gray, scaled_tmpl, cv2.TM_CCOEFF_NORMED)
        ys, xs      = np.where(res >= match_threshold)
        for x, y in zip(xs, ys):
            best_boxes.append((float(res[y, x]), int(x), int(y), nw, nh))

    # 无超过阈值的匹配 → 取全图最佳点（保证至少返回一个）
    if not best_boxes:
        logger.warning(
            f"[detect_workpieces_by_template_matching] "
            f"无超过阈值({match_threshold})的匹配，使用全图最佳点"
        )
        res = cv2.matchTemplate(pred_gray, tmpl_gray, cv2.TM_CCOEFF_NORMED)
        _, max_val, _, max_loc = cv2.minMaxLoc(res)
        logger.info(f"  最佳匹配分数={max_val:.3f}, 位置={max_loc}")
        return [(max_loc[0], max_loc[1], w_t, h_t)]

    # 按分数降序
    best_boxes.sort(key=lambda b: b[0], reverse=True)

    # NMS 去重
    def _iou(a, b):
        ax, ay, aw, ah = a[1], a[2], a[3], a[4]
        bx, by, bw, bh = b[1], b[2], b[3], b[4]
        ix1 = max(ax, bx); iy1 = max(ay, by)
        ix2 = min(ax+aw, bx+bw); iy2 = min(ay+ah, by+bh)
        inter = max(0, ix2-ix1) * max(0, iy2-iy1)
        union = aw*ah + bw*bh - inter
        return inter / union if union > 0 else 0.0

    kept = []
    for box in best_boxes:
        if len(kept) >= max_workpieces:
            break
        if all(_iou(box, k) < nms_iou_threshold for k in kept):
            kept.append(box)

    result = [(b[1], b[2], b[3], b[4]) for b in kept]
    logger.info(f"[detect_workpieces_by_template_matching] 检测到 {len(result)} 个工件: {result}")
    return result


def _run_roi_inference_for_workpiece(
    detector,
    aligned_pred: np.ndarray,
    annotations: List[Dict],
    tmpl_w: int,
    tmpl_h: int,
    H: np.ndarray,
    request_id: str,
) -> Dict[int, Dict]:
    """
    对单个对齐后的预测图执行 ROI 推理，返回 {ann_idx: result_dict}
    """
    category_rois:    Dict[str, List] = {}
    category_indices: Dict[str, List] = {}

    for i, ann in enumerate(annotations):
        category = ann.get("category")
        if not category or category not in detector.models:
            continue

        roi = None
        seg  = ann.get("segmentation", [])
        bbox = ann.get("bbox", [0, 0, 0, 0])

        if seg:
            roi = _extract_roi_from_segmentation(aligned_pred, seg, pad_ratio=0.0)
        if roi is None or roi.size == 0:
            if not bbox or len(bbox) < 4:
                continue
            x, y, w, h = [int(v) for v in bbox]
            x = max(0, min(x, tmpl_w-1)); y = max(0, min(y, tmpl_h-1))
            w = min(w, tmpl_w-x);         h = min(h, tmpl_h-y)
            if w <= 0 or h <= 0:
                continue
            roi = aligned_pred[y:y+h, x:x+w]
        if roi is None or roi.size == 0:
            continue

        category_rois.setdefault(category, []).append(roi)
        category_indices.setdefault(category, []).append((i, ann.get("category_name", category)))

    results_map: Dict[int, Dict] = {}
    H_inv = np.linalg.inv(H) if H is not None else np.eye(3, dtype=np.float64)

    for category, rois in category_rois.items():
        indices_info         = category_indices[category]
        category_annotations = [annotations[idx] for idx, _ in indices_info]
        det_results = detector.detect_category(
            rois, category, request_id, annotations=category_annotations,
        )

        for idx, det_result in enumerate(det_results):
            ann_idx, category_name = indices_info[idx]
            ann  = annotations[ann_idx]
            bbox = ann.get("bbox", [0,0,0,0])
            segm = ann.get("segmentation", [])

            x, y, w, h = [float(v) for v in bbox]
            corners = np.array([[x,y],[x+w,y],[x+w,y+h],[x,y+h]],
                                dtype=np.float64).reshape(-1,1,2)
            tc = cv2.perspectiveTransform(corners, H_inv).reshape(-1, 2)
            bbox_in_pred = [
                float(np.min(tc[:,0])), float(np.min(tc[:,1])),
                float(np.max(tc[:,0]) - np.min(tc[:,0])),
                float(np.max(tc[:,1]) - np.min(tc[:,1])),
            ]

            segm_in_pred = []
            if segm and len(segm) > 0 and len(segm[0]) >= 8:
                pts = np.array([[segm[0][i], segm[0][i+1]]
                                 for i in range(0, len(segm[0]), 2)],
                                dtype=np.float64).reshape(-1,1,2)
                tp  = cv2.perspectiveTransform(pts, H_inv).reshape(-1, 2)
                segm_in_pred = [float(v) for v in tp.flatten()]

            is_anomaly = det_result.get("is_anomaly", False)
            results_map[ann_idx] = {
                "category":             category_name,
                "pos_id":               ann.get("pos_id"),
                "bbox":                 bbox,
                "bbox_in_pred":         bbox_in_pred,
                "bbox_clipped":         bbox,
                "segmentation":         segm,
                "segmentation_in_pred": segm_in_pred,
                "is_anomaly":           is_anomaly,
                "anomaly_score":        det_result.get("anomaly_score", 0.0),
                "error":                det_result.get("error",         0.0),
                "threshold":            det_result.get("threshold",     0.0),
                "infer_failed":         det_result.get("infer_failed",  False),
                "anomaly_type":         "real_defect" if is_anomaly else "normal",
                "dual_info":            det_result.get("dual_info",     {}),
            }

    return results_map


def create_workpieces_visualization(
    pred_image: np.ndarray,
    all_workpiece_results: List[Dict],
    title: str = "检测到的工件",
) -> np.ndarray:
    """
    创建多工件检测结果的整体可视化图像
    """
    COLOR_NORMAL   = (0, 255, 0)
    COLOR_ANOMALY  = (0, 0, 255)
    COLOR_TEXT     = (255, 255, 255)
    COLOR_BG       = (40, 40, 40)
    COLOR_WORKPIECE = (0, 255, 128)

    # 计算布局
    n_workpieces = len(all_workpiece_results)
    if n_workpieces == 0:
        return np.full((400, 600, 3), COLOR_BG, dtype=np.uint8)

    # 调整图像大小用于显示
    display_size = (400, 400)
    resized_pred = cv2.resize(pred_image, display_size)

    # 创建画布
    cols = min(3, n_workpieces)
    rows = (n_workpieces + cols - 1) // cols
    cell_w = display_size[0] + 20
    cell_h = display_size[1] + 80
    canvas_w = cell_w * cols + 40
    canvas_h = cell_h * rows + 80

    canvas = np.full((canvas_h, canvas_w, 3), COLOR_BG, dtype=np.uint8)
    canvas = cv2_put_chinese_text(canvas, title, (20, 40), COLOR_TEXT, 24)

    for idx, wp in enumerate(all_workpiece_results):
        row = idx // cols
        col = idx % cols
        x_off = 20 + col * cell_w
        y_off = 60 + row * cell_h

        # 绘制工件bbox
        wx, wy, ww, wh = wp.get("workpiece_bbox", [0, 0, 0, 0])
        sx = display_size[0] / pred_image.shape[1]
        sy = display_size[1] / pred_image.shape[0]
        cv2.rectangle(resized_pred,
                      (int(wx*sx), int(wy*sy)),
                      (int((wx+ww)*sx), int((wy+wh)*sy)),
                      COLOR_WORKPIECE, 2)

        # 绘制ROI结果
        for r_idx, result in enumerate(wp.get("results", [])):
            color = COLOR_ANOMALY if result.get("is_anomaly") else COLOR_NORMAL
            bbox = result.get("bbox_in_pred", [0, 0, 0, 0])
            bx, by, bw, bh = bbox
            cv2.rectangle(resized_pred,
                          (int(bx*sx), int(by*sy)),
                          (int((bx+bw)*sx), int((by+bh)*sy)),
                          color, 1)

        # 复制到画布
        canvas[y_off:y_off+display_size[1], x_off:x_off+display_size[0]] = resized_pred.copy()

        # 添加文字信息
        info_text = f"工件 {idx+1}: {wp.get('anomaly_count', 0)}/{wp.get('total_rois', 0)} 异常"
        canvas = cv2_put_chinese_text(canvas, info_text, (x_off, y_off + display_size[1] + 10),
                                      COLOR_TEXT, 16)

    return canvas


def detect_multiple_workpieces(
    image: np.ndarray,
    padding: int = 20,
    min_area_ratio: float = 0.01,
    max_area_ratio: float = 0.90,
    min_iou_threshold: float = 0.3,
) -> List[tuple]:
    """
    检测图像中的多个工件，返回所有有效的工件 bbox 列表
    使用简单直观的方案：灰度化 -> 二值化 -> 形态学操作 -> 轮廓检测
    
    Args:
        image: 输入图像
        padding: 边界框padding
        min_area_ratio: 最小面积比例（默认1%）
        max_area_ratio: 最大面积比例（默认90%）
        min_iou_threshold: 去重时的最小IOU阈值
        
    Returns:
        List[tuple]: 每个 tuple 为 (x, y, w, h)
    """
    h_img, w_img = image.shape[:2]
    img_area = h_img * w_img

    # 转换为灰度图
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY) if len(image.shape) == 3 else image.copy()
    
    all_bboxes = []
    
    # 策略1: 直接二值化（适用于黑白对比明显的图像）
    # 黑色工件像素值接近0，白色背景接近255
    _, binary = cv2.threshold(gray, 127, 255, cv2.THRESH_BINARY_INV)
    _extract_bboxes_from_binary_simple(binary, all_bboxes, w_img, h_img, img_area, 
                                       min_area_ratio, max_area_ratio, padding)
    
    # 策略2: 多种阈值尝试
    for thresh in [50, 100, 150, 200]:
        _, binary = cv2.threshold(gray, thresh, 255, cv2.THRESH_BINARY_INV)
        _extract_bboxes_from_binary_simple(binary, all_bboxes, w_img, h_img, img_area,
                                          min_area_ratio, max_area_ratio, padding)
    
    # 策略3: OTSU自动阈值
    _, binary_otsu = cv2.threshold(gray, 0, 255, cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)
    _extract_bboxes_from_binary_simple(binary_otsu, all_bboxes, w_img, h_img, img_area,
                                      min_area_ratio, max_area_ratio, padding)

    if not all_bboxes:
        logger.warning(f"[detect_multiple_workpieces] 未检测到工件，回退到全图")
        return [(0, 0, w_img, h_img)]

    # 按面积排序并去重
    all_bboxes.sort(key=lambda x: x[4], reverse=True)
    
    def compute_iou(box1, box2):
        x1, y1, w1, h1 = box1[:4]
        x2, y2, w2, h2 = box2[:4]
        
        xi1 = max(x1, x2)
        yi1 = max(y1, y2)
        xi2 = min(x1 + w1, x2 + w2)
        yi2 = min(y1 + h1, y2 + h2)
        
        inter_area = max(0, xi2 - xi1) * max(0, yi2 - yi1)
        box1_area = w1 * h1
        box2_area = w2 * h2
        union_area = box1_area + box2_area - inter_area
        
        return inter_area / union_area if union_area > 0 else 0

    # NMS-like 去重
    filtered_bboxes = []
    for bbox in all_bboxes:
        is_duplicate = False
        for kept_bbox in filtered_bboxes:
            if compute_iou(bbox, kept_bbox) > min_iou_threshold:
                is_duplicate = True
                break
        if not is_duplicate:
            filtered_bboxes.append(bbox)

    result = [(b[0], b[1], b[2], b[3]) for b in filtered_bboxes]
    logger.info(f"[detect_multiple_workpieces] 检测到 {len(result)} 个工件: {result}")
    return result


def _extract_bboxes_from_binary_simple(
    binary: np.ndarray,
    all_bboxes: List,
    w_img: int,
    h_img: int,
    img_area: int,
    min_area_ratio: float,
    max_area_ratio: float,
    padding: int
):
    """
    从二值图像中提取边界框 - 简化版本
    形态学操作 -> 查找轮廓 -> 过滤 -> 添加bbox
    """
    # 形态学操作 - 连接工件区域
    kernel_close = cv2.getStructuringElement(cv2.MORPH_RECT, (15, 15))
    binary_cleaned = cv2.morphologyEx(binary, cv2.MORPH_CLOSE, kernel_close, iterations=2)
    
    # 去除小噪声
    kernel_open = cv2.getStructuringElement(cv2.MORPH_RECT, (5, 5))
    binary_cleaned = cv2.morphologyEx(binary_cleaned, cv2.MORPH_OPEN, kernel_open, iterations=1)
    
    # 查找轮廓
    contours, _ = cv2.findContours(binary_cleaned, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    
    for cnt in contours:
        area = cv2.contourArea(cnt)
        area_ratio = area / img_area
        
        # 过滤条件：
        # 1. 面积比例在有效范围内
        # 2. 面积不能太小（至少100像素）
        if not (min_area_ratio <= area_ratio <= max_area_ratio):
            continue
        if area < 100:
            continue
        
        # 获取边界框
        x, y, w, h = cv2.boundingRect(cnt)
        
        # 添加padding
        x1 = max(0, x - padding)
        y1 = max(0, y - padding)
        x2 = min(w_img, x + w + padding)
        y2 = min(h_img, y + h + padding)
        
        bbox = (x1, y1, x2 - x1, y2 - y1, area_ratio)
        
        # 避免添加完全相同的框（位置差<5像素视为相同）
        is_duplicate = False
        for existing in all_bboxes:
            if (abs(existing[0] - bbox[0]) < 5 and 
                abs(existing[1] - bbox[1]) < 5 and
                abs(existing[2] - bbox[2]) < 5 and 
                abs(existing[3] - bbox[3]) < 5):
                is_duplicate = True
                break
        
        if not is_duplicate:
            all_bboxes.append(bbox)


def precompute_template_workpiece(
    template_img: np.ndarray,
    match_size: tuple = (512, 512),
    padding: int = 30,
) -> Dict[str, Any]:
    bbox = detect_workpiece_bbox(template_img, padding=padding)
    if bbox is None:
        cx, cy = 0, 0
        cw, ch = template_img.shape[1], template_img.shape[0]
        logger.warning("[precompute_template_workpiece] 工件检测失败，使用全图")
    else:
        cx, cy, cw, ch = bbox

    crop      = template_img[cy:cy + ch, cx:cx + cw]
    resized   = cv2.resize(crop, match_size)
    crop_gray = enhance_for_matching(resized)

    logger.info(f"[precompute_template_workpiece] workpiece=({cx},{cy},{cw},{ch})")
    return {
        "workpiece_bbox": (cx, cy, cw, ch),
        "crop_gray":      crop_gray,
        "full_bbox":      (0, 0, template_img.shape[1], template_img.shape[0]),
    }


def find_alignment_homography(
    template_img: np.ndarray,
    pred_img:     np.ndarray,
    cached_template_gray: Optional[np.ndarray] = None,
):
    MATCH_SIZE = (512, 512)

    def resize_with_scale(img):
        h, w = img.shape[:2]
        r    = cv2.resize(img, MATCH_SIZE)
        return r, w / MATCH_SIZE[0], h / MATCH_SIZE[1]

    tr, t_sx, t_sy = resize_with_scale(template_img)
    pr, p_sx, p_sy = resize_with_scale(pred_img)

    tg = cached_template_gray if cached_template_gray is not None \
        else enhance_for_matching(tr)
    pg = enhance_for_matching(pr)

    H, strategy = None, None
    for fn, name in [
        (lambda: align_orb_homography(tg, pg), "ORB"),
        (lambda: align_ecc(tg, pg),            "ECC"),
        (lambda: align_contour_affine(tr, pr), "轮廓仿射对齐"),
    ]:
        H = fn()
        if H is not None:
            strategy = name
            break

    if H is None:
        return None, None

    S_t     = np.diag([1.0 / t_sx, 1.0 / t_sy, 1.0])
    S_p_inv = np.diag([p_sx, p_sy, 1.0])
    H_orig  = S_p_inv @ H @ S_t

    logger.info(
        f"[Homography] strategy={strategy}, "
        f"template=({template_img.shape[1]},{template_img.shape[0]}), "
        f"pred=({pred_img.shape[1]},{pred_img.shape[0]})"
    )
    return H_orig, strategy


def _extract_roi_from_bbox(img: np.ndarray, bbox: List[float]) -> np.ndarray:
    x, y, w, h = [int(v) for v in bbox]
    img_h, img_w = img.shape[:2]
    x = max(0, min(x, img_w - 1))
    y = max(0, min(y, img_h - 1))
    w = max(1, min(w, img_w - x))
    h = max(1, min(h, img_h - y))
    return img[y:y + h, x:x + w]


def _extract_roi_from_segmentation(img: np.ndarray, segmentation: List[List[float]], pad_ratio: float = 0.05) -> Optional[np.ndarray]:
    if not segmentation:
        return None

    all_pts = []
    for seg in segmentation:
        pts = np.array(seg).reshape(-1, 2).astype(np.int32)
        all_pts.append(pts)

    if not all_pts:
        return None

    all_points = np.vstack(all_pts)
    x_min, y_min = np.min(all_points, axis=0)
    x_max, y_max = np.max(all_points, axis=0)

    w, h = x_max - x_min, y_max - y_min
    pad_x = int(w * pad_ratio)
    pad_y = int(h * pad_ratio)

    x_min = max(0, x_min - pad_x)
    y_min = max(0, y_min - pad_y)
    x_max = min(img.shape[1], x_max + pad_x)
    y_max = min(img.shape[0], y_max + pad_y)

    roi = img[y_min:y_max, x_min:x_max].copy()
    if roi.size == 0:
        return None

    mask = np.zeros((y_max - y_min, x_max - x_min), dtype=np.uint8)
    for pts in all_pts:
        pts_shifted = pts - [x_min, y_min]
        cv2.fillPoly(mask, [pts_shifted], 255)

    roi_masked = cv2.bitwise_and(roi, roi, mask=mask)
    return roi_masked


def _extract_roi(img: np.ndarray, ann: Dict) -> Optional[np.ndarray]:
    segmentation = ann.get("segmentation", [])
    if segmentation:
        roi = _extract_roi_from_segmentation(img, segmentation)
        if roi is not None:
            return roi
    bbox = ann.get("bbox", [0, 0, 0, 0])
    if bbox and len(bbox) >= 4:
        return _extract_roi_from_bbox(img, bbox)
    return None


def save_roi_screenshots(
    results:      List[Dict[str, Any]],
    template_img: np.ndarray,
    aligned_pred: np.ndarray,
    annotations:  List[Dict],
    request_id:   str = "",
) -> Dict[str, List[str]]:
    saved_paths = {"ok": [], "ng": []}
    if aligned_pred is None or aligned_pred.size == 0:
        return saved_paths
    if len(results) != len(annotations):
        return saved_paths

    for idx, (res, ann) in enumerate(zip(results, annotations)):
        anomaly_type  = res.get("anomaly_type", "normal")
        status_folder = "ok" if anomaly_type == "normal" else ("ng" if anomaly_type == "real_defect" else None)
        if status_folder is None:
            continue

        category = res.get("category", "unknown")
        save_dir = ROI_SAVE_DIR / category / status_folder

        template_roi = _extract_roi(template_img, ann)
        if template_roi is None or template_roi.size == 0:
            continue

        pred_roi = _extract_roi(aligned_pred, ann)
        if pred_roi is None or pred_roi.size == 0:
            continue

        try:
            save_dir.mkdir(parents=True, exist_ok=True)

            tmpl_filename = f"roi{idx+1}_{category}_{status_folder}_template.jpg"
            if cv2.imwrite(str(save_dir / tmpl_filename), template_roi):
                saved_paths[status_folder].append(str(save_dir / tmpl_filename))

            pred_filename = f"roi{idx+1}_{category}_{status_folder}_pred.jpg"
            if cv2.imwrite(str(save_dir / pred_filename), pred_roi):
                saved_paths[status_folder].append(str(save_dir / pred_filename))

        except Exception as e:
            logger.error(f"[{request_id}] 保存ROI截图失败: {e}")

    return saved_paths


def create_simple_visualization(
    template_img:  np.ndarray,
    pred_img:      np.ndarray,
    aligned_pred:  np.ndarray,
    annotations:   List[Dict],
    results:       List[Dict],
    strategy:      str,
    request_id:    str = "",
    template_workpiece_bbox: Optional[tuple] = None,
    pred_workpiece_bbox:     Optional[tuple] = None,
    H: Optional[np.ndarray] = None,
) -> np.ndarray:
    COLOR_NORMAL   = (0, 255, 0)
    COLOR_ANOMALY  = (0, 0, 255)
    COLOR_TEMPLATE = (255, 128, 0)
    COLOR_TEXT     = (255, 255, 255)
    COLOR_BG       = (40, 40, 40)
    COLOR_WORKPIECE = (0, 255, 128)
    COLOR_DASH     = (128, 128, 128)

    DISPLAY_SIZE = (400, 400)
    ROI_SIZE     = (150, 150)
    row1_height  = DISPLAY_SIZE[1] + 60

    def _resize(img):
        return cv2.resize(img, DISPLAY_SIZE)

    def draw_dashed_rect(img, pt1, pt2, color, thickness=1, dash_length=10, gap_length=5):
        x1, y1 = pt1; x2, y2 = pt2
        for x in range(x1, x2, dash_length + gap_length):
            end_x = min(x + dash_length, x2)
            cv2.line(img, (x, y1), (end_x, y1), color, thickness)
            cv2.line(img, (x, y2), (end_x, y2), color, thickness)
        for y in range(y1, y2, dash_length + gap_length):
            end_y = min(y + dash_length, y2)
            cv2.line(img, (x1, y), (x1, end_y), color, thickness)
            cv2.line(img, (x2, y), (x2, end_y), color, thickness)

    sx = DISPLAY_SIZE[0] / template_img.shape[1]
    sy = DISPLAY_SIZE[1] / template_img.shape[0]

    tmpl_viz = _resize(template_img).copy()
    if template_workpiece_bbox is not None:
        wx, wy, ww, wh = template_workpiece_bbox
        cv2.rectangle(tmpl_viz, (int(wx*sx), int(wy*sy)), (int((wx+ww)*sx), int((wy+wh)*sy)), COLOR_WORKPIECE, 2)
        tmpl_viz = cv2_put_chinese_text(tmpl_viz, "工件", (int(wx*sx), max(int(wy*sy)-25, 0)), COLOR_WORKPIECE, 16)

    for i, ann in enumerate(annotations):
        segmentation = ann.get("segmentation", [])
        if segmentation:
            for seg in segmentation:
                pts = np.array(seg).reshape(-1, 2).astype(np.float32)
                pts[:, 0] *= sx; pts[:, 1] *= sy
                cv2.polylines(tmpl_viz, [pts.astype(np.int32)], True, COLOR_TEMPLATE, 2)
                tmpl_viz = cv2_put_chinese_text(tmpl_viz, f"{i+1}", (int(pts[0][0]), max(int(pts[0][1])-25, 0)), COLOR_TEMPLATE, 18)
        else:
            x, y, w, h = ann.get("bbox", [0, 0, 0, 0])
            cv2.rectangle(tmpl_viz, (int(x*sx), int(y*sy)), (int((x+w)*sx), int((y+h)*sy)), COLOR_TEMPLATE, 2)
            tmpl_viz = cv2_put_chinese_text(tmpl_viz, f"{i+1}", (int(x*sx), max(int(y*sy)-25, 0)), COLOR_TEMPLATE, 18)

    col1 = np.full((row1_height, DISPLAY_SIZE[0], 3), COLOR_BG, dtype=np.uint8)
    col1[60:] = tmpl_viz
    col1 = cv2_put_chinese_text(col1, "1. 模板图像 + 标注框", (10, 30), COLOR_TEXT, 22)

    ap_viz = _resize(aligned_pred).copy()
    for i, (ann, res) in enumerate(zip(annotations, results)):
        color = COLOR_ANOMALY if res.get("is_anomaly", False) else COLOR_NORMAL
        segmentation = ann.get("segmentation", [])
        if segmentation:
            for seg in segmentation:
                pts = np.array(seg).reshape(-1, 2).astype(np.float32)
                pts[:, 0] *= sx; pts[:, 1] *= sy
                cv2.polylines(ap_viz, [pts.astype(np.int32)], True, color, 2)
                ap_viz = cv2_put_chinese_text(ap_viz, f"{i+1}", (int(pts[0][0]), max(int(pts[0][1])-25, 0)), color, 16)
        else:
            x, y, w, h = ann.get("bbox", [0, 0, 0, 0])
            cv2.rectangle(ap_viz, (int(x*sx), int(y*sy)), (int((x+w)*sx), int((y+h)*sy)), color, 2)
            ap_viz = cv2_put_chinese_text(ap_viz, f"{i+1}", (int(x*sx), max(int(y*sy)-25, 0)), color, 16)

    col2 = np.full((row1_height, DISPLAY_SIZE[0], 3), COLOR_BG, dtype=np.uint8)
    col2[60:] = ap_viz
    col2 = cv2_put_chinese_text(col2, "2. 对齐后预测图 + 结果", (10, 30), COLOR_TEXT, 22)

    col3_viz = _resize(pred_img).copy()
    sx_p = DISPLAY_SIZE[0] / pred_img.shape[1]
    sy_p = DISPLAY_SIZE[1] / pred_img.shape[0]
    if pred_workpiece_bbox is not None:
        wx, wy, ww, wh = pred_workpiece_bbox
        cv2.rectangle(col3_viz, (int(wx*sx_p), int(wy*sy_p)), (int((wx+ww)*sx_p), int((wy+wh)*sy_p)), COLOR_WORKPIECE, 2)

    col3 = np.full((row1_height, DISPLAY_SIZE[0], 3), COLOR_BG, dtype=np.uint8)
    col3[60:] = col3_viz
    col3 = cv2_put_chinese_text(col3, "3. 原始预测图", (10, 30), COLOR_TEXT, 22)

    row1 = np.hstack([col1, col2, col3])

    rois_per_row   = 3
    n_results      = len(results)
    n_rows         = max(1, (n_results + rois_per_row - 1) // rois_per_row)
    compare_width  = ROI_SIZE[0] * 2 + 20
    roi_row_height = ROI_SIZE[1] + 80
    row2_width     = row1.shape[1]
    row2 = np.full((roi_row_height * n_rows + 60, row2_width, 3), COLOR_BG, dtype=np.uint8)
    row2 = cv2_put_chinese_text(row2, "4. ROI 对比详情 (模板 | 对齐后预测)", (20, 30), COLOR_TEXT, 24)

    def _extract_roi_viz(img, ann):
        segmentation = ann.get('segmentation', [])
        canvas = np.zeros((ROI_SIZE[1], ROI_SIZE[0], 3), dtype=np.uint8)
        if segmentation:
            all_pts = []
            for seg in segmentation:
                pts = np.array(seg).reshape(-1, 2).astype(np.int32)
                all_pts.append(pts)
            if all_pts:
                all_points = np.vstack(all_pts)
                x_min, y_min = np.min(all_points, axis=0)
                x_max, y_max = np.max(all_points, axis=0)
                pad = max(int((x_max - x_min) * 0.1), int((y_max - y_min) * 0.1), 1)
                x_min = max(0, x_min - pad); y_min = max(0, y_min - pad)
                x_max = min(img.shape[1], x_max + pad); y_max = min(img.shape[0], y_max + pad)
                roi = img[y_min:y_max, x_min:x_max].copy()
                if roi.size > 0:
                    mask = np.zeros((y_max - y_min, x_max - x_min), dtype=np.uint8)
                    for pts in all_pts:
                        cv2.fillPoly(mask, [pts - [x_min, y_min]], 255)
                    roi = cv2.bitwise_and(roi, roi, mask=mask)
                    sc = min(ROI_SIZE[0] / roi.shape[1], ROI_SIZE[1] / roi.shape[0])
                    nw, nh = int(roi.shape[1] * sc), int(roi.shape[0] * sc)
                    if nw > 0 and nh > 0:
                        canvas[:nh, :nw] = cv2.resize(roi, (nw, nh))
                return canvas
        rx, ry, rw, rh = [max(0, int(v)) for v in ann.get('bbox', [0,0,0,0])]
        if rw > 0 and rh > 0 and ry+rh <= img.shape[0] and rx+rw <= img.shape[1]:
            roi = img[ry:ry+rh, rx:rx+rw]
            sc  = min(ROI_SIZE[0]/roi.shape[1], ROI_SIZE[1]/roi.shape[0])
            nw, nh = int(roi.shape[1]*sc), int(roi.shape[0]*sc)
            if nw > 0 and nh > 0:
                canvas[:nh, :nw] = cv2.resize(roi, (nw, nh))
        return canvas

    for idx, (ann, res) in enumerate(zip(annotations, results)):
        row_i  = idx // rois_per_row
        col_i  = idx % rois_per_row
        x_off  = 20 + col_i * (compare_width + 40)
        y_off  = 60 + row_i * roi_row_height

        t_roi  = _extract_roi_viz(template_img, ann)
        p_roi  = _extract_roi_viz(aligned_pred, ann)
        max_h  = max(t_roi.shape[0], p_roi.shape[0])
        canvas = np.full((max_h, compare_width, 3), COLOR_BG, dtype=np.uint8)
        canvas[:t_roi.shape[0], :ROI_SIZE[0]] = t_roi
        canvas[:p_roi.shape[0], ROI_SIZE[0]+10:ROI_SIZE[0]+10+p_roi.shape[1]] = p_roi
        cv2.line(canvas, (ROI_SIZE[0]+5, 0), (ROI_SIZE[0]+5, max_h), (128,128,128), 1)

        color    = COLOR_ANOMALY if res.get('is_anomaly', False) else COLOR_NORMAL
        bordered = cv2.copyMakeBorder(canvas, 3, 3, 3, 3, cv2.BORDER_CONSTANT, value=color)
        rh2, rw2 = bordered.shape[:2]
        row2[y_off:y_off+rh2, x_off:x_off+rw2] = bordered

        row2 = cv2_put_chinese_text(row2, "模板",    (x_off+10,             max(y_off-5,0)), (180,180,180), 12)
        row2 = cv2_put_chinese_text(row2, "对齐预测", (x_off+ROI_SIZE[0]+15, max(y_off-5,0)), (180,180,180), 12)
        text_y = y_off + rh2 + 5
        row2 = cv2_put_chinese_text(row2, f"#{idx+1} {res.get('category','?')}", (x_off, text_y), color, 14)
        text_y += 20
        row2 = cv2_put_chinese_text(row2, "异常" if res.get('is_anomaly') else "正常", (x_off, text_y), color, 14)
        text_y += 20
        row2 = cv2_put_chinese_text(row2, f"Score: {res.get('anomaly_score',0):.3f}", (x_off, text_y), (180,180,180), 11)

    anomaly_count = sum(1 for r in results if r.get("is_anomaly", False))
    normal_count  = len(results) - anomaly_count
    header = np.full((50, row2_width, 3), (60, 60, 60), dtype=np.uint8)
    title  = f"检测结果 | 策略:{strategy} | ROI:{len(results)} | 缺陷:{anomaly_count} | 正常:{normal_count}"
    header = cv2_put_chinese_text(header, title, (20, 32), (255,255,255), 20)

    return np.vstack([header, row1, row2])


def transform_bbox_with_H(bbox, H, img_size=None):
    x, y, w, h = bbox
    corners = np.array([[x,y],[x+w,y],[x+w,y+h],[x,y+h]], dtype=np.float32).reshape(-1,1,2)
    t = cv2.perspectiveTransform(corners, H).reshape(-1, 2)
    x0, y0 = np.min(t[:,0]), np.min(t[:,1])
    x1, y1 = np.max(t[:,0]), np.max(t[:,1])
    if img_size:
        iw, ih = img_size
        x0, y0 = max(0, min(x0, iw)), max(0, min(y0, ih))
        x1, y1 = max(0, min(x1, iw)), max(0, min(y1, ih))
    return [float(x0), float(y0), float(x1-x0), float(y1-y0)]


def detect_with_template_coords(
    detector,
    image:           np.ndarray,
    template_image:  np.ndarray,
    annotations:     List[Dict],
    request_id:      str = "",
    monitor:         Optional[PerformanceMonitor] = None,
    return_visualization: bool = False,
) -> Dict[str, Any]:
    if template_image is None or not annotations:
        return {"results": [], "visualization": None, "strategy": "none", "aligned_pred": None}

    local_monitor = monitor if monitor else PerformanceMonitor(request_id or "internal")
    tmpl_h, tmpl_w = template_image.shape[:2]

    local_monitor.start_step("detect_workpiece")
    # 使用缓存的模板工件bbox，避免重复检测
    global CACHED_TEMPLATE_WORKPIECE
    if CACHED_TEMPLATE_WORKPIECE is not None:
        tmpl_workpiece = CACHED_TEMPLATE_WORKPIECE
        logger.debug(f"[{request_id}] Using cached template workpiece bbox")
    else:
        tmpl_workpiece = detect_workpiece_bbox(template_image, padding=30) or (0, 0, tmpl_w, tmpl_h)
        CACHED_TEMPLATE_WORKPIECE = tmpl_workpiece
        logger.info(f"[{request_id}] Cached template workpiece bbox: {tmpl_workpiece}")
    pred_workpiece = detect_workpiece_bbox(image, padding=30) or (0, 0, image.shape[1], image.shape[0])
    local_monitor.end_step("detect_workpiece")

    local_monitor.start_step("sift_alignment")
    tx, ty, tw, th = tmpl_workpiece
    px, py, pw, ph = pred_workpiece
    tmpl_roi = template_image[ty:ty+th, tx:tx+tw]
    pred_roi = image[py:py+ph, px:px+pw]

    sift = cv2.SIFT_create(5000)  # 减少特征点数量，提高性能
    bf   = cv2.BFMatcher(cv2.NORM_L2)
    tmpl_gray = cv2.cvtColor(tmpl_roi, cv2.COLOR_BGR2GRAY) if len(tmpl_roi.shape) == 3 else tmpl_roi
    pred_gray = cv2.cvtColor(pred_roi, cv2.COLOR_BGR2GRAY) if len(pred_roi.shape) == 3 else pred_roi

    kp_tmpl, des_tmpl = sift.detectAndCompute(tmpl_gray, None)
    kp_pred, des_pred = sift.detectAndCompute(pred_gray, None)

    H = None; strategy = "none"
    if des_tmpl is not None and des_pred is not None and len(kp_tmpl) > 10 and len(kp_pred) > 10:
        matches = bf.knnMatch(des_tmpl, des_pred, k=2)
        good    = [m for m_n in matches if len(m_n)==2 for m, n in [m_n] if m.distance < 0.8*n.distance]
        if len(good) > 10:
            src_pts = np.float32([[kp_tmpl[m.queryIdx].pt[0]+tx, kp_tmpl[m.queryIdx].pt[1]+ty] for m in good]).reshape(-1,1,2)
            dst_pts = np.float32([[kp_pred[m.trainIdx].pt[0]+px, kp_pred[m.trainIdx].pt[1]+py] for m in good]).reshape(-1,1,2)
            H_fwd, _ = cv2.findHomography(src_pts, dst_pts, cv2.RANSAC, 8.0)
            if H_fwd is not None:
                H = np.linalg.inv(H_fwd)
                strategy = "sift_workpiece"
                logger.info(f"[{request_id}] SIFT 工件对齐成功，匹配点数: {len(good)}")

    if H is None:
        H = np.eye(3, dtype=np.float64)
    local_monitor.end_step("sift_alignment")

    local_monitor.start_step("warp_image")
    aligned_pred = cv2.warpPerspective(
        image, H, (tmpl_w, tmpl_h),
        flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_CONSTANT, borderValue=(0,0,0)
    )
    local_monitor.end_step("warp_image")

    local_monitor.start_step("roi_inference")
    category_rois:    Dict[str, List[tuple]] = {}
    category_indices: Dict[str, List[int]]   = {}

    for i, ann in enumerate(annotations):
        category = ann.get("category")
        if not category or category not in detector.models:
            continue

        roi = None
        segmentation = ann.get("segmentation", [])
        bbox = ann.get("bbox", [0, 0, 0, 0])

        if segmentation and len(segmentation) > 0:
            roi = _extract_roi_from_segmentation(aligned_pred, segmentation, pad_ratio=0.0)

        if roi is None or roi.size == 0:
            if not bbox or len(bbox) < 4:
                continue
            x, y, w, h = [int(v) for v in bbox]
            x = max(0, min(x, tmpl_w-1)); y = max(0, min(y, tmpl_h-1))
            w = min(w, tmpl_w-x);         h = min(h, tmpl_h-y)
            if w <= 0 or h <= 0:
                continue
            roi = aligned_pred[y:y+h, x:x+w]

        if roi is None or roi.size == 0:
            continue

        category_rois.setdefault(category, []).append(roi)
        category_indices.setdefault(category, []).append((i, ann.get("category_name", category)))

    results_map: Dict[int, Dict] = {}
    for category, rois in category_rois.items():
        indices_info         = category_indices[category]
        category_annotations = [annotations[idx] for idx, _ in indices_info]
        det_results = detector.detect_category(
            rois, category, request_id,
            annotations=category_annotations,
        )
        H_inv = np.linalg.inv(H) if H is not None else np.eye(3, dtype=np.float64)

        for idx, det_result in enumerate(det_results):
            ann_idx, category_name = indices_info[idx]
            ann  = annotations[ann_idx]
            bbox = ann.get("bbox", [0,0,0,0])
            segm = ann.get("segmentation", [])

            x, y, w, h = [float(v) for v in bbox]
            corners = np.array([[x,y],[x+w,y],[x+w,y+h],[x,y+h]], dtype=np.float64).reshape(-1,1,2)
            tc      = cv2.perspectiveTransform(corners, H_inv).reshape(-1,2)
            bbox_in_pred = [float(np.min(tc[:,0])), float(np.min(tc[:,1])),
                            float(np.max(tc[:,0])-np.min(tc[:,0])), float(np.max(tc[:,1])-np.min(tc[:,1]))]

            segm_in_pred = []
            if segm and len(segm) > 0 and len(segm[0]) >= 8:
                pts = np.array([[segm[0][i], segm[0][i+1]] for i in range(0, len(segm[0]), 2)],
                               dtype=np.float64).reshape(-1,1,2)
                tp  = cv2.perspectiveTransform(pts, H_inv).reshape(-1, 2)
                segm_in_pred = [float(v) for v in tp.flatten()]

            results_map[ann_idx] = {
                "category":             category_name,
                "pos_id":               ann.get("pos_id"),
                "bbox":                 bbox,
                "bbox_in_pred":         bbox_in_pred,
                "bbox_clipped":         bbox,
                "segmentation":         segm,
                "segmentation_in_pred": segm_in_pred,
                "is_anomaly":           det_result.get("is_anomaly", False),
                "anomaly_score":        det_result.get("anomaly_score", 0.0),
                "error":                det_result.get("error", 0.0),
                "threshold":            det_result.get("threshold", 0.0),
                "infer_failed":         det_result.get("infer_failed", False),
                "anomaly_type":         "real_defect" if det_result.get("is_anomaly", False) else "normal",
            }

    local_monitor.end_step("roi_inference")

    results = [results_map.get(i, {
        "category":             annotations[i].get("category", "unknown"),
        "pos_id":               annotations[i].get("pos_id"),
        "bbox":                 annotations[i].get("bbox", [0,0,0,0]),
        "bbox_in_pred":         annotations[i].get("bbox", [0,0,0,0]),
        "segmentation":         annotations[i].get("segmentation", []),
        "segmentation_in_pred": [],
        "is_anomaly":           False,
        "anomaly_score":        0.0,
        "error":                0.0,
        "threshold":            0.0,
        "infer_failed":         True,
        "anomaly_type":         "infer_failed",
    }) for i in range(len(annotations))]

    saved_roi_paths = save_roi_screenshots(results, template_image, aligned_pred, annotations, request_id)
    logger.info(f"[{request_id}] ROI截图: OK={len(saved_roi_paths['ok'])}, NG={len(saved_roi_paths['ng'])}")

    visualization = None
    if return_visualization:
        visualization = create_simple_visualization(
            template_image, image, aligned_pred,
            annotations, results, strategy, request_id,
            template_workpiece_bbox=tmpl_workpiece,
            pred_workpiece_bbox=pred_workpiece,
            H=H,
        )

    return {
        "results":            results,
        "visualization":      visualization,
        "strategy":           strategy,
        "aligned_pred":       aligned_pred,
        "H":                  H,
        "template_workpiece": tmpl_workpiece,
        "pred_workpiece":     pred_workpiece,
        "saved_roi_paths":    saved_roi_paths,
    }


def detect_with_template_coords_multi_workpiece(
    detector,
    image: np.ndarray,
    template_image: np.ndarray,
    annotations: List[Dict],
    request_id: str = "",
    monitor: Optional[PerformanceMonitor] = None,
    return_visualization: bool = False,
) -> Dict[str, Any]:
    """
    支持多工件检测的推理函数
    1. 检测图像中的所有工件
    2. 对每个工件进行模板对齐
    3. 对每个工件进行 ROI 检测
    4. 合并所有结果
    """
    if template_image is None or not annotations:
        return {
            "workpieces": [],
            "total_workpieces": 0,
            "total_rois": 0,
            "total_anomalies": 0,
            "visualization": None,
            "strategy": "none",
        }

    local_monitor = monitor if monitor else PerformanceMonitor(request_id or "internal")
    tmpl_h, tmpl_w = template_image.shape[:2]

    # 1. 检测模板工件（用于对齐参考）
    local_monitor.start_step("detect_template_workpiece")
    global CACHED_TEMPLATE_WORKPIECE
    if CACHED_TEMPLATE_WORKPIECE is not None:
        tmpl_workpiece = CACHED_TEMPLATE_WORKPIECE
        logger.debug(f"[{request_id}] Using cached template workpiece bbox")
    else:
        tmpl_workpiece = detect_workpiece_bbox(template_image, padding=30) or (0, 0, tmpl_w, tmpl_h)
        CACHED_TEMPLATE_WORKPIECE = tmpl_workpiece
        logger.info(f"[{request_id}] Cached template workpiece bbox: {tmpl_workpiece}")
    local_monitor.end_step("detect_template_workpiece")

    # 2. 检测输入图像中的所有工件
    local_monitor.start_step("detect_multiple_workpieces")
    pred_workpieces = detect_multiple_workpieces(image, padding=30)
    logger.info(f"[{request_id}] Detected {len(pred_workpieces)} workpiece(s) in input image")
    local_monitor.end_step("detect_multiple_workpieces")

    # 3. 对每个工件进行处理
    all_workpiece_results = []
    total_anomalies = 0
    total_rois = 0

    for wp_idx, pred_workpiece in enumerate(pred_workpieces):
        wp_request_id = f"{request_id}_wp{wp_idx+1}"
        logger.info(f"[{request_id}] Processing workpiece {wp_idx+1}/{len(pred_workpieces)}: {pred_workpiece}")

        local_monitor.start_step(f"align_workpiece_{wp_idx+1}")
        
        # 工件对齐
        tx, ty, tw, th = tmpl_workpiece
        px, py, pw, ph = pred_workpiece
        tmpl_roi = template_image[ty:ty+th, tx:tx+tw]
        pred_roi = image[py:py+ph, px:px+pw]

        sift = cv2.SIFT_create(5000)
        bf = cv2.BFMatcher(cv2.NORM_L2)
        tmpl_gray = cv2.cvtColor(tmpl_roi, cv2.COLOR_BGR2GRAY) if len(tmpl_roi.shape) == 3 else tmpl_roi
        pred_gray = cv2.cvtColor(pred_roi, cv2.COLOR_BGR2GRAY) if len(pred_roi.shape) == 3 else pred_roi

        kp_tmpl, des_tmpl = sift.detectAndCompute(tmpl_gray, None)
        kp_pred, des_pred = sift.detectAndCompute(pred_gray, None)

        H = None
        strategy = "none"
        if des_tmpl is not None and des_pred is not None and len(kp_tmpl) > 10 and len(kp_pred) > 10:
            matches = bf.knnMatch(des_tmpl, des_pred, k=2)
            good = [m for m_n in matches if len(m_n) == 2 for m, n in [m_n] if m.distance < 0.8 * n.distance]
            if len(good) > 10:
                src_pts = np.float32([[kp_tmpl[m.queryIdx].pt[0]+tx, kp_tmpl[m.queryIdx].pt[1]+ty] for m in good]).reshape(-1,1,2)
                dst_pts = np.float32([[kp_pred[m.trainIdx].pt[0]+px, kp_pred[m.trainIdx].pt[1]+py] for m in good]).reshape(-1,1,2)
                H_fwd, _ = cv2.findHomography(src_pts, dst_pts, cv2.RANSAC, 8.0)
                if H_fwd is not None:
                    H = np.linalg.inv(H_fwd)
                    strategy = "sift_workpiece"
                    logger.info(f"[{wp_request_id}] SIFT alignment successful, matches: {len(good)}")

        if H is None:
            H = np.eye(3, dtype=np.float64)
        local_monitor.end_step(f"align_workpiece_{wp_idx+1}")

        # 对齐图像
        local_monitor.start_step(f"warp_workpiece_{wp_idx+1}")
        aligned_pred = cv2.warpPerspective(
            image, H, (tmpl_w, tmpl_h),
            flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_CONSTANT, borderValue=(0,0,0)
        )
        local_monitor.end_step(f"warp_workpiece_{wp_idx+1}")

        # ROI 推理
        local_monitor.start_step(f"roi_inference_wp{wp_idx+1}")
        category_rois: Dict[str, List[tuple]] = {}
        category_indices: Dict[str, List[int]] = {}

        for i, ann in enumerate(annotations):
            category = ann.get("category")
            if not category or category not in detector.models:
                continue

            roi = None
            segmentation = ann.get("segmentation", [])
            bbox = ann.get("bbox", [0, 0, 0, 0])

            if segmentation and len(segmentation) > 0:
                roi = _extract_roi_from_segmentation(aligned_pred, segmentation, pad_ratio=0.0)

            if roi is None or roi.size == 0:
                if not bbox or len(bbox) < 4:
                    continue
                x, y, w, h = [int(v) for v in bbox]
                x = max(0, min(x, tmpl_w-1))
                y = max(0, min(y, tmpl_h-1))
                w = min(w, tmpl_w-x)
                h = min(h, tmpl_h-y)
                if w <= 0 or h <= 0:
                    continue
                roi = aligned_pred[y:y+h, x:x+w]

            if roi is None or roi.size == 0:
                continue

            category_rois.setdefault(category, []).append(roi)
            category_indices.setdefault(category, []).append((i, ann.get("category_name", category)))

        results_map: Dict[int, Dict] = {}
        wp_anomaly_count = 0
        
        for category, rois in category_rois.items():
            indices_info = category_indices[category]
            category_annotations = [annotations[idx] for idx, _ in indices_info]
            det_results = detector.detect_category(
                rois, category, wp_request_id,
                annotations=category_annotations,
            )
            H_inv = np.linalg.inv(H) if H is not None else np.eye(3, dtype=np.float64)

            for idx, det_result in enumerate(det_results):
                ann_idx, category_name = indices_info[idx]
                ann = annotations[ann_idx]
                bbox = ann.get("bbox", [0,0,0,0])
                segm = ann.get("segmentation", [])

                x, y, w, h = [float(v) for v in bbox]
                corners = np.array([[x,y],[x+w,y],[x+w,y+h],[x,y+h]], dtype=np.float64).reshape(-1,1,2)
                tc = cv2.perspectiveTransform(corners, H_inv).reshape(-1,2)
                bbox_in_pred = [float(np.min(tc[:,0])), float(np.min(tc[:,1])),
                                float(np.max(tc[:,0])-np.min(tc[:,0])), float(np.max(tc[:,1])-np.min(tc[:,1]))]

                segm_in_pred = []
                if segm and len(segm) > 0 and len(segm[0]) >= 8:
                    pts = np.array([[segm[0][i], segm[0][i+1]] for i in range(0, len(segm[0]), 2)],
                                   dtype=np.float64).reshape(-1,1,2)
                    tp = cv2.perspectiveTransform(pts, H_inv).reshape(-1, 2)
                    segm_in_pred = [float(v) for v in tp.flatten()]

                is_anomaly = det_result.get("is_anomaly", False)
                if is_anomaly:
                    wp_anomaly_count += 1

                results_map[ann_idx] = {
                    "category":             category_name,
                    "pos_id":               ann.get("pos_id"),
                    "bbox":                 bbox,
                    "bbox_in_pred":         bbox_in_pred,
                    "bbox_clipped":         bbox,
                    "segmentation":         segm,
                    "segmentation_in_pred": segm_in_pred,
                    "is_anomaly":           is_anomaly,
                    "anomaly_score":        det_result.get("anomaly_score", 0.0),
                    "error":                det_result.get("error", 0.0),
                    "threshold":            det_result.get("threshold", 0.0),
                    "infer_failed":         det_result.get("infer_failed", False),
                    "anomaly_type":         "real_defect" if is_anomaly else "normal",
                }

        local_monitor.end_step(f"roi_inference_wp{wp_idx+1}")

        # 构建该工件的完整结果列表
        wp_results = [results_map.get(i, {
            "category":             annotations[i].get("category", "unknown"),
            "pos_id":               annotations[i].get("pos_id"),
            "bbox":                 annotations[i].get("bbox", [0,0,0,0]),
            "bbox_in_pred":         annotations[i].get("bbox", [0,0,0,0]),
            "segmentation":         annotations[i].get("segmentation", []),
            "segmentation_in_pred": [],
            "is_anomaly":           False,
            "anomaly_score":        0.0,
            "error":                0.0,
            "threshold":            0.0,
            "infer_failed":         True,
            "anomaly_type":         "infer_failed",
        }) for i in range(len(annotations))]

        # 工件级可视化
        wp_visualization = None
        if return_visualization:
            wp_visualization = create_simple_visualization(
                template_image, image, aligned_pred,
                annotations, wp_results, strategy, wp_request_id,
                template_workpiece_bbox=tmpl_workpiece,
                pred_workpiece_bbox=pred_workpiece,
                H=H,
            )

        workpiece_info = {
            "workpiece_id":       wp_idx + 1,
            "workpiece_bbox":     pred_workpiece,
            "results":            wp_results,
            "anomaly_count":      wp_anomaly_count,
            "total_rois":         len(wp_results),
            "alignment_strategy": strategy,
            "visualization_b64":  encode_image_to_base64(wp_visualization) if wp_visualization is not None else None,
        }
        all_workpiece_results.append(workpiece_info)
        total_anomalies += wp_anomaly_count
        total_rois += len(wp_results)

    logger.info(f"[{request_id}] Multi-workpiece detection complete: {len(pred_workpieces)} workpieces, "
                f"{total_rois} total ROIs, {total_anomalies} anomalies")

    return {
        "workpieces":       all_workpiece_results,
        "total_workpieces": len(all_workpiece_results),
        "total_rois":       total_rois,
        "total_anomalies":  total_anomalies,
        "visualization":    None,  # 多工件模式下，可视化在各自的workpiece中
        "strategy":         "multi_workpiece",
    }


# ─────────────────────────────────────────────────────────────────────────────
# FastAPI
# ─────────────────────────────────────────────────────────────────────────────

MODELS:               Dict[str, Any]                   = {}
MODEL_PATHS                                            = {{ models_config | tojson(indent=4) }}
PATCHCORE_DETECTOR:   Optional[MultiPatchCoreDetector] = None
TEMPLATE_IMAGE:       Optional[np.ndarray]             = None
TEMPLATE_ANNOTATIONS: List[Dict[str, Any]]             = []
CACHED_TEMPLATE_GRAY: Optional[np.ndarray]             = None
CACHED_TEMPLATE_WORKPIECE: Optional[Tuple[int, int, int, int]] = None  # 缓存模板工件bbox
ACTIVE_DETECTOR:      str                              = "patchcore"


class WorkpieceResult(BaseModel):
    """单个工件的检测结果"""
    workpiece_id:       int
    workpiece_bbox:     List[float]  # [x, y, w, h]
    results:            List[Dict[str, Any]]
    anomaly_count:      int
    total_rois:         int
    alignment_strategy: str
    visualization_b64:  Optional[str] = None


class PredictROIResponse(BaseModel):
    """预测响应，支持单工件或多工件模式"""
    # 单工件模式（向后兼容）
    results:            List[Dict[str, Any]] = []
    processing_time:    float
    total_detections:   int = 0
    anomaly_count:      int = 0
    infer_failed_count: int = 0
    visualization_b64:  Optional[str] = None
    alignment_strategy: str = "none"
    # 多工件模式
    multi_workpiece:    bool = False
    workpieces:         List[WorkpieceResult] = []
    total_workpieces:   int = 0
    total_rois_all:     int = 0


def encode_image_to_base64(img: np.ndarray) -> str:
    if img is None:
        return ""
    _, buffer = cv2.imencode('.png', img)
    return base64.b64encode(buffer).decode('utf-8')


def load_models():
    global PATCHCORE_DETECTOR, MODELS, \
           TEMPLATE_IMAGE, TEMPLATE_ANNOTATIONS, CACHED_TEMPLATE_GRAY

    model_dirs = {
        path for key, path in MODEL_PATHS.items()
        if not key.endswith('_type') and key not in ('_labels', '_model_type')
    }
    if not model_dirs:
        logger.warning("No model directories found")
        return

    base_dir           = Path(list(model_dirs)[0]).parent
    PATCHCORE_DETECTOR = MultiPatchCoreDetector(base_dir)
    if PATCHCORE_DETECTOR.get_loaded_categories():
        MODELS = {
            cat: {'loaded': True, 'detector_type': 'patchcore'}
            for cat in PATCHCORE_DETECTOR.get_loaded_categories()
        }
        logger.info(f"Loaded PatchCore models: {list(MODELS.keys())}")

    # 优先使用传入的 annotations_path，否则尝试默认路径
    annotations_path = None
    if "{{ annotations_path }}":
        annotations_path = Path("{{ annotations_path }}")
    else:
        # 尝试从默认 product 路径加载
        default_path = Path("product/{{ project_id }}/train/{{ task_uuid }}/annotations.json")
        if default_path.exists():
            annotations_path = default_path
            logger.info(f"Using default annotations path: {annotations_path}")
    
    if annotations_path and annotations_path.exists():
        tpl_path, tpl_anns = select_best_template_from_annotations(str(annotations_path))
        if tpl_path:
            TEMPLATE_IMAGE       = cv2.imread(tpl_path)
            TEMPLATE_ANNOTATIONS = tpl_anns
            if TEMPLATE_IMAGE is not None:
                logger.info(f"Loaded template from annotations: {tpl_path}, {len(TEMPLATE_ANNOTATIONS)} annotations")

    if TEMPLATE_IMAGE is None:
        for model_dir in model_dirs:
            tpl = Path(model_dir) / "template.jpg"
            if tpl.exists():
                TEMPLATE_IMAGE = cv2.imread(str(tpl))
                if TEMPLATE_IMAGE is not None:
                    logger.info(f"Loaded template from: {tpl}")
                    break

    if TEMPLATE_IMAGE is None:
        logger.warning("No template image found")
        return

    try:
        CACHED_TEMPLATE_GRAY = enhance_for_matching(cv2.resize(TEMPLATE_IMAGE, (512, 512)))
        logger.info("Cached enhanced template gray image")
    except Exception as e:
        logger.warning(f"Failed to cache template gray: {e}")
        CACHED_TEMPLATE_GRAY = None


@app.on_event("startup")
async def startup_event():
    global _infer_semaphore
    _infer_semaphore = asyncio.Semaphore(4)  # 增加并发数，提高吞吐量
    _executor_manager.init_lock()
    # 使用线程池异步加载模型，避免阻塞事件循环
    loop = asyncio.get_event_loop()
    await loop.run_in_executor(_executor_manager.executor, load_models)
    # 启动时异步加载所有已保存的反例库
    await loop.run_in_executor(_executor_manager.executor, _load_all_negative_banks)


