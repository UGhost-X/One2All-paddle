@app.delete("/negative_banks/{pos_id}/clear")
async def clear_negative_bank(pos_id: str):
    """
    清空指定pos_id的反例库
    
    Args:
        pos_id: 位置ID
    """
    if PATCHCORE_DETECTOR is None:
        raise HTTPException(status_code=500, detail="Models not loaded")
    
    if pos_id not in PATCHCORE_DETECTOR.models:
        raise HTTPException(status_code=404, detail=f"Model not found for pos_id={pos_id}")
    
    model = PATCHCORE_DETECTOR.models[pos_id]
    
    if hasattr(model, 'neg_memory_bank') and model.neg_memory_bank is not None:
        feature_dim = model.neg_memory_bank.shape[1]
        device = model.neg_memory_bank.device
        model.neg_memory_bank = torch.empty(0, feature_dim).to(device)
        
        if hasattr(model, 'dual_detector') and model.dual_detector is not None:
            model.dual_detector.neg_memory_bank = model.neg_memory_bank
        
        logger.info(f"Cleared negative bank for pos_id={pos_id}")
        return {
            "success": True,
            "pos_id": pos_id,
            "message": "Negative bank cleared",
            "negative_bank_size": 0,
        }
    else:
        return {
            "success": True,
            "pos_id": pos_id,
            "message": "No negative bank to clear",
            "negative_bank_size": 0,
        }


# 全局ROI缓存，用于存储最近一次推理的ROI图像
_roi_cache: Dict[str, Any] = {}


# ─────────────────────────────────────────────────────────────────────────────
# 反例库持久化功能
# ─────────────────────────────────────────────────────────────────────────────

def _get_negative_bank_path(pos_id: str) -> Optional[Path]:
    """
    获取反例库的保存路径
    
    Args:
        pos_id: 位置ID
        
    Returns:
        反例库文件路径，如果模型未加载则返回None
    """
    if PATCHCORE_DETECTOR is None:
        return None
    
    # 模型目录结构: {models_dir}/{pos_id}/
    pos_id_dir = PATCHCORE_DETECTOR.models_dir / pos_id
    if not pos_id_dir.exists():
        return None
    
    # 反例库保存路径: {models_dir}/{pos_id}/negative_bank.pt
    return pos_id_dir / "negative_bank.pt"


def _save_negative_bank_to_disk(pos_id: str) -> bool:
    """
    将反例库保存到磁盘
    
    Args:
        pos_id: 位置ID
        
    Returns:
        是否保存成功
    """
    if PATCHCORE_DETECTOR is None or pos_id not in PATCHCORE_DETECTOR.models:
        logger.error(f"Model not found for pos_id={pos_id}")
        return False
    
    model = PATCHCORE_DETECTOR.models[pos_id]
    
    if not hasattr(model, 'neg_memory_bank') or model.neg_memory_bank is None:
        logger.warning(f"No negative bank to save for pos_id={pos_id}")
        return False
    
    neg_bank_path = _get_negative_bank_path(pos_id)
    if neg_bank_path is None:
        logger.error(f"Cannot determine save path for pos_id={pos_id}")
        return False
    
    try:
        # 保存反例库
        torch.save({
            'negative_memory_bank': model.neg_memory_bank.cpu(),
            'pos_id': pos_id,
            'saved_at': datetime.now().isoformat(),
            'bank_size': len(model.neg_memory_bank),
        }, str(neg_bank_path))
        
        logger.info(f"Saved negative bank for pos_id={pos_id} to {neg_bank_path}, size: {len(model.neg_memory_bank)}")
        return True
        
    except Exception as e:
        logger.error(f"Failed to save negative bank for pos_id={pos_id}: {e}")
        return False


def _load_negative_bank_from_disk(pos_id: str) -> bool:
    """
    从磁盘加载反例库
    
    Args:
        pos_id: 位置ID
        
    Returns:
        是否加载成功
    """
    if PATCHCORE_DETECTOR is None or pos_id not in PATCHCORE_DETECTOR.models:
        logger.error(f"Model not found for pos_id={pos_id}")
        return False
    
    neg_bank_path = _get_negative_bank_path(pos_id)
    if neg_bank_path is None or not neg_bank_path.exists():
        logger.info(f"No saved negative bank found for pos_id={pos_id}")
        return False
    
    try:
        # 加载反例库
        checkpoint = torch.load(str(neg_bank_path), map_location='cpu')
        neg_memory_bank = checkpoint.get('negative_memory_bank')
        
        if neg_memory_bank is None:
            logger.warning(f"No negative_memory_bank in checkpoint for pos_id={pos_id}")
            return False
        
        # 确保模型已初始化为双库
        model = PATCHCORE_DETECTOR.models[pos_id]
        if not hasattr(model, 'neg_memory_bank'):
            success = _initialize_negative_bank_for_pos_id(pos_id)
            if not success:
                logger.error(f"Failed to initialize negative bank for pos_id={pos_id}")
                return False
            model = PATCHCORE_DETECTOR.models[pos_id]
        
        # 加载反例库到模型
        device = model.device if hasattr(model, 'device') else torch.device('cpu')
        model.neg_memory_bank = neg_memory_bank.to(device)
        
        if hasattr(model, 'dual_detector') and model.dual_detector is not None:
            model.dual_detector.neg_memory_bank = model.neg_memory_bank
        
        logger.info(f"Loaded negative bank for pos_id={pos_id} from {neg_bank_path}, size: {len(model.neg_memory_bank)}")
        return True
        
    except Exception as e:
        logger.error(f"Failed to load negative bank for pos_id={pos_id}: {e}")
        return False


def _load_all_negative_banks():
    """
    启动时加载所有已保存的反例库
    """
    if PATCHCORE_DETECTOR is None:
        return
    
    logger.info("Loading all saved negative banks...")
    loaded_count = 0
    
    for pos_id in PATCHCORE_DETECTOR.models.keys():
        neg_bank_path = _get_negative_bank_path(pos_id)
        if neg_bank_path is not None and neg_bank_path.exists():
            if _load_negative_bank_from_disk(pos_id):
                loaded_count += 1
    
    logger.info(f"Loaded {loaded_count} negative banks from disk")


